  export DEBIAN_FRONTEND=noninteractive
  local need=0
  [ -x /usr/sbin/sshd ] || need=1
  have nft || need=1
  have curl || need=1
  have python3 || need=1
  [ "$need" = 1 ] || return 0
  apt-get update -qq || true
