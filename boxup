try:
    p = json.load(sys.stdin)
    print(",".join(str(x) for x in (p.get("AdvertiseRoutes") or [])))
except Exception:
    print("")
' 2>/dev/null || true
}

# H13 (P1-4): true (0) iff the tailnet shows at least one PEER. Naming is
# computed from peers only (Self is often still `cursor`), so `name: unnamed` is
# only a health FAILURE once peers are visible — a genuinely lone first node has
# nothing to pick against and must not be failed forever.
has_peers() {
  ts status --json 2>/dev/null | python3 -c '
import json, sys
try:
    print("yes" if (json.load(sys.stdin).get("Peer") or {}) else "no")
except Exception:
    print("no")
' 2>/dev/null | grep -q yes
}

prefs_hostname() {
  ts debug prefs 2>/dev/null | python3 -c '
import json, sys
try:
    print((json.load(sys.stdin).get("Hostname") or "").strip())
except Exception:
    print("")
' 2>/dev/null || true
}

# F9 (#9): the tags the device ALREADY carries in its current prefs. Source
# from live prefs (debug prefs AdvertiseTags), falling back to status --json
# Self.Tags. NEVER from config.toml [tailscale] tags — that is first-login-only
# (F11). Prints a comma-separated "tag:a,tag:b" or empty. Restating tags the
# node already has is a MENTION the CLI demands, not INTRODUCING new tags.
current_advertise_tags() {
  local tags
  tags="$(ts debug prefs 2>/dev/null | python3 -c '
import json, sys
try:
    t = json.load(sys.stdin).get("AdvertiseTags") or []
    print(",".join(str(x) for x in t))
except Exception:
    print("")
' 2>/dev/null || true)"
  if [ -z "$tags" ]; then
    tags="$(ts status --json 2>/dev/null | python3 -c '
import json, sys
try:
    t = (json.load(sys.stdin).get("Self") or {}).get("Tags") or []
    print(",".join(str(x) for x in t))
except Exception:
    print("")
' 2>/dev/null || true)"
  fi
  echo "$tags"
}

# D1/D2 (#10): resolve the FIRST-LOGIN advertise-tags from config, applying the
# code default. This is the ONLY tag source for the first-login `up` (F5: it is
# also passed to run_reauth_up by `boxup retag`; NEVER read on the unattended
# --force-reauth path — that MENTIONS live tags via current_advertise_tags).
# Semantics, matching config_get's found/not-found exit code:
#   * key ABSENT (config_get exit 1)     -> DEFAULT_TS_TAGS ("tag:grok-box")
#   * key PRESENT, non-empty (exit 0)    -> that value verbatim
#   * key PRESENT, empty "" (exit 0)     -> empty (deliberate untagged opt-out)
# Prints the resolved tag string (may be empty). Never fails.
resolved_config_tags() {
  local tags
  if tags="$(config_get tailscale tags)"; then
    # Present (possibly empty): honour it verbatim — empty is an explicit opt-out.
    printf '%s' "$tags"
  else
    # Absent: the code default applies.
    printf '%s' "$DEFAULT_TS_TAGS"
  fi
}

# D3 (#10): the node-identity predicate, shared by `check` and `boxup retag`.
# Reads NOTHING itself (F2: no second `tailscale status --json`) — the CALLER
# must have run read_ts_fields first, so ts_tags / ts_keyexpiry are populated
# from the SAME single parser pass check_reason already runs. Prints the first
# failing check_reason-style `kebab:detail` token (empty ⇒ identity OK):
#   tags-missing:<want>          any wanted tag is not in the device's Self.Tags
#                                (want empty ⇒ predicate SKIPPED: untagged-by-
#                                choice is not a failure).
#   key-expiry-enabled:<date>    node-key expiry is ENABLED (Self.KeyExpiry
#                                PRESENT, F1) AND the node is supposed to be
#                                tagged (want non-empty). An untagged-by-choice
#                                box is NOT flagged for expiry (expected TS
#                                behaviour, the operator's call).
# $1 = wanted tags, comma-separated (the resolved_config_tags value).
verify_node_identity() {
  local want="$1" reason="" t have=",${ts_tags:-},"
  # tags-missing: every wanted tag must appear in the device's current tags.
  if [ -n "$want" ]; then
    local IFS=,
    for t in $want; do
      [ -n "$t" ] || continue
      case "$have" in
        *",$t,"*) ;;
        *) reason="tags-missing:$want"; break ;;
      esac
    done
  fi
  # key-expiry-enabled: only meaningful when the node is supposed to be tagged.
  if [ -z "$reason" ] && [ -n "$want" ] && [ -n "${ts_keyexpiry:-}" ]; then
    # Trim the RFC3339 timestamp to the YYYY-MM-DD date for the token.
    reason="key-expiry-enabled:${ts_keyexpiry%%T*}"
  fi
  printf '%s' "$reason"
}

wait_for_socket() {
  local i=0
  while [ "$i" -lt 25 ]; do
    [ -S "$TS_SOCK" ] || [ -S /run/tailscale/tailscaled.sock ] && return 0
    sleep 0.2; i=$((i + 1))
  done
  return 1
}

# Wait until backend is Running / NeedsLogin / Stopped / Starting, or timeout.
# NoState right after start is not NeedsLogin and not a reason to mint AuthURL.
wait_for_backend() {
  local i=0
  while [ "$i" -lt 20 ]; do
    read_ts_fields
    case "$backend" in
      Running|NeedsLogin|Stopped|Starting) echo "$backend"; return 0 ;;
    esac
    sleep 0.5; i=$((i + 1))
  done
  echo "${backend:-NoState}"
  return 1
}

