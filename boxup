# --- converge: tailscale binaries -------------------------------------------
# Vendored static binaries under $BIN_DIR are the primary install: they live
# in /workspace, so after an image swap the daemon restarts without waiting on
# apt or the network. Sources, in order: existing bin/, a system install to
# copy, the official static tarball, and finally the apt repo.
ts_version_want() { config_get tailscale version || echo "$DEFAULT_TS_VERSION"; }

vendor_from_tarball() {
  local ver="$1" arch tmp url
  case "$(uname -m)" in
    x86_64) arch=amd64 ;;
    aarch64) arch=arm64 ;;
    *) return 1 ;;
  esac
  have curl || return 1
  url="https://pkgs.tailscale.com/stable/tailscale_${ver}_${arch}.tgz"
  tmp="$(mktemp -d)" || return 1
  if curl -fsSL "$url" | tar -xz -C "$tmp" --strip-components=1 2>/dev/null \
      && [ -x "$tmp/tailscaled" ] && [ -x "$tmp/tailscale" ] \
      && "$tmp/tailscaled" --version >/dev/null 2>&1; then
    install -m 0755 "$tmp/tailscaled" "$BIN_DIR/tailscaled"
    install -m 0755 "$tmp/tailscale" "$BIN_DIR/tailscale"
    rm -rf "$tmp"
    log "vendored tailscale $ver ($arch) into $BIN_DIR"
    return 0
  fi
  rm -rf "$tmp"
  return 1
}

vendor_from_apt() {
  have apt-get || return 1
  local codename=trixie gpg=/usr/share/keyrings/tailscale-archive-keyring.gpg
  if [ -f /etc/os-release ]; then
    # shellcheck disable=SC1091
    . /etc/os-release
    codename="${VERSION_CODENAME:-trixie}"
  fi
  if [ ! -f "$gpg" ] && have curl; then
    curl -fsSL "https://pkgs.tailscale.com/stable/debian/${codename}.noarmor.gpg" \
      -o "$gpg" 2>/dev/null || true
  fi
  if [ -f "$gpg" ]; then
    echo "deb [signed-by=$gpg] https://pkgs.tailscale.com/stable/debian ${codename} main" \
      > /etc/apt/sources.list.d/tailscale.list
    apt-get update -qq || true
  fi
  apt-get install -y -qq tailscale 2>/dev/null || return 1
  [ -x /usr/sbin/tailscaled ] || return 1
  install -m 0755 /usr/sbin/tailscaled "$BIN_DIR/tailscaled"
  install -m 0755 /usr/bin/tailscale "$BIN_DIR/tailscale"
  return 0
}

ensure_tailscale_bin() {
  local want
  want="$(ts_version_want)"
  if [ -x "$BIN_DIR/tailscaled" ] && [ -x "$BIN_DIR/tailscale" ]; then
    # Re-vendor only when the config pins a different version.
    local cur
    cur="$("$BIN_DIR/tailscale" --version 2>/dev/null | head -1 | tr -d '[:space:]')"
    if [ -z "$(config_get tailscale version || true)" ] || [ "$cur" = "$want" ]; then
      return 0
    fi
    log "tailscale $cur -> $want (config pin)"
  elif [ -x /usr/sbin/tailscaled ] && [ -x /usr/bin/tailscale ]; then
    install -m 0755 /usr/sbin/tailscaled "$BIN_DIR/tailscaled"
    install -m 0755 /usr/bin/tailscale "$BIN_DIR/tailscale"
    return 0
  fi
  vendor_from_tarball "$want" && return 0
  vendor_from_apt && return 0
  [ -x "$BIN_DIR/tailscaled" ] && return 0   # keep what we have
  log "ensure_tailscale_bin: no tailscale binaries available" >&2
  return 1
}

# --- converge: sshd ----------------------------------------------------------
SSHD_DROPIN="/etc/ssh/sshd_config.d/00-box-setup.conf"

# Password login is the contract for these boxes: after an image swap it is the
# only way back in. Own it in a drop-in rather than sed-ing the main file —
# Debian's sshd_config Includes sshd_config.d/*.conf near the top and sshd
# keeps the FIRST value it obtains, so 00- wins over the main file and over
# any other drop-in. Falls back to editing the main file on images without
# Include support.
write_sshd_config() {
  local tmp
  if [ -d /etc/ssh/sshd_config.d ] && \
     grep -qiE '^[[:space:]]*Include[[:space:]]+.*sshd_config\.d' \
       /etc/ssh/sshd_config 2>/dev/null; then
    tmp="$(mktemp)" || return 1
    cat > "$tmp" <<'DROPIN'
# Managed by grok-box-setup (boxup). Overwritten on every converge.
# Set the password in /workspace/box-setup/config.toml instead.
ListenAddress 0.0.0.0
ListenAddress ::
PermitRootLogin yes
PasswordAuthentication yes
KbdInteractiveAuthentication yes
UsePAM yes
DROPIN
    if [ -f "$SSHD_DROPIN" ] && cmp -s "$tmp" "$SSHD_DROPIN"; then
      rm -f "$tmp"
      return 1          # already correct, no reload needed
    fi
    install -m 0644 "$tmp" "$SSHD_DROPIN"
    rm -f "$tmp"
    return 0
  fi
  [ -f /etc/ssh/sshd_config ] || return 1
  grep -q '^ListenAddress 0.0.0.0' /etc/ssh/sshd_config 2>/dev/null || \
    echo 'ListenAddress 0.0.0.0' >> /etc/ssh/sshd_config
  grep -q '^ListenAddress ::' /etc/ssh/sshd_config 2>/dev/null || \
    echo 'ListenAddress ::' >> /etc/ssh/sshd_config
  sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config 2>/dev/null || true
  sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config 2>/dev/null || true
  return 0
}

# Host keys live in /etc/ssh, which dies on image swap; clients then see a
# changed-host-key warning on every swap. Persist the keys in state/ssh and
# restore them, so each grok-box-N keeps one SSH identity for its lifetime.
ensure_host_keys() {
  local k restored=0
  if [ ! -f /etc/ssh/ssh_host_ed25519_key ] && \
     [ -f "$SSH_STATE_DIR/ssh_host_ed25519_key" ]; then
    for k in "$SSH_STATE_DIR"/ssh_host_*; do
      [ -e "$k" ] || continue
      cp -a "$k" /etc/ssh/ 2>/dev/null && restored=1
    done
    [ "$restored" = 1 ] && log "sshd: restored persisted host keys"
  fi
  [ -f /etc/ssh/ssh_host_ed25519_key ] || ssh-keygen -A >/dev/null 2>&1 || true
  for k in /etc/ssh/ssh_host_*_key /etc/ssh/ssh_host_*_key.pub; do
    [ -f "$k" ] || continue
    if [ ! -f "$SSH_STATE_DIR/$(basename "$k")" ]; then
      cp -a "$k" "$SSH_STATE_DIR/" 2>/dev/null || true
    fi
  done
}

ensure_sshd() {
  local changed=0 pw
  mkdir -p /run/sshd /etc/ssh
  ensure_host_keys
  write_sshd_config && changed=1

  # Grok images ship box/root with a locked shadow entry (* / !) and /etc/shadow
  # dies on image swap — sshd=up is not a working login. Re-apply every converge.
  # H7 (P0): do NOT swallow chpasswd failure — a failed unlock means the box can
  # be sshd=up yet have NO usable login (the exact resurrection-path trap). Log
  # each non-zero rc loudly; `boxup check` independently verifies the accounts
  # are actually unlocked (not merely that we tried).
  pw="$(ssh_password)"
  if have chpasswd; then
    if id box >/dev/null 2>&1; then
      if ! printf 'box:%s\n' "$pw" | chpasswd 2>/dev/null; then
        log "sshd: ERROR chpasswd failed to set box password — login may be locked out despite sshd up (H7)" >&2
      fi
    fi
    if ! printf 'root:%s\n' "$pw" | chpasswd 2>/dev/null; then
      log "sshd: ERROR chpasswd failed to set root password — login may be locked out despite sshd up (H7)" >&2
    fi
  else
    log "sshd: ERROR chpasswd not available — cannot unlock box/root accounts (H7)" >&2
  fi

  if [ -x /usr/sbin/sshd ]; then
    if pgrep -x sshd >/dev/null 2>&1; then
      # Reload only on config change; a HUP every tick churns sshd for nothing.
      [ "$changed" = 1 ] && kill -HUP "$(pgrep -n -x sshd)" 2>/dev/null || true
    else
      # H9/D4: route sshd's spawn through spawn_detached for CONSISTENCY and
      # defense-in-depth — every long-lived spawn goes through one helper that
      # closes the converge-lock fd (fd 9). NB: a self-daemonizing sshd already
      # drops inherited fds on its own, and since H1 the converge body runs with
      # the lock fd closed anyway (flock --close), so sshd was never a CONFIRMED
      # leak — this is belt-and-braces, not a fix for an observed sshd bug.
      spawn_detached "" /usr/sbin/sshd || true
    fi
  fi
}

# --- converge: forwarding ----------------------------------------------------
# Admin console "cannot relay traffic" fires if EITHER v4 or v6 forwarding is 0.
write_proc() {
  local path="$1" val="$2" cur
  [ -e "$path" ] || return 0
  cur=$(tr -d '[:space:]' < "$path" 2>/dev/null || echo "")
  [ "$cur" = "$val" ] && return 0
  echo "$val" > "$path" 2>/dev/null && return 0
  local key="${path#/proc/sys/}"
  sysctl -w "${key//\//.}=${val}" >/dev/null 2>&1 || return 1
}

ensure_forwarding() {
  local changed=0 p before after d v4 v6
  if [ -d /etc/sysctl.d ] || mkdir -p /etc/sysctl.d 2>/dev/null; then
    cat > /etc/sysctl.d/99-tailscale-exitnode.conf 2>/dev/null <<'EOF' || true
net.ipv4.ip_forward = 1
net.ipv4.conf.all.forwarding = 1
net.ipv4.conf.default.forwarding = 1
net.ipv6.conf.all.forwarding = 1
net.ipv6.conf.default.forwarding = 1
net.ipv4.conf.all.src_valid_mark = 1
net.ipv4.conf.all.rp_filter = 2
net.ipv4.conf.default.rp_filter = 2
EOF
  fi
  for p in \
    /proc/sys/net/ipv4/ip_forward \
    /proc/sys/net/ipv4/conf/all/forwarding \
    /proc/sys/net/ipv4/conf/default/forwarding \
    /proc/sys/net/ipv6/conf/all/forwarding \
    /proc/sys/net/ipv6/conf/default/forwarding \
    /proc/sys/net/ipv4/conf/all/src_valid_mark
  do
    before=$(tr -d '[:space:]' < "$p" 2>/dev/null || echo "")
    write_proc "$p" 1 || log "forwarding: cannot write $p (need NET_ADMIN)" >&2
    after=$(tr -d '[:space:]' < "$p" 2>/dev/null || echo "")
    [ "$before" != "$after" ] && changed=1
  done
  write_proc /proc/sys/net/ipv4/conf/all/rp_filter 2 || true
  write_proc /proc/sys/net/ipv4/conf/default/rp_filter 2 || true
  # Per-interface v6 forwarding: conf/all does not cover already-up interfaces.
  for d in /proc/sys/net/ipv6/conf/*/forwarding; do
    [ -e "$d" ] || continue
    case "$d" in */lo/forwarding) continue ;; esac
    write_proc "$d" 1 || true
  done

  v4=$(tr -d '[:space:]' < /proc/sys/net/ipv4/ip_forward 2>/dev/null || echo 0)
  v6=$(tr -d '[:space:]' < /proc/sys/net/ipv6/conf/all/forwarding 2>/dev/null || echo 0)
  {
    echo "ipfwd_v4=${v4}"
    echo "ipfwd_v6=${v6}"
    echo "changed=${changed}"
    echo "ts=$(date +%s)"
  } > "$RUN_DIR/ipfwd.env" 2>/dev/null || true
  [ "$v4" = 1 ] && [ "$v6" = 1 ]
}

# --- converge: NAT -----------------------------------------------------------
# Docker's FORWARD DROP + a missing masquerade = exit node "connected" with no
# WAN. nft rules die with the overlay, so re-apply every tick. The whole file
# is one kernel transaction (create-if-absent, delete, redefine) — atomic and
# idempotent, no grep-the-rule-text games. The ip6 output reject + prohibit
# default route force-fail IPv6 fast so exit-node clients fall back to v4
# instead of hanging on a WAN that has no v6.
ensure_nat() {
  if have nft; then
    nft -f - <<'NFT' 2>/dev/null || log "nat: nft apply failed" >&2
table ip ts-exitfix {}
delete table ip ts-exitfix
table ip ts-exitfix {
  chain postrouting {
    type nat hook postrouting priority 100;
    oifname != "lo" masquerade
  }
  chain forward {
    type filter hook forward priority 0;
    iifname "tailscale0" accept
    oifname "tailscale0" accept
  }
}
table ip6 ts-exitfix {}
delete table ip6 ts-exitfix
table ip6 ts-exitfix {
  chain postrouting {
    type nat hook postrouting priority 100;
    oifname != "lo" masquerade
  }
  chain forward {
    type filter hook forward priority 0;
    iifname "tailscale0" accept
    oifname "tailscale0" accept
  }
  chain output {
    type filter hook output priority 0;
    oifname != "lo" oifname != "tailscale0" reject
  }
}
NFT
  fi
  if have iptables-legacy; then
    iptables-legacy -C DOCKER-USER -j ACCEPT 2>/dev/null || \
      iptables-legacy -I DOCKER-USER 1 -j ACCEPT 2>/dev/null || \
      iptables-legacy -A DOCKER-USER -j ACCEPT 2>/dev/null || true
    iptables-legacy -C FORWARD -i tailscale0 -j ACCEPT 2>/dev/null || \
      iptables-legacy -I FORWARD 1 -i tailscale0 -j ACCEPT 2>/dev/null || true
    iptables-legacy -C FORWARD -o tailscale0 -j ACCEPT 2>/dev/null || \
      iptables-legacy -I FORWARD 1 -o tailscale0 -j ACCEPT 2>/dev/null || true
  fi
  if have ip; then
    ip -6 route show default 2>/dev/null | grep -q prohibit || \
      ip -6 route replace prohibit default 2>/dev/null || true
  fi
}

# --- converge: detached long-lived spawns (F7 / #7 + addendum P0-A) ----------
# THE ONE place that spawns a long-lived, detached child. Every long-lived
# process boxup starts — tailscaled, sshd (both spawn sites), and the worker —
# goes through here (H9). Since H1 the converge lock is flock --close, so the
# body already runs with the lock fd CLOSED — this helper is DEFENSE-IN-DEPTH
# and consistency (one place any future spawn is guaranteed clean), NOT the
# load-bearing #7 fix. A lint/test rule fails if setsid/nohup/disown appears
# outside this function.
#
# Closes both fds boxup ever flocks, so a child inherits neither regardless of
# what the caller held:
#   * fd 9 -> $CONVERGE_LOCK (H1) and $START_LOCK (start_tailscaled's fork
#     window) — both use fd 9, at different times/subshells.
#   * fd 8 -> historical converge-lock fd (pre-H1); closed too so a LEGACY
#     daemon's inherited fd 8 is never propagated further during the transition.
# All are write fds, so closes use `>&-`. setsid -f fully detaches (new session,
# no controlling tty) so the child outlives this shell. NB: a self-daemonizing
# child (sshd) drops fds on its own anyway — the close here is belt-and-braces.
#
# Usage: spawn_detached <logfile|""> <cmd> [args...]
#   logfile: append target for the child's stdout+stderr; "" -> /dev/null.
# The caller passes any `env VAR=... cmd ...` as the command words.
spawn_detached() {
  local out="$1"; shift
  if [ -n "$out" ]; then
    setsid -f "$@" 8>&- 9>&- >>"$out" 2>&1
  else
    setsid -f "$@" 8>&- 9>&- >/dev/null 2>&1
  fi
}

# --- converge: FLEET-BRAIN reverse tunnel (docs/FLEET-BRAIN.md §1) ------------
# The boxup tick supervises a plain `ssh -N` reverse tunnel in a loop, exactly
# like it supervises tailscaled/sshd — NOT autossh (no extra binary survives an
# image swap), NOT a systemd unit (no systemd in the sand container). Each tick:
# if no live tunnel process, (re)spawn it detached via spawn_detached and let
# the tick own the lifecycle. Liveness is CLIENT-driven (ServerAliveInterval/
# CountMax) because the VPS runs ClientAliveInterval 0 and never reaps a dead
# tunnel. Backoff bounds respawn storms when the VPS is unreachable.
#
# UNCONFIGURED ⇒ SILENT NO-OP: with no [fleet].vps set, an un-enrolled box does
# nothing here and is completely unaffected.

# fleet_configured: 0 iff [fleet].vps is set (a VPS host to tunnel to).
fleet_configured() {
  local vps; vps="$(config_get fleet vps || true)"
  [ -n "$vps" ]
}

# =============================================================================
# box-naming-3digit D1 — canonical grok-box-NNN name <-> index helpers.
# These two functions are BYTE-IDENTICAL in boxup and fleetctl (a test diffs the
# two definitions); edit them TOGETHER. `box_index_from_name` is the ONLY place
# allowed to turn a name into an integer for arithmetic: it parses with 10# so a
# padded suffix (008/009) is DECIMAL, not octal — fixing the live bug where
# $((20000+008)) errored and $((20000+011)) silently became 20009. Parsers stay
# permissive ([0-9]{1,3}) so legacy unpadded names are still recognised; only
# emitters (box_name_from_index) produce the padded canonical form.
# =============================================================================
# box_name_from_index <int> -> grok-box-NNN (three-digit, zero-padded).
box_name_from_index() {
  local n="${1#grok-box-}"
  case "$n" in ''|*[!0-9]*) return 1 ;; esac
  printf 'grok-box-%03d' "$((10#$n))"
}

# box_index_from_name <grok-box-N|N> -> DECIMAL integer via 10#. Rejects (rc 1,
# empty) anything not matching ^grok-box-[0-9]{1,3}$ (a bare 1..3-digit N is
# accepted too, for callers that pass a raw index). Never does octal arithmetic.
box_index_from_name() {
  local raw="$1" n="${1#grok-box-}"
  case "$raw" in
    grok-box-[0-9]|grok-box-[0-9][0-9]|grok-box-[0-9][0-9][0-9]) : ;;
    [0-9]|[0-9][0-9]|[0-9][0-9][0-9]) : ;;
    *) return 1 ;;
  esac
  case "$n" in ''|*[!0-9]*) return 1 ;; esac
  printf '%s' "$((10#$n))"
}

# fleet_port: the box's reverse loopback port 20000+box_index. box_index comes
# from [fleet].box_index, else parsed from the frozen grok-box-N hostname.
fleet_port() {
  local n; n="$(config_get fleet box_index || true)"
  if [ -z "$n" ]; then
    local name; name="$(read_box_name || true)"
    n="$(box_index_from_name "$name")" || return 1
  else
    n="$(box_index_from_name "$n")" || return 1
  fi
  printf '%s' "$((20000 + n))"
}

# ensure_tunnel_key: generate the per-box ed25519 tunnel key on first converge
# if absent. Lives under /workspace (survives image swap). Private key 600.
ensure_tunnel_key() {
  [ -f "$TUNNEL_KEY" ] && return 0
  have ssh-keygen || { log "tunnel: ssh-keygen missing — cannot generate tunnel key" >&2; return 1; }
  mkdir -p "$SECRETS_DIR" 2>/dev/null || true
  chmod 700 "$SECRETS_DIR" 2>/dev/null || true
  local umask_old; umask_old="$(umask)"
  umask 077
  if ssh-keygen -t ed25519 -N "" -C "grok-tunnel-$(read_box_name 2>/dev/null || echo box)" \
       -f "$TUNNEL_KEY" >/dev/null 2>&1; then
    log "tunnel: generated per-box tunnel key at $TUNNEL_KEY"
  else
    log "tunnel: ssh-keygen failed for $TUNNEL_KEY" >&2
    umask "$umask_old"; return 1
  fi
  umask "$umask_old"
  chmod 600 "$TUNNEL_KEY" 2>/dev/null || true
  chmod 644 "$TUNNEL_PUB" 2>/dev/null || true
}

# tunnel_pid: the supervised ssh -N pid if alive AND still a tunnel process,
# else empty. Never match a bare `ssh` an operator ran — verify the argv.
tunnel_pid() {
  [ -f "$TUNNEL_PID" ] || return 1
  local pid; pid="$(tr -d '[:space:]' < "$TUNNEL_PID" 2>/dev/null)"
  case "$pid" in ''|*[!0-9]*) return 1 ;; esac
  kill -0 "$pid" 2>/dev/null || return 1
  # Confirm it is our reverse tunnel (argv carries -R 127.0.0.1:2000N).
  local cmd; cmd="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)"
  case "$cmd" in *"-R 127.0.0.1:"*|*"-R"*"127.0.0.1:"*) printf '%s' "$pid"; return 0 ;; esac
  return 1
}

# tunnel_candidates <port>: print the pid of EVERY live ssh process whose argv
# is OUR reverse tunnel for this box — an `-R` token followed by exactly
# `127.0.0.1:<port>:localhost:22` AND an `-i` token followed by exactly
# $TUNNEL_KEY. Mirrors start_tailscaled's stray sweep: `pgrep -x ssh` for the
# pid list, then a per-pid NUL-split read of /proc/<pid>/cmdline. Never
# `pkill -f` (house rule) and never `pgrep -f` substring matching — a substring
# match would also claim an operator's own ssh, another box's port, or a tunnel
# built with a different key.
tunnel_candidates() {
  local port="$1" pid tok prev hit_r hit_i want_r="127.0.0.1:$1:localhost:22"
  for pid in $(pgrep -x ssh 2>/dev/null || true); do
    hit_r=0; hit_i=0; prev=""
    while IFS= read -r -d '' tok; do
      case "$prev" in
        -R) [ "$tok" = "$want_r" ] && hit_r=1 ;;
        -i) [ "$tok" = "$TUNNEL_KEY" ] && hit_i=1 ;;
      esac
      prev="$tok"
    done < "/proc/$pid/cmdline" 2>/dev/null || true
    [ "$hit_r" = 1 ] && [ "$hit_i" = 1 ] && printf '%s\n' "$pid"
  done
  return 0
}

# tunnel_starttime <pid>: field 22 of /proc/<pid>/stat (process start time in
# clock ticks since boot) — the only monotonic "which one is newer" signal that
# survives pid wraparound. The comm field (field 2) may itself contain spaces
# and parens, so cut past the LAST `) ` and count from field 3; field 22 is then
# the 20th positional.
tunnel_starttime() {
  local pid="$1" stat rest
  stat="$(tr '\n' ' ' < "/proc/$pid/stat" 2>/dev/null || true)"
  [ -n "$stat" ] || return 1
  rest="${stat##*') '}"
  # shellcheck disable=SC2086
  set -- $rest
  printf '%s' "${20:-0}"
}

# tunnel_newest <pid>...: the NEWEST pid (highest start time, ties broken by the
# higher pid). Empty input => rc 1. Newest, not oldest: after a racing respawn
# the newest process is the one whose forward actually holds the VPS port (the
# older one lost ExitOnForwardFailure and is on its way out).
tunnel_newest() {
  local p t best="" best_t=-1
  for p in "$@"; do
    case "$p" in ''|*[!0-9]*) continue ;; esac
    t="$(tunnel_starttime "$p" || echo 0)"
    case "$t" in ''|*[!0-9]*) t=0 ;; esac
    if [ -z "$best" ] || [ "$t" -gt "$best_t" ] ||
       { [ "$t" -eq "$best_t" ] && [ "$p" -gt "$best" ]; }; then
      best="$p"; best_t="$t"
    fi
  done
  [ -n "$best" ] || return 1
  printf '%s' "$best"
}

# tunnel_backoff_window <fails> -> 15,30,60,120,300 cap (respawn storm brake).
tunnel_backoff_window() {
  local f="${1:-0}"
  case "$f" in 0|1) echo 0 ;; 2) echo 15 ;; 3) echo 30 ;; 4) echo 60 ;; 5) echo 120 ;; *) echo 300 ;; esac
}
tunnel_fail_count() {
  local n=0
  [ -f "$RUN_DIR/fail.tunnel" ] && n=$(tr -d '[:space:]' < "$RUN_DIR/fail.tunnel" 2>/dev/null || echo 0)
  case "$n" in ''|*[!0-9]*) n=0 ;; esac
  echo "$n"
}

# supervise_tunnel: the per-tick supervisor. Unconfigured => silent no-op. A
# stray tunnel (one with our exact argv that is NOT the pidfile pid) is ADOPTED
# and any duplicate killed BEFORE the spawn decision; only with zero candidates
# does the (re)spawn path run, under a backoff window.
#
# Why adoption (observed on grok-box-005, 2026-09-01): a mid-tick subshell that
# survived a kill, an operator-started ssh, or a raced tick holds the VPS port.
# The old code asked only "is the PIDFILE pid alive?", saw "down", spawned a
# second ssh, `ExitOnForwardFailure=yes` killed it because the port was already
# held, fail.tunnel climbed, and the backoff ladder parked the box for up to 5
# minutes per attempt while the VPS was reachable the whole time through the
# stray. Adoption existed only as a race: the old trailing `pgrep -n -f` could
# happen to write the stray's pid into the pidfile.
supervise_tunnel() {
  fleet_configured || return 0        # unconfigured: silent no-op
  local vps port sshport
  vps="$(config_get fleet vps || true)"
  [ -n "$vps" ] || return 0
  port="$(fleet_port)" || { log "tunnel: no box_index/hostname — cannot derive port" >&2; return 0; }
  sshport="$(config_get fleet port || true)"; [ -n "$sshport" ] || sshport=22

  # D2 — adopt-or-kill, BEFORE any spawn decision. Every process carrying our
  # exact tunnel argv is a candidate, whether or not it is the pidfile pid. Keep
  # the newest, TERM the rest by exact pid (KILL sweep after 1s, exactly as
  # start_tailscaled does), point the pidfile at the survivor and clear the fail
  # counter — the tunnel IS up, so the backoff ladder must not run.
  local cands keep extras=0 p prev_pid=""
  cands="$(tunnel_candidates "$port")"
  if [ -n "$cands" ]; then
    # shellcheck disable=SC2086
    keep="$(tunnel_newest $cands)" || keep=""
    if [ -n "$keep" ]; then
      for p in $cands; do
        [ "$p" = "$keep" ] && continue
        extras=$((extras + 1))
        log "tunnel: extra tunnel pid=$p on port $port — stopping"
        kill -TERM "$p" 2>/dev/null || true
      done
      if [ "$extras" -gt 0 ]; then
        sleep 1
        for p in $cands; do
          [ "$p" = "$keep" ] && continue
          kill -0 "$p" 2>/dev/null && kill -KILL "$p" 2>/dev/null || true
        done
        log "tunnel: killed $extras extra tunnel(s) on port $port"
      fi
      [ -f "$TUNNEL_PID" ] && prev_pid="$(tr -d '[:space:]' < "$TUNNEL_PID" 2>/dev/null || true)"
      [ "$prev_pid" = "$keep" ] || log "tunnel: adopted stray pid=$keep on port $port"
      printf '%s\n' "$keep" > "$TUNNEL_PID" 2>/dev/null || true
      echo 0 > "$RUN_DIR/fail.tunnel" 2>/dev/null || true
      return 0
    fi
  fi

  if tunnel_pid >/dev/null 2>&1; then
    echo 0 > "$RUN_DIR/fail.tunnel" 2>/dev/null || true
    return 0
  fi

  # No live tunnel. Respect the backoff window since the last spawn attempt.
  local fails window now last
  fails="$(tunnel_fail_count)"
  window="$(tunnel_backoff_window "$fails")"
  now="$(date +%s)"; last=0
  [ -f "$RUN_DIR/last-tunnel" ] && last=$(tr -d '[:space:]' < "$RUN_DIR/last-tunnel" 2>/dev/null || echo 0)
  case "$last" in ''|*[!0-9]*) last=0 ;; esac
  if [ "$last" -gt 0 ] && [ "$window" -gt 0 ] && [ $((now - last)) -lt "$window" ]; then
    log "tunnel: down but backing off (window=${window}s fails=${fails})" >&2
    return 0
  fi

  ensure_tunnel_key || return 0
  [ -f "$TUNNEL_KEY" ] || { log "tunnel: no key at $TUNNEL_KEY — skipping" >&2; return 0; }

  echo "$now" > "$RUN_DIR/last-tunnel" 2>/dev/null || true
  echo $((fails + 1)) > "$RUN_DIR/fail.tunnel" 2>/dev/null || true

  touch "$TUNNEL_LOG" 2>/dev/null || true
  if [ "$(wc -c < "$TUNNEL_LOG" 2>/dev/null || echo 0)" -gt 10485760 ]; then : > "$TUNNEL_LOG"; fi

  # Spawn detached (the ONLY long-lived spawn primitive, H9). ExitOnForwardFailure
  # + ServerAlive* make a dead tunnel exit promptly so the next tick respawns it.
  log "tunnel: (re)spawning reverse tunnel -R 127.0.0.1:$port:localhost:22 -> fleet@$vps:$sshport"
  spawn_detached "$TUNNEL_LOG" \
    ssh -N -T \
      -o ExitOnForwardFailure=yes \
      -o ServerAliveInterval=30 \
      -o ServerAliveCountMax=3 \
      -o BatchMode=yes \
      -o StrictHostKeyChecking=accept-new \
      -i "$TUNNEL_KEY" \
      -R "127.0.0.1:$port:localhost:22" \
      -p "$sshport" "fleet@$vps"
  # Record the newest ssh pid we can attribute to this tunnel. D1: the old
  # `pgrep -n -f -- "-R 127.0.0.1:$port..."` is GONE — it matched any argv
  # substring (an operator's ssh, or a `-c` command line merely mentioning the
  # port) and ignored the key entirely.
  sleep 0.3
  local newpids pid
  newpids="$(tunnel_candidates "$port")"
  # shellcheck disable=SC2086
  pid="$(tunnel_newest $newpids)" || pid=""
  [ -n "$pid" ] && printf '%s\n' "$pid" > "$TUNNEL_PID" 2>/dev/null || true
}

# tunnel_state: for `boxup status`. unconfigured | up | down.
tunnel_state() {
  fleet_configured || { printf 'unconfigured'; return 0; }
  if tunnel_pid >/dev/null 2>&1; then printf 'up'; else printf 'down'; fi
}

# --- converge: tailscaled ----------------------------------------------------
# Exactly one daemon, bound to the workspace statedir. Kill strays (dpkg's
# default unit uses /var/lib/tailscale) by PID, never pkill -f.
# F7 (#7) history: the daemon is spawned via spawn_detached, which closes the
# lock fds belt-and-braces. Since H1 the converge lock is fd 9 held under
# flock --close (the body runs with it already closed), so a daemon can no
# longer inherit it regardless — the pre-H1 failure was tailscaled inheriting
# the then-fd-8 converge lock and holding it for life (observed 256 skips /
# 77 min on box-8). The close in spawn_detached is now defense-in-depth.
start_tailscaled() {
  local daemon pid cmd keep=""
  daemon="$(tailscaled_bin)"
  if [ ! -x "$daemon" ]; then
    log "start: no tailscaled binary" >&2
    return 1
  fi
  if [ ! -e /dev/net/tun ]; then
    log "start: /dev/net/tun missing — kernel TUN required" >&2
    return 1
  fi

  for pid in $(pgrep -x tailscaled 2>/dev/null || true); do
    cmd=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)
    if echo "$cmd" | grep -q -- "$STATE_DIR"; then
      if [ -z "$keep" ]; then
        keep="$pid"
      else
        log "start: extra statedir daemon pid=$pid — stopping"
        kill "$pid" 2>/dev/null || true
      fi
    else
      log "start: stopping stray pid=$pid (wrong statedir)"
      kill "$pid" 2>/dev/null || true
    fi
  done
  sleep 0.4
  for pid in $(pgrep -x tailscaled 2>/dev/null || true); do
    cmd=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)
    echo "$cmd" | grep -q -- "$STATE_DIR" && continue
    kill -9 "$pid" 2>/dev/null || true
  done

  if [ -n "$keep" ] && kill -0 "$keep" 2>/dev/null; then
    return 0
  fi

  touch "$TAILSCALED_LOG" 2>/dev/null || true
  # Keep the log bounded; it lives on the overlay but a long-lived box would
  # otherwise grow it without limit.
  if [ "$(wc -c < "$TAILSCALED_LOG" 2>/dev/null || echo 0)" -gt 52428800 ]; then
    : > "$TAILSCALED_LOG"
  fi

  # The flock lives in a subshell so it is released the moment the fork window
  # closes — a long-lived worker holding it forever would wedge later starts.
  # F7 (#7): spawn_detached closes BOTH lock fds (fd 8 + fd 9) on the daemon so
  # it inherits neither — see the helper. The old code closed only fd 9 (as a
  # sloppy `9<&-`) and never fd 8, so tailscaled held the converge lock for its
  # whole life and starved every tick.
  (
    exec 9>"$START_LOCK"
    flock -n 9 || exit 3
    spawn_detached "$TAILSCALED_LOG" \
      env TS_DEBUG_FIREWALL_MODE="${TS_DEBUG_FIREWALL_MODE:-nftables}" \
      "$daemon" \
        --statedir="$STATE_DIR" \
        --socket="$TS_SOCK" \
        --tun=tailscale0 \
        --port=41641
  )
  if [ "$?" = 3 ]; then
    wait_for_socket || true
    if pgrep -x tailscaled >/dev/null 2>&1; then
      return 0
    fi
    log "start: lock busy ($START_LOCK)" >&2
    return 1
  fi
  wait_for_socket || true
  pid=$(pgrep -n -x tailscaled 2>/dev/null || true)
  log "start: tailscaled pid=${pid:-?} statedir=$STATE_DIR"
}

# --- converge: first login / re-auth -----------------------------------------
# `tailscale up` is allowed here and ONLY here: when the backend needs a login.
# Two cases share this one `up`, distinguished by the statedir:
#   * statedir empty  -> first login (auth-key join, or mint an AuthURL)
#   * statedir populated but backend=NeedsLogin -> the node key expired (~180d)
#     or the node was deleted in the admin console. `tailscale up` on an expired
#     node exits silently, so re-auth needs --force-reauth (tailscale#6786,
#     tailscale#4854). Re-auth reuses the existing machine key: same identity,
#     no fork. The minted AuthURL surfaces in `boxup status` via auth=.
# Everything after a successful login goes through `tailscale set` (up resets
# flags it is not given). NoState right after daemon start is NOT NeedsLogin —
# it stays in the *) arm below and never mints, per the house rule.
# F9 (#9): invoke `tailscale up --force-reauth` with the MENTIONS current
# tailscale (1.102.x) demands. It refuses re-auth otherwise:
#   "changing settings via 'tailscale up' requires mentioning all non-default
#    flags".
# We add --hostname=<current> always, and --advertise-tags=<current> ONLY when
# the device already carries tags (F11 distinction: mentioning tags the node
# already has is the required MENTION, not INTRODUCING new tags on re-auth —
# never source these from config.toml). We NEVER use --reset (it would drop
# prefs we then have to re-set). #9(c): the failure is no longer swallowed with
# `|| true` — we capture combined output and, on non-zero rc, log the actual
# tailscale error at ERROR level, calling out the mentioning-flags case
# explicitly. Non-fatal to the tick (no set -e escape) but always VISIBLE.
# Args: $1 = human reason for the log; remaining args appended to the up argv
# (e.g. --auth-key=...). Returns the tailscale rc.
run_reauth_up() {
  local reason="$1"; shift
  local b hostname tags out rc
  b="$(tailscale_bin)"
  [ -x "$b" ] || return 0
  local -a up
  # F9 (#10 r1.2): --accept-risk=lose-ssh — management of these boxes is BY
  # DESIGN over ssh-on-tailnet, so tailscale's lose-ssh guard would otherwise
  # refuse `up --force-reauth` ("this action may result in your SSH session
  # disconnecting"). The flag is a no-op when no tailscale-carried session
  # exists (the unattended worker path), so it is safe everywhere.
  up=("$b" up --ssh=false --advertise-exit-node --accept-dns
      --snat-subnet-routes=true --timeout=25s --force-reauth
      --accept-risk=lose-ssh)
  id box >/dev/null 2>&1 && up+=(--operator=box)

  # H6 (#9): resolve the current hostname from THREE sources in order —
  # live prefs, the frozen hostname file, then status --json Self.HostName.
  # If ALL are empty we must NOT attempt: current tailscale refuses an `up`
  # that omits an already-set --hostname, so a re-auth with no hostname is a
  # guaranteed-failing command. A doomed `up` is worse than an honest skip
  # (it still counts as an attempt against the control plane and logs noise).
  hostname="$(prefs_hostname)"
  [ -n "$hostname" ] || hostname="$(read_box_name || true)"
  [ -n "$hostname" ] || hostname="$(ts status --json 2>/dev/null | python3 -c '
import json, sys
try:
    print(((json.load(sys.stdin).get("Self") or {}).get("HostName") or "").strip())
except Exception:
    print("")
' 2>/dev/null || true)"
  if [ -z "$hostname" ]; then
    log "login: ERROR cannot resolve current hostname (prefs, $HOSTNAME_FILE, and status Self.HostName all empty) — REFUSING re-auth; a --hostname-less force-reauth is refused by tailscale and would just churn. Fix the hostname source, then retry." >&2
    return 3
  fi
  up+=(--hostname="$hostname")

  # Tag resolution. F5 (#10): `boxup retag` sets REAUTH_TAGS_OVERRIDE to the
  # config-resolved tags so it can INTRODUCE the tag at re-auth (an operator
  # action) WITHOUT hand-rolling a second `up` array (the #9 hazard). When the
  # override is UNSET (the normal unattended re-auth path), tags come from the
  # device's LIVE prefs via current_advertise_tags — MENTIONING, never
  # INTRODUCING. An override set to the empty string means "no tags".
  if [ "${REAUTH_TAGS_OVERRIDE+set}" = set ]; then
    tags="$REAUTH_TAGS_OVERRIDE"
  else
    tags="$(current_advertise_tags)"
  fi
  if [ -n "$tags" ]; then
    up+=(--advertise-tags="$tags")
    log "login: $reason — mentioning current prefs hostname=$hostname tags=$tags (--force-reauth)"
  else
    log "login: $reason — mentioning current prefs hostname=$hostname (no tags on device) (--force-reauth)"
  fi

  out="$("${up[@]}" "$@" 2>&1)"; rc=$?
  if [ "$rc" -ne 0 ]; then
    log "login: tailscale up --force-reauth FAILED rc=$rc: $out" >&2
    case "$out" in
      *"requires mentioning all non-default flags"*)
        log "login: ERROR tailscale refused re-auth — it wants ALL non-default flags mentioned. Our argv had hostname=$hostname tags=${tags:-<none>}. Tailscale's suggested command is in the error text above; a pref changed underneath us." >&2
        ;;
    esac
  fi
  return "$rc"
}

ensure_login() {
  local st
  st="$(wait_for_backend || true)"
  case "$st" in Running|Starting) return 0 ;; esac
  case "$st" in NeedsLogin|Stopped|"") ;; *) return 0 ;; esac

  local b
  b="$(tailscale_bin)"
  [ -x "$b" ] || return 0
  # P1-1: ONE attempt limiter for ALL `tailscale up` invocations — first-login
  # AND re-auth. Every `up` (re-register OR fresh join) rewrites registration
  # against the control plane; a rc=0 `up` that only printed an AuthURL must not
  # license another attempt next tick. 30-min floor, rc-independent (H5).
  if ! reauth_attempt_allowed; then
    log "login: backend=$st but a tailscale up was attempted <${REAUTH_MIN_INTERVAL}s ago — rate-limited, skipping this tick" >&2
    return 0
  fi
  reauth_attempt_record
  local urc=0
  # A populated statedir at NeedsLogin means an existing identity whose node
  # key expired or was revoked; --force-reauth re-auths it in place (same key).
  # An empty statedir is a first login and must NOT get --force-reauth.
  if state_is_populated; then
    # Tags are auth-time-only and NEVER INTRODUCED on the --force-reauth branch
    # (F11 / see H8 in docs/AGENT.md for the control-plane scoping): an
    # unattended re-auth must not convert a user-owned node to tag-owned.
    # F9 (#9): run_reauth_up still MENTIONS the tags the device ALREADY carries
    # (from live prefs, never config.toml) because current tailscale refuses an
    # up that omits an already-set non-default flag. Mentioning is not
    # introducing. Retagging is still a documented MANUAL operator step.
    # P0-C (#9): do NOT swallow the re-auth rc with `|| true`. run_reauth_up
    # already logs the tailscale error text; the CALLER also records the outcome.
    if [ -s "$AUTHKEY_FILE" ]; then
      run_reauth_up "re-auth existing identity with auth-key" \
        --auth-key="$(tr -d '[:space:]' < "$AUTHKEY_FILE")"; urc=$?
    else
      run_reauth_up "re-auth existing identity, minting AuthURL — see boxup status"; urc=$?
    fi
    if [ "$urc" -ne 0 ]; then
      log "login: re-auth (NeedsLogin, populated statedir) FAILED rc=$urc — see the tailscale error above; node stays NeedsLogin, will retry after the attempt-limiter window" >&2
    fi
  else
    # First login (empty statedir). This is the ONLY place --advertise-tags is
    # added from config: config [tailscale] tags tags the node at initial
    # registration. D1 (#10): the value is now RESOLVED via resolved_config_tags
    # — an ABSENT key defaults to tag:grok-box (register tagged + expiry-disabled
    # by default), a PRESENT-empty key ("tags = "") is a deliberate untagged
    # opt-out. D2: when the resolved tags are empty AND the key was explicitly
    # present-empty, log ONE line so an intentionally-untagged box is visible.
    # F4: this branch is ALSO the state-loss REJOIN path, so a rebuilt box comes
    # back tagged + expiry-disabled by default too. No interactive prompt (boxes
    # are unattended).
    local -a up
    # F9 (#10 r1.2): --accept-risk=lose-ssh here too — a state-loss rejoin (F4)
    # is driven by an operator over ssh-on-tailnet just like retag; the flag is
    # a harmless no-op on the unattended first-join path.
    up=("$b" up --ssh=false --advertise-exit-node --accept-dns
        --snat-subnet-routes=true --timeout=25s
        --accept-risk=lose-ssh)
    id box >/dev/null 2>&1 && up+=(--operator=box)
    local tags out
    tags="$(resolved_config_tags)"
    if [ -n "$tags" ]; then
      up+=(--advertise-tags="$tags")
    else
      # Resolved empty ⇒ the key is present-and-empty (absent would have
      # defaulted). D2: register untagged by explicit config, logged once.
      log "login: registering UNTAGGED by explicit config (tags = \"\")"
    fi
    # P1-1: do NOT swallow the first-login `up` rc with `|| true`. Capture the
    # combined output, log it, and surface a non-zero rc so a failing first
    # login is visible (a `check` FAIL + a degraded converge), not silent.
    if [ -s "$AUTHKEY_FILE" ]; then
      log "login: auth-key join (statedir empty)${tags:+ tags=$tags}"
      out="$("${up[@]}" --auth-key="$(tr -d '[:space:]' < "$AUTHKEY_FILE")" 2>&1)"; urc=$?
    else
      log "login: minting AuthURL (statedir empty, no key)${tags:+ tags=$tags} — see boxup status"
      out="$("${up[@]}" 2>&1)"; urc=$?
    fi
    if [ "$urc" -ne 0 ]; then
      log "login: first-login tailscale up FAILED rc=$urc: $out" >&2
    fi
  fi
  return "$urc"
}

# --- converge: name ----------------------------------------------------------
# Pick the lowest free grok-box-N from PEERS only (Self is often still named
# cursor). Only when logged in and peers are visible; a lone node would always
# pick grok-box-1 and collide later.
pick_name() {
  python3 - <<PY
import json, re, subprocess

pat = re.compile(r"^grok-box-([0-9]+)\$")

def run(args, timeout=8):
    try:
        p = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        return p.stdout or ""
    except Exception:
        return ""

tsbin = "$(tailscale_bin)"
raw = run([tsbin, "status", "--json"])
status_txt = run([tsbin, "status"])
self_ip = run([tsbin, "ip", "-4"]).strip()
taken = set()

def take(name):
    if not name:
        return
    name = name.strip().rstrip(".")
    if "." in name and name.endswith("ts.net"):
        name = name.split(".")[0]
    m = pat.match(name)
    if m:
        taken.add(int(m.group(1)))

try:
    d = json.loads(raw) if raw.strip() else {}
except json.JSONDecodeError:
    d = {}

peers = d.get("Peer") or {}
if not peers:
    raise SystemExit(1)   # no peers visible: do not guess

for peer in peers.values():
    take(peer.get("HostName") or "")
    dns = peer.get("DNSName") or ""
    take(dns.split(".")[0] if dns else "")

for line in status_txt.splitlines():
    cols = line.split()
    if len(cols) < 2:
        continue
    if self_ip and cols[0] == self_ip:
        continue
    take(cols[1])

n = 1
while n in taken:
    n += 1
print(f"grok-box-{n:03d}")
PY
}

# H13: the LIVE hostname the control plane currently has for Self (status JSON
# Self.HostName). The frozen $HOSTNAME_FILE is the INTENT; this is the observed
# POSTCONDITION. After an auth-key rejoin the node can register under the OS
# hostname (`cursor`) even though the file says grok-box-8 — box-8 Stage 3.
live_hostname() {
  ts status --json 2>/dev/null | python3 -c '
import json, sys
try:
    print(((json.load(sys.stdin).get("Self") or {}).get("HostName") or "").strip())
except Exception:
    print("")
' 2>/dev/null || true
}

# F2: the LIVE MagicDNS first label (Self.DNSName, e.g.
# "grok-box-8-1.tail8ecb39.ts.net." -> "grok-box-8-1"). This is what peers
# actually resolve/reach. On a state-loss rejoin while the STALE node still
# holds `grok-box-8`, the new node's DNSName gets a `-1` suffix even though its
# Self.HostName is already `grok-box-8` — so a HostName-only comparison passes
# while the box is unreachable under its intended MagicDNS name.
live_dnsname_label() {
  ts status --json 2>/dev/null | python3 -c '
import json, sys
try:
    d = ((json.load(sys.stdin).get("Self") or {}).get("DNSName") or "").strip().rstrip(".")
    print(d.split(".")[0] if d else "")
except Exception:
    print("")
' 2>/dev/null || true
}

# H13/F2: true (0) iff the frozen file name is a grok-box-N AND the live control-
# plane identity differs from it, in EITHER of two ways. Sets NAME_MISMATCH_KIND
# (hostname|dns), NAME_MISMATCH_FILE, NAME_MISMATCH_LIVE for callers.
#   * kind=hostname: Self.HostName != file (e.g. `cursor`). Self-FIXABLE on-box
#     via `tailscale set --hostname=<file>`.
#   * kind=dns: Self.HostName already == file BUT the MagicDNS first label != file
#     (e.g. `grok-box-8-1` — the split-brain `-1` suffix). NOT self-fixable:
#     `tailscale set --hostname` is a no-op when the hostname is unchanged; the
#     stale device must be deleted then the live device renamed via the API
#     (brain/operator, FLEET-BRAIN row b). ensure_name reports it, does not spin.
# HostName mismatch is checked first (it's the fixable one). A missing file name
# or unreadable live values ⇒ NOT a mismatch (we only act on a concrete intent).
NAME_MISMATCH_FILE=""
NAME_MISMATCH_LIVE=""
NAME_MISMATCH_KIND=""
name_mismatch() {
  local f l dns
  NAME_MISMATCH_FILE=""; NAME_MISMATCH_LIVE=""; NAME_MISMATCH_KIND=""
  f="$(read_box_name || true)"
  case "$f" in grok-box-[0-9]*) ;; *) return 1 ;; esac
  l="$(live_hostname)"
  if [ -n "$l" ] && [ "$f" != "$l" ]; then
    NAME_MISMATCH_FILE="$f"; NAME_MISMATCH_LIVE="$l"; NAME_MISMATCH_KIND=hostname
    return 0
  fi
  dns="$(live_dnsname_label)"
  if [ -n "$dns" ] && [ "$f" != "$dns" ]; then
    NAME_MISMATCH_FILE="$f"; NAME_MISMATCH_LIVE="$dns"; NAME_MISMATCH_KIND=dns
    return 0
  fi
  return 1
}

ensure_name() {
  local name
  name="$(read_box_name || true)"
  # First: pick + freeze a name if we don't have one yet.
  case "$name" in
    grok-box-[0-9]*) ;;
    *)
      read_ts_fields
      [ "$backend" = Running ] || return 0
      name="$(pick_name 2>/dev/null || true)"
      case "$name" in
        grok-box-[0-9]*)
          printf '%s\n' "$name" > "$HOSTNAME_FILE"
          log "name: picked $name"
          ;;
        *) return 0 ;;   # couldn't pick yet
      esac
      ;;
  esac
  # H13/F2: the file is the INTENT; enforce it against the LIVE postcondition.
  if name_mismatch; then
    if [ "$NAME_MISMATCH_KIND" = hostname ]; then
      # Self.HostName differs (e.g. `cursor` after a rejoin) — self-fixable:
      # push `tailscale set --hostname` (not `up`, so no other pref resets).
      log "name: live=$NAME_MISMATCH_LIVE want=$NAME_MISMATCH_FILE — pushing tailscale set --hostname" >&2
      local b
      b="$(tailscale_bin)"
      if [ -x "$b" ]; then
        if id box >/dev/null 2>&1 && timeout 25 sudo -n -u box "$b" set --hostname="$NAME_MISMATCH_FILE" 2>/dev/null; then
          :
        else
          timeout 25 "$b" set --hostname="$NAME_MISMATCH_FILE" 2>/dev/null || \
            log "name: tailscale set --hostname=$NAME_MISMATCH_FILE failed" >&2
        fi
      fi
    else
      # F2 kind=dns: the MagicDNS name carries a `-1` split-brain suffix while
      # Self.HostName is already correct. `tailscale set --hostname` is a NO-OP
      # here (hostname unchanged) so we do NOT spin on it — this is NOT fixable
      # on-box. It needs the brain/operator to DELETE the stale duplicate device
      # then POST /api/v2/device/<live-id>/name. Log it; `check` reports it.
      log "name: dns=$NAME_MISMATCH_LIVE want=$NAME_MISMATCH_FILE — split-brain MagicDNS suffix, NOT on-box fixable; brain/operator must delete the stale device + POST /device/name" >&2
    fi
  fi
  # F3 (P2): also set the OS hostname to the frozen grok-box-N. The sand image
  # ships OS hostname `cursor`; leaving it means prompts, logs, and `hostname`
  # all say `cursor`, which misleads an operator ssh'd into the box (box-8 test:
  # the reproducer printed "on cursor"). This is COSMETIC (tailscale identity is
  # unaffected — that's Self.HostName/prefs, handled above) and BEST-EFFORT
  # (log, never fail a converge). Re-applied every converge because the overlay
  # (incl. /etc/hostname) dies on an image swap, same as passwords/nft. Only
  # when we have a concrete grok-box-N.
  local want
  want="$(read_box_name || true)"
  case "$want" in
    grok-box-[0-9]*)
      if [ "$(hostname 2>/dev/null || true)" != "$want" ]; then
        hostname "$want" 2>/dev/null || log "name: could not set OS hostname to $want (need CAP_SYS_ADMIN)" >&2
        printf '%s\n' "$want" > /etc/hostname 2>/dev/null || true
      fi
      ;;
  esac
}

# --- converge: exit-node refresh --------------------------------------------
# Full flag set. Prefer operator=box; fall back to root if that user cannot
# talk to the daemon yet (first join, operator not written).
# H3: each `set` is wrapped in `timeout` — an unbounded `tailscale set` is the
# realistic way the converge body could hold the lock past 60s and starve the
# next converge; bound it so the lock is always released promptly.
tailscale_set_full() {
  local name="$1" b
  b="$(tailscale_bin)"
  [ -x "$b" ] || return 1
  if id box >/dev/null 2>&1 && timeout 25 sudo -n -u box "$b" set --hostname="$name" \
      --ssh=false --operator=box --advertise-exit-node \
      --snat-subnet-routes=true --stateful-filtering=false 2>/dev/null; then
    return 0
  fi
  timeout 25 "$b" set --hostname="$name" --ssh=false --operator=box \
    --advertise-exit-node --snat-subnet-routes=true \
    --stateful-filtering=false
}

# Refresh-failure backoff (D4). A persistently failing `tailscale set` used to
# retry on EVERY 15s tick forever (last-set is stamped only on success), with
# no escalation and no status visibility. Now consecutive failures stretch the
# effective rate-limit window 20s -> 60s -> 180s -> cap 600s; a success resets
# both the counter and the window. There is NO permanent give-up.
#
# fail.refresh holds the consecutive-failure count (run dir; reset free on
# recycle/boot). The window is a pure function of that count:
refresh_fail_count() {
  local n=0
  [ -f "$RUN_DIR/fail.refresh" ] && \
    n=$(tr -d '[:space:]' < "$RUN_DIR/fail.refresh" 2>/dev/null || echo 0)
  case "$n" in ''|*[!0-9]*) n=0 ;; esac
  echo "$n"
}

refresh_backoff_window() {
  local n="$1"
  if   [ "$n" -le 0 ]; then echo "$SET_MIN_INTERVAL"
  elif [ "$n" -eq 1 ]; then echo 60
  elif [ "$n" -eq 2 ]; then echo 180
  else                      echo 600
  fi
}

# --- re-auth ATTEMPT limiter (H5) --------------------------------------------
# A `tailscale up` ATTEMPT (first-login OR force-reauth) rewrites registration
# against the control plane; a storm is worse than the bug. The prior design
# keyed a backoff off rc, but a rc=0 `up` that only PRINTED an AuthURL reset the
# counter and left a 20s floor (~180 attempts/hour). ONE mechanism now, separate
# from the D4 refresh backoff: a hard minimum interval between attempts
# (REAUTH_MIN_INTERVAL, 30 min), rc-independent. (N1/D6: an earlier per-hour cap
# was removed as redundant — a 30-min floor already caps attempts at 2/hour, so
# a second knob could never bind first.)
# Why 30 min: comfortably above tailscale control-plane rate-limit headroom for
# `up`, and 1800s == the hourly-automation period / 2, so the external hourly
# `boxup once` and a 15s worker tick can never double-fire a re-auth for one
# outage (two attempts can't fall inside one 3600s period). Persisted under
# $RUN_DIR — ephemeral, so a reboot/swap legitimately resets and a fresh box may
# attempt once immediately.
REAUTH_LAST="$RUN_DIR/last-reauth"          # unix ts of the last ATTEMPT
REAUTH_MIN_INTERVAL="${BOXUP_REAUTH_MIN_INTERVAL:-1800}"   # 30 min

# 0 (proceed) iff we are outside the min-interval floor; else 1. Read-only —
# the caller calls reauth_attempt_record() only when it actually attempts.
reauth_attempt_allowed() {
  local now last
  now=$(date +%s)
  last=0
  [ -f "$REAUTH_LAST" ] && last=$(tr -d '[:space:]' < "$REAUTH_LAST" 2>/dev/null || echo 0)
  case "$last" in ''|*[!0-9]*) last=0 ;; esac
  [ "$last" -le 0 ] && return 0
  [ $((now - last)) -ge "$REAUTH_MIN_INTERVAL" ]
}

# Record that an attempt happened NOW (regardless of its rc).
reauth_attempt_record() {
  date +%s > "$REAUTH_LAST" 2>/dev/null || true
}

# Push a full `tailscale set` when the coordination server would show "unable
# to relay traffic". Never `up`. Rate-limited: an unneeded set every tick
# cancels PollNetMap and marks the node offline.
refresh_exitnode() {
  local name need=0 reason="" chk warn v4 v6 routes now last
  read_ts_fields
  case "$backend" in Running) ;; *) return 0 ;; esac

  name="$(read_box_name || true)"
  case "$name" in
    grok-box-[0-9]*) ;;
    *) name="$(prefs_hostname)" ;;
  esac
  case "$name" in grok-box-[0-9]*) ;; *) return 0 ;; esac

  # Healthy payload is {"Warning":""}. Parse the value — grepping for the key
  # name is always true and spammed `tailscale set` (node went offline).
  chk=$(timeout 5 curl -sS --unix-socket "$TS_SOCK" \
    http://local-tailscaled.sock/localapi/v0/check-ip-forwarding 2>/dev/null || true)
  warn=$(printf '%s' "$chk" | python3 -c '
import json, sys
try:
    w = json.load(sys.stdin).get("Warning") or ""
    if isinstance(w, list):
        w = " ".join(str(x) for x in w)
    print(str(w).strip())
except Exception:
    print("")
' 2>/dev/null || true)
  [ -n "$warn" ] && { need=1; reason="check-ip-forwarding warning"; }

  v4=$(tr -d '[:space:]' < /proc/sys/net/ipv4/ip_forward 2>/dev/null || echo 0)
  v6=$(tr -d '[:space:]' < /proc/sys/net/ipv6/conf/all/forwarding 2>/dev/null || echo 0)
  if [ "$v4" != 1 ] || [ "$v6" != 1 ]; then
    need=1; reason="kernel ipfwd v4=${v4} v6=${v6}"
  fi
  if [ -f "$RUN_DIR/ipfwd.env" ]; then
    # shellcheck disable=SC1091
    . "$RUN_DIR/ipfwd.env"
    [ "${changed:-0}" = 1 ] && { need=1; reason="sysctl just flipped"; }
  fi

  [ "$exitn" = yes ] || { need=1; reason="ExitNodeOption false"; }
  [ "$fwdhealth" = yes ] && { need=1; reason="status Health mentions forward"; }

  routes="$(advertised_routes)"
  echo "$routes" | grep -q '0.0.0.0/0' || { need=1; reason="missing 0.0.0.0/0"; }
  echo "$routes" | grep -q '::/0' || { need=1; reason="missing ::/0"; }

  [ "$need" = 1 ] || return 0

  local fails window force=0
  fails=$(refresh_fail_count)
  window=$(refresh_backoff_window "$fails")

  # BOXUP_FORCE_REFRESH=1 bypasses the backoff window exactly once (an operator
  # escape hatch). It is NOT tied to `cmd == once` — the hourly automation runs
  # `boxup once`, so a cmd-based bypass would reset backoff unattended (F6).
  # sudo strips the var, so require_root whitelists it and D12 documents the
  # working form: sudo env BOXUP_FORCE_REFRESH=1 /workspace/box-setup/boxup once
  if [ "${BOXUP_FORCE_REFRESH:-}" = 1 ]; then
    force=1
    log "refresh: BOXUP_FORCE_REFRESH=1 — bypassing backoff window (${window}s, fails=${fails})"
  fi

  now=$(date +%s)
  # Window guard keyed on the LAST ATTEMPT time (stamped on BOTH success and
  # failure below), not merely the last success — otherwise a fresh RUN_DIR
  # with fail-count > 0 but no stamp would skip the guard entirely and retry a
  # failing `set` every tick (D4 regression). Missing stamp => last=0 => the
  # delta is huge, so a genuine first-ever attempt still proceeds immediately.
  last=0
  [ -f "$RUN_DIR/last-exitnode-set" ] && \
    last=$(cat "$RUN_DIR/last-exitnode-set" 2>/dev/null || echo 0)
  case "$last" in ''|*[!0-9]*) last=0 ;; esac
  if [ "$force" = 0 ] && [ $((now - last)) -lt "$window" ]; then
    log "refresh: need set ($reason) but rate-limited (window=${window}s fails=${fails})"
    return 0
  fi
  log "refresh: tailscale set ($reason) hostname=$name"
  if tailscale_set_full "$name"; then
    echo "$now" > "$RUN_DIR/last-exitnode-set" 2>/dev/null || true
    # Success resets the failure counter and window.
    echo 0 > "$RUN_DIR/fail.refresh" 2>/dev/null || true
  else
    fails=$((fails + 1))
    echo "$fails" > "$RUN_DIR/fail.refresh" 2>/dev/null || true
    # Stamp the ATTEMPT time on failure too, so the stretched window applies
    # from the first failure even on a fresh RUN_DIR with no prior stamp.
    echo "$now" > "$RUN_DIR/last-exitnode-set" 2>/dev/null || true
    window=$(refresh_backoff_window "$fails")
    log "refresh: set failed (consecutive=${fails}, next window=${window}s)" >&2
    return 1
  fi
}

# --- selfheal: freeze / offline recycle -------------------------------------
hb_age() {
  local now prev
  now=$(date +%s)
  prev=0
  [ -f "$RUN_DIR/hb" ] && prev=$(tr -d '[:space:]' < "$RUN_DIR/hb" 2>/dev/null || echo 0)
  case "$prev" in ''|*[!0-9]*) prev=0 ;; esac
  [ "$prev" -le 0 ] && { echo 0; return; }
  echo $((now - prev))
}

recent_time_jump() {
  python3 - "$TAILSCALED_LOG" <<'PY'
import datetime, re, sys, time
try:
    lines = open(sys.argv[1], errors="replace").read().splitlines()[-150:]
except Exception:
    sys.exit(1)
pat = re.compile(r"^(\d{4}/\d{2}/\d{2} \d{2}:\d{2}:\d{2}).*time jump detected")
now = time.time()
for line in reversed(lines):
    m = pat.search(line)
    if not m:
        continue
    ts = datetime.datetime.strptime(m.group(1), "%Y/%m/%d %H:%M:%S")
    ts = ts.replace(tzinfo=datetime.timezone.utc)
    sys.exit(0 if 0 <= now - ts.timestamp() <= 180 else 1)
sys.exit(1)
PY
}

recycled_recently() {
  local now rec
  now=$(date +%s)
  rec=0
  [ -f "$RUN_DIR/last-recycle" ] && rec=$(tr -d '[:space:]' < "$RUN_DIR/last-recycle" 2>/dev/null || echo 0)
  case "$rec" in ''|*[!0-9]*) rec=0 ;; esac
  [ "$rec" -gt 0 ] && [ $((now - rec)) -lt "$RECYCLE_COOLDOWN" ]
}

# Kill that PID only (must be on our statedir), restart, re-push prefs.
recycle_tailscaled() {
  local reason="$1" pid cmd i
  pid=$(pgrep -n -x tailscaled 2>/dev/null || true)
  [ -n "$pid" ] || return 0
  cmd=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)
  echo "$cmd" | grep -q -- "$STATE_DIR" || return 0

  log "selfheal: $reason — recycle tailscaled pid=$pid"
  # Stamp BEFORE the kill: if this tick is slow or dies mid-recycle, the next
  # tick must still honor the cooldown instead of recycling again.
  date +%s > "$RUN_DIR/last-recycle" 2>/dev/null || true
  kill "$pid" 2>/dev/null || true
  i=0
  while [ "$i" -lt 20 ]; do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.2; i=$((i + 1))
  done
  if kill -0 "$pid" 2>/dev/null; then
    kill -9 "$pid" 2>/dev/null || true
    sleep 0.3
  fi
  rm -f "$RUN_DIR/last-online" "$RUN_DIR/offline-ticks"
  start_tailscaled || true
  # Hostinfo set is skipped while backend=NoState; wait out the blip.
  wait_for_backend >/dev/null || true
  # H4 (#8): consume the FRESH BackendState the restart produced. A node that
  # was deleted server-side stays Running-but-dead across a LocalAPI query, but
  # a genuine daemon RESTART re-reads state and lands in NeedsLogin (upstream
  # tailscale/tailscale#20615) — so re-auth is driven by recycle-then-read, not
  # by log parsing. ensure_login MUST run before refresh_exitnode: a freshly
  # NeedsLogin daemon otherwise sits idle until the next hourly converge (the
  # gate flagged this exact ordering bug — old code only called refresh here).
  ensure_login || true
  refresh_exitnode || true
}

# After freeze/thaw, PollNetMap's long-poll is already dead but Self.Online
# and Health stay green for ~2 min (map timeout). A long-lived worker's stale
# hb is the wake signal — recycle. A brand-new worker (after stop) also sees
# leftover hb; only recycle then if tailscaled logged a time jump or the node
# is already down.
maybe_wake_recycle() {
  local age now started
  age=$(hb_age)
  case "$age" in ''|*[!0-9]*) age=0 ;; esac
  [ "$age" -ge "$FREEZE_SECS" ] || return 0
  recycled_recently && return 0

  now=$(date +%s)
  started=${WORKER_STARTED:-0}
  case "$started" in ''|*[!0-9]*) started=0 ;; esac
  if [ "$started" -gt 0 ] && [ $((now - started)) -lt "$FREEZE_SECS" ]; then
    read_ts_fields
    if [ "$online" = yes ] && [ "$mapfail" != yes ] && ! recent_time_jump; then
      log "selfheal: stale hb ${age}s but worker is new and node is live — skip"
      return 0
    fi
  fi
  recycle_tailscaled "time jump ${age}s (hb) — map poll dies on freeze"
}

# Process alive + Running + (Online=false OR map-poll/out-of-sync Health) that
# persists ⇒ recycle. H4 (#8): this is the recycle-then-read driver for a
# server-deleted node too — a deleted node stays Running-but-dead on a LocalAPI
# query, but the RESTART inside recycle_tailscaled re-reads state and lands in
# NeedsLogin, which recycle_tailscaled → ensure_login then re-auths. No Health
# text matching, no log parsing: persistent Online=false / not-in-map-poll is
# the trigger, the restart produces the authoritative BackendState.
recycle_offline_tailscaled() {
  local now last ticks do_recycle=0
  recycled_recently && return 0
  read_ts_fields
  case "$backend" in
    Running) ;;
    *) rm -f "$RUN_DIR/offline-ticks"; return 0 ;;
  esac

  now=$(date +%s)
  if [ "$online" = yes ] && [ "$mapfail" != yes ]; then
    echo "$now" > "$RUN_DIR/last-online" 2>/dev/null || true
    rm -f "$RUN_DIR/offline-ticks"
    return 0
  fi

  last=0
  [ -f "$RUN_DIR/last-online" ] && last=$(tr -d '[:space:]' < "$RUN_DIR/last-online" 2>/dev/null || echo 0)
  case "$last" in ''|*[!0-9]*) last=0 ;; esac
  ticks=0
  [ -f "$RUN_DIR/offline-ticks" ] && ticks=$(tr -d '[:space:]' < "$RUN_DIR/offline-ticks" 2>/dev/null || echo 0)
  case "$ticks" in ''|*[!0-9]*) ticks=0 ;; esac
  ticks=$((ticks + 1))
  echo "$ticks" > "$RUN_DIR/offline-ticks" 2>/dev/null || true

  if [ "$last" -gt 0 ] && [ $((now - last)) -ge 30 ]; then
    do_recycle=1
  elif [ "$ticks" -ge 3 ]; then
    do_recycle=1
  fi
  [ "$do_recycle" = 1 ] || return 0
  recycle_tailscaled "online=${online} mapfail=${mapfail} after freeze"
}

# --- disk guard (blueprint boxup-disk-guard G1-G3) ---------------------------
# The box platform's sandbox host writes /tmp/sand-host.log and never rotates
# it. It reached 101 GB on grok-box-006 and filled the root overlay, which made
# `install.sh` exit 1 and stalled the fleet rollout; 004 was at 96%. Nothing on
# the box and nothing in the brain was watching disk usage. This is that watch.
#
# Shape: one cheap `df /` per tick (rate-limited to BOXUP_DISK_INTERVAL), two
# thresholds, and — only at FAIL — truncation of an ALLOWLIST of platform logs.
# Never a delete, never a path off the list, never a symlink. The result lands
# in $RUN_DIR/disk for the operator, in the `disk=` status token, and in
# check_reason, so the brain's existing "reachable-cannot-converge" alert fires
# with no brain-side change at all (G4: no grokfleet code in this lane).
#
# Why truncation runs AS THE FILE'S OWNER: /tmp is sticky and world-writable,
# and Linux's fs.protected_regular refuses an O_TRUNC open of a file in such a
# directory when the opener is neither the file's owner nor the directory's —
# root included. `truncate` as root gets EACCES on /tmp/sand-host.log. The
# owner switch is not a hardening nicety, it is the only thing that makes the
# guard work; deleting it turns every truncation into a silent failure.
BOXUP_DISK_WARN_PCT="${BOXUP_DISK_WARN_PCT:-80}"
BOXUP_DISK_FAIL_PCT="${BOXUP_DISK_FAIL_PCT:-90}"
BOXUP_DISK_TRUNCATE_MIN_BYTES="${BOXUP_DISK_TRUNCATE_MIN_BYTES:-1073741824}"  # 1 GiB
# Whitespace-separated allowlist of paths the guard may truncate at FAIL level.
# Nothing outside it is ever touched. Env-overridable so the gate can point the
# guard at a canary file instead of the real platform log.
DISK_GUARD_TRUNCATE="${DISK_GUARD_TRUNCATE:-/tmp/sand-host.log}"
# grokfleet-jobs J6 (r9-B1/r10-B1): a SECOND allowlist that is BUILT IN and
# deliberately NOT env-overridable. Job logs are bounded by truncation through
# disk_truncate_one, whose FIRST gate is disk_allowlisted — so with only the
# overridable list an operator override that dropped this entry would silently
# disable the 64 MiB per-job bound as well as the pressure reclaim. Both
# CONSUMERS of the allowlist walk this list after the overridable one: the
# checker disk_allowlisted() and, separately, disk_guard()'s candidate loop
# (they are two consumers of the same variable, and changing only the checker
# leaves the reclaim broken). The value is a GLOB PATTERN and both loops expand
# it UNQUOTED — word splitting AND pathname expansion are the point; quoting it
# leaves the pattern literal and makes every exact comparison fail silently,
# which is why the SC2086 suppression rides along.
DISK_GUARD_BUILTIN_TRUNCATE="${BOX_SETUP_JOBS:-/workspace/jobs}/*/log"
# The tick is 15s; re-reading df four times a minute buys nothing.
BOXUP_DISK_INTERVAL="${BOXUP_DISK_INTERVAL:-60}"
DISK_STATE="$RUN_DIR/disk"                  # "<pct>% <level> <epoch>"
DISK_STAMP="$RUN_DIR/last-disk-guard"       # rate-limit stamp
DISK_WARN_STAMP="$RUN_DIR/last-disk-warn"   # once/hour WARN stamp (check)

# disk_used_pct: root usage as a bare integer percent, or -1 when df is missing
# or unparseable. Never fails — an unreadable df must not break a tick.
disk_used_pct() {
  local pct
  pct=$(df --output=pcent / 2>/dev/null | tail -1 | tr -dc '0-9')
  case "$pct" in ''|*[!0-9]*) echo -1 ;; *) echo "$pct" ;; esac
}

# disk_level <pct> -> ok | warn | fail | unknown.
# BOTH comparisons are >=: a box sitting exactly ON the fail threshold is
# already in trouble. (Mutant g3 flips these to > and the pct==FAIL_PCT case
# must then report warn, not fail.)
disk_level() {
  local p="${1:--1}"
  case "$p" in ''|*[!0-9-]*) echo unknown; return 0 ;; esac
  [ "$p" -lt 0 ] && { echo unknown; return 0; }
  if   [ "$p" -ge "$BOXUP_DISK_FAIL_PCT" ]; then echo fail
  elif [ "$p" -ge "$BOXUP_DISK_WARN_PCT" ]; then echo warn
  else                                          echo ok
  fi
}

# disk_allowlisted <path>: 0 iff <path> is EXACTLY one of the whitespace-
# separated entries of DISK_GUARD_TRUNCATE. Exact string match, never a prefix
# or a glob, so `/tmp/sand-host.log.evil` is not on the list. It is its own
# function so the mutator below has one auditable gate that a unit test can
# drive directly (deleting the call is mutant g2).
# shellcheck disable=SC2086  # word splitting is the point: the list is space-separated
disk_allowlisted() {
  local want="$1" p
  for p in $DISK_GUARD_TRUNCATE; do
    [ "$p" = "$want" ] && return 0
  done
  # ... then the BUILT-IN list, which an override cannot remove (J6, r9-B1).
  for p in $DISK_GUARD_BUILTIN_TRUNCATE; do
    [ "$p" = "$want" ] && return 0
  done
  return 1
}

# disk_truncate_one <path> [<pct>]: the ONLY mutator in the guard. Every safety
# gate lives inside it so no caller can bypass one:
#   * the path must be on the allowlist;
#   * a SYMLINK is refused outright and never followed — swapping a symlink
#     under a log truncator is the classic way to turn it into an arbitrary
#     file truncator;
#   * only a REGULAR file, and only one LARGER than the min-bytes floor (a
#     small log is not what fills a 100 GB overlay, and truncating it would
#     just destroy evidence);
#   * the write runs as the file's OWNER (see the section header).
# Returns 0 iff it truncated. Never deletes and never creates: `truncate -c`
# leaves a missing file missing.
#
# grokfleet-jobs J6 adds TWO optional parameters and changes NOTHING about the
# gates or their order (r8-B1/r9-n1; the pre-existing optional parameter is the
# percentage):
#   <floor_bytes>  the size floor for THIS call. The default,
#                  BOXUP_DISK_TRUNCATE_MIN_BYTES, is 1 GiB — sized for
#                  disk-pressure reclaim, not for the per-job log bound sixteen
#                  times smaller, against which every call would return 1 and
#                  nothing would ever truncate.
#   <log_prefix>   the log-line prefix. The job bound is a routine per-job
#                  event, not a disk emergency, so it must not print under
#                  `disk-guard:` with a percentage of minus one.
# It also owns the job-log truncation COUNTERS: bumping them here, after the
# gates pass and the truncation succeeds, is what makes `disk_guard`'s pressure
# reclaim of a job log move the same counters as the per-job bound (r7-B1). One
# mutator, both properties — a job-specific helper beside it would have skipped
# the symlink refusal, which a job's own `cmd` can make reachable by replacing
# its log with a link.
disk_truncate_one() {
  local f="$1" pct="${2:--1}" floor="${3:-$BOXUP_DISK_TRUNCATE_MIN_BYTES}" \
        prefix="${4:-disk-guard}" owner size me rc
  disk_allowlisted "$f" || return 1
  # ORDER IS LOAD-BEARING: the symlink refusal must stay ABOVE the size floor.
  # A symlink is rejected whatever its size, and neither line below can stand in
  # for it: `-f` FOLLOWS the link (so it is true for a link to a regular file),
  # and `stat -c %s` does NOT follow (so it reports the link's pathname length,
  # ~26 bytes, which the floor then rejects for the wrong reason). The r1 gate
  # caught exactly that masking: deleting this line survived because the floor
  # happened to fire first. tests/test-boxup-disk-guard.sh (a6b) now drives this
  # line directly with a floor below the pathname length, so nothing else can
  # cover for it.
  [ -L "$f" ] && return 1
  [ -f "$f" ] || return 1
  size=$(stat -c %s "$f" 2>/dev/null || echo 0)
  case "$size" in ''|*[!0-9]*) size=0 ;; esac
  case "$floor" in ''|*[!0-9]*) floor="$BOXUP_DISK_TRUNCATE_MIN_BYTES" ;; esac
  [ "$size" -gt "$floor" ] || return 1
  owner=$(stat -c %U "$f" 2>/dev/null || echo "")
  [ -n "$owner" ] || return 1
  me=$(id -un 2>/dev/null || echo "")
  rc=1
  if [ "$owner" = "$me" ]; then
    # We ARE the owner: no privilege switch at all. This is the branch a
    # non-root unit test exercises, and on a box it is the branch that runs
    # whenever the worker and the platform log share a user.
    truncate -c -s 0 "$f" 2>/dev/null && rc=0
  else
    # Not the owner: drop to them. runuser first (no PAM session, no password,
    # the right tool), then su. If runuser is absent on a stripped image, or
    # refuses because we are not privileged enough to setuid, fall THROUGH to
    # su rather than giving up — and if neither works, report the failure. We
    # never fall back to truncating as root: that is precisely the operation
    # fs.protected_regular denies, so it would fail anyway, silently.
    if have runuser; then
      runuser -u "$owner" -- truncate -c -s 0 "$f" 2>/dev/null && rc=0
    fi
    if [ "$rc" -ne 0 ] && have su; then
      su -s /bin/sh "$owner" -c "truncate -c -s 0 '$f'" 2>/dev/null && rc=0
    fi
  fi
  if [ "$rc" -eq 0 ]; then
    # The counters live here so BOTH callers move them (r7-B1/j34).
    case "$f" in
      "$JOBS_DIR"/*/log) jobs_record_truncation "${f%/log}" "$size" ;;
    esac
    case "$pct" in
      ''|-*|*[!0-9]*) log "$prefix: truncated $f ($size B)" ;;
      *)              log "$prefix: truncated $f ($size B, root ${pct}%)" ;;
    esac
    return 0
  fi
  log "$prefix: could not truncate $f ($size B, owner=$owner) as its owner — NOT retrying as root (fs.protected_regular would refuse it)" >&2
  return 1
}

# disk_guard: the per-tick entry point (G1). Rate-limited, reads usage once,
# and only at FAIL level walks the allowlist. It re-reads df afterwards so the
# state it records is the POST-truncation truth, which is what makes the check
# reason honest. ALWAYS returns 0 — a disk watcher that can break the self-heal
# tick is worse than no disk watcher.
disk_guard() {
  local now last pct level f
  now=$(date +%s)
  last=0
  [ -f "$DISK_STAMP" ] && last=$(tr -d '[:space:]' < "$DISK_STAMP" 2>/dev/null || echo 0)
  case "$last" in ''|*[!0-9]*) last=0 ;; esac
  if [ "$last" -gt 0 ] && [ $((now - last)) -lt "$BOXUP_DISK_INTERVAL" ]; then
    return 0
  fi
  echo "$now" > "$DISK_STAMP" 2>/dev/null || true

  pct=$(disk_used_pct)
  level=$(disk_level "$pct")
  if [ "$level" = fail ]; then
    # shellcheck disable=SC2086  # word splitting is the point (space-separated list)
    # BOTH lists (J6, r10-B1): disk_allowlisted is the checker, this is the
    # CANDIDATE loop — two separate consumers of the same variable. Walking the
    # built-in list only in the checker would leave the pressure reclaim unable
    # to name a job log at all under an override.
    for f in $DISK_GUARD_TRUNCATE $DISK_GUARD_BUILTIN_TRUNCATE; do
      [ -n "$f" ] || continue
      disk_truncate_one "$f" "$pct" || true
    done
    pct=$(disk_used_pct)
    level=$(disk_level "$pct")
  fi
  echo "${pct}% $level $now" > "$DISK_STATE" 2>/dev/null || true
  return 0
}

# disk_status_token: the `disk=` value for the status line (G3). Computed FRESH
# from df rather than read back from $DISK_STATE — one df is ~1 ms, far cheaper
# than the two tailscale calls check_reason already makes, and it means `boxup
# status` on a box whose worker has not ticked yet still tells the truth. `ok`
# prints bare (disk=22%); warn and fail carry the level (disk=93%/fail) so an
# operator grepping a fleet's status lines sees the bad ones without knowing
# the thresholds.
disk_status_token() {
  local pct level
  pct=$(disk_used_pct)
  level=$(disk_level "$pct")
  case "$level" in
    unknown) printf 'unknown' ;;
    ok)      printf '%s%%' "$pct" ;;
    *)       printf '%s%%/%s' "$pct" "$level" ;;
  esac
}

# --- keep-awake guard (blueprint boxup-keepawake K1-K6) ----------------------
# The platform pauses a box after an idle window keyed to AGENT TURNS, and the
# box is charged nothing while it sleeps but is also unreachable — the VPS brain
# cannot converge, cannot alert, cannot even see it. The platform's own hourly
# `keep-alive` automation is too slow (003 slept 51 m 50 s inside an hourly gap)
# and gets parked on Auto-review approval widgets. This guard drives the SAME
# mechanism the hourly automation uses — one minimal agent turn — at a
# 20-minute cadence, from the box itself.
#
# K1 — the turn: POST $BOXUP_GATEWAY_URL/api/sendPrompt with the bearer token
# from $BOXUP_GATEWAY_JSON and agentId = the gateway's CURRENT `activeAgentId`
# read from GET /health. The agent id is NEVER hard-coded: the gateway restarts
# and the id changes (it changed at 01:41Z during the probe). A request carrying
# an `Origin` header is refused 403, so we send none. Success is HTTP 200 with
# `"accepted":true`.
#
# K2 — the delivery: this box has NO systemd and NO cron (tini is PID 1) and
# only /workspace survives an image swap, so there is nothing to schedule with.
# keepawake_guard is a tick-driven action in the disk_guard shape, called from
# run_tick, rate-limited by a stamp file exactly like DISK_STAMP. The worker's
# own 15 s cadence is the clock; a paused box simply resumes ticking when the
# platform resumes it. No unit files, nothing outside /workspace and $RUN_DIR.
#
# K3 — it is skip-first and MEASURED. Every attempt appends one line to
# $KEEPAWAKE_LOG, including skips and unreachables: that log is the DENOMINATOR
# of the 48 h fleet experiment (acceptance 3), so a skip that is not logged is a
# measurement defect, not a saving.
#
# COST: one minimal model turn per fire — 72 per box per day at 20 minutes, 792
# a day across eleven boxes. That is the whole reason the shipped step carries
# its own measurement: the experiment decides KEEP or ABANDON, and ABANDON is
# `[keepawake] interval_min = 0` fleet-wide.
#
# MEASUREMENT CAVEAT (read this before believing the readout): a paused box
# writes nothing, so a sleep ERASES the slots it covers, and the readout
# attributes absent slots to sleep as an approximation. A stopped worker, an
# image swap, or a crashed gateway produce absent slots too. Every one of those
# alternative causes pushes the verdict toward ABANDON, which is the CHEAP
# error — abandoning costs us a mechanism we can re-enable with one config key,
# while keeping a mechanism that does not work costs 792 model turns a day
# forever. The bias is deliberate and it is the safe direction.
#
# Gateway endpoint + discovery file. Both are env seams (K6) so the test suite
# can drive the real functions against a stub `curl` with no listening port, and
# so a gate can point the guard at a canary gateway.
BOXUP_GATEWAY_URL="${BOXUP_GATEWAY_URL:-http://127.0.0.1:1340}"
BOXUP_GATEWAY_JSON="${BOXUP_GATEWAY_JSON:-/home/box/sand-data/gateway.json}"
# The cadence knob's baked default, its floor, and the dedicated unreachable
# retry floor (K3). interval_min comes from [keepawake].interval_min via
# config_get (managed.toml > config.toml > this default); 0 turns the guard off.
KEEPAWAKE_DEFAULT_MIN=20
KEEPAWAKE_FLOOR_MIN=10
KEEPAWAKE_RETRY_S=90
# How long we watch /health after an accepted send before calling the fire
# inert. The probe saw isBusy flip within ~2 s and hold ~20 s.
KEEPAWAKE_POLL_S=10
KEEPAWAKE_PROMPT="Reply with only the word: ok"
# $RUN_DIR state (ephemeral by design: an image swap loses it and the first tick
# after the swap fires at once, which is acceptable — K5).
KEEPAWAKE_STAMP="$RUN_DIR/last-keepawake"                   # main cadence stamp
KEEPAWAKE_UNREACH_STAMP="$RUN_DIR/last-keepawake-unreach"   # 90 s retry floor
KEEPAWAKE_UNREACH_WARN="$RUN_DIR/last-keepawake-unreach-warn"
KEEPAWAKE_WARN_STAMP="$RUN_DIR/last-keepawake-warn"         # parked-approval WARN
KEEPAWAKE_OFF_STAMP="$RUN_DIR/last-keepawake-off"           # `off` notice
KEEPAWAKE_RC_FILE="$RUN_DIR/keepawake"                      # "<rc> <epoch>"
# /workspace state: SURVIVES an image swap. The attempt log is the experiment's
# raw data and the baseline is what makes the `jumps` token a per-install count
# rather than the box's lifetime total.
KEEPAWAKE_LOG="${BOXUP_KEEPAWAKE_LOG:-/workspace/boxup-keepawake.log}"
KEEPAWAKE_BASELINE="${BOXUP_KEEPAWAKE_BASELINE:-/workspace/.boxup-keepawake-baseline}"

# keepawake_interval_min: the resolved cadence in MINUTES.
#   unset / unparseable -> KEEPAWAKE_DEFAULT_MIN (20)
#   0                   -> 0 (off; the guard becomes a no-op)
#   1..floor-1          -> KEEPAWAKE_FLOOR_MIN (10)
# The floor exists because the cost is one model turn per fire: a fat-fingered
# `interval_min = 1` would be 1440 turns a box a day.
keepawake_interval_min() {
  local v
  v="$(config_get keepawake interval_min 2>/dev/null || true)"
  v="$(printf '%s' "$v" | tr -d '[:space:]')"
  case "$v" in ''|*[!0-9]*) echo "$KEEPAWAKE_DEFAULT_MIN"; return 0 ;; esac
  if [ "$v" = 0 ]; then echo 0; return 0; fi
  if [ "$v" -lt "$KEEPAWAKE_FLOOR_MIN" ]; then echo "$KEEPAWAKE_FLOOR_MIN"; return 0; fi
  echo "$v"
}

# keepawake_json_get <json> <key>: the value of a TOP-LEVEL scalar key, empty
# when absent. Deliberately not a JSON parser — the box image has no jq, and the
# four fields we read (activeAgentId, isBusy, busyOnlyAwaitingApproval,
# lastBusyAtMs) are all top-level scalars in the gateway's /health object.
keepawake_json_get() {
  printf '%s' "$1" \
    | tr ',{}' '\n\n\n' \
    | sed -n "s/^[[:space:]]*\"$2\"[[:space:]]*:[[:space:]]*//p" \
    | head -1 \
    | sed -e 's/^"//' -e 's/"[[:space:]]*$//' -e 's/[[:space:]]*$//'
}

# keepawake_health: GET /health (no auth — the gateway does not require it on
# this route). Prints the body; non-zero rc means UNREACHABLE, which is never
# a tick failure.
keepawake_health() {
  curl -sS --max-time 5 "$BOXUP_GATEWAY_URL/health" 2>/dev/null
}

# keepawake_gateway_token: the bearer from the discovery file.
keepawake_gateway_token() {
  local j=""
  [ -f "$BOXUP_GATEWAY_JSON" ] && j="$(cat "$BOXUP_GATEWAY_JSON" 2>/dev/null || true)"
  keepawake_json_get "$j" token
}

# keepawake_fire <agentId>: the one request that costs money. NO Origin header
# (the gateway 403s any request that carries one) and the agent id comes from
# the caller, which read it from /health this very tick.
keepawake_fire() {
  local agent="$1" tok
  tok="$(keepawake_gateway_token)"
  curl -sS --max-time 15 -X POST \
    -H "Authorization: Bearer $tok" \
    -H 'content-type: application/json' \
    -d "{\"agentId\":\"$agent\",\"prompt\":\"$KEEPAWAKE_PROMPT\",\"directAddressedAcceptance\":true}" \
    "$BOXUP_GATEWAY_URL/api/sendPrompt" 2>/dev/null
}

# keepawake_hourly <stampfile> <now>: 0 (and stamps) iff an hour has passed.
# The DISK_WARN_STAMP shape — the tick calls this every 15 s, so an unthrottled
# line would be 240 an hour in the worker log.
keepawake_hourly() {
  local f="$1" now="$2" last=0
  [ -f "$f" ] && last=$(tr -d '[:space:]' < "$f" 2>/dev/null || echo 0)
  case "$last" in ''|*[!0-9]*) last=0 ;; esac
  [ $((now - last)) -ge 3600 ] || return 1
  echo "$now" > "$f" 2>/dev/null || true
  return 0
}

# keepawake_record <rc> <epoch>: the last outcome, for the status tokens.
keepawake_record() {
  echo "$1 $2" > "$KEEPAWAKE_RC_FILE" 2>/dev/null || true
}

# keepawake_log_attempt <rc> <before> <after>: ONE line per guard ATTEMPT into
# the /workspace attempt log — skips and unreachables INCLUDED. This log is the
# denominator of the fleet experiment; tests/keepawake-readout.sh reads exactly
# this format. `-` means "the endpoint was not read at that moment", so an
# unreachable line is `before=- after=-` and a skip carries `before` only.
# Rotated at 1 MB to .1 (a year of 20-minute lines is ~1.5 MB).
keepawake_log_attempt() {
  local rc="$1" before="${2:--}" after="${3:--}" sz
  [ -n "$before" ] || before=-
  [ -n "$after" ] || after=-
  # `[ -f ]` first, deliberately: a bare `wc -c < "$f" 2>/dev/null` on a file
  # that does not exist yet still prints a shell REDIRECTION error (the input
  # redirect is resolved before 2>/dev/null is applied), so the very first
  # attempt on a fresh box would spit a spurious error into the worker log.
  sz=0
  [ -f "$KEEPAWAKE_LOG" ] && sz=$(wc -c < "$KEEPAWAKE_LOG" 2>/dev/null || echo 0)
  case "$sz" in ''|*[!0-9]*) sz=0 ;; esac
  if [ "$sz" -gt 1048576 ]; then
    mv -f "$KEEPAWAKE_LOG" "$KEEPAWAKE_LOG.1" 2>/dev/null || true
  fi
  printf '%s rc=%s before=%s after=%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$rc" "$before" "$after" \
    >> "$KEEPAWAKE_LOG" 2>/dev/null || true
}

# keepawake_jumps_raw: the box's LIFETIME count of tailscaled time jumps — the
# marker a sleep leaves behind. Honours BOX_SETUP_LOG through TAILSCALED_LOG so
# the suite can point it at a scratch tree.
keepawake_jumps_raw() {
  local n
  n=$(grep -c 'time jump detected' "$TAILSCALED_LOG" 2>/dev/null || echo 0)
  case "$n" in ''|*[!0-9]*) n=0 ;; esac
  echo "$n"
}

# keepawake_jumps: jumps SINCE the install baseline. Subtracting is the whole
# point (acceptance 3 has ONE baseline, this one): without it every box reports
# its lifetime total and a fresh install looks like a box that has slept eight
# times. Clamped at 0 — a truncated tailscaled.log must not go negative.
keepawake_jumps() {
  local raw base n
  raw=$(keepawake_jumps_raw)
  base=0
  [ -f "$KEEPAWAKE_BASELINE" ] && base=$(tr -d '[:space:]' < "$KEEPAWAKE_BASELINE" 2>/dev/null || echo 0)
  case "$base" in ''|*[!0-9]*) base=0 ;; esac
  n=$((raw - base))
  [ "$n" -lt 0 ] && n=0
  echo "$n"
}

# keepawake_converge (K5): the ONLY install step, and it is idempotent — write
# the jumps baseline the first time we ever converge on this box and never
# again. Rewriting it on every converge would silently reset the experiment's
# numerator every time the engine rolled a build out.
keepawake_converge() {
  [ -f "$KEEPAWAKE_BASELINE" ] && return 0
  keepawake_jumps_raw > "$KEEPAWAKE_BASELINE" 2>/dev/null || true
  log "keepawake: wrote jumps baseline $(tr -d '[:space:]' < "$KEEPAWAKE_BASELINE" 2>/dev/null || echo '?') to $KEEPAWAKE_BASELINE"
  return 0
}

# keepawake_guard: the per-tick entry point (K2/K3). ALWAYS returns 0 — a
# keep-awake helper that can break the self-heal tick is far worse than a box
# that sleeps. The seven outcomes it can record are exactly the seven values of
# the `keepawake_rc` status token:
#   ok              accepted AND a turn started within KEEPAWAKE_POLL_S
#   inert           accepted but no turn appeared  (NOT a success: the K4
#                   evidence rule excludes an inert window from the denominator)
#   refused         HTTP error, or a body without "accepted":true
#   skip            a REAL turn was already running (the platform's own activity
#                   already refreshed the idle clock; firing would waste a turn)
#   unreachable     /health did not answer
#   parked-ok       fired into a parked approval and the clock DID advance
#   parked-blocked  fired into a parked approval and the clock did NOT advance
keepawake_guard() {
  local now last interval_min interval_s ulast health agent busy parked
  local before after body rc i sawbusy advanced

  now=$(date +%s)
  interval_min="$(keepawake_interval_min)"

  # OFF: a no-op with a once-an-hour breadcrumb, so an operator reading the
  # worker log can tell "configured off" from "silently broken".
  if [ "$interval_min" = 0 ]; then
    keepawake_hourly "$KEEPAWAKE_OFF_STAMP" "$now" && \
      log "keepawake: off ([keepawake] interval_min = 0)"
    return 0
  fi
  interval_s=$((interval_min * 60))

  # The main cadence stamp. Nothing at all happens inside the window — not even
  # a /health read, which is why an idle tick costs nothing.
  last=0
  [ -f "$KEEPAWAKE_STAMP" ] && last=$(tr -d '[:space:]' < "$KEEPAWAKE_STAMP" 2>/dev/null || echo 0)
  case "$last" in ''|*[!0-9]*) last=0 ;; esac
  if [ "$last" -gt 0 ] && [ $((now - last)) -lt "$interval_s" ]; then
    return 0
  fi

  # The DEDICATED unreachable retry floor (K3). Its own stamp, because the main
  # stamp is deliberately NOT advanced on an unreachable tick — the first
  # reachable tick after the floor must fire. Without this floor a gateway that
  # is restarting, or a box that resumes and ticks before the gateway listens,
  # would hit /health every 15 s: 240 requests an hour instead of 40. The
  # refresh backoff (refresh_backoff_window) is the precedent — outcome-
  # independent, bounded, and cheap.
  ulast=0
  [ -f "$KEEPAWAKE_UNREACH_STAMP" ] && ulast=$(tr -d '[:space:]' < "$KEEPAWAKE_UNREACH_STAMP" 2>/dev/null || echo 0)
  case "$ulast" in ''|*[!0-9]*) ulast=0 ;; esac
  if [ "$ulast" -gt 0 ] && [ $((now - ulast)) -lt "$KEEPAWAKE_RETRY_S" ]; then
    return 0
  fi

  health="$(keepawake_health)"
  if [ -z "$health" ]; then
    echo "$now" > "$KEEPAWAKE_UNREACH_STAMP" 2>/dev/null || true
    keepawake_record unreachable "$now"
    keepawake_log_attempt unreachable - -
    keepawake_hourly "$KEEPAWAKE_UNREACH_WARN" "$now" && \
      log "keepawake: gateway unreachable ($BOXUP_GATEWAY_URL/health) — retrying no faster than every ${KEEPAWAKE_RETRY_S}s"
    return 0
  fi
  rm -f "$KEEPAWAKE_UNREACH_STAMP" 2>/dev/null || true

  agent="$(keepawake_json_get "$health" activeAgentId)"
  busy="$(keepawake_json_get "$health" isBusy)"
  parked="$(keepawake_json_get "$health" busyOnlyAwaitingApproval)"
  before="$(keepawake_json_get "$health" lastBusyAtMs)"
  [ -n "$before" ] || before=-

  # SKIP-FIRST. A genuinely running turn already refreshed lastBusyAtMs on the
  # platform's side; firing beside it would buy nothing and cost a model turn.
  # The `parked` exception below is the whole point of the feature.
  if [ "$busy" = true ] && [ "$parked" != true ]; then
    echo "$now" > "$KEEPAWAKE_STAMP" 2>/dev/null || true
    keepawake_record skip "$now"
    keepawake_log_attempt skip "$before" -
    log "keepawake: skip busy"
    return 0
  fi

  # From here we FIRE, so the main stamp advances whatever happens — a refused
  # or inert fire must not turn into a tight retry loop against a sick gateway.
  echo "$now" > "$KEEPAWAKE_STAMP" 2>/dev/null || true

  body="$(keepawake_fire "$agent")"; rc=$?
  if [ "$rc" -ne 0 ] || ! printf '%s' "$body" | grep -q '"accepted"[[:space:]]*:[[:space:]]*true'; then
    keepawake_record refused "$now"
    keepawake_log_attempt refused "$before" -
    log "keepawake: fired but the gateway REFUSED it (curl rc=$rc, body=$(printf '%s' "$body" | tr -d '\n' | cut -c1-120))" >&2
    return 0
  fi

  # Watch /health for up to KEEPAWAKE_POLL_S. Two different questions, because
  # the two cases have two different definitions of success:
  #   normal  -> did a turn START?              (isBusy true)
  #   parked  -> did the idle CLOCK advance?    (lastBusyAtMs moved)
  # The parked case is the one the probe never exercised: a turn parked on an
  # approval widget sets busyOnlyAwaitingApproval and does NOT refresh
  # lastBusyAtMs, so whether a new prompt runs BESIDE it or queues BEHIND it
  # decides whether this whole mechanism works on a box with a stuck widget.
  after=-; sawbusy=0; advanced=0; i=0
  while [ "$i" -lt "$KEEPAWAKE_POLL_S" ]; do
    sleep 1
    i=$((i + 1))
    health="$(keepawake_health)"
    [ -n "$health" ] || continue
    [ "$(keepawake_json_get "$health" isBusy)" = true ] && sawbusy=1
    after="$(keepawake_json_get "$health" lastBusyAtMs)"
    [ -n "$after" ] || after=-
    # STRICTLY GREATER, not merely different (empirical gate r1, finding 3).
    # lastBusyAtMs is a wall-clock millisecond stamp on the gateway's side, and
    # it can go BACKWARDS: a gateway restart re-initialises it, and the boxes
    # take real time jumps (that is the very thing we are measuring). A `!=`
    # test would read a clock that jumped backwards as "the turn refreshed it"
    # and report parked-ok — a false success in exactly the parked-approval path
    # this feature exists to diagnose. Non-numeric on either side proves
    # nothing, so it is not an advance either.
    if [ "$before" != - ] && [ "$after" != - ]; then
      case "$before$after" in
        ''|*[!0-9]*) ;;
        *) [ "$after" -gt "$before" ] && advanced=1 ;;
      esac
    fi
    if [ "$parked" = true ]; then
      [ "$advanced" = 1 ] && break
    else
      [ "$sawbusy" = 1 ] && break
    fi
  done

  if [ "$parked" = true ]; then
    if [ "$advanced" = 1 ]; then
      keepawake_record parked-ok "$now"
      keepawake_log_attempt parked-ok "$before" "$after"
      log "keepawake: fired through parked approval — clock refreshed"
    else
      keepawake_record parked-blocked "$now"
      keepawake_log_attempt parked-blocked "$before" "$after"
      keepawake_hourly "$KEEPAWAKE_WARN_STAMP" "$now" && \
        log "check: WARN keepawake: agent has a parked approval widget — clear it in the GUI" >&2
      log "keepawake: fired but clock NOT refreshed — parked approval blocks keep-awake"
    fi
    return 0
  fi

  if [ "$sawbusy" = 1 ]; then
    keepawake_record ok "$now"
    keepawake_log_attempt ok "$before" "$after"
    log "keepawake: fired ok"
  else
    keepawake_record inert "$now"
    keepawake_log_attempt inert "$before" "$after"
    log "keepawake: fired but not busy after ${KEEPAWAKE_POLL_S} s"
  fi
  return 0
}

# keepawake_status_tokens (K4): the four tokens appended to the status line.
# `keepawake_last`/`keepawake_rc` come from the run-dir record (so they reset on
# an image swap, like every other $RUN_DIR fact) and `jumps` is the baseline-
# subtracted sleep count, which is THE metric of the 48 h experiment.
keepawake_status_tokens() {
  local on=off rc=- lastiso=never line ts
  [ "$(keepawake_interval_min)" = 0 ] || on=on
  if [ -f "$KEEPAWAKE_RC_FILE" ]; then
    line="$(tr -d '\n' < "$KEEPAWAKE_RC_FILE" 2>/dev/null || true)"
    rc="${line%% *}"; ts="${line##* }"
    [ -n "$rc" ] || rc=-
    case "$ts" in
      ''|*[!0-9]*) ;;
      *) lastiso="$(date -u -d "@$ts" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo never)" ;;
    esac
  fi
  printf 'keepawake=%s keepawake_last=%s keepawake_rc=%s jumps=%s' \
    "$on" "$lastiso" "$rc" "$(keepawake_jumps)"
}

# --- job runner (blueprint grokfleet-jobs J1/J2/J6/J9) -----------------------
# A job is a detached process on THIS box, started by ONE short ssh, recorded
# DURABLY under $JOBS_DIR/<id>/ and supervised by the tick. The brain never
# holds a long ssh open: it starts, polls `job status`, fetches `job log` by
# offset, and stops. Consequences that are the point (J1):
#   * a paused box FREEZES a job and it resumes with the box;
#   * a VPS/API restart loses nothing (the record is here, on /workspace);
#   * an image swap kills the process but keeps the record, and the swap is
#     detected with NO kernel identity at all — $RUN_DIR is cleared by the swap
#     for free, exactly as WORKER_PID/TUNNEL_PID already rely on (boxup:1785,
#     :2280). A record with no `rc` and no $RUN_DIR marker IS the swap case.
#
# TWO KINDS, ONE RUNNER (J2). `kind=run` is ad-hoc CI: a wall-clock cap enforced
# BOX-SIDE by the wrapper's own watchdog, rc recorded on exit, 124 on the cap.
# `kind=service` is long-lived: no cap, `keep_alive=1` so this guard restarts it
# whenever it is not LIVE and no `rc` exists, and `restart_on_swap=1` so it comes
# back after an image swap. Both kinds write the same files.
#
# THE ONE LIVENESS RULE (J2, r2-B1). A job is LIVE iff
#   (a) its marker $JOBS_RUN_DIR/<id>.pid exists, AND
#   (b) the pid in that marker is alive, AND
#   (c) is_job_wrapper_proc <pid> <id> holds.
# EVERY liveness question — `status`, the slot stale-break, the keep-alive
# restart, `stop`'s post-kill check — asks exactly this. The durable `pgid` is
# for SIGNALLING ONLY (`stop` and the crashloop kill) and is NEVER read as
# liveness: after a swap pids restart from 1 in a fresh namespace, so a recorded
# pgid in the low thousands is a plausible number for an unrelated process.
# BOX_SETUP_JOBS is a documented seam in the shape of BOX_SETUP_RUN/BOX_SETUP_LOG
# (and it is forwarded across require_root's sudo re-exec for the same reason):
# it lets a gate point the whole runner at a scratch tree. It relocates the jobs
# ROOT, and DISK_GUARD_BUILTIN_TRUNCATE below is derived FROM it, so the job-log
# allowlist entry moves with the tree instead of being lost — which is the
# property r9-B1 asked for. It grants no authority: `boxup job` is root-only on a
# box where root is already passwordless.
JOBS_DIR="${BOX_SETUP_JOBS:-/workspace/jobs}"   # durable records (survive a swap)
JOBS_RUN_DIR="$RUN_DIR/jobs"        # liveness: the slot + per-job pid markers
JOBS_SLOT="$JOBS_RUN_DIR/.slot"     # atomic mkdir; ONE job per box (box-run.sh)
JOBS_LOG_MAX_BYTES=67108864         # 64 MiB, the per-job log bound (J6)
JOBS_LOG_FETCH_MAX=1048576          # 1 MiB, the per-`job log` call bound
JOBS_DEFAULT_CAP=2400               # box-run.sh's default wall-clock cap
JOBS_STOP_GRACE_S=10                # SIGTERM -> SIGKILL window
JOBS_RETAIN_DAYS=7                  # age prune of terminal records
JOBS_RETAIN_COUNT=20                # count prune of terminal records (r1-B3)
JOBS_SLOT_AGE_BACKSTOP_S=86400      # 24 h: the second stale-slot discriminator
JOBS_CRASHLOOP_N=5                  # 5 restarts ...
JOBS_CRASHLOOP_WINDOW_S=600         # ... within 10 min => rc=crashloop

# is_job_wrapper_proc <pid> <id>: true iff /proc/<pid>/cmdline is EXACTLY the
# job wrapper for <id> — the fields `*boxup`, `job-wrapper` and `<id>` all
# present as WHOLE argv fields, and NO `-c` field anywhere.
#
# This is is_worker_proc (below) extended, and the discipline comes with it:
# read the cmdline NUL-separated and compare whole fields, never a substring of
# the flattened line. The house rule at the top of this file was learned the
# hard way ("never pkill -f"), and this design re-creates the same hazard on
# purpose — the brain runs `boxup job status <id>` and `boxup job log <id> <n>`
# against the very id being scanned, so a substring match on <id> would find the
# brain's own poll, conclude the wrapper is alive, and never restart the service
# (r3-B1). The `-c` rejection excludes the job's own `sh -c "$cmd"` child and the
# `timeout ... sh -c` watchdog, which carry the command text and may mention the
# id inside it. `job status <id>` is excluded because its subcommand field is
# `status`, not `job-wrapper` — which is why the wrapper gets an argv shape of
# its own instead of being launched through a shell (r3-B1, mutants j28/j29).
is_job_wrapper_proc() {
  local pid="$1" id="$2" arg have_script=0 have_wrapper=0 have_id=0 have_c=0
  [ -n "$id" ] || return 1
  [ -r "/proc/$pid/cmdline" ] || return 1
  while IFS= read -r -d '' arg; do
    case "$arg" in
      -c) have_c=1 ;;
    esac
    [ "$arg" = job-wrapper ] && have_wrapper=1
    [ "$arg" = "$id" ] && have_id=1
    case "$arg" in
      *boxup) have_script=1 ;;
    esac
  done < "/proc/$pid/cmdline" 2>/dev/null || return 1
  [ "$have_c" = 0 ] && [ "$have_script" = 1 ] && \
    [ "$have_wrapper" = 1 ] && [ "$have_id" = 1 ]
}

# jobs_rec <id> -> the durable record directory. Never creates it.
jobs_rec() {
  printf '%s/%s' "$JOBS_DIR" "$1"
}

# jobs_marker <id> -> the EPHEMERAL liveness marker under $RUN_DIR.
jobs_marker() {
  printf '%s/%s.pid' "$JOBS_RUN_DIR" "$1"
}

# jobs_read <recdir> <file> [default]: trimmed content, or the default.
jobs_read() {
  local v=""
  [ -f "$1/$2" ] && v=$(tr -d '[:space:]' < "$1/$2" 2>/dev/null || true)
  [ -n "$v" ] || v="${3:-}"
  printf '%s' "$v"
}

# jobs_read_raw <recdir> <file>: content WITHOUT whitespace stripping (cmd/cwd).
jobs_read_raw() {
  [ -f "$1/$2" ] || return 1
  cat "$1/$2" 2>/dev/null
}

# jobs_valid_id <id>: base64url only. A job id may legitimately start with `-`,
# so nothing here may treat it as an option; it may never contain `/` or `.`,
# which is what keeps it a single path component.
jobs_valid_id() {
  case "${1:-}" in
    '') return 1 ;;
    *[!A-Za-z0-9_-]*) return 1 ;;
    *) return 0 ;;
  esac
}

# jobs_live <id>: THE ONE LIVENESS RULE (J2). See the section header.
jobs_live() {
  local id="$1" m pid
  m="$(jobs_marker "$id")"
  [ -f "$m" ] || return 1
  pid=$(tr -d '[:space:]' < "$m" 2>/dev/null || true)
  case "$pid" in ''|*[!0-9]*) return 1 ;; esac
  kill -0 "$pid" 2>/dev/null || return 1
  is_job_wrapper_proc "$pid" "$id" || return 1
  return 0
}

# jobs_scan_wrapper <id>: print the pid of a live wrapper for <id>, or nothing.
# ONLY `start` and the keep-alive restart path scan; `status` never does — it is
# a TARGETED check on the marker's own pid, so a concurrent poll cannot fool it
# (r3-n1). The scan closes the duplicate-service case: a live wrapper whose
# marker was lost must have its marker RE-CREATED, not a second instance
# launched beside it (mutant j27).
jobs_scan_wrapper() {
  local id="$1" d pid
  for d in /proc/[0-9]*; do
    pid="${d##*/}"
    is_job_wrapper_proc "$pid" "$id" || continue
    printf '%s' "$pid"
    return 0
  done
  return 1
}

# jobs_terminal <recdir>: true iff an `rc` file exists (the terminal marker).
jobs_terminal() {
  [ -f "$1/rc" ]
}

# jobs_state <id>: the derived state, from the FILES (J9). Order is
# load-bearing:
#   rc present                                        -> terminal
#   marker present, pid alive, IS the <id> wrapper     -> running
#   marker present, pid dead OR not the wrapper, no rc -> lost:died
#   marker ABSENT, no rc                               -> lost:image-swap
# A missing `rc` file is NEVER `done` (mutant j15): a job that was killed before
# it could record anything is lost, not successful.
jobs_state() {
  local id="$1" rec rc m
  rec="$(jobs_rec "$id")"
  [ -d "$rec" ] || { printf 'unknown'; return 1; }
  if [ -f "$rec/rc" ]; then
    rc="$(jobs_read "$rec" rc)"
    if [ -f "$rec/stopped" ]; then printf 'stopped'; return 0; fi
    case "$rc" in
      crashloop) printf 'crashloop' ;;
      0)         printf 'done' ;;
      124)       if [ "$(jobs_read "$rec" kind run)" = run ]; then
                   printf 'timeout'
                 else
                   printf 'failed'
                 fi ;;
      *)         printf 'failed' ;;
    esac
    return 0
  fi
  m="$(jobs_marker "$id")"
  if [ -f "$m" ]; then
    if jobs_live "$id"; then printf 'running'; else printf 'lost:died'; fi
  else
    printf 'lost:image-swap'
  fi
  return 0
}

# --- the one-job-per-box slot ------------------------------------------------
# $JOBS_RUN_DIR/.slot is an ATOMIC mkdir, and it lives under $RUN_DIR so an
# image swap clears it for free (r1-B1) — the wedged-box failure of a durable
# lock with no way to break it cannot happen here. It records the job id, not a
# pid: staleness is decided by the ONE liveness rule, never by a recorded pgid
# (mutant j26), with the 24 h age check as a second discriminator for a slot so
# corrupt it names no readable id (mutant j2 makes the break age-only).

jobs_slot_id() {
  [ -d "$JOBS_SLOT" ] || return 1
  local id
  id=$(tr -d '[:space:]' < "$JOBS_SLOT/id" 2>/dev/null || true)
  [ -n "$id" ] || return 1
  printf '%s' "$id"
}

jobs_slot_release() {
  rm -rf "$JOBS_SLOT" 2>/dev/null || true
}

# jobs_slot_held: 0 iff the slot is genuinely occupied. Held while the job it
# names is LIVE, or has a live wrapper whose marker was lost, or is a keep-alive
# job that has not reached a terminal state (the guard still owns it and will
# restart it — releasing the slot in that window would let another job take it
# and strand the service).
jobs_slot_held() {
  local id rec age at now
  [ -d "$JOBS_SLOT" ] || return 1
  if ! id="$(jobs_slot_id)"; then
    # A slot naming no id is corrupt. Break it only past the age backstop, so a
    # start racing its own slot-write is never robbed of it.
    now=$(date +%s); at=0
    [ -f "$JOBS_SLOT/at" ] && at=$(tr -d '[:space:]' < "$JOBS_SLOT/at" 2>/dev/null || echo 0)
    case "$at" in ''|*[!0-9]*) at=0 ;; esac
    age=$((now - at))
    if [ "$at" -gt 0 ] && [ "$age" -ge "$JOBS_SLOT_AGE_BACKSTOP_S" ]; then
      log "jobs_guard: WARN breaking a corrupt job slot (no id, age=${age}s)" >&2
      jobs_slot_release
      return 1
    fi
    return 0
  fi
  jobs_live "$id" && return 0
  jobs_scan_wrapper "$id" >/dev/null 2>&1 && return 0
  rec="$(jobs_rec "$id")"
  if [ -d "$rec" ] && ! jobs_terminal "$rec" && \
     [ "$(jobs_read "$rec" keep_alive 0)" = 1 ]; then
    return 0
  fi
  now=$(date +%s); at=0
  [ -f "$JOBS_SLOT/at" ] && at=$(tr -d '[:space:]' < "$JOBS_SLOT/at" 2>/dev/null || echo 0)
  case "$at" in ''|*[!0-9]*) at=0 ;; esac
  age=$((now - at))
  log "jobs: WARN breaking a STALE job slot id=$id (no live wrapper, age=${age}s)" >&2
  jobs_slot_release
  return 1
}

# jobs_slot_claim <id>: take the one-job slot for <id>. Returns 0 iff <id> holds
# it afterwards.
#
# This exists because an image swap — or a plain reboot; both clear /run — takes
# the slot away along with every marker, which is precisely how the swap is
# detected. The tick then restarts a keep-alive service and, without this, the
# slot would stay gone for the life of that job: `boxup status` would report
# `job=-` while the service ran, and the next `boxup job start` would find no
# slot and put a SECOND job on the box, silently disabling the rc 75 backstop
# that J7/J9's one-job-per-box rule depends on.
#
# A slot naming a DIFFERENT job is offered to jobs_slot_held, which breaks it if
# it is stale and keeps it if that job is genuinely live. A live holder is never
# stolen from — restarting into its slot is the same two-jobs-on-one-box
# outcome, arrived at from the other side.
jobs_slot_claim() {
  local id="$1" cur
  cur="$(jobs_slot_id 2>/dev/null || true)"
  [ "$cur" = "$id" ] && return 0
  if [ -d "$JOBS_SLOT" ]; then
    jobs_slot_held && return 1
  fi
  mkdir "$JOBS_SLOT" 2>/dev/null || return 1
  echo "$id" > "$JOBS_SLOT/id" 2>/dev/null || true
  date +%s > "$JOBS_SLOT/at" 2>/dev/null || true
  return 0
}

# --- log bound (J6) ----------------------------------------------------------
# The wrapper's stdout+stderr is ONE append descriptor, opened once by
# spawn_detached and inherited across the exec. So the log is bounded by
# IN-PLACE TRUNCATION and NEVER by rename-rotation: a rename would leave the
# wrapper writing into the renamed inode and the visible log empty forever
# (r4-B1 — the rename form used for $KEEPAWAKE_LOG is correct only because
# every write there reopens the file). Mutant j30 does exactly that.
#
# The truncation goes through disk_truncate_one, the guard's SOLE mutator, so it
# inherits EVERY gate — above all the symlink refusal, which is load-bearing
# here specifically: a job's own `cmd` runs on this box and can replace its log
# with a symlink, which is the classic way to turn a log truncator into an
# arbitrary-file truncator (r7-B1, mutant j35). The explicit floor argument is
# required because the mutator's default floor is 1 GiB, sized for disk-pressure
# reclaim, not for a per-job bound sixteen times smaller (r8-B1, mutant j36).
jobs_bound_logs() {
  local d id sz
  for d in "$JOBS_DIR"/*; do
    [ -d "$d" ] || continue
    [ -f "$d/log" ] || continue
    # -L DEREFERENCES on purpose. `stat -c %s` on a symlink reports the LINK's
    # own size (~26-70 bytes, its pathname), which is below the bound — so a job
    # that replaced its log with a link to a huge file would slip past this
    # pre-check and the mutator's symlink refusal would never be reached. That
    # is the same masking the disk guard's r1 gate caught between its `-L` line
    # and its size floor. Dereferencing here means the link IS offered to the
    # mutator, which refuses it, and the refusal is WARNed below.
    sz=$(stat -Lc %s "$d/log" 2>/dev/null || echo 0)
    case "$sz" in ''|*[!0-9]*) sz=0 ;; esac
    [ "$sz" -gt "$JOBS_LOG_MAX_BYTES" ] || continue
    id="${d##*/}"
    # A REFUSAL is never silent. The mutator returns 1 for a symlink, a
    # non-regular file, or a path off both allowlists — and a job's own command
    # can create the first of those under its own record directory, so an
    # operator has to be able to see why a log stopped being bounded.
    disk_truncate_one "$d/log" -1 "$JOBS_LOG_MAX_BYTES" "jobs_guard: job=$id" || \
      log "jobs_guard: WARN job=$id log is over the bound ($sz B) and the guard REFUSED to truncate it (symlink, not a regular file, or not allowlisted)" >&2
  done
}

# jobs_record_truncation <recdir> <bytes>: the TWO durable counters, bumped from
# INSIDE disk_truncate_one after its gates pass and the truncation succeeds, so
# `disk_guard`'s pressure reclaim of a job log moves them exactly as the per-job
# bound does — one mutator, both properties (r7-B1, mutant j34). Both counters
# are REPORTED on the status line: the brain must never infer a truncation from
# sizes, because a fast writer's new generation can already be larger than the
# brain's old offset by the next poll (r6-B1, mutant j33).
jobs_record_truncation() {
  local rec="$1" bytes="$2" n t
  [ -d "$rec" ] || return 0
  n=$(jobs_read "$rec" truncations 0); case "$n" in ''|*[!0-9]*) n=0 ;; esac
  t=$(jobs_read "$rec" truncated_total 0); case "$t" in ''|*[!0-9]*) t=0 ;; esac
  case "$bytes" in ''|*[!0-9]*) bytes=0 ;; esac
  echo $((n + 1)) > "$rec/truncations" 2>/dev/null || true
  echo $((t + bytes)) > "$rec/truncated_total" 2>/dev/null || true
  printf '[log truncated on box at %s after %s bytes]\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$bytes" >> "$rec/log" 2>/dev/null || true
}

# --- supervision (J2/J9) -----------------------------------------------------
# Restart bookkeeping is EPHEMERAL, under $RUN_DIR: an image swap legitimately
# resets it, because a swap-restart is not a crashloop.
jobs_restart_state() {
  printf '%s/%s.restarts' "$JOBS_RUN_DIR" "$1"
}

# jobs_restart_one <id>: relaunch the wrapper for a keep-alive job, honouring the
# backoff ladder and the crashloop cutoff. Returns 0 iff it launched.
jobs_restart_one() {
  local id="$1" rec st n first last now window pid
  rec="$(jobs_rec "$id")"
  st="$(jobs_restart_state "$id")"
  now=$(date +%s)
  n=0; first=0; last=0
  if [ -f "$st" ]; then
    read -r n first last < "$st" 2>/dev/null || true
  fi
  case "$n" in ''|*[!0-9]*) n=0 ;; esac
  case "$first" in ''|*[!0-9]*) first=0 ;; esac
  case "$last" in ''|*[!0-9]*) last=0 ;; esac
  # Crashloop: N restarts inside the window and the guard STOPS restarting,
  # recording rc=crashloop (mutant j6 never crashloops).
  if [ "$n" -ge "$JOBS_CRASHLOOP_N" ] && [ "$first" -gt 0 ] && \
     [ $((now - first)) -lt "$JOBS_CRASHLOOP_WINDOW_S" ]; then
    log "jobs_guard: job=$id CRASHLOOP ($n restarts in $((now - first))s) — not restarting" >&2
    echo crashloop > "$rec/rc" 2>/dev/null || true
    date -u +%Y-%m-%dT%H:%M:%SZ > "$rec/ended" 2>/dev/null || true
    rm -f "$(jobs_marker "$id")" 2>/dev/null || true
    [ "$(jobs_slot_id 2>/dev/null || true)" = "$id" ] && jobs_slot_release
    return 1
  fi
  # Backoff: the SAME 20->60->180->600 s ladder the tick-repair path uses
  # (refresh_backoff_window). Mutant j5 restarts with no backoff at all.
  window=$(refresh_backoff_window "$n")
  if [ "$last" -gt 0 ] && [ $((now - last)) -lt "$window" ]; then
    return 1
  fi
  # The duplicate-service closure: a live wrapper with no marker gets its marker
  # RE-CREATED; a second instance is never launched (mutant j27). The scan is
  # whole-field, so an in-flight `boxup job status <id>` poll is NOT a match.
  if pid="$(jobs_scan_wrapper "$id")"; then
    echo "$pid" > "$(jobs_marker "$id")" 2>/dev/null || true
    # The job IS running, so the marker goes back unconditionally; the slot is
    # best-effort here because another live job may legitimately hold it.
    jobs_slot_claim "$id" || \
      log "jobs_guard: WARN job=$id is live but the job slot is held by $(jobs_slot_id 2>/dev/null || echo '?')" >&2
    log "jobs_guard: job=$id wrapper already live pid=$pid — marker re-created, not restarting"
    return 1
  fi
  # Re-take the slot BEFORE launching. A swap cleared it, and a service that
  # comes back without it is invisible to `boxup status` and leaves the box
  # accepting a second job. If it cannot be claimed, another job is genuinely
  # running here: do NOT restart into that, log it, and let the next tick retry.
  # The restart counter is not advanced, so a blocked service does not burn its
  # way to a crashloop while it waits.
  if ! jobs_slot_claim "$id"; then
    log "jobs_guard: job=$id NOT restarting — the job slot is held by $(jobs_slot_id 2>/dev/null || echo '?')" >&2
    return 1
  fi
  [ "$first" -gt 0 ] && [ $((now - first)) -ge "$JOBS_CRASHLOOP_WINDOW_S" ] && { n=0; first=0; }
  [ "$first" -gt 0 ] || first="$now"
  n=$((n + 1))
  echo "$n $first $now" > "$st" 2>/dev/null || true
  log "jobs_guard: job=$id restarting (attempt=$n window=${window}s)"
  jobs_launch_wrapper "$id"
}

# jobs_supervise: the reap + restart pass. There is nothing to `wait` on — the
# wrapper is fully detached and tini (PID 1) reaps it — so "reaping" here is
# what actually leaks otherwise: a slot still held by a job that is terminal or
# can never be restarted. jobs_slot_held does that release as its stale break.
jobs_supervise() {
  local d id rec keep swap
  jobs_slot_held >/dev/null 2>&1 || true
  for d in "$JOBS_DIR"/*; do
    [ -d "$d" ] || continue
    id="${d##*/}"
    jobs_valid_id "$id" || continue
    rec="$d"
    jobs_terminal "$rec" && continue
    jobs_live "$id" && continue
    keep="$(jobs_read "$rec" keep_alive 0)"
    [ "$keep" = 1 ] || continue
    # An ABSENT marker with no rc is the image-swap case (r1-B1). A service is
    # restarted after a swap only when restart_on_swap=1; otherwise it stays
    # `lost:image-swap` for the brain to record.
    swap=0
    [ -f "$(jobs_marker "$id")" ] || swap=1
    if [ "$swap" = 1 ] && [ "$(jobs_read "$rec" restart_on_swap 1)" != 1 ]; then
      continue
    fi
    jobs_restart_one "$id" || true
  done
}

# jobs_prune: terminal records are bounded by AGE *and* COUNT (r1-B3, mutant
# j25 prunes by age only). Count first — twenty 64 MiB logs is already 1.3 GB on
# a box whose disk pressure needed its own guard.
jobs_prune() {
  local d id now cutoff ended ts keep n line
  [ -d "$JOBS_DIR" ] || return 0
  now=$(date +%s)
  cutoff=$((now - JOBS_RETAIN_DAYS * 86400))
  keep="$(mktemp 2>/dev/null || echo "")"
  [ -n "$keep" ] || return 0
  for d in "$JOBS_DIR"/*; do
    [ -d "$d" ] || continue
    id="${d##*/}"
    jobs_valid_id "$id" || continue
    jobs_terminal "$d" || continue
    ts=$(stat -c %Y "$d/rc" 2>/dev/null || echo 0)
    case "$ts" in ''|*[!0-9]*) ts=0 ;; esac
    ended="$(jobs_read "$d" ended_epoch)"
    case "$ended" in ''|*[!0-9]*) ;; *) ts="$ended" ;; esac
    printf '%s %s\n' "$ts" "$id" >> "$keep"
  done
  n=0
  while IFS=' ' read -r ts id; do
    [ -n "$id" ] || continue
    n=$((n + 1))
    if [ "$n" -gt "$JOBS_RETAIN_COUNT" ] || [ "$ts" -lt "$cutoff" ]; then
      log "jobs_guard: pruning terminal record job=$id (rank=$n ended=$ts)"
      rm -rf "${JOBS_DIR:?}/$id" 2>/dev/null || true
      rm -f "$(jobs_marker "$id")" "$(jobs_restart_state "$id")" 2>/dev/null || true
    fi
  done < <(sort -rn "$keep")
  rm -f "$keep" 2>/dev/null || true
  return 0
}

# jobs_guard: the per-tick entry point (J9). Runs in run_tick right after
# keepawake_guard, OUTSIDE the converge lock and for the same reason: a tick
# that loses the lock to an in-progress converge must still supervise jobs.
# ALWAYS returns 0.
jobs_guard() {
  [ -d "$JOBS_DIR" ] || return 0
  jobs_supervise || true
  jobs_bound_logs || true
  jobs_prune || true
  return 0
}

# jobs_status_tokens: the `job=` / `job_state=` pair for the status line. The
# active job is whatever holds the one slot; a terminal job has released it.
jobs_status_tokens() {
  local id
  if id="$(jobs_slot_id)"; then
    printf 'job=%s job_state=%s' "$id" "$(jobs_state "$id" || true)"
  else
    printf 'job=- job_state=-'
  fi
}

# --- the wrapper -------------------------------------------------------------
# jobs_launch_wrapper <id>: the ONLY launch site. spawn_detached is the one
# detachment primitive in this file (a lint rule enforces that), and it already
# opens the log ONCE with `>>` and execs the child under it — which is exactly
# the single inherited O_APPEND descriptor the whole log-bounding design rests
# on. The argv is `bash <path>/boxup job-wrapper <id>`: an INTERNAL subcommand,
# never `sh -c`, so is_job_wrapper_proc can identify it (r3-B1, mutant j29).
jobs_launch_wrapper() {
  local id="$1" rec
  rec="$(jobs_rec "$id")"
  mkdir -p "$JOBS_RUN_DIR" 2>/dev/null || true
  : >> "$rec/log" 2>/dev/null || true
  spawn_detached "$rec/log" bash "$SELF" job-wrapper "$id"
}

# job_wrapper_main <id>: runs AS the detached job. It records its pgid (for
# SIGNALLING only), plants the liveness marker, runs the command under the
# box-side watchdog, and records the outcome.
#
# A keep-alive job deliberately does NOT write `rc` when its command exits: the
# absence of `rc` is precisely what tells the guard to restart it. It leaves the
# marker in place too, so `status` reports `lost:died` (the process died) rather
# than `lost:image-swap` (the run dir was cleared) in the window before the
# restart. Only `stop`, the crashloop cutoff, or a non-keep-alive exit write a
# terminal `rc`.
job_wrapper_main() {
  local id="$1" rec cmd cwd cap kind keep pgid rc
  jobs_valid_id "$id" || { echo "boxup: job-wrapper: invalid id" >&2; return 2; }
  rec="$(jobs_rec "$id")"
  [ -d "$rec" ] || { echo "boxup: job-wrapper: no record for $id" >&2; return 2; }
  mkdir -p "$JOBS_RUN_DIR" 2>/dev/null || true
  pgid=$(ps -o pgid= -p $$ 2>/dev/null | tr -d '[:space:]')
  case "$pgid" in ''|*[!0-9]*) pgid=$$ ;; esac
  echo "$pgid" > "$rec/pgid" 2>/dev/null || true
  echo $$ > "$(jobs_marker "$id")" 2>/dev/null || true
  [ -f "$rec/started" ] || date -u +%Y-%m-%dT%H:%M:%SZ > "$rec/started" 2>/dev/null || true
  cmd="$(jobs_read_raw "$rec" cmd || true)"
  cwd="$(jobs_read "$rec" cwd /workspace)"
  cap="$(jobs_read "$rec" cap "$JOBS_DEFAULT_CAP")"
  kind="$(jobs_read "$rec" kind run)"
  keep="$(jobs_read "$rec" keep_alive 0)"
  [ -d "$cwd" ] || cwd=/workspace
  cd "$cwd" 2>/dev/null || cd / || true
  rc=0
  if [ "$kind" = run ]; then
    # The cap is enforced BOX-SIDE, inside the pgid, so it holds even when the
    # brain is down, rolled back, or has forgotten the job (J2/J10). --foreground
    # so the signal reaches the command, -k 30 so a wedged child still dies.
    timeout --foreground -k 30 "$cap" sh -c "$cmd"
    rc=$?
  else
    # A service has NO cap (mutant j20 gives it one, which test (6) kills).
    sh -c "$cmd"
    rc=$?
  fi
  date -u +%Y-%m-%dT%H:%M:%SZ > "$rec/last_exit" 2>/dev/null || true
  echo "$rc" > "$rec/last_rc" 2>/dev/null || true
  if [ "$keep" = 1 ]; then
    return "$rc"
  fi
  echo "$rc" > "$rec/rc" 2>/dev/null || true
  date +%s > "$rec/ended_epoch" 2>/dev/null || true
  date -u +%Y-%m-%dT%H:%M:%SZ > "$rec/ended" 2>/dev/null || true
  # rc BEFORE the marker: at no instant is (marker absent, no rc) true for a job
  # that actually finished, so `status` can never mistake a clean exit for an
  # image swap.
  rm -f "$(jobs_marker "$id")" 2>/dev/null || true
  [ "$(jobs_slot_id 2>/dev/null || true)" = "$id" ] && jobs_slot_release
  return "$rc"
}

# --- the `boxup job` subcommands --------------------------------------------
jobs_usage() {
  cat >&2 <<'EOF'
boxup job start <id> [--kind run|service] [--cap <s>] [--keep-alive]
                     [--cwd <dir>] [--no-restart-on-swap] -- <cmd...>
boxup job status <id>
boxup job log <id> [<offset>]
boxup job stop <id>
boxup job ls
boxup job prune
EOF
}

# rc 75 (EX_TEMPFAIL) = the box's one job slot is taken. Chosen so the brain can
# distinguish "busy" from every usage/IO error (mutant j1 drops the check).
jobs_cmd_start() {
  local id="$1"; shift
  local kind=run cap="$JOBS_DEFAULT_CAP" keep=0 cwd=/workspace swap=1 rec
  jobs_valid_id "$id" || { echo "boxup: job start: invalid id" >&2; return 2; }
  while [ $# -gt 0 ]; do
    case "$1" in
      --kind)   kind="${2:-run}"; shift 2 ;;
      --cap)    cap="${2:-$JOBS_DEFAULT_CAP}"; shift 2 ;;
      --cwd)    cwd="${2:-/workspace}"; shift 2 ;;
      --keep-alive) keep=1; shift ;;
      --no-restart-on-swap) swap=0; shift ;;
      --restart-on-swap)    swap=1; shift ;;
      --) shift; break ;;
      *) echo "boxup: job start: unknown option: $1" >&2; jobs_usage; return 2 ;;
    esac
  done
  [ $# -gt 0 ] || { echo "boxup: job start: no command" >&2; jobs_usage; return 2; }
  case "$kind" in run|service) ;; *) echo "boxup: job start: bad kind: $kind" >&2; return 2 ;; esac
  case "$cap" in ''|*[!0-9]*) echo "boxup: job start: bad cap: $cap" >&2; return 2 ;; esac
  [ "$kind" = service ] && keep=1
  ensure_dirs
  mkdir -p "$JOBS_RUN_DIR" "$JOBS_DIR" 2>/dev/null || true
  # The slot: an ATOMIC mkdir. A held slot is rc 75; a stale one is broken with
  # a WARN by jobs_slot_held, and the retry then succeeds.
  if ! mkdir "$JOBS_SLOT" 2>/dev/null; then
    if jobs_slot_held; then
      echo "job=busy holder=$(jobs_slot_id 2>/dev/null || echo unknown)" >&2
      return 75
    fi
    mkdir "$JOBS_SLOT" 2>/dev/null || { echo "boxup: job start: cannot take the slot" >&2; return 75; }
  fi
  echo "$id" > "$JOBS_SLOT/id" 2>/dev/null || true
  date +%s > "$JOBS_SLOT/at" 2>/dev/null || true
  rec="$(jobs_rec "$id")"
  mkdir -p "$rec" 2>/dev/null || { jobs_slot_release; echo "boxup: job start: cannot create $rec" >&2; return 1; }
  printf '%s' "$*" > "$rec/cmd" 2>/dev/null || true
  printf '%s' "$cwd" > "$rec/cwd" 2>/dev/null || true
  echo "$kind" > "$rec/kind"; echo "$cap" > "$rec/cap"
  echo "$keep" > "$rec/keep_alive"; echo "$swap" > "$rec/restart_on_swap"
  echo 0 > "$rec/truncations"; echo 0 > "$rec/truncated_total"
  rm -f "$rec/rc" "$rec/ended" "$rec/ended_epoch" "$rec/stopped" 2>/dev/null || true
  date -u +%Y-%m-%dT%H:%M:%SZ > "$rec/started" 2>/dev/null || true
  date +%s > "$rec/started_epoch" 2>/dev/null || true
  : > "$rec/log" 2>/dev/null || true
  jobs_launch_wrapper "$id"
  log "job: started id=$id kind=$kind cap=${cap}s keep_alive=$keep cwd=$cwd"
  printf 'job=%s state=starting\n' "$id"
  return 0
}

# ONE key=value line — the brain's whole channel (J9/J5). `truncations` and
# `truncated_total` ride here because the brain must NEVER infer a truncation
# from sizes (r6-B1).
jobs_cmd_status() {
  local id="$1" rec pid m
  jobs_valid_id "$id" || { echo "boxup: job status: invalid id" >&2; return 2; }
  rec="$(jobs_rec "$id")"
  [ -d "$rec" ] || { printf 'state=unknown\n'; return 1; }
  m="$(jobs_marker "$id")"
  pid="-"
  [ -f "$m" ] && pid=$(tr -d '[:space:]' < "$m" 2>/dev/null || echo -)
  [ -n "$pid" ] || pid=-
  printf 'state=%s pid=%s pgid=%s rc=%s started=%s ended=%s log_bytes=%s truncations=%s truncated_total=%s\n' \
    "$(jobs_state "$id" || true)" \
    "$pid" \
    "$(jobs_read "$rec" pgid -)" \
    "$(jobs_read "$rec" rc -)" \
    "$(jobs_read "$rec" started -)" \
    "$(jobs_read "$rec" ended -)" \
    "$(stat -c %s "$rec/log" 2>/dev/null || echo 0)" \
    "$(jobs_read "$rec" truncations 0)" \
    "$(jobs_read "$rec" truncated_total 0)"
  return 0
}

# `log <id> [<offset>]`: raw bytes from <offset>, bounded to 1 MiB per call.
# `tail -c +N` is 1-BASED, so byte offset 0 is `+1` (mutant j8 is the off-by-one).
jobs_cmd_log() {
  local id="$1" off="${2:-0}" rec
  jobs_valid_id "$id" || { echo "boxup: job log: invalid id" >&2; return 2; }
  case "$off" in ''|*[!0-9]*) echo "boxup: job log: bad offset: $off" >&2; return 2 ;; esac
  rec="$(jobs_rec "$id")"
  [ -f "$rec/log" ] || return 0
  tail -c +$((off + 1)) "$rec/log" 2>/dev/null | head -c "$JOBS_LOG_FETCH_MAX"
  return 0
}

# `stop <id>`: SIGTERM the process GROUP, wait, then SIGKILL (mutant j7 skips
# the KILL). The durable pgid is used HERE and only here — signalling, never
# liveness. Idempotent on a terminal record.
jobs_cmd_stop() {
  local id="$1" rec pgid i
  jobs_valid_id "$id" || { echo "boxup: job stop: invalid id" >&2; return 2; }
  rec="$(jobs_rec "$id")"
  [ -d "$rec" ] || { echo "boxup: job stop: no record for $id" >&2; return 1; }
  if jobs_terminal "$rec"; then
    printf 'job=%s state=%s rc=%s\n' "$id" "$(jobs_state "$id" || true)" "$(jobs_read "$rec" rc -)"
    return 0
  fi
  pgid="$(jobs_read "$rec" pgid)"
  case "$pgid" in
    ''|*[!0-9]*) ;;
    *) kill -TERM -- "-$pgid" 2>/dev/null || true ;;
  esac
  i=0
  while [ "$i" -lt "$JOBS_STOP_GRACE_S" ]; do
    jobs_live "$id" || break
    sleep 1
    i=$((i + 1))
  done
  if jobs_live "$id"; then
    case "$pgid" in
      ''|*[!0-9]*) ;;
      *) kill -KILL -- "-$pgid" 2>/dev/null || true ;;
    esac
  fi
  echo 1 > "$rec/stopped" 2>/dev/null || true
  echo 143 > "$rec/rc" 2>/dev/null || true
  date +%s > "$rec/ended_epoch" 2>/dev/null || true
  date -u +%Y-%m-%dT%H:%M:%SZ > "$rec/ended" 2>/dev/null || true
  rm -f "$(jobs_marker "$id")" "$(jobs_restart_state "$id")" 2>/dev/null || true
  [ "$(jobs_slot_id 2>/dev/null || true)" = "$id" ] && jobs_slot_release
  log "job: stopped id=$id rc=143"
  printf 'job=%s state=stopped rc=143\n' "$id"
  return 0
}

jobs_cmd_ls() {
  local d id
  [ -d "$JOBS_DIR" ] || return 0
  for d in "$JOBS_DIR"/*; do
    [ -d "$d" ] || continue
    id="${d##*/}"
    jobs_valid_id "$id" || continue
    printf 'id=%s state=%s kind=%s rc=%s started=%s ended=%s\n' \
      "$id" "$(jobs_state "$id" || true)" "$(jobs_read "$d" kind -)" \
      "$(jobs_read "$d" rc -)" "$(jobs_read "$d" started -)" "$(jobs_read "$d" ended -)"
  done
  return 0
}

cmd_job() {
  local sub="${1:-}"
  [ $# -gt 0 ] && shift
  case "$sub" in
    start)  [ $# -ge 1 ] || { jobs_usage; return 2; }; jobs_cmd_start "$@" ;;
    status) [ $# -ge 1 ] || { jobs_usage; return 2; }; jobs_cmd_status "$1" ;;
    log)    [ $# -ge 1 ] || { jobs_usage; return 2; }; jobs_cmd_log "$1" "${2:-0}" ;;
    stop)   [ $# -ge 1 ] || { jobs_usage; return 2; }; jobs_cmd_stop "$1" ;;
    ls)     jobs_cmd_ls ;;
    prune)  jobs_prune ;;
    *)      jobs_usage; return 2 ;;
  esac
}

# --- selfheal: worker --------------------------------------------------------
# The actual tick body. Runs under the converge lock (via run_tick).
do_tick() {
  # Freeze checks first — they need the OLD heartbeat.
  if pgrep -x tailscaled >/dev/null 2>&1; then
    maybe_wake_recycle || true
    recycle_offline_tailscaled || true
  else
    start_tailscaled || true
  fi
  # Write hb immediately after the checks: a slow recycle above must not leave
  # a stale hb for the next tick to mistake for another freeze.
  date +%s > "$RUN_DIR/hb" 2>/dev/null || true

  ensure_forwarding || true
  ensure_nat || true

  # FLEET-BRAIN §1: supervise the out-of-band reverse tunnel every tick, like
  # tailscaled/sshd. Unconfigured ([fleet].vps unset) is a silent no-op, so an
  # un-enrolled box is unaffected. Runs regardless of the check-repair backoff
  # (the tunnel is liveness the brain needs even while a box is unhealthy).
  supervise_tunnel || true

  # P1-1 (H12, unified): the tick's health probe IS `check_reason` — the SINGLE
  # health predicate, so the tick and `boxup check` can never diverge. If any
  # predicate fails, run the FULL do_ensure_body under this tick's lock (stop
  # hand-picking which repair a tick may run: the tick's job is "if not
  # converged, converge"). A persistently UNSATISFIABLE predicate is bounded by
  # the SAME backoff shape as refresh (20→60→180→600s cap) with `repair=failing:N`
  # in status and a log line naming the reason — never a blind fixed loop. The
  # freeze/recycle above stays: it handles sleep/thaw liveness that check can't
  # express, and it must run every tick regardless of the backoff window.
  local reason
  reason="$(check_reason)"
  if [ -n "$reason" ]; then
    local fails window now last
    fails=$(repair_fail_count)
    window=$(refresh_backoff_window "$fails")
    now=$(date +%s); last=0
    [ -f "$RUN_DIR/last-repair" ] && last=$(tr -d '[:space:]' < "$RUN_DIR/last-repair" 2>/dev/null || echo 0)
    case "$last" in ''|*[!0-9]*) last=0 ;; esac
    if [ "$last" -gt 0 ] && [ $((now - last)) -lt "$window" ]; then
      log "tick: unhealthy (reason=$reason) but repair backing off (window=${window}s fails=${fails})" >&2
    else
      log "tick: unhealthy (reason=$reason) — running full do_ensure_body under the lock" >&2
      echo "$now" > "$RUN_DIR/last-repair" 2>/dev/null || true
      do_ensure_body || true
      # Re-evaluate: a cleared predicate resets the backoff, a persistent one
      # stretches it (bounded, visible via repair=failing:N in status).
      if [ -n "$(check_reason)" ]; then
        fails=$((fails + 1))
        echo "$fails" > "$RUN_DIR/fail.repair" 2>/dev/null || true
        window=$(refresh_backoff_window "$fails")
        log "tick: still unhealthy after repair (consecutive=${fails}, next window=${window}s)" >&2
      else
        echo 0 > "$RUN_DIR/fail.repair" 2>/dev/null || true
      fi
    fi
  else
    # Healthy: reset the repair backoff and do the cheap idempotent maintenance.
    echo 0 > "$RUN_DIR/fail.repair" 2>/dev/null || true
    case "$(read_box_name || true)" in
      grok-box-[0-9]*)
        pgrep -x tailscaled >/dev/null 2>&1 && refresh_exitnode || true
        ;;
    esac
  fi
  date +%s > "$RUN_DIR/hb" 2>/dev/null || true
}

# P1-1: consecutive tick-repair failures (a persistently UNSATISFIABLE check
# predicate). Reuses refresh_backoff_window (20→60→180→600s). Ephemeral run-dir
# state (resets free on reboot/recycle), like fail.refresh.
repair_fail_count() {
  local n=0
  [ -f "$RUN_DIR/fail.repair" ] && \
    n=$(tr -d '[:space:]' < "$RUN_DIR/fail.repair" 2>/dev/null || echo 0)
  case "$n" in ''|*[!0-9]*) n=0 ;; esac
  echo "$n"
}

# run_tick: take the converge lock with flock -n (skip on contention). A tick
# that loses the lock to an in-progress converge MUST still stamp hb before
# returning 0 (B1 — a converge in progress IS liveness; otherwise a long
# `boxup once` starves hb and the next tick spuriously recycles tailscaled).
run_tick() {
  local rc
  # boxup-disk-guard G1: the guard runs OUTSIDE the converge lock and BEFORE
  # the tick body. Outside, because a tick that loses the lock to an in-progress
  # converge returns early and must still be watching the disk. Before, because
  # do_tick's check_reason should see the space the guard just freed instead of
  # failing the box on a condition the same tick already fixed.
  disk_guard || true
  # boxup-keepawake K2: the keep-awake guard runs in the same place and for the
  # same reason — outside the converge lock (a tick that skips on contention
  # must still keep the box awake) and before the tick body. It is rate-limited
  # to [keepawake].interval_min internally, so calling it every 15 s is free.
  keepawake_guard || true
  # grokfleet-jobs J9: the job supervisor runs in the SAME place and for the
  # same reason — outside the converge lock, because a tick that skips on
  # contention must still restart a dead service, bound a runaway log and reap
  # a stale slot. It always returns 0.
  jobs_guard || true
  run_with_converge_lock try do_tick
  rc=$?
  if [ "$rc" = 200 ]; then
    log "tick: converge already running — skipping (stamping hb for liveness)"
    date +%s > "$RUN_DIR/hb" 2>/dev/null || true
  fi
  return 0
}

# True iff argv is `bash <path>/boxup worker` (or a legacy v4 selfheal worker).
# Never match `bash -c ...`: flattened cmdline greps used to SIGTERM agent
# shells that merely mentioned the name.
is_worker_proc() {
  local pid="$1" arg have_script=0 have_worker=0 have_c=0
  [ -r "/proc/$pid/cmdline" ] || return 1
  while IFS= read -r -d '' arg; do
    case "$arg" in
      -c) have_c=1 ;;
      worker|--worker) have_worker=1 ;;
      *boxup|*tailscale-selfheal.sh) have_script=1 ;;
    esac
  done < "/proc/$pid/cmdline" 2>/dev/null || return 1
  [ "$have_c" = 0 ] && [ "$have_script" = 1 ] && [ "$have_worker" = 1 ]
}

# shellcheck disable=SC2120  # optional $1 (keep-pid) reserved for callers
stop_workers() {
  local keep="${1:-}" pid i leftover
  for pid in $(pgrep -x bash 2>/dev/null || true); do
    [ "$pid" = "$$" ] && continue
    [ -n "$keep" ] && [ "$pid" = "$keep" ] && continue
    is_worker_proc "$pid" || continue
    log "selfheal: stopping worker pid=$pid"
    kill "$pid" 2>/dev/null || true
  done
  i=0
  while [ "$i" -lt 15 ]; do
    leftover=0
    for pid in $(pgrep -x bash 2>/dev/null || true); do
      [ "$pid" = "$$" ] && continue
      [ -n "$keep" ] && [ "$pid" = "$keep" ] && continue
      is_worker_proc "$pid" || continue
      leftover=1
      kill -9 "$pid" 2>/dev/null || true
    done
    [ "$leftover" = 0 ] && break
    sleep 0.2; i=$((i + 1))
  done
}

worker_loop() {
  local trc
  ensure_dirs
  echo $$ > "$WORKER_PID"
  echo "boxup-worker v$BOXUP_VERSION pid=$$ interval=$INTERVAL freeze=${FREEZE_SECS}s" >> "$WORKER_LOG"
  while true; do
    # P1: capture and surface the tick rc instead of a blanket `|| true`.
    # run_tick is designed to return 0 (B1: a skipped tick is liveness), so a
    # NON-zero here means run_tick itself errored unexpectedly — log it rather
    # than discard it silently. Never break the loop (the self-heal must keep
    # ticking past a transient failure — D8 `set -u` not blanket `set -e`).
    run_tick >> "$WORKER_LOG" 2>&1
    trc=$?
    [ "$trc" -ne 0 ] && log "worker: run_tick returned rc=$trc (unexpected; loop continues)" >> "$WORKER_LOG" 2>&1
    if [ "$(wc -c < "$WORKER_LOG" 2>/dev/null || echo 0)" -gt 10485760 ]; then
      : > "$WORKER_LOG"
    fi
    sleep "$INTERVAL"
  done
}

start_daemon() {
  ensure_dirs
  # Always reap leftovers and start one worker from THIS file; a pidfile hit
  # once kept an old version's worker in memory next to a newer install.
  stop_workers
  rm -f "$WORKER_PID"
  # F7/P0-A: route the worker spawn through spawn_detached too. Currently benign
  # (start_daemon runs at top level, after the lock subshell has exited) but it
  # is one refactor away from being bug #7 again if start_daemon is ever called
  # from under the converge lock — one helper, no special cases.
  spawn_detached "" env BOX_SETUP_ROOT="$ROOT" bash "$SELF" worker
  local i=0
  while [ "$i" -lt 15 ]; do
    if [ -f "$WORKER_PID" ] && kill -0 "$(cat "$WORKER_PID" 2>/dev/null)" 2>/dev/null; then
      break
    fi
    sleep 0.2; i=$((i + 1))
  done
  log "selfheal: started pid=$(cat "$WORKER_PID" 2>/dev/null || echo '?')"
}

stop_daemon() {
  local old
  if [ -f "$WORKER_PID" ]; then
    old=$(cat "$WORKER_PID" 2>/dev/null || echo "")
    [ -n "$old" ] && kill "$old" 2>/dev/null || true
    rm -f "$WORKER_PID"
  fi
  stop_workers
  log "selfheal: stopped (tailscaled left running)"
}

# --- status ------------------------------------------------------------------
# The installed git sha, stamped by install.sh into $ROOT/GIT_SHA. "unknown"
# when absent (an old-format box, or a source tree with no .git at install
# time). Never fails.
boxup_git_sha() {
  local s=""
  [ -f "$ROOT/GIT_SHA" ] && s=$(tr -d '[:space:]' < "$ROOT/GIT_SHA" 2>/dev/null || true)
  [ -n "$s" ] || s="unknown"
  printf '%s' "$s"
}

print_status() {
  local sshd=down ts_pid sh_pid="" hb=- v4 v6 name now last
  v4=$(tr -d '[:space:]' < /proc/sys/net/ipv4/ip_forward 2>/dev/null || echo 0)
  v6=$(tr -d '[:space:]' < /proc/sys/net/ipv6/conf/all/forwarding 2>/dev/null || echo 0)
  ts_pid=$(pgrep -n -x tailscaled 2>/dev/null || echo "")
  if [ -f "$WORKER_PID" ]; then
    sh_pid=$(tr -d '[:space:]' < "$WORKER_PID")
    kill -0 "$sh_pid" 2>/dev/null || sh_pid=""
  fi
  if [ -f "$RUN_DIR/hb" ]; then
    now=$(date +%s)
    last=$(tr -d '[:space:]' < "$RUN_DIR/hb" 2>/dev/null || echo 0)
    case "$last" in ''|*[!0-9]*) last=0 ;; esac
    [ "$last" -gt 0 ] && hb="$((now - last))s"
  fi
  pgrep -x sshd >/dev/null 2>&1 && sshd=up
  read_ts_fields
  name="$(read_box_name || true)"

  local vstr
  vstr="$BOXUP_VERSION/$(boxup_git_sha)"
  printf 'backend=%s online=%s exit-node=%s sshd=%s ipfwd=4:%s,6:%s tailscaled=%s selfheal=%s worker=%s hb=%s name=%s v=%s' \
    "${backend:-unknown}" "${online:-no}" "${exitn:-no}" "$sshd" "$v4" "$v6" \
    "${ts_pid:--}" "${sh_pid:--}" "${sh_pid:--}" "$hb" "${name:--}" "$vstr"
  # D3 (#10): node identity, ALWAYS shown (not only on failure). tags = the
  # device's current Self.Tags (or `none`); keyexpiry = `disabled` when the
  # KeyExpiry field is absent (F1), else the RFC3339 timestamp.
  printf ' tags=%s keyexpiry=%s' \
    "${ts_tags:-none}" "$([ -n "${ts_keyexpiry:-}" ] && printf '%s' "$ts_keyexpiry" || printf 'disabled')"
  # refresh backoff visibility (D4): surface a persistently failing refresh only
  # at N>=3 consecutive failures, so a healthy box's status line is unchanged.
  local rf
  rf=$(refresh_fail_count)
  [ "$rf" -ge 3 ] && printf ' refresh=failing:%s' "$rf"
  # P1-1: a persistently unsatisfiable tick-repair predicate is bounded by the
  # same backoff as refresh; surface it at N>=1 so an unhealthy-but-backing-off
  # box is visible (unlike refresh, ANY repair failure is worth showing).
  local rp
  rp=$(repair_fail_count)
  [ "$rp" -ge 1 ] && printf ' repair=failing:%s' "$rp"
  [ -n "${auth:-}" ] && printf ' auth=%s' "$auth"
  # H11: surface auth-key expiry (warn/expired only; ok/none stay silent so a
  # healthy box's status line is unchanged).
  local akx
  akx="$(authkey_expiry_state)"
  case "$akx" in
    warn)    printf ' authkey=expiring:%s' "$(tr -d '[:space:]' < "$AUTHKEY_EXPIRES" 2>/dev/null)" ;;
    expired) printf ' authkey=EXPIRED:%s' "$(tr -d '[:space:]' < "$AUTHKEY_EXPIRES" 2>/dev/null)" ;;
    unknown) printf ' authkey=unknown-expiry' ;;
  esac
  # FLEET-BRAIN §1: the reverse-tunnel state. unconfigured (silent for legacy
  # readers is fine, but the brain reads this field) | up | down.
  # D3: tunnelfail= rides alongside it, ALWAYS (0 when the counter file is
  # absent) — a box parked on the tunnel backoff ladder was previously invisible
  # from the status line, which is how the grok-box-005 stray went unnoticed.
  # `check` stays OK on tunnelfail alone; this is visibility, not a predicate.
  printf ' tunnel=%s tunnelfail=%s' "$(tunnel_state)" "$(tunnel_fail_count)"
  # boxup-disk-guard G3: root-disk pressure, appended AFTER tunnel= so nothing
  # that already parses this line moves. grokfleet's status.ts tokenizes on `k=v`
  # and drops unknown keys, and splitVersion only ever reads v=, so every
  # existing consumer is untouched by construction.
  printf ' disk=%s' "$(disk_status_token)"
  # boxup-keepawake K4: four tokens appended AFTER disk=, for the same reason
  # disk= was appended after tunnel= — nothing that already parses this line
  # moves. grokfleet's status.ts tokenizes on `k=v` and drops unknown keys, so
  # every existing consumer is untouched by construction.
  printf ' %s' "$(keepawake_status_tokens)"
  # grokfleet-jobs J9: two tokens appended LAST, for the same reason disk= and
  # the keepawake four were appended after what came before them — nothing that
  # already parses this line moves, and grokfleet's status.ts tokenizes on `k=v`
  # and drops unknown keys.
  printf ' %s' "$(jobs_status_tokens)"
  printf '\n'
}

# --- check: the single health predicate (D6) ---------------------------------
# `boxup check`: exit 0 iff the box is healthy, else exit 1 printing
# `check=FAIL reason=<first-failed-predicate>`. On success prints
# `check=OK ` + the normal status line. This is THE definition of "healthy";
# fleetctl and D7 rollout verification delegate to it instead of reimplementing
# health parsing laptop-side.
#
# check MUST NEVER exit 2 — exit 2 is the unknown-subcommand dispatch arm and
# is fleetctl's "old boxup" signal (B2). A check bug emitting 2 would silently
# downgrade a new fleetctl to the legacy status parse. Every failure here is
# exit 1; the dispatch arm below runs do_check and translates its rc to 0/1.
do_check() {
  local reason
  reason="$(check_reason)"
  if [ -n "$reason" ]; then
    echo "check=FAIL reason=$reason"
    return 1
  fi
  printf 'check=OK '
  print_status
  return 0
}

# check_reason: the SINGLE health predicate, factored out so BOTH `boxup check`
# and the worker tick (P1-1) use the exact same list — no parallel/forked
# predicate set can drift. Prints the first-failed-predicate string (empty ⇒
# healthy). Read-only apart from the once/hour unknown-expiry warn. Cost: one
# read_ts_fields (ts status --json + python), one advertised_routes (ts debug
# prefs + python) only on the happy path, passwd -S x1-2, a few pgrep — ~2
# tailscale calls, well within a 15s tick (measured acceptable; if a future
# tailscale makes status slow, cache it, do NOT fork the list).
check_reason() {
  local reason="" v4 v6 hb_secs now last ts_count pid cmd routes
  v4=$(tr -d '[:space:]' < /proc/sys/net/ipv4/ip_forward 2>/dev/null || echo 0)
  v6=$(tr -d '[:space:]' < /proc/sys/net/ipv6/conf/all/forwarding 2>/dev/null || echo 0)
  read_ts_fields

  # Predicates in order; first failure wins.
  if [ -z "$reason" ] && [ "${backend:-}" != Running ]; then
    reason="backend=${backend:-unknown} (want Running)"
  fi
  if [ -z "$reason" ] && [ "${online:-no}" != yes ]; then
    reason="online=${online:-no} (want yes)"
  fi
  # H13 (P1-4): the name postcondition has TWO failure modes.
  #   * rejoin/wrong-name: file says grok-box-N but live Self.HostName differs
  #     (e.g. `cursor` after an auth-key rejoin) — name_mismatch.
  #   * fresh/unnamed: no grok-box-N frozen yet while backend=Running with peers
  #     visible — the box SHOULD have picked a name by now; `name=-` is NOT
  #     healthy. (We gate on peers so a lone first node isn't failed forever.)
  if [ -z "$reason" ] && name_mismatch; then
    if [ "$NAME_MISMATCH_KIND" = dns ]; then
      reason="name: dns=$NAME_MISMATCH_LIVE want=$NAME_MISMATCH_FILE"
    else
      reason="name: live=$NAME_MISMATCH_LIVE want=$NAME_MISMATCH_FILE"
    fi
  fi
  if [ -z "$reason" ]; then
    case "$(read_box_name || true)" in
      grok-box-[0-9]*) ;;
      *) has_peers && reason="name: unnamed" ;;
    esac
  fi
  # D3 (#10): node identity — tags present + node-key expiry disabled. Placed
  # after name (identity before services) and before sshd. Uses the ts_tags /
  # ts_keyexpiry already populated by the read_ts_fields above (F2: no second
  # status call). `want` is the config-resolved first-login tags (absent key ⇒
  # tag:grok-box default; present-empty ⇒ untagged-by-choice, both predicates
  # skip). WARN-class in status but FAIL in check (the brain keys on check).
  if [ -z "$reason" ]; then
    local _idreason
    _idreason="$(verify_node_identity "$(resolved_config_tags)")"
    [ -n "$_idreason" ] && reason="$_idreason"
  fi
  if [ -z "$reason" ] && ! pgrep -x sshd >/dev/null 2>&1; then
    reason="sshd=down (want up)"
  fi
  # H7 (P0): sshd running is not a working login. Verify the login accounts
  # actually have a usable password — the resurrection-path invariant.
  # D8: `box` is THE login account; a MISSING box account is a FAILURE, not a
  # skip (the old `id box && ...` silently passed a box with no box account).
  if [ -z "$reason" ] && ! id box >/dev/null 2>&1; then
    reason="login: box account missing"
  fi
  if [ -z "$reason" ] && ! account_unlocked box; then
    reason="account box=locked (sshd up but no usable login)"
  fi
  if [ -z "$reason" ] && id root >/dev/null 2>&1 && ! account_unlocked root; then
    reason="account root=locked (sshd up but no usable login)"
  fi
  # H12: sshd up + accounts unlocked is still not a working login without host
  # keys on disk (box-8 Stage 1 wiped them). Same file ensure_host_keys treats
  # as the presence marker, so "present" means sshd can start with OUR identity.
  if [ -z "$reason" ] && ! host_keys_present; then
    reason="host keys missing (/etc/ssh/ssh_host_ed25519_key)"
  fi
  if [ -z "$reason" ] && { [ "$v4" != 1 ] || [ "$v6" != 1 ]; }; then
    reason="ipfwd=4:${v4},6:${v6} (want 4:1,6:1)"
  fi
  if [ -z "$reason" ]; then
    # Exactly one tailscaled bound to the workspace statedir.
    ts_count=0
    for pid in $(pgrep -x tailscaled 2>/dev/null || true); do
      cmd=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)
      echo "$cmd" | grep -q -- "$STATE_DIR" && ts_count=$((ts_count + 1))
    done
    if [ "$ts_count" != 1 ]; then
      reason="tailscaled=${ts_count} on statedir (want exactly 1)"
    fi
  fi
  if [ -z "$reason" ]; then
    # Worker alive with a fresh heartbeat (< FREEZE_SECS).
    if [ ! -f "$WORKER_PID" ] || \
       ! kill -0 "$(tr -d '[:space:]' < "$WORKER_PID" 2>/dev/null)" 2>/dev/null; then
      reason="worker=dead (want alive)"
    else
      hb_secs=-1
      if [ -f "$RUN_DIR/hb" ]; then
        now=$(date +%s)
        last=$(tr -d '[:space:]' < "$RUN_DIR/hb" 2>/dev/null || echo 0)
        case "$last" in ''|*[!0-9]*) last=0 ;; esac
        [ "$last" -gt 0 ] && hb_secs=$((now - last))
      fi
      if [ "$hb_secs" -lt 0 ] || [ "$hb_secs" -ge "$FREEZE_SECS" ]; then
        reason="hb=${hb_secs}s (want < ${FREEZE_SECS}s)"
      fi
    fi
  fi
  if [ -z "$reason" ]; then
    # Exit-node advertised (ExitNodeOption + both default routes present).
    if [ "${exitn:-no}" != yes ]; then
      reason="exit-node=${exitn:-no} (want yes)"
    else
      routes="$(advertised_routes)"
      if ! echo "$routes" | grep -q '0.0.0.0/0' || ! echo "$routes" | grep -q '::/0'; then
        reason="exit-node routes missing 0.0.0.0/0 or ::/0"
      fi
    fi
  fi
  # boxup-disk-guard G3: root-disk pressure.
  # FAIL is a real health failure, not cosmetics — a full root overlay is what
  # made install.sh exit 1 on grok-box-006 and stalled the rollout — so it flips
  # the check rc like every other predicate here, and the brain's existing
  # reachable-cannot-converge row raises the alert with no brain-side change.
  # Placed after the service/exit-node predicates so a box that is ALSO offline
  # still reports the more fundamental fault first.
  # WARN is not a failure, but it is not silent either: once per hour, the same
  # shape as the H11 unknown-expiry warn. The tick calls check_reason every 15s,
  # so an unthrottled warn would be 240 lines an hour in the worker log.
  local disk_pct disk_lvl
  disk_pct=$(disk_used_pct)
  disk_lvl=$(disk_level "$disk_pct")
  if [ -z "$reason" ] && [ "$disk_lvl" = fail ]; then
    reason="disk ${disk_pct}% (after truncation) want < ${BOXUP_DISK_FAIL_PCT}%"
  fi
  if [ "$disk_lvl" = warn ]; then
    local dwnow dwlast
    dwnow=$(date +%s); dwlast=0
    [ -f "$DISK_WARN_STAMP" ] && dwlast=$(tr -d '[:space:]' < "$DISK_WARN_STAMP" 2>/dev/null || echo 0)
    case "$dwlast" in ''|*[!0-9]*) dwlast=0 ;; esac
    if [ $((dwnow - dwlast)) -ge 3600 ]; then
      echo "$dwnow" > "$DISK_WARN_STAMP" 2>/dev/null || true
      log "check: WARN disk ${disk_pct}% (>= ${BOXUP_DISK_WARN_PCT}% warn threshold; the guard truncates the allowlist at ${BOXUP_DISK_FAIL_PCT}%)" >&2
    fi
  fi
  # H11: an EXPIRED auth key means the box's only unattended recovery path is
  # dead — it is not healthy, it just hasn't needed to recover yet. Fail check.
  # (A key expiring soon is a WARNING surfaced in status, not a check failure.)
  # D6: an UNKNOWN expiry (missing/unparseable .expires sidecar) is NOT a FAIL
  # — the key may be valid, we just can't prove it — but it is NOT silent
  # either: WARN once per hour so a never-seeded sidecar stays visible.
  local akx_check
  akx_check="$(authkey_expiry_state)"
  if [ -z "$reason" ] && [ "$akx_check" = expired ]; then
    reason="authkey EXPIRED ($(tr -d '[:space:]' < "$AUTHKEY_EXPIRES" 2>/dev/null)) — unattended recovery path is dead"
  fi
  if [ "$akx_check" = unknown ]; then
    local uxlog now_u last_u
    uxlog="$RUN_DIR/last-authkey-unknown.log"
    now_u=$(date +%s); last_u=0
    [ -f "$uxlog" ] && last_u=$(tr -d '[:space:]' < "$uxlog" 2>/dev/null || echo 0)
    case "$last_u" in ''|*[!0-9]*) last_u=0 ;; esac
    if [ $((now_u - last_u)) -ge 3600 ]; then
      echo "$now_u" > "$uxlog" 2>/dev/null || true
      log "check: WARN authkey expiry unknown ($AUTHKEY_EXPIRES missing or unparseable) — seed it (see docs/AGENT.md §A); key may still be valid, not failing check" >&2
    fi
  fi
  printf '%s' "$reason"
}


# ensure_path_symlink: keep /usr/local/bin/boxup pointing at $ROOT/boxup.
#
# install.sh creates this link (bug-triage (6)), but it lives in /usr and an
# image swap wipes everything outside /workspace — so after a thaw the link is
# gone while $ROOT/boxup is still there, and install.sh does not run again
# until the next rollout. Without this step a swapped box spends hours or days
# with no `boxup` on PATH. That is exactly why ensure_sshd and the host-key
# restore live in converge too: converge is what rebuilds the parts of a box
# that do not survive a swap.
#
# Idempotent and SILENT on the happy path — this runs on every converge, so a
# link already aimed at the right target is left alone with no log line. It
# acts only when the link is missing, points elsewhere, or is not a symlink at
# all (an old copy sitting at that path is "points elsewhere" too; `ln -sfn`
# replaces it, and -n keeps it from being created INSIDE an existing link's
# directory). Always returns 0: a read-only /usr costs the convenience link,
# never the converge.
#
# BOX_SETUP_PREFIX roots the LINK for tests. install.sh calls the same knob
# PREFIX, mirroring vps/install-vps.sh; boxup namespaces it like every other
# boxup knob (BOX_SETUP_ROOT/RUN/LOG/CONFIG) because boxup is a long-lived
# daemon that inherits whatever an operator shell exports, and a bare PREFIX is
# a common variable in build environments. The link TARGET is never prefixed.
# It is honoured IN-PROCESS only: require_root does not forward it across the
# sudo re-exec and the worker spawn does not carry it, so it cannot leak from
# an operator's shell into a real converge. A test never needs root anyway.
ensure_path_symlink() {
  local dir link want
  dir="${BOX_SETUP_PREFIX:-}/usr/local/bin"
  link="$dir/boxup"
  want="$ROOT/boxup"
  if [ -L "$link" ] && [ "$(readlink "$link" 2>/dev/null || true)" = "$want" ]; then
    return 0
  fi
  if mkdir -p "$dir" 2>/dev/null && ln -sfn "$want" "$link" 2>/dev/null; then
    log "converge: linked $link -> $want"
    return 0
  fi
  log "converge: could not link $link -> $want (read-only /usr?) — use $want directly" >&2
  return 0
}

# --- converge ----------------------------------------------------------------
# The converge body. Runs under the converge lock (via do_ensure).
# P1: previously every member was bare or `|| true`, so a converge reported
# success even if every step failed — invisibly. We now run each step through
# _ensure_step, which logs a non-zero rc and records a `degraded` marker under
# $RUN_DIR. The function's RETURN SEMANTICS ARE UNCHANGED (callers depend on
# do_ensure_body not failing a tick): it still returns 0 regardless. The marker
# and per-step logs are the visibility; they do not gate convergence. A clean
# converge clears the marker.
DEGRADED_MARKER="$RUN_DIR/degraded"

# _ensure_step <label> <fn>: run <fn>, log its rc if non-zero, set the degraded
# flag (shell var `_degraded`) so the body can stamp the marker. Never aborts.
_ensure_step() {
  local label="$1" fn="$2" rc
  "$fn"; rc=$?
  if [ "$rc" -ne 0 ]; then
    log "converge: step '$label' rc=$rc (converge continues, marking degraded)" >&2
    _degraded=1
  fi
  return 0
}

do_ensure_body() {
  local _degraded=0
  ensure_dirs
  # D1/D8: hoist the [managed].enabled gate ONCE per converge so config_get
  # honours the managed layer uniformly and the "ignored" notice fires at most
  # once. Default true (managed layer on). When a managed.toml is present but
  # the operator has set `[managed] enabled = false` in config.toml, log the
  # escape hatch exactly once per converge (D8).
  MANAGED_ENABLED="$(config_get_file "$CONFIG_FILE" managed enabled || echo true)"
  [ -n "$MANAGED_ENABLED" ] || MANAGED_ENABLED=true
  if [ "$MANAGED_ENABLED" != true ] && [ -f "$MANAGED_FILE" ]; then
    log "converge: managed.toml ignored by local config ([managed] enabled=$MANAGED_ENABLED)"
  fi
  _ensure_step packages       ensure_packages
  _ensure_step tailscale-bin  ensure_tailscale_bin
  _ensure_step sshd           ensure_sshd
  # bug-triage (6): /usr/local/bin/boxup does not survive an image swap, and
  # install.sh only runs on a rollout. Restore it here, next to the other
  # things a swap wipes.
  _ensure_step path-link      ensure_path_symlink
  _ensure_step forwarding     ensure_forwarding
  _ensure_step tailscaled     start_tailscaled
  wait_for_socket || true
  _ensure_step login          ensure_login
  _ensure_step name           ensure_name
  _ensure_step nat            ensure_nat
  _ensure_step refresh        refresh_exitnode
  # FLEET-BRAIN §1: generate the per-box tunnel key on first converge (so
  # enroll can read the .pub over the tailnet) and supervise the reverse tunnel.
  # Both are no-ops when already keyed / unconfigured — an un-enrolled box is
  # unaffected.
  _ensure_step tunnel-key     ensure_tunnel_key
  _ensure_step tunnel         supervise_tunnel
  # boxup-keepawake K5: nothing to install — the only converge-time act is
  # writing the jumps baseline ONCE, when it is absent.
  _ensure_step keepawake      keepawake_converge
  # Visibility only — does NOT change the return code (callers depend on a tick
  # not being failed by a degraded converge). A clean pass clears the marker.
  if [ "$_degraded" = 1 ]; then
    date +%s > "$DEGRADED_MARKER" 2>/dev/null || true
  else
    rm -f "$DEGRADED_MARKER" 2>/dev/null || true
  fi
  return 0
}

# do_ensure: take the converge lock with flock -w 60 (bounded WAIT, never
# skip — `boxup once` is AGENT.md's remedy for nearly every symptom, so a tick
# holding the lock must delay converge, not fake it out). H3: if the lock
# cannot be taken within the window we do NOT converge unlocked — do_ensure
# returns non-zero (201) so `boxup once`/`up`/`ensure` surface a hard error
# rather than silently faking a converge. ensure_dirs runs BEFORE we open the
# lock file (CONVERGE_LOCK lives in RUN_DIR).
do_ensure() {
  local rc
  ensure_dirs
  run_with_converge_lock wait do_ensure_body
  rc=$?
  if [ "$rc" = 201 ]; then
    log "converge: could NOT take the converge lock (busy > 60s) — converge SKIPPED, not faked (H3). Retry, or check for a stuck converge/tailscale_set." >&2
  fi
  return "$rc"
}

do_update() {
  local url tmp
  url="$(config_get update repo || echo "$DEFAULT_REPO_URL")"
  have git || { log "update: git missing" >&2; return 1; }
  tmp="$(mktemp -d)" || return 1
  log "update: cloning $url"
  if git clone --depth 1 "$url" "$tmp/repo" >/dev/null 2>&1; then
    BOX_SETUP_ROOT="$ROOT" bash "$tmp/repo/install.sh"
    rm -rf "$tmp"
    log "update: installed $(cat "$ROOT/VERSION" 2>/dev/null || echo '?') — run: boxup once"
  else
    rm -rf "$tmp"
    log "update: clone failed" >&2
    return 1
  fi
}

# D4 (#10): true (0) iff at least one tailscaled is running bound to our
# statedir. Factored out of cmd_retag so it is stubbable in tests and mirrors
# the check_reason tailscaled-count predicate (same NUL-split cmdline match).
tailscaled_on_statedir() {
  local pid cmd
  for pid in $(pgrep -x tailscaled 2>/dev/null || true); do
    cmd=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)
    echo "$cmd" | grep -q -- "$STATE_DIR" && return 0
  done
  return 1
}

# D4 (#10): `boxup retag` — operator remediation for a box that registered
# untagged and/or with node-key expiry enabled (issue #10). Idempotent: it
# re-authenticates the node WITH the resolved config tags so Tailscale disables
# key expiry (tagging AT AUTH TIME is the only path that does — key-expiry
# docs). NOT automatic: converge/tick NEVER retag (a key that cannot mint the
# tag would loop-fail every hour — the #9 re-auth-churn hazard); converge only
# REPORTS via the D3 check predicate.
#
# F5: reuses run_reauth_up (the SAME flag builder ensure_login's re-auth uses)
# with REAUTH_TAGS_OVERRIDE, rather than hand-rolling a second `up` array (the
# #9 bug). F6: exit codes — no seeded auth key -> 3, resolved tags empty -> 4,
# tailscaled not running -> 5, post-verify still failing -> 6, success -> 0.
# It never uses exit 2 (that is the unknown-subcommand / "old boxup" signal).
# On a failed `up` tailscale refuses BEFORE changing prefs, so the node is left
# as it was (no rollback code needed); the exit-6 path DID change prefs (the up
# succeeded) but verify still failed — that is surfaced, not described as
# "untouched".
cmd_retag() {
  local b tags before_tags before_kx after_reason rc
  b="$(tailscale_bin)"

  # Precondition: a seeded auth key. retag re-auths with --auth-key=file:<key>;
  # without it we cannot complete unattended (F6: exit 3).
  if [ ! -s "$AUTHKEY_FILE" ]; then
    log "retag: ERROR no seeded auth key at $AUTHKEY_FILE — retag needs a tag-capable reusable key (see docs/AGENT.md §A/§G)" >&2
    return 3
  fi

  # Precondition: resolvable, non-empty tags (F6: exit 4). retag introduces the
  # tag, so an empty resolution (tags = "") is a no-op we refuse loudly.
  tags="$(resolved_config_tags)"
  if [ -z "$tags" ]; then
    log "retag: ERROR resolved tags are empty ([tailscale] tags = \"\") — nothing to retag with; set a tag first" >&2
    return 4
  fi

  # Precondition: tailscaled running on our statedir (F6: exit 5). A retag with
  # no daemon just churns; refuse honestly.
  if ! tailscaled_on_statedir; then
    log "retag: ERROR tailscaled is not running on $STATE_DIR — start it (boxup once) then retry" >&2
    return 5
  fi

  # Before snapshot (single parser pass; also feeds verify below implicitly
  # after the up refreshes it).
  read_ts_fields
  before_tags="${ts_tags:-none}"
  before_kx="$([ -n "${ts_keyexpiry:-}" ] && printf '%s' "$ts_keyexpiry" || printf 'disabled')"
  log "retag: before tags=$before_tags keyexpiry=$before_kx — re-authenticating with tags=$tags"

  # F5: reuse run_reauth_up with the tag override so the resolved config tags
  # are INTRODUCED at re-auth (an operator action). This is the one place tags
  # are legitimately introduced on a --force-reauth `up`.
  REAUTH_TAGS_OVERRIDE="$tags" run_reauth_up "retag (operator)" \
    --auth-key="file:$AUTHKEY_FILE"; rc=$?
  if [ "$rc" -ne 0 ]; then
    log "retag: tailscale up --force-reauth FAILED rc=$rc — node prefs unchanged (tailscale refuses before applying); see the error above" >&2
    return 6
  fi

  # Post-verify (F1/F2): re-read the single parser, then run the shared
  # identity predicate. exit 0 only if BOTH tags present AND expiry disabled.
  read_ts_fields
  after_reason="$(verify_node_identity "$tags")"
  local after_tags after_kx
  after_tags="${ts_tags:-none}"
  after_kx="$([ -n "${ts_keyexpiry:-}" ] && printf '%s' "$ts_keyexpiry" || printf 'disabled')"
  log "retag: after tags=$after_tags keyexpiry=$after_kx"
  if [ -n "$after_reason" ]; then
    log "retag: post-verify STILL FAILING: $after_reason — the seeded key is likely not tag-capable (mint a tagged, pre-authorized, reusable key; see docs/AGENT.md §D5/§G)" >&2
    return 6
  fi
  log "retag: OK tags=$after_tags keyexpiry=$after_kx"
  return 0
}

# require_root: re-exec under sudo when we are not root, carrying the knobs that
# change behaviour with us. The disk-guard five are forwarded because they are a
# DOCUMENTED env interface (README): without them here, `BOXUP_DISK_FAIL_PCT=1
# boxup once` from a normal shell re-execs without the variable and silently
# does nothing — the r1 gate flagged exactly that. They are forwarded as their
# already-resolved values (the assignments run at load time, above), so an
# operator's deliberate empty value survives instead of being re-defaulted.
# BOXUP_GATEWAY_URL/BOXUP_GATEWAY_JSON (boxup-keepawake K6) ride along for the
# same reason: they are the documented seams a gate points at a canary gateway,
# and losing them at the re-exec would silently aim the guard back at the real
# one.
#
# Security: this grants no new authority. Anyone who can run `sudo boxup` on
# these boxes already has passwordless root and can truncate anything directly;
# and the guard still truncates only allowlisted, non-symlink, regular files
# over the floor, AS THEIR OWNER, never as root.
require_root() {
  if [ "$(id -u)" -ne 0 ]; then
    if have sudo; then
      exec sudo env BOX_SETUP_ROOT="$ROOT" \
        BOX_SETUP_CONFIG="${BOX_SETUP_CONFIG:-}" \
        BOX_SETUP_RUN="${BOX_SETUP_RUN:-}" \
        BOX_SETUP_JOBS="${BOX_SETUP_JOBS:-}" \
        BOX_SETUP_LOG="${BOX_SETUP_LOG:-}" \
        BOX_SSH_PASSWORD="${BOX_SSH_PASSWORD:-}" \
        BOXUP_FORCE_REFRESH="${BOXUP_FORCE_REFRESH:-}" \
        BOXUP_DISK_WARN_PCT="$BOXUP_DISK_WARN_PCT" \
        BOXUP_DISK_FAIL_PCT="$BOXUP_DISK_FAIL_PCT" \
        BOXUP_DISK_TRUNCATE_MIN_BYTES="$BOXUP_DISK_TRUNCATE_MIN_BYTES" \
        BOXUP_DISK_INTERVAL="$BOXUP_DISK_INTERVAL" \
        DISK_GUARD_TRUNCATE="$DISK_GUARD_TRUNCATE" \
        BOXUP_GATEWAY_URL="$BOXUP_GATEWAY_URL" \
        BOXUP_GATEWAY_JSON="$BOXUP_GATEWAY_JSON" \
        bash "$SELF" "$@"
    fi
    log "boxup: need root" >&2
    exit 1
  fi
}

usage() { sed -n '4,18p' "$0"; }

cmd="${1:-up}"
case "$cmd" in
  once|--once)
    require_root once
    # H3: if do_ensure could not take the converge lock (rc=201), surface it as
    # a non-zero exit so the hourly automation sees a failed converge instead of
    # a faked-success. Still run the tick + status for visibility.
    do_ensure; _once_rc=$?
    start_daemon
    run_tick
    print_status
    # Propagate a busy converge lock (201) so hourly automation sees a failed
    # converge; a clean run must exit 0 explicitly. Without this, the trailing
    # `[ … = 201 ]` test would be the arm's last status and a healthy converge
    # (_once_rc=0) would make `boxup once` exit 1 (no set -e). (P2-2, 5.2.0)
    if [ "$_once_rc" = 201 ]; then exit "$_once_rc"; fi
    exit 0
    ;;
  ensure|--ensure)
    require_root ensure
    do_ensure   # propagates rc (201 = lock busy, converge NOT faked — H3)
    ;;
  up|--up|"")
    require_root up
    do_ensure; _up_rc=$?
    start_daemon
    print_status
    # Same trailing-conditional trap as `once`: exit 0 on the clean path, only
    # propagate a busy converge lock (201). (P2-2, 5.2.0)
    if [ "$_up_rc" = 201 ]; then exit "$_up_rc"; fi
    exit 0
    ;;
  tick|--tick)
    require_root tick
    run_tick
    ;;
  status|--status)
    print_status
    ;;
  check|--check)
    # Read-only health gate. Delegate to do_check; force the exit code into
    # {0,1} so a bug can never surface as 2 (B2: 2 = "old boxup" to fleetctl).
    if do_check; then exit 0; else exit 1; fi
    ;;
  stop|--stop)
    require_root stop
    stop_daemon
    ;;
  update|--update)
    require_root update
    do_update
    ;;
  worker|--worker)
    worker_loop
    ;;
  job|--job)
    # grokfleet-jobs J9. Needs root: the wrapper is a detached root process and
    # the marker lives under $RUN_DIR.
    require_root "$@"
    shift
    cmd_job "$@"; exit $?
    ;;
  job-wrapper)
    # INTERNAL, like `boxup worker`. NEVER invoked by a human and never through
    # a shell: this argv shape is what is_job_wrapper_proc identifies, and it is
    # the only reason the brain's own `boxup job status <id>` poll for the SAME
    # id cannot be mistaken for the job itself.
    if [ $# -lt 2 ]; then
      echo "boxup: job-wrapper: need a job id" >&2
      exit 2
    fi
    job_wrapper_main "$2"; exit $?
    ;;
  version|--version)
    echo "boxup $BOXUP_VERSION"
    ;;
  config-get|--config-get)
    # D1/D5: read-only probe of the LOCAL config.toml value (never the managed
    # layer). Used by the brain's push_managed status line so brain and boxup
    # can never disagree on the TOML grammar. Prints the value, exit 1 if unset.
    if [ $# -lt 3 ]; then
      echo "boxup: usage: config-get <table> <key>" >&2
      exit 1
    fi
    if v="$(config_get_file "$CONFIG_FILE" "$2" "$3")"; then
      printf '%s\n' "$v"
      exit 0
    fi
    exit 1
    ;;
  retag|--retag)
    # D4 (#10): operator remediation — re-auth WITH the resolved config tags so
    # Tailscale disables node-key expiry. Exit codes (F6): 3 no key, 4 tags
    # empty, 5 tailscaled down, 6 post-verify still failing, 0 success. NEVER 2.
    require_root retag
    cmd_retag; exit $?
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "boxup: unknown command: $cmd" >&2
    usage >&2
    exit 2
    ;;
esac


