#!/bin/bash
# boxup — turn a Grok sand box into a self-healing Tailscale exit node.
#
# One file, one copy, installed at /workspace/box-setup/boxup. Everything the
# old scripts/ tree did lives here as subcommands:
#
#   boxup once      full converge + health tick + status   (hourly contract)
#   boxup ensure    full converge only
#   boxup up        converge + start the selfheal worker   (default)
#   boxup tick      one health tick (sysctl / nft / refresh / procs)
#   boxup status    one-line health string
#   boxup check     health gate: exit 0 healthy / 1 unhealthy (never 2)
#   boxup retag     re-auth WITH config tags to disable node-key expiry (#10)
#   boxup stop      stop the selfheal worker (tailscaled stays up)
#   boxup update    fresh clone from GitHub + reinstall (never git pull)
#   boxup worker    internal: the selfheal loop
#   boxup job       start|status|log|stop|ls|prune an ad-hoc or long-lived job
#   boxup job-wrapper  internal: the supervised body of ONE job
#
# Environment contract (see docs/DESIGN.md): Debian in a Cursor sand container,
# PID 1 is tini, no systemd, no cron. The box sleeps when idle and the whole
# overlay (/etc, /usr, processes, nft rules, /etc/shadow, ssh host keys) is
# wiped on image swap. Only /workspace is expected back. An external hourly
# automation runs `box-bootstrap.sh --once` (a shim onto `boxup once`); that is
# the resurrection path. Between runs, the worker loop heals sleep/thaw.
#
# House rules, learned the hard way — keep them:
#   * never pkill -f (agent -c processes mentioning our names get killed)
#   * never `tailscale up` after first login (it clobbers unmentioned prefs);
#     always `tailscale set` with the full flag list
#   * exactly one tailscaled, bound to the /workspace statedir
#   * NoState right after daemon start is not NeedsLogin — wait, don't mint
set -u

BOXUP_VERSION=5.5.1

# The box user's PATH lacks /usr/sbin; nft, sshd and friends live there.
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
umask 022

# --- layout ------------------------------------------------------------------
# ROOT is always /workspace/box-setup unless BOX_SETUP_ROOT says otherwise.
# No checkout auto-detection: a dev tree must opt in explicitly, so a stray
# clone can never silently become the live root.
ROOT="${BOX_SETUP_ROOT:-/workspace/box-setup}"
SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"

STATE_DIR="$ROOT/state/tailscale"
STATE_FILE="$STATE_DIR/tailscaled.state"
SSH_STATE_DIR="$ROOT/state/ssh"
HOSTNAME_FILE="$ROOT/hostname"
SECRETS_DIR="$ROOT/secrets"
AUTHKEY_FILE="$SECRETS_DIR/ts-authkey"
# H11: optional sidecar recording the auth key's expiry (single ISO date
# YYYY-MM-DD). Tailscale keys expire (<=90d) and the date is NOT recoverable
# from the key itself, so it must be recorded next to it. Missing/unparseable
# WHILE a key exists => status authkey=unknown-expiry + a once/hour check WARN
# (D6, not silent, not a FAIL); absent ts-authkey entirely => none (no warn).
AUTHKEY_EXPIRES="$SECRETS_DIR/ts-authkey.expires"
BIN_DIR="$ROOT/bin"
CONFIG_FILE="${BOX_SETUP_CONFIG:-$ROOT/config.toml}"

# FLEET-BRAIN §config-truth (D1): the brain-managed config file. Written ONLY
# by the VPS brain over the reverse tunnel (fleetctl push_managed); hand edits
# are overwritten on the next reconcile. Lives under /workspace (like
# config.toml) so it survives an image swap; mode 600 root. Precedence per key:
# env override (where one exists) > managed.toml > config.toml > baked default.
# Missing managed.toml == today's behaviour exactly (zero-diff for un-managed
# fleets). The `[managed] enabled = false` gate in config.toml turns the whole
# managed layer off locally (D8).
MANAGED_FILE="${BOX_SETUP_MANAGED:-$ROOT/managed.toml}"

# FLEET-BRAIN (docs/FLEET-BRAIN.md §1): the out-of-band reverse-SSH tunnel key
# + supervision state. The per-box ed25519 key lives under /workspace so it
# survives an image swap; it authenticates THIS box's tunnel to the VPS. The
# box generates it on first converge if absent (enroll reads the .pub over the
# tailnet). Tunnel supervision is a NO-OP unless [fleet].vps is configured, so
# an un-enrolled box is completely unaffected. (TUNNEL_PID/TUNNEL_LOG depend on
# RUN_DIR/LOG_DIR, set below.)
TUNNEL_KEY="$SECRETS_DIR/tunnel_ed25519"
TUNNEL_PUB="$SECRETS_DIR/tunnel_ed25519.pub"

RUN_DIR="${BOX_SETUP_RUN:-/run/box-setup}"
LOG_DIR="${BOX_SETUP_LOG:-/var/log}"
WORKER_PID="/run/tailscale-selfheal.pid"
WORKER_LOG="$LOG_DIR/boxup-worker.log"
TAILSCALED_LOG="$LOG_DIR/tailscaled.log"
TS_SOCK="/var/run/tailscale/tailscaled.sock"

# FLEET-BRAIN reverse-tunnel supervision state (see TUNNEL_KEY above).
TUNNEL_PID="$RUN_DIR/tunnel.pid"
TUNNEL_LOG="$LOG_DIR/boxup-tunnel.log"

# Two flock-guarded critical sections. Since H1 (iter3 hotfix) the converge
# lock uses flock --close semantics — the body runs with the lock fd CLOSED for
# it and every descendant — so the historical "which fd, and does the child
# close it" hazard is gone by construction. The fds:
#   * fd 9 -> CONVERGE_LOCK     converge mutual exclusion (D3): an OUTER subshell
#                               holds fd 9 for the body's whole duration; the
#                               body runs in an INNER subshell with `9<&-` so
#                               neither it nor any descendant inherits the lock.
#                               run_tick takes it `flock -n 9` (skip-on-
#                               contention — a converge in progress is itself
#                               liveness); do_ensure/`boxup once` takes it
#                               `flock -w 60 9` (bounded WAIT). H3: we NEVER run
#                               the body unlocked — a timeout/open-failure is a
#                               hard skip (tick) or non-zero (once), not an
#                               unlocked run.
#   * fd 9 -> START_LOCK        the tailscaled fork window inside start_tailscaled,
#                               in ITS OWN subshell (the converge body has fd 9
#                               closed, so this fresh fd 9 does not collide).
#                               spawn_detached closes fd 8 and fd 9 on the child
#                               as belt-and-braces defense-in-depth.
# fd 8 is no longer a converge-lock fd (it was, pre-hotfix); spawn_detached
# still closes it so a legacy daemon's inherited fd 8 is never propagated
# further.
START_LOCK="/run/tailscaled.start.lock"
# F1(b): the converge lock path is VERSIONED (v2). A pre-H1 daemon that inherited
# the OLD converge.lock fd (the #7 wedge) can NEVER wedge a v2 boxup, because a
# v2 tick flocks a DIFFERENT file — decoupled by construction, independent of
# whether the E1 install migration fired. Bump this suffix again if a future
# change must guarantee non-interference with an older running daemon.
CONVERGE_LOCK="$RUN_DIR/converge.v2.lock"

DEFAULT_SSH_PASSWORD="12345678"
DEFAULT_TS_VERSION="1.102.3"
DEFAULT_REPO_URL="https://github.com/chaogebaba/grok-box-setup.git"
# D1 (#10): the code default for the FIRST-LOGIN advertise-tags. A config
# [tailscale] tags key that is ABSENT resolves to this value, so a box
# registers TAGGED + node-key-expiry-disabled by default. A key that is PRESENT
# but empty (`tags = ""`) is a deliberate untagged opt-out and is honoured as-is
# — present-empty is distinct from absent. See resolved_config_tags().
DEFAULT_TS_TAGS="tag:grok-box"

INTERVAL="${BOXUP_INTERVAL:-${SELFHEAL_INTERVAL:-15}}"
FREEZE_SECS="${BOXUP_FREEZE_SECS:-${SELFHEAL_FREEZE_SECS:-60}}"
RECYCLE_COOLDOWN="${BOXUP_RECYCLE_COOLDOWN:-${SELFHEAL_RECYCLE_COOLDOWN:-120}}"
SET_MIN_INTERVAL="${MIN_INTERVAL:-20}"
WORKER_STARTED=$(date +%s)

log() { echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] $*"; }
have() { command -v "$1" >/dev/null 2>&1; }

# --- converge lock (D3, H1) --------------------------------------------------
# Serialize converge across `boxup once`, the worker tick, and a rollout.
#
# H1 (iter3 hotfix): the lock now uses flock --close semantics — the body runs
# with NO lock descriptor exposed to it OR any descendant. We open the lock on
# fd 9 in an OUTER subshell that holds the flock for the body's whole duration,
# then run the body in an INNER subshell with `9<&-` so neither the body nor
# anything it spawns inherits the fd. This makes the #7 fd-inheritance bug
# STRUCTURALLY IMPOSSIBLE for any new daemon, regardless of whether a given
# spawn site remembered to close the fd. It also retires the entire /proc/locks
# stale-holder detector + 5-skip break that the dual gate proved cannot work:
# with boxup's real leak shape (a subshell takes `flock -n`, spawns a detached
# child, then EXITS) /proc/locks records the EXITED helper's pid (e.g. 445980),
# NOT the inheriting daemon (445981) — so the holder reads "?", the counter
# resets, and the break never fires. flock --close removes the need for it.
#
#   mode = "wait" -> flock -w 60  (do_ensure / `boxup once`: bounded WAIT).
#   mode = "try"  -> flock -n     (run_tick: skip on contention).
#
# H3: mutual exclusion is now GUARANTEED — we NEVER run the body unlocked.
#   * cannot open the lock file: try -> skip (200); wait -> fail (201).
#   * wait-mode timeout: fail (201), never proceed unlocked.
#   * try-mode contention: skip (200), after attempting the transitional
#     legacy-daemon recovery below.
# Return code: 200 = try-mode contended (caller stamps hb and skips);
#   201 = could not take the lock in wait mode (caller surfaces a hard error);
#   otherwise the exit status of <fn>.
run_with_converge_lock() {
  local mode="$1" fn="$2" rc
  if ! have flock; then
    # D2: no flock ⇒ we CANNOT guarantee mutual exclusion, so we REFUSE rather
    # than run the body unlocked (an unlocked converge/tick defeats D3 and can
    # race a concurrent one). install.sh asserts util-linux flock exists, so
    # this is a broken-install guard, not an expected path.
    log "converge-lock: flock not found (util-linux required) — REFUSING to run unlocked (D2)" >&2
    case "$mode" in try) return 200 ;; *) return 201 ;; esac
  fi
  (
    if ! { exec 9>"$CONVERGE_LOCK"; } 2>/dev/null; then
      # H3: cannot open the lock file. We do NOT run unlocked anymore.
      # Note: do NOT write `exec 9>&- 2>/dev/null` — an exec with no command
      # makes the 2>/dev/null permanent and swallows the log below. fd 9 was
      # never opened, so no close is needed.
      log "converge-lock: cannot open $CONVERGE_LOCK — refusing to run unlocked (H3)" >&2
      case "$mode" in try) exit 200 ;; *) exit 201 ;; esac
    fi
    case "$mode" in
      try)
        if ! flock -n 9; then
          # Contended. Since H1 (flock --close) a NEW daemon can no longer wedge
          # the lock, so genuine contention is another live boxup converge —
          # skip. (Legacy pre-H1 wedges are handled ONCE at upgrade time by the
          # install.sh migration, not by any runtime detector — see E1: two
          # rounds of a runtime detector were proven inert, and a one-time
          # migration is one-shot by nature, not a per-tick job.)
          exit 200
        fi
        ;;
      *)
        if ! flock -w 60 9; then
          # H3: wait-mode timeout. NEVER run the body unlocked (the old code
          # did, defeating mutual exclusion). Surface a hard failure instead.
          log "converge-lock: could not acquire within 60s — NOT running unlocked (H3)" >&2
          exit 201
        fi
        ;;
    esac
    # H1: run the body with the lock fd CLOSED for it and every descendant.
    # The outer subshell keeps fd 9 (and thus the flock) until it exits.
    ( "$fn" ) 9<&-
  )
  rc=$?
  return "$rc"
}

# E1: a runtime legacy-wedge detector was tried for two rounds and DELETED — it
# was proven inert twice (`stat` without -L stats the /proc/PID/fd symlink not
# its target; then it re-picked the daemon via `pgrep -n` instead of the found
# pid; and its $STATE_DIR match was a substring, so `$STATE_DIR-other` counted
# as ours). A runtime detector for a ONE-TIME migration is the wrong shape.
# Pre-H1 wedges are cleared ONCE, at upgrade, by the migration in install.sh
# (stop the old worker; kill only a tailscaled whose argv carries the exact
# `--statedir=$STATE_DIR` token; the normal `boxup once` then restarts it via
# the flock --close path). Nothing runs in a tick.

# --- config.toml -------------------------------------------------------------
# A TOML subset, read with awk so it works before python3 is installed.
# Handles [table] headers, "basic" and 'literal' strings, bare values and
# # comments. See etc/config.example.toml for exactly what is supported.
read -r -d '' _BOX_TOML_AWK <<'AWK' || true
function trim(s) { sub(/^[ \t\r]+/, "", s); sub(/[ \t\r]+$/, "", s); return s }
{
  line = trim($0)
  if (line == "" || line ~ /^#/) next
  if (line ~ /^\[.*\]$/) { sec = trim(substr(line, 2, length(line) - 2)); next }
  eq = index(line, "=")
  if (eq == 0) next
  if (sec != want_t || trim(substr(line, 1, eq - 1)) != want_k) next
  v = trim(substr(line, eq + 1))
  if (substr(v, 1, 1) == "\"") {
    out = ""; i = 2; n = length(v)
    while (i <= n) {
      c = substr(v, i, 1)
      if (c == "\\" && i < n) {
        d = substr(v, i + 1, 1)
        if (d == "n") out = out "\n"
        else if (d == "t") out = out "\t"
        else out = out d
        i += 2; continue
      }
      if (c == "\"") break
      out = out c; i++
    }
    print out; found = 1; exit
  }
  if (substr(v, 1, 1) == "'") {
    rest = substr(v, 2)
    q = index(rest, "'")
    if (q > 0) rest = substr(rest, 1, q - 1)
    print rest; found = 1; exit
  }
  h = index(v, "#")
  if (h > 0) v = trim(substr(v, 1, h - 1))
  print v; found = 1; exit
}
END { exit(found ? 0 : 1) }
AWK

# config_get_file <file> <table> <key> -> prints value, non-zero when unset.
# The single awk reader, invoked on an EXPLICIT file. FIRST match in the wanted
# table wins (the awk exits at the first hit). This is the only reader; the two
# public wrappers below layer file precedence on top of it.
config_get_file() {
  [ -f "$1" ] || return 1
  awk -v want_t="$2" -v want_k="$3" "$_BOX_TOML_AWK" "$1" 2>/dev/null
}

# MANAGED_ENABLED: the hoisted [managed].enabled gate (D1). Set once per
# converge by do_ensure_body so the log line (D8) fires at most once. Default
# "true" — the managed layer is on unless config.toml explicitly disables it.
# A tick/subcommand that reads config before the hoist still behaves correctly:
# the wrapper below re-reads the gate lazily when MANAGED_ENABLED is unset.
MANAGED_ENABLED=""

# config_get <table> <key> -> prints value, non-zero when unset.
# Two-file precedence (D1): if the managed layer is enabled AND managed.toml
# exists AND the key is found there, that value wins; otherwise fall back to
# today's config.toml lookup. FIRST-match-per-file semantics are unchanged.
# Missing managed.toml == config.toml-only behaviour exactly.
config_get() {
  local en="$MANAGED_ENABLED"
  # Lazy gate read for callers outside a converge (e.g. `boxup status`), so we
  # never spuriously honour a disabled managed layer. Empty default => true.
  if [ -z "$en" ]; then
    en="$(config_get_file "$CONFIG_FILE" managed enabled || echo true)"
    [ -n "$en" ] || en=true
  fi
  if [ "$en" = true ] && [ -f "$MANAGED_FILE" ]; then
    local mv
    if mv="$(config_get_file "$MANAGED_FILE" "$1" "$2")"; then
      printf '%s' "$mv"
      echo
      return 0
    fi
  fi
  config_get_file "$CONFIG_FILE" "$1" "$2"
}

# Password applied to root and box. Precedence: BOX_SSH_PASSWORD env >
# config.toml [ssh].password > default. chpasswd takes one user:password line;
# anything that cannot survive that round trip would set an unknown password
# and lock the box out, so refuse it and keep the documented default.
ssh_password() {
  local p=""
  if [ -n "${BOX_SSH_PASSWORD:-}" ]; then
    p="$BOX_SSH_PASSWORD"
  else
    p="$(config_get ssh password || true)"
  fi
  case "$p" in
    "") p="$DEFAULT_SSH_PASSWORD" ;;
    *[![:print:]]*)
      log "config: [ssh] password is not printable; using default" >&2
      p="$DEFAULT_SSH_PASSWORD"
      ;;
  esac
  printf '%s' "$p"
}

# H7 (P0): true (0) iff account <user> exists AND has a USABLE password (not
# locked, not empty). `passwd -S <user>` prints "<user> <status> ..." where the
# status field is P (usable), L (locked), or NP (no password). Only P is a
# working login. Prefer passwd -S; fall back to parsing /etc/shadow field 2
# (a locked entry starts with ! or *, an empty field means no password). Used
# by `boxup check` so a box that is sshd=up but has locked accounts (the image
# ships them locked, /etc/shadow dies on swap) reports UNHEALTHY, not OK.
account_unlocked() {
  local user="$1" st hash
  id "$user" >/dev/null 2>&1 || return 1
  if have passwd; then
    st="$(passwd -S "$user" 2>/dev/null | awk '{print $2}')"
    case "$st" in
      P) return 0 ;;
      L|NP) return 1 ;;
    esac
    # Unknown/empty status output — fall through to the shadow check.
  fi
  if [ -r /etc/shadow ]; then
    hash="$(awk -F: -v u="$user" '$1==u{print $2}' /etc/shadow 2>/dev/null)"
    case "$hash" in
      ''|'!'*|'*'*) return 1 ;;   # empty / locked
      *) return 0 ;;
    esac
  fi
  return 1   # cannot prove it is unlocked → treat as not-unlocked (fail-safe)
}

# H12: the LOGIN postcondition, probed CHEAPLY (read-only: passwd -S + one
# stat, NO chpasswd / keygen). do_tick historically only restarted a DEAD sshd.
# H12: at least one host key on disk — /etc/ssh/ssh_host_ed25519_key, the SAME
# file ensure_host_keys treats as the presence marker, so "present" means "sshd
# can start with OUR persisted identity", not "some file exists". A check_reason
# predicate (P1-1): the tick and `boxup check` both catch wiped host keys
# (box-8 Stage 1) and repair via do_ensure_body → ensure_sshd.
host_keys_present() {
  [ -s /etc/ssh/ssh_host_ed25519_key ]
}

# H11: classify the seeded auth key's expiry from $AUTHKEY_EXPIRES (a single
# ISO date YYYY-MM-DD). Prints exactly one of:
#   none    — no auth key present at all ($AUTHKEY_FILE absent). A box run via
#             the AuthURL dance legitimately has no key; do NOT warn about the
#             expiry of a key that does not exist. (P2-7)
#   unknown — a key EXISTS but $AUTHKEY_EXPIRES is missing/unreadable/unparseable.
#             D6: NOT silent — status shows authkey=unknown-expiry and check
#             WARNs once/hour — but NOT a FAIL (the key may be valid; an
#             unattended box must not fail for a sidecar the operator hasn't
#             seeded yet).
#   ok      — expires in > 7 days
#   warn    — expires within 7 days (inclusive), not yet past
#   expired — the date is in the past
# Warn window = 7 days. Honest rationale: it is one weekly operator pass of
# margin — nothing authoritative backs a specific number (Tailscale's own
# KeyExpirationNotice defaults to 24h, which is far too short for an unattended
# fleet with a weekly human cadence). 14d produced a fortnight of steady-state
# noise for no added recoverability; 7d is the smallest window a weekly pass
# reliably catches. Days compared at UTC granularity. One mechanism; both
# `boxup check` and `boxup status` consume it.
authkey_expiry_state() {
  local raw exp_epoch now_epoch days
  # P2-7: no key => none (no warning; URL-dance boxes are legitimate).
  [ -s "$AUTHKEY_FILE" ] || { echo none; return 0; }
  [ -f "$AUTHKEY_EXPIRES" ] || { echo unknown; return 0; }
  raw="$(tr -d '[:space:]' < "$AUTHKEY_EXPIRES" 2>/dev/null || true)"
  case "$raw" in
    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
    *) echo unknown; return 0 ;;   # unparseable => unknown (not silent)
  esac
  exp_epoch="$(date -u -d "$raw" +%s 2>/dev/null || true)"
  case "$exp_epoch" in ''|*[!0-9]*) echo unknown; return 0 ;; esac
  now_epoch="$(date -u +%s)"
  if [ "$now_epoch" -ge "$exp_epoch" ]; then echo expired; return 0; fi
  days=$(( (exp_epoch - now_epoch) / 86400 ))
  if [ "$days" -lt 7 ]; then echo warn; else echo ok; fi
}

# --- tailscale binaries ------------------------------------------------------
tailscale_bin() {
  if [ -x "$BIN_DIR/tailscale" ]; then echo "$BIN_DIR/tailscale"; return; fi
  command -v tailscale 2>/dev/null || echo tailscale
}

tailscaled_bin() {
  if [ -x "$BIN_DIR/tailscaled" ]; then echo "$BIN_DIR/tailscaled"; return; fi
  command -v tailscaled 2>/dev/null || echo /usr/sbin/tailscaled
}

ts() { timeout "${TS_TIMEOUT:-8}" "$(tailscale_bin)" "$@"; }

ensure_dirs() {
  mkdir -p "$STATE_DIR" "$SSH_STATE_DIR" "$SECRETS_DIR" "$BIN_DIR" \
    "$RUN_DIR" "$LOG_DIR" /var/run/tailscale /run/sshd 2>/dev/null || true
  chmod 700 "$ROOT/state" "$STATE_DIR" "$SSH_STATE_DIR" "$SECRETS_DIR" \
    2>/dev/null || true
}

# --- tailscaled state --------------------------------------------------------
state_is_populated() {
  [ -f "$STATE_FILE" ] || return 1
  # The state file is JSON with a "_machinekey" entry once a login happened.
  # Prefer checking that; fall back to the old >=1KB size heuristic when the
  # file is unreadable or python3 is missing.
  if [ -r "$STATE_FILE" ] && have python3; then
    python3 - "$STATE_FILE" <<'PY' 2>/dev/null && return 0 || return 1
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    sys.exit(0 if any(k.startswith("_machinekey") for k in d) else 1)
except Exception:
    sys.exit(2)
PY
  fi
  local n
  n="$( { wc -c < "$STATE_FILE" || sudo sh -c 'wc -c < "$1"' _ "$STATE_FILE"; } 2>/dev/null \
    | tr -d '[:space:]' )"
  case "$n" in ''|*[!0-9]*) n=0 ;; esac
  [ "$n" -ge 1024 ]
}

read_box_name() {
  [ -s "$HOSTNAME_FILE" ] && tr -d '[:space:]' < "$HOSTNAME_FILE"
}

# --- status parsing ----------------------------------------------------------
# One parser for everything. Prints newline-separated key=value pairs:
#   backend= online= exitn= mapfail= fwdhealth= routes= auth= tags= keyexpiry=
ts_fields() {
  ts status --json 2>/dev/null | python3 -c '
import json, sys
out = {"backend": "", "online": "no", "exitn": "no", "mapfail": "no",
       "fwdhealth": "no", "routes": "", "auth": "", "tags": "", "keyexpiry": ""}
try:
    d = json.load(sys.stdin)
    s = d.get("Self") or {}
    health = " ".join(str(x) for x in (d.get("Health") or []))
    h = health.lower()
    out["backend"] = str(d.get("BackendState") or "")
    out["online"] = "yes" if s.get("Online") else "no"
    out["exitn"] = "yes" if s.get("ExitNodeOption") else "no"
    out["mapfail"] = "yes" if ("coordination server" in h
                               or "not-in-map-poll" in h
                               or "pollnetmap" in h
                               or "out of sync" in h) else "no"
    out["fwdhealth"] = "yes" if "forward" in h else "no"
    out["auth"] = (d.get("AuthURL") or "").replace("\n", " ").strip()
    # #10 (D3/F2): tags the device CURRENTLY carries (Self.Tags), comma-joined.
    out["tags"] = ",".join(str(x) for x in (s.get("Tags") or []))
    # #10 (D3/F1): node-key expiry. A node with expiry DISABLED omits KeyExpiry
    # entirely; an enabled node carries an RFC3339 timestamp. Emit the RAW
    # string (empty when the field is absent ⇒ expiry disabled).
    out["keyexpiry"] = str(s.get("KeyExpiry") or "").strip()
except Exception:
    pass
for k, v in out.items():
    print(f"{k}={v}")
' 2>/dev/null || true
}

read_ts_fields() {
  backend=""; online="no"; exitn="no"; mapfail="no"; fwdhealth="no"; auth=""
  ts_tags=""; ts_keyexpiry=""
  while IFS= read -r line; do
    case "$line" in
      backend=*)   backend="${line#backend=}" ;;
      online=*)    online="${line#online=}" ;;
      exitn=*)     exitn="${line#exitn=}" ;;
      mapfail=*)   mapfail="${line#mapfail=}" ;;
      fwdhealth=*) fwdhealth="${line#fwdhealth=}" ;;
      auth=*)      auth="${line#auth=}" ;;
      tags=*)      ts_tags="${line#tags=}" ;;
      keyexpiry=*) ts_keyexpiry="${line#keyexpiry=}" ;;
    esac
  done <<EOF
$(ts_fields)
EOF
}

advertised_routes() {
  ts debug prefs 2>/dev/null | python3 -c '
