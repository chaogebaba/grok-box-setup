#!/bin/bash
# boxup — turn a Grok sand box into a self-healing Tailscale exit node.
#
# One file, one copy, installed at /workspace/box-setup/boxup. Everything the
# old scripts/ tree did lives here as subcommands:
#
#   boxup once      full converge + health tick + status   (hourly contract)
#   boxup ensure    full converge only
#   boxup up        converge + start the selfheal worker   (default)
#   boxup tick      one health tick (sysctl / nft / refresh / procs)
#   boxup status    one-line health string
#   boxup check     health gate: exit 0 healthy / 1 unhealthy (never 2)
#   boxup stop      stop the selfheal worker (tailscaled stays up)
#   boxup update    fresh clone from GitHub + reinstall (never git pull)
#   boxup worker    internal: the selfheal loop
#
# Environment contract (see docs/DESIGN.md): Debian in a Cursor sand container,
# PID 1 is tini, no systemd, no cron. The box sleeps when idle and the whole
# overlay (/etc, /usr, processes, nft rules, /etc/shadow, ssh host keys) is
# wiped on image swap. Only /workspace is expected back. An external hourly
# automation runs `box-bootstrap.sh --once` (a shim onto `boxup once`); that is
# the resurrection path. Between runs, the worker loop heals sleep/thaw.
#
# House rules, learned the hard way — keep them:
#   * never pkill -f (agent -c processes mentioning our names get killed)
#   * never `tailscale up` after first login (it clobbers unmentioned prefs);
#     always `tailscale set` with the full flag list
#   * exactly one tailscaled, bound to the /workspace statedir
#   * NoState right after daemon start is not NeedsLogin — wait, don't mint
set -u

BOXUP_VERSION=5.1.0

# The box user's PATH lacks /usr/sbin; nft, sshd and friends live there.
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
umask 022

# --- layout ------------------------------------------------------------------
# ROOT is always /workspace/box-setup unless BOX_SETUP_ROOT says otherwise.
# No checkout auto-detection: a dev tree must opt in explicitly, so a stray
# clone can never silently become the live root.
ROOT="${BOX_SETUP_ROOT:-/workspace/box-setup}"
SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"

STATE_DIR="$ROOT/state/tailscale"
STATE_FILE="$STATE_DIR/tailscaled.state"
SSH_STATE_DIR="$ROOT/state/ssh"
HOSTNAME_FILE="$ROOT/hostname"
SECRETS_DIR="$ROOT/secrets"
AUTHKEY_FILE="$SECRETS_DIR/ts-authkey"
BIN_DIR="$ROOT/bin"
CONFIG_FILE="${BOX_SETUP_CONFIG:-$ROOT/config.toml}"

RUN_DIR="${BOX_SETUP_RUN:-/run/box-setup}"
LOG_DIR="${BOX_SETUP_LOG:-/var/log}"
WORKER_PID="/run/tailscale-selfheal.pid"
WORKER_LOG="$LOG_DIR/boxup-worker.log"
TAILSCALED_LOG="$LOG_DIR/tailscaled.log"
TS_SOCK="/var/run/tailscale/tailscaled.sock"

# Two flock-guarded critical sections, each on its OWN fd (flock keys on the
# open-file-description, and holding two different fds to two different files
# in the SAME process never conflict, but reusing one fd across nested
# subshells does — so keep them distinct and documented together):
#   * fd 9 -> START_LOCK        the tailscaled fork window (start_tailscaled,
#                               taken in a subshell so it releases the instant
#                               the fork returns; the daemon child closes fd 9).
#   * fd 8 -> CONVERGE_LOCK     converge mutual exclusion (D3): run_tick takes
#                               it with `flock -n` (skip-on-contention — a
#                               converge in progress is itself liveness), while
#                               do_ensure/`boxup once` takes it with `flock -w
#                               60` (bounded WAIT — `boxup once` is AGENT.md's
#                               remedy for nearly every symptom and must not be
#                               silently skipped). BOTH live in a subshell (or
#                               close the fd explicitly) because `boxup once`
#                               runs do_ensure then run_tick sequentially in one
#                               process and a process-held lock would deadlock.
#                               Fail-open: if the lock file cannot be opened the
#                               guarded work still runs (the lock is an
#                               optimization against duplicate work, never a
#                               gate on convergence).
START_LOCK="/run/tailscaled.start.lock"
CONVERGE_LOCK="$RUN_DIR/converge.lock"

DEFAULT_SSH_PASSWORD="12345678"
DEFAULT_TS_VERSION="1.102.3"
DEFAULT_REPO_URL="https://github.com/chaogebaba/grok-box-setup.git"

INTERVAL="${BOXUP_INTERVAL:-${SELFHEAL_INTERVAL:-15}}"
FREEZE_SECS="${BOXUP_FREEZE_SECS:-${SELFHEAL_FREEZE_SECS:-60}}"
RECYCLE_COOLDOWN="${BOXUP_RECYCLE_COOLDOWN:-${SELFHEAL_RECYCLE_COOLDOWN:-120}}"
SET_MIN_INTERVAL="${MIN_INTERVAL:-20}"
WORKER_STARTED=$(date +%s)

log() { echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] $*"; }
have() { command -v "$1" >/dev/null 2>&1; }

# --- converge lock stale-holder detection (F7 / #7) --------------------------
# The converge skip counter is ephemeral run-dir bookkeeping (like fail.refresh
# / offline-ticks), NOT persistent identity — it must reset free on reboot /
# fresh RUN_DIR, so it lives under $RUN_DIR, never $STATE_DIR. (Brief said
# "$STATE_DIR"; that dir holds the tailscale identity and survives image swaps
# — a stale skip counter there would outlive the daemon that caused it. Using
# $RUN_DIR matches every other counter and DESIGN.md's ephemeral-bookkeeping
# rule.)
CONVERGE_SKIP_COUNT="$RUN_DIR/converge-skip.count"
CONVERGE_STALE_BREAK_AFTER=5   # consecutive non-boxup skips before we break

converge_skip_count_read() {
  local n=0
  [ -f "$CONVERGE_SKIP_COUNT" ] && \
    n=$(tr -d '[:space:]' < "$CONVERGE_SKIP_COUNT" 2>/dev/null || echo 0)
  case "$n" in ''|*[!0-9]*) n=0 ;; esac
  echo "$n"
}

converge_skip_count_reset() { rm -f "$CONVERGE_SKIP_COUNT" 2>/dev/null || true; }

converge_lock_holders() {
  local target ino line lpid lino comm printed=0
  target="$(readlink -f "$CONVERGE_LOCK" 2>/dev/null || echo "$CONVERGE_LOCK")"
  [ -n "$target" ] || return 1
  [ -r /proc/locks ] || return 1
  # Inode of the lock file (device:inode in /proc/locks is MAJ:MIN:INO; we
  # match on the inode component, which is unambiguous for a single file).
  ino="$(stat -c '%i' "$target" 2>/dev/null || true)"
  case "$ino" in ''|*[!0-9]*) return 1 ;; esac
  # /proc/locks columns: "N: FLOCK ADVISORY WRITE <pid> <maj>:<min>:<ino> ..."
  while IFS= read -r line; do
    case "$line" in *FLOCK*) ;; *) continue ;; esac
    # shellcheck disable=SC2086  # deliberate word-split of the columns
    set -- $line
    lpid="$5"
    lino="${6##*:}"
    [ "$lino" = "$ino" ] || continue
    case "$lpid" in ''|*[!0-9]*) continue ;; esac
    [ "$lpid" = "$$" ] && continue        # never count our own boxup process
    [ "$lpid" = "$BASHPID" ] && continue  # nor our own lock-check subshell
    if [ -r "/proc/$lpid/comm" ]; then
      comm="$(tr -d '\0\n' < "/proc/$lpid/comm" 2>/dev/null || echo '?')"
    else
      comm='?'   # unreadable (racing/exiting pid) — caller fails SAFE
    fi
    [ -n "$comm" ] || comm='?'   # empty comm (racing pid) — also unproven
    echo "$lpid $comm"
    printed=1
  done < /proc/locks
  [ "$printed" = 1 ] || return 1
  return 0
}

# True (0) iff the converge lock is held by a process we must NOT stomp — a
# GENUINE concurrent boxup/shell, OR a holder whose comm we cannot read (a
# racing/exiting pid: we cannot PROVE it is non-boxup, so we fail SAFE and keep
# skipping rather than break). comm values that count as boxup: bash/sh/dash
# (boxup runs under a shell), "boxup" itself, or "?" (unreadable = unproven).
converge_lock_held_by_boxup() {
  local holders line comm
  holders="$(converge_lock_holders)" || return 1
  while IFS= read -r line; do
    comm="${line#* }"
    case "$comm" in
      bash|sh|dash|boxup|'?') return 0 ;;
    esac
  done <<EOF
$holders
EOF
  return 1
}

# True (0) iff there IS a holder but EVERY holder's comm is unproven ('?') —
# i.e. we could not resolve any holder pid to a readable /proc/PID/comm. This
# is the fail-safe path (treated as boxup, never broken), but it is also the
# platform-degradation signal the supervisor asked to make loud: verified
# 2026-08-28 that /proc/locks pids DO resolve inside these containers (shared
# pid namespace, tini as pid 1). If the platform ever moves the boxes into
# their own pid namespace, holders stop resolving, this returns true forever,
# and the stale-break silently no-ops — the exact invisible-regression class
# that produced #7/#8. So the caller LOGS this (once per window), never silent.
converge_lock_holder_unresolved() {
  local holders line comm any=0
  holders="$(converge_lock_holders)" || return 1   # no holder at all
  while IFS= read -r line; do
    comm="${line#* }"
    any=1
    case "$comm" in '?') ;; *) return 1 ;; esac   # a resolved holder exists
  done <<EOF
$holders
EOF
  [ "$any" = 1 ]
}

# Rate-limited (once per window) diagnostic for the unresolvable-holder
# degradation. Uses its own stamp so it never spams per-tick.
CONVERGE_UNRESOLVED_LOG="$RUN_DIR/last-unresolved-holder.log"
converge_log_unresolved_once() {
  local now last window=600
  now=$(date +%s)
  last=0
  [ -f "$CONVERGE_UNRESOLVED_LOG" ] && \
    last=$(tr -d '[:space:]' < "$CONVERGE_UNRESOLVED_LOG" 2>/dev/null || echo 0)
  case "$last" in ''|*[!0-9]*) last=0 ;; esac
  [ $((now - last)) -ge "$window" ] || return 0
  echo "$now" > "$CONVERGE_UNRESOLVED_LOG" 2>/dev/null || true
  log "tick: converge lock holder pid does not resolve to /proc/PID/comm — treating as unproven and NOT breaking (fail-safe). If this persists, the boxes may have moved into their own pid namespace and this self-heal has degraded to a no-op — investigate (verified working on grok-box-1 2026-08-28)." >&2
}

# --- converge lock (D3) ------------------------------------------------------
# Serialize converge across `boxup once`, the worker tick, and a rollout.
# run_with_converge_lock <mode> <fn>:
#   mode = "wait" -> flock -w 60 (do_ensure / `boxup once`: bounded WAIT).
#   mode = "try"  -> flock -n    (run_tick: skip on contention).
# The flock lives in a subshell so it is released the instant <fn> returns and
# never wedges the sequential do_ensure-then-run_tick path of `boxup once`.
# Fail-open: if the lock file cannot be opened (e.g. RUN_DIR absent on a fresh
# `boxup tick`), run <fn> UNLOCKED and return 0-from-fn — the lock guards
# against duplicate work, it is never a gate on convergence.
# Return code: 0 if the lock was contended in "try" mode (caller decides what
#   that means), otherwise the exit status of <fn>.
run_with_converge_lock() {
  local mode="$1" fn="$2"
  if ! have flock; then
    "$fn"; return
  fi
  (
    if ! { exec 8>"$CONVERGE_LOCK"; } 2>/dev/null; then
      # Fail-open: cannot open the lock file — log and proceed UNLOCKED (the
      # lock is an optimization against duplicate work, never a gate on
      # convergence; the blueprint requires a diagnostic here). Note: do NOT
      # write `exec 8>&- 2>/dev/null` — an exec with no command makes the
      # 2>/dev/null PERMANENT for the rest of the subshell and would swallow
      # the log line below. fd 8 was never opened, so no close is needed.
      log "converge-lock: cannot open $CONVERGE_LOCK — proceeding unlocked (fail-open)" >&2
      "$fn"
      exit
    fi
    case "$mode" in
      try)
        if ! flock -n 8; then
          # Contended. F7 (#7): distinguish a GENUINE concurrent boxup from a
          # tailscaled that inherited fd 8 and holds the converge lock for its
          # whole life. If a live boxup/shell holds it, this is real work in
          # progress — skip as before (reset the skip counter: a genuine holder
          # means the lock is NOT stale). If the holder is non-boxup
          # (tailscaled or anything else) for CONVERGE_STALE_BREAK_AFTER
          # consecutive ticks, the lock is stale — break it and run the tick
          # anyway. Fail-open: if the /proc walk errors we cannot prove the
          # holder is non-boxup, so we behave exactly as today (skip).
          if converge_lock_held_by_boxup; then
            # Either a genuine boxup/shell holder, OR an unresolvable holder
            # (fail-safe: never break on an unproven holder). If it is the
            # unresolvable case, log it once per window — a persistent
            # unresolvable holder means the platform moved the boxes into their
            # own pid namespace and this self-heal has silently degraded.
            converge_lock_holder_unresolved && converge_log_unresolved_once
            converge_skip_count_reset
            exit 200
          fi
          if converge_lock_holders >/dev/null 2>&1; then
            # Holder exists and is provably non-boxup. Count consecutive skips;
            # only break after the threshold so a brief non-boxup overlap never
            # trips it. If the counter cannot be persisted (missing/unwritable
            # $RUN_DIR), we CANNOT know this is the Nth consecutive skip, so we
            # never break — skip as today (supervisor directive: no counter =
            # no break).
            local skips holder_line
            skips=$(( $(converge_skip_count_read) + 1 ))
            if ! echo "$skips" > "$CONVERGE_SKIP_COUNT" 2>/dev/null; then
              exit 200   # cannot persist the streak → never break, just skip
            fi
            if [ "$skips" -ge "$CONVERGE_STALE_BREAK_AFTER" ]; then
              holder_line="$(converge_lock_holders 2>/dev/null | head -n1)"
              log "tick: converge lock held by non-boxup pid=${holder_line% *} comm=${holder_line#* } — stale (${skips} consecutive skips), breaking" >&2
              converge_skip_count_reset
              # Run the tick UNLOCKED. We do not hold the flock (the stale
              # holder still does, on ITS fd), but the holder is not a boxup so
              # there is no concurrent converge to collide with.
              "$fn"
              exit
            fi
            exit 200   # under threshold — skip this tick, keep counting
          fi
          # /proc walk could not identify any holder (fail-open): behave as
          # today — skip without counting.
          exit 200
        fi
        # Acquired the lock cleanly: any prior skip streak is over.
        converge_skip_count_reset
        ;;
      *)
        flock -w 60 8 || true   # bounded wait; proceed even on timeout
        ;;
    esac
    "$fn"
  )
}

# --- config.toml -------------------------------------------------------------
# A TOML subset, read with awk so it works before python3 is installed.
# Handles [table] headers, "basic" and 'literal' strings, bare values and
# # comments. See etc/config.example.toml for exactly what is supported.
read -r -d '' _BOX_TOML_AWK <<'AWK' || true
function trim(s) { sub(/^[ \t\r]+/, "", s); sub(/[ \t\r]+$/, "", s); return s }
{
  line = trim($0)
  if (line == "" || line ~ /^#/) next
  if (line ~ /^\[.*\]$/) { sec = trim(substr(line, 2, length(line) - 2)); next }
  eq = index(line, "=")
  if (eq == 0) next
  if (sec != want_t || trim(substr(line, 1, eq - 1)) != want_k) next
  v = trim(substr(line, eq + 1))
  if (substr(v, 1, 1) == "\"") {
    out = ""; i = 2; n = length(v)
    while (i <= n) {
      c = substr(v, i, 1)
      if (c == "\\" && i < n) {
        d = substr(v, i + 1, 1)
        if (d == "n") out = out "\n"
        else if (d == "t") out = out "\t"
        else out = out d
        i += 2; continue
      }
      if (c == "\"") break
      out = out c; i++
    }
    print out; found = 1; exit
  }
  if (substr(v, 1, 1) == "'") {
    rest = substr(v, 2)
    q = index(rest, "'")
    if (q > 0) rest = substr(rest, 1, q - 1)
    print rest; found = 1; exit
  }
  h = index(v, "#")
  if (h > 0) v = trim(substr(v, 1, h - 1))
  print v; found = 1; exit
}
END { exit(found ? 0 : 1) }
AWK

# config_get <table> <key> -> prints value, non-zero when unset.
config_get() {
  [ -f "$CONFIG_FILE" ] || return 1
  awk -v want_t="$1" -v want_k="$2" "$_BOX_TOML_AWK" "$CONFIG_FILE" 2>/dev/null
}

# Password applied to root and box. Precedence: BOX_SSH_PASSWORD env >
# config.toml [ssh].password > default. chpasswd takes one user:password line;
# anything that cannot survive that round trip would set an unknown password
# and lock the box out, so refuse it and keep the documented default.
ssh_password() {
  local p=""
  if [ -n "${BOX_SSH_PASSWORD:-}" ]; then
    p="$BOX_SSH_PASSWORD"
  else
    p="$(config_get ssh password || true)"
  fi
  case "$p" in
    "") p="$DEFAULT_SSH_PASSWORD" ;;
    *[![:print:]]*)
      log "config: [ssh] password is not printable; using default" >&2
      p="$DEFAULT_SSH_PASSWORD"
      ;;
  esac
  printf '%s' "$p"
}

# --- tailscale binaries ------------------------------------------------------
tailscale_bin() {
  if [ -x "$BIN_DIR/tailscale" ]; then echo "$BIN_DIR/tailscale"; return; fi
  command -v tailscale 2>/dev/null || echo tailscale
}

tailscaled_bin() {
  if [ -x "$BIN_DIR/tailscaled" ]; then echo "$BIN_DIR/tailscaled"; return; fi
  command -v tailscaled 2>/dev/null || echo /usr/sbin/tailscaled
}

ts() { timeout "${TS_TIMEOUT:-8}" "$(tailscale_bin)" "$@"; }

ensure_dirs() {
  mkdir -p "$STATE_DIR" "$SSH_STATE_DIR" "$SECRETS_DIR" "$BIN_DIR" \
    "$RUN_DIR" "$LOG_DIR" /var/run/tailscale /run/sshd 2>/dev/null || true
  chmod 700 "$ROOT/state" "$STATE_DIR" "$SSH_STATE_DIR" "$SECRETS_DIR" \
    2>/dev/null || true
}

# --- tailscaled state --------------------------------------------------------
state_is_populated() {
  [ -f "$STATE_FILE" ] || return 1
  # The state file is JSON with a "_machinekey" entry once a login happened.
  # Prefer checking that; fall back to the old >=1KB size heuristic when the
  # file is unreadable or python3 is missing.
  if [ -r "$STATE_FILE" ] && have python3; then
    python3 - "$STATE_FILE" <<'PY' 2>/dev/null && return 0 || return 1
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    sys.exit(0 if any(k.startswith("_machinekey") for k in d) else 1)
except Exception:
    sys.exit(2)
PY
  fi
  local n
  n="$( { wc -c < "$STATE_FILE" || sudo sh -c 'wc -c < "$1"' _ "$STATE_FILE"; } 2>/dev/null \
    | tr -d '[:space:]' )"
  case "$n" in ''|*[!0-9]*) n=0 ;; esac
  [ "$n" -ge 1024 ]
}

read_box_name() {
  [ -s "$HOSTNAME_FILE" ] && tr -d '[:space:]' < "$HOSTNAME_FILE"
}

# --- status parsing ----------------------------------------------------------
# One parser for everything. Prints newline-separated key=value pairs:
#   backend= online= exitn= mapfail= fwdhealth= routes= auth=
ts_fields() {
  ts status --json 2>/dev/null | python3 -c '
import json, sys
out = {"backend": "", "online": "no", "exitn": "no", "mapfail": "no",
       "fwdhealth": "no", "routes": "", "auth": "", "nodegone": "no"}
try:
    d = json.load(sys.stdin)
    s = d.get("Self") or {}
    health = " ".join(str(x) for x in (d.get("Health") or []))
    h = health.lower()
    out["backend"] = str(d.get("BackendState") or "")
    out["online"] = "yes" if s.get("Online") else "no"
    out["exitn"] = "yes" if s.get("ExitNodeOption") else "no"
    out["mapfail"] = "yes" if ("coordination server" in h
                               or "not-in-map-poll" in h
                               or "pollnetmap" in h) else "no"
    out["fwdhealth"] = "yes" if "forward" in h else "no"
    # F8 (#8): the control plane deleted the node but LocalAPI keeps reporting
    # BackendState=Running. The Health strings name it — "node not found" /
    # "not found (404)". This is one of two nodegone sources (the other is a
    # bounded tailscaled.log tail in read_ts_fields); either is sufficient.
    out["nodegone"] = "yes" if ("node not found" in h
                                or "not found (404)" in h
                                or "404: node not found" in h) else "no"
    out["auth"] = (d.get("AuthURL") or "").replace("\n", " ").strip()
except Exception:
    pass
for k, v in out.items():
    print(f"{k}={v}")
' 2>/dev/null || true
}

read_ts_fields() {
  backend=""; online="no"; exitn="no"; mapfail="no"; fwdhealth="no"; auth=""
  nodegone="no"
  while IFS= read -r line; do
    case "$line" in
      backend=*)   backend="${line#backend=}" ;;
      online=*)    online="${line#online=}" ;;
      exitn=*)     exitn="${line#exitn=}" ;;
      mapfail=*)   mapfail="${line#mapfail=}" ;;
      fwdhealth=*) fwdhealth="${line#fwdhealth=}" ;;
      auth=*)      auth="${line#auth=}" ;;
      nodegone=*)  nodegone="${line#nodegone=}" ;;
    esac
  done <<EOF
$(ts_fields)
EOF
  # F8 (#8): second nodegone source — a BOUNDED tail of $TAILSCALED_LOG. The
  # Health strings above can clear while the map-poll keeps 404ing, so also
  # scan the log. Bounded two ways so a stale log never re-triggers forever:
  # only the last ~200 lines, AND (since we cannot cheaply parse per-line
  # timestamps against the daemon's start) only when Self.Online is false —
  # a node that is genuinely Online again is not gone regardless of old lines.
  if [ "$nodegone" != yes ] && [ "$online" != yes ]; then
    nodegone_from_log && nodegone="yes"
  fi
}

# F8 (#8): true (0) iff the last ~200 lines of $TAILSCALED_LOG show a
# PollNetMap / lite-map "404 node not found". Bounded to the tail only; the
# caller additionally gates on Self.Online=false so a stale log entry from a
# since-recovered node cannot re-trigger re-auth. Fail-open: no log / no match
# returns non-zero (not nodegone).
nodegone_from_log() {
  [ -f "$TAILSCALED_LOG" ] || return 1
  tail -n 200 "$TAILSCALED_LOG" 2>/dev/null \
    | grep -Eiq 'pollnetmap.*404.*node not found|404: node not found'
}

advertised_routes() {
  ts debug prefs 2>/dev/null | python3 -c '
import json, sys
try:
    p = json.load(sys.stdin)
    print(",".join(str(x) for x in (p.get("AdvertiseRoutes") or [])))
except Exception:
    print("")
' 2>/dev/null || true
}

prefs_hostname() {
  ts debug prefs 2>/dev/null | python3 -c '
import json, sys
try:
    print((json.load(sys.stdin).get("Hostname") or "").strip())
except Exception:
    print("")
' 2>/dev/null || true
}

# F9 (#9): the tags the device ALREADY carries in its current prefs. Source
# from live prefs (debug prefs AdvertiseTags), falling back to status --json
# Self.Tags. NEVER from config.toml [tailscale] tags — that is first-login-only
# (F11). Prints a comma-separated "tag:a,tag:b" or empty. Restating tags the
# node already has is a MENTION the CLI demands, not INTRODUCING new tags.
current_advertise_tags() {
  local tags
  tags="$(ts debug prefs 2>/dev/null | python3 -c '
import json, sys
try:
    t = json.load(sys.stdin).get("AdvertiseTags") or []
    print(",".join(str(x) for x in t))
except Exception:
    print("")
' 2>/dev/null || true)"
  if [ -z "$tags" ]; then
    tags="$(ts status --json 2>/dev/null | python3 -c '
import json, sys
try:
    t = (json.load(sys.stdin).get("Self") or {}).get("Tags") or []
    print(",".join(str(x) for x in t))
except Exception:
    print("")
' 2>/dev/null || true)"
  fi
  echo "$tags"
}

wait_for_socket() {
  local i=0
  while [ "$i" -lt 25 ]; do
    [ -S "$TS_SOCK" ] || [ -S /run/tailscale/tailscaled.sock ] && return 0
    sleep 0.2; i=$((i + 1))
  done
  return 1
}

# Wait until backend is Running / NeedsLogin / Stopped / Starting, or timeout.
# NoState right after start is not NeedsLogin and not a reason to mint AuthURL.
wait_for_backend() {
  local i=0
  while [ "$i" -lt 20 ]; do
    read_ts_fields
    case "$backend" in
      Running|NeedsLogin|Stopped|Starting) echo "$backend"; return 0 ;;
    esac
    sleep 0.5; i=$((i + 1))
  done
  echo "${backend:-NoState}"
  return 1
}

# --- converge: packages ------------------------------------------------------
ensure_packages() {
  have apt-get || return 0
  export DEBIAN_FRONTEND=noninteractive
  local need=0
  [ -x /usr/sbin/sshd ] || need=1
  have nft || need=1
  have curl || need=1
  have python3 || need=1
  [ "$need" = 1 ] || return 0
  apt-get update -qq || true
  apt-get install -y -qq --no-install-recommends \
    openssh-server iptables nftables ca-certificates curl python3 \
    iproute2 procps sudo 2>/dev/null || true
}

# --- converge: tailscale binaries -------------------------------------------
# Vendored static binaries under $BIN_DIR are the primary install: they live
# in /workspace, so after an image swap the daemon restarts without waiting on
# apt or the network. Sources, in order: existing bin/, a system install to
# copy, the official static tarball, and finally the apt repo.
ts_version_want() { config_get tailscale version || echo "$DEFAULT_TS_VERSION"; }

vendor_from_tarball() {
  local ver="$1" arch tmp url
  case "$(uname -m)" in
    x86_64) arch=amd64 ;;
    aarch64) arch=arm64 ;;
    *) return 1 ;;
  esac
  have curl || return 1
  url="https://pkgs.tailscale.com/stable/tailscale_${ver}_${arch}.tgz"
  tmp="$(mktemp -d)" || return 1
  if curl -fsSL "$url" | tar -xz -C "$tmp" --strip-components=1 2>/dev/null \
      && [ -x "$tmp/tailscaled" ] && [ -x "$tmp/tailscale" ] \
      && "$tmp/tailscaled" --version >/dev/null 2>&1; then
    install -m 0755 "$tmp/tailscaled" "$BIN_DIR/tailscaled"
    install -m 0755 "$tmp/tailscale" "$BIN_DIR/tailscale"
    rm -rf "$tmp"
    log "vendored tailscale $ver ($arch) into $BIN_DIR"
    return 0
  fi
  rm -rf "$tmp"
  return 1
}

vendor_from_apt() {
  have apt-get || return 1
  local codename=trixie gpg=/usr/share/keyrings/tailscale-archive-keyring.gpg
  if [ -f /etc/os-release ]; then
    # shellcheck disable=SC1091
    . /etc/os-release
    codename="${VERSION_CODENAME:-trixie}"
  fi
  if [ ! -f "$gpg" ] && have curl; then
    curl -fsSL "https://pkgs.tailscale.com/stable/debian/${codename}.noarmor.gpg" \
      -o "$gpg" 2>/dev/null || true
  fi
  if [ -f "$gpg" ]; then
    echo "deb [signed-by=$gpg] https://pkgs.tailscale.com/stable/debian ${codename} main" \
      > /etc/apt/sources.list.d/tailscale.list
    apt-get update -qq || true
  fi
  apt-get install -y -qq tailscale 2>/dev/null || return 1
  [ -x /usr/sbin/tailscaled ] || return 1
  install -m 0755 /usr/sbin/tailscaled "$BIN_DIR/tailscaled"
  install -m 0755 /usr/bin/tailscale "$BIN_DIR/tailscale"
  return 0
}

ensure_tailscale_bin() {
  local want
  want="$(ts_version_want)"
  if [ -x "$BIN_DIR/tailscaled" ] && [ -x "$BIN_DIR/tailscale" ]; then
    # Re-vendor only when the config pins a different version.
    local cur
    cur="$("$BIN_DIR/tailscale" --version 2>/dev/null | head -1 | tr -d '[:space:]')"
    if [ -z "$(config_get tailscale version || true)" ] || [ "$cur" = "$want" ]; then
      return 0
    fi
    log "tailscale $cur -> $want (config pin)"
  elif [ -x /usr/sbin/tailscaled ] && [ -x /usr/bin/tailscale ]; then
    install -m 0755 /usr/sbin/tailscaled "$BIN_DIR/tailscaled"
    install -m 0755 /usr/bin/tailscale "$BIN_DIR/tailscale"
    return 0
  fi
  vendor_from_tarball "$want" && return 0
  vendor_from_apt && return 0
  [ -x "$BIN_DIR/tailscaled" ] && return 0   # keep what we have
  log "ensure_tailscale_bin: no tailscale binaries available" >&2
  return 1
}

# --- converge: sshd ----------------------------------------------------------
SSHD_DROPIN="/etc/ssh/sshd_config.d/00-box-setup.conf"

# Password login is the contract for these boxes: after an image swap it is the
# only way back in. Own it in a drop-in rather than sed-ing the main file —
# Debian's sshd_config Includes sshd_config.d/*.conf near the top and sshd
# keeps the FIRST value it obtains, so 00- wins over the main file and over
# any other drop-in. Falls back to editing the main file on images without
# Include support.
write_sshd_config() {
  local tmp
  if [ -d /etc/ssh/sshd_config.d ] && \
     grep -qiE '^[[:space:]]*Include[[:space:]]+.*sshd_config\.d' \
       /etc/ssh/sshd_config 2>/dev/null; then
    tmp="$(mktemp)" || return 1
    cat > "$tmp" <<'DROPIN'
# Managed by grok-box-setup (boxup). Overwritten on every converge.
# Set the password in /workspace/box-setup/config.toml instead.
ListenAddress 0.0.0.0
ListenAddress ::
PermitRootLogin yes
PasswordAuthentication yes
KbdInteractiveAuthentication yes
UsePAM yes
DROPIN
    if [ -f "$SSHD_DROPIN" ] && cmp -s "$tmp" "$SSHD_DROPIN"; then
      rm -f "$tmp"
      return 1          # already correct, no reload needed
    fi
    install -m 0644 "$tmp" "$SSHD_DROPIN"
    rm -f "$tmp"
    return 0
  fi
  [ -f /etc/ssh/sshd_config ] || return 1
  grep -q '^ListenAddress 0.0.0.0' /etc/ssh/sshd_config 2>/dev/null || \
    echo 'ListenAddress 0.0.0.0' >> /etc/ssh/sshd_config
  grep -q '^ListenAddress ::' /etc/ssh/sshd_config 2>/dev/null || \
    echo 'ListenAddress ::' >> /etc/ssh/sshd_config
  sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config 2>/dev/null || true
  sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config 2>/dev/null || true
  return 0
}

# Host keys live in /etc/ssh, which dies on image swap; clients then see a
# changed-host-key warning on every swap. Persist the keys in state/ssh and
# restore them, so each grok-box-N keeps one SSH identity for its lifetime.
ensure_host_keys() {
  local k restored=0
  if [ ! -f /etc/ssh/ssh_host_ed25519_key ] && \
     [ -f "$SSH_STATE_DIR/ssh_host_ed25519_key" ]; then
    for k in "$SSH_STATE_DIR"/ssh_host_*; do
      [ -e "$k" ] || continue
      cp -a "$k" /etc/ssh/ 2>/dev/null && restored=1
    done
    [ "$restored" = 1 ] && log "sshd: restored persisted host keys"
  fi
  [ -f /etc/ssh/ssh_host_ed25519_key ] || ssh-keygen -A >/dev/null 2>&1 || true
  for k in /etc/ssh/ssh_host_*_key /etc/ssh/ssh_host_*_key.pub; do
    [ -f "$k" ] || continue
    if [ ! -f "$SSH_STATE_DIR/$(basename "$k")" ]; then
      cp -a "$k" "$SSH_STATE_DIR/" 2>/dev/null || true
    fi
  done
}

ensure_sshd() {
  local changed=0 pw
  mkdir -p /run/sshd /etc/ssh
  ensure_host_keys
  write_sshd_config && changed=1

  # Grok images ship box/root with a locked shadow entry (* / !) and /etc/shadow
  # dies on image swap — sshd=up is not a working login. Re-apply every converge.
  pw="$(ssh_password)"
  if have chpasswd; then
    id box >/dev/null 2>&1 && printf 'box:%s\n' "$pw" | chpasswd >/dev/null 2>&1 || true
    printf 'root:%s\n' "$pw" | chpasswd >/dev/null 2>&1 || true
  fi

  if [ -x /usr/sbin/sshd ]; then
    if pgrep -x sshd >/dev/null 2>&1; then
      # Reload only on config change; a HUP every tick churns sshd for nothing.
      [ "$changed" = 1 ] && kill -HUP "$(pgrep -n -x sshd)" 2>/dev/null || true
    else
      # F7/P0-A: sshd self-daemonizes and would keep an inherited converge-lock
      # fd open for life (ensure_sshd runs inside the fd-8 lock subshell via
      # do_ensure_body). Spawn through spawn_detached so it inherits neither
      # lock fd — same failure class as the tailscaled leak.
      spawn_detached "" /usr/sbin/sshd || true
    fi
  fi
}

# --- converge: forwarding ----------------------------------------------------
# Admin console "cannot relay traffic" fires if EITHER v4 or v6 forwarding is 0.
write_proc() {
  local path="$1" val="$2" cur
  [ -e "$path" ] || return 0
  cur=$(tr -d '[:space:]' < "$path" 2>/dev/null || echo "")
  [ "$cur" = "$val" ] && return 0
  echo "$val" > "$path" 2>/dev/null && return 0
  local key="${path#/proc/sys/}"
  sysctl -w "${key//\//.}=${val}" >/dev/null 2>&1 || return 1
}

ensure_forwarding() {
  local changed=0 p before after d v4 v6
  if [ -d /etc/sysctl.d ] || mkdir -p /etc/sysctl.d 2>/dev/null; then
    cat > /etc/sysctl.d/99-tailscale-exitnode.conf 2>/dev/null <<'EOF' || true
net.ipv4.ip_forward = 1
net.ipv4.conf.all.forwarding = 1
net.ipv4.conf.default.forwarding = 1
net.ipv6.conf.all.forwarding = 1
net.ipv6.conf.default.forwarding = 1
net.ipv4.conf.all.src_valid_mark = 1
net.ipv4.conf.all.rp_filter = 2
net.ipv4.conf.default.rp_filter = 2
EOF
  fi
  for p in \
    /proc/sys/net/ipv4/ip_forward \
    /proc/sys/net/ipv4/conf/all/forwarding \
    /proc/sys/net/ipv4/conf/default/forwarding \
    /proc/sys/net/ipv6/conf/all/forwarding \
    /proc/sys/net/ipv6/conf/default/forwarding \
    /proc/sys/net/ipv4/conf/all/src_valid_mark
  do
    before=$(tr -d '[:space:]' < "$p" 2>/dev/null || echo "")
    write_proc "$p" 1 || log "forwarding: cannot write $p (need NET_ADMIN)" >&2
    after=$(tr -d '[:space:]' < "$p" 2>/dev/null || echo "")
    [ "$before" != "$after" ] && changed=1
  done
  write_proc /proc/sys/net/ipv4/conf/all/rp_filter 2 || true
  write_proc /proc/sys/net/ipv4/conf/default/rp_filter 2 || true
  # Per-interface v6 forwarding: conf/all does not cover already-up interfaces.
  for d in /proc/sys/net/ipv6/conf/*/forwarding; do
    [ -e "$d" ] || continue
    case "$d" in */lo/forwarding) continue ;; esac
    write_proc "$d" 1 || true
  done

  v4=$(tr -d '[:space:]' < /proc/sys/net/ipv4/ip_forward 2>/dev/null || echo 0)
  v6=$(tr -d '[:space:]' < /proc/sys/net/ipv6/conf/all/forwarding 2>/dev/null || echo 0)
  {
    echo "ipfwd_v4=${v4}"
    echo "ipfwd_v6=${v6}"
    echo "changed=${changed}"
    echo "ts=$(date +%s)"
  } > "$RUN_DIR/ipfwd.env" 2>/dev/null || true
  [ "$v4" = 1 ] && [ "$v6" = 1 ]
}

# --- converge: NAT -----------------------------------------------------------
# Docker's FORWARD DROP + a missing masquerade = exit node "connected" with no
# WAN. nft rules die with the overlay, so re-apply every tick. The whole file
# is one kernel transaction (create-if-absent, delete, redefine) — atomic and
# idempotent, no grep-the-rule-text games. The ip6 output reject + prohibit
# default route force-fail IPv6 fast so exit-node clients fall back to v4
# instead of hanging on a WAN that has no v6.
ensure_nat() {
  if have nft; then
    nft -f - <<'NFT' 2>/dev/null || log "nat: nft apply failed" >&2
table ip ts-exitfix {}
delete table ip ts-exitfix
table ip ts-exitfix {
  chain postrouting {
    type nat hook postrouting priority 100;
    oifname != "lo" masquerade
  }
  chain forward {
    type filter hook forward priority 0;
    iifname "tailscale0" accept
    oifname "tailscale0" accept
  }
}
table ip6 ts-exitfix {}
delete table ip6 ts-exitfix
table ip6 ts-exitfix {
  chain postrouting {
    type nat hook postrouting priority 100;
    oifname != "lo" masquerade
  }
  chain forward {
    type filter hook forward priority 0;
    iifname "tailscale0" accept
    oifname "tailscale0" accept
  }
  chain output {
    type filter hook output priority 0;
    oifname != "lo" oifname != "tailscale0" reject
  }
}
NFT
  fi
  if have iptables-legacy; then
    iptables-legacy -C DOCKER-USER -j ACCEPT 2>/dev/null || \
      iptables-legacy -I DOCKER-USER 1 -j ACCEPT 2>/dev/null || \
      iptables-legacy -A DOCKER-USER -j ACCEPT 2>/dev/null || true
    iptables-legacy -C FORWARD -i tailscale0 -j ACCEPT 2>/dev/null || \
      iptables-legacy -I FORWARD 1 -i tailscale0 -j ACCEPT 2>/dev/null || true
    iptables-legacy -C FORWARD -o tailscale0 -j ACCEPT 2>/dev/null || \
      iptables-legacy -I FORWARD 1 -o tailscale0 -j ACCEPT 2>/dev/null || true
  fi
  if have ip; then
    ip -6 route show default 2>/dev/null | grep -q prohibit || \
      ip -6 route replace prohibit default 2>/dev/null || true
  fi
}

# --- converge: detached long-lived spawns (F7 / #7 + addendum P0-A) ----------
# THE ONE place that spawns a long-lived, detached child. Every long-lived
# process boxup starts — tailscaled, sshd (both spawn sites), and the worker —
# MUST go through here so it inherits NEITHER converge-lock fd. #7 happened
# because the fd-close was an unenforced per-site convention (the old comment
# even claimed a close that the code did not do); a hand-appended `8>&- 9>&-`
# at each call site is exactly how it survived review. One helper = one place
# to be right, one place to review.
#
# Closes BOTH lock fds on the child:
#   * fd 8 -> $CONVERGE_LOCK — held by run_with_converge_lock while do_ensure_body
#     / do_tick run; a child that keeps it holds the converge flock for life and
#     starves every later tick (the #7 failure, byte-for-byte).
#   * fd 9 -> $START_LOCK — the tailscaled fork window.
# Both are write fds, so both closes use `>&-`. setsid -f fully detaches
# (new session, no controlling tty) so the child outlives this shell.
#
# Usage: spawn_detached <logfile|""> <cmd> [args...]
#   logfile: append target for the child's stdout+stderr; "" -> /dev/null.
# The caller passes any `env VAR=... cmd ...` as the command words.
spawn_detached() {
  local out="$1"; shift
  if [ -n "$out" ]; then
    setsid -f "$@" 8>&- 9>&- >>"$out" 2>&1
  else
    setsid -f "$@" 8>&- 9>&- >/dev/null 2>&1
  fi
}

# --- converge: tailscaled ----------------------------------------------------
# Exactly one daemon, bound to the workspace statedir. Kill strays (dpkg's
# default unit uses /var/lib/tailscale) by PID, never pkill -f.
# F7 (#7): the daemon is spawned via spawn_detached, which closes BOTH lock fds
# (fd 8 $CONVERGE_LOCK + fd 9 $START_LOCK). start_tailscaled is reachable from
# under the converge lock (do_tick/do_ensure_body run it while holding fd 8),
# so a daemon inheriting fd 8 would hold the converge flock for its ENTIRE life
# — every later `run_tick` then loses `flock -n 8` and logs "converge already
# running — skipping" forever (observed 256 skips / 77 min on box-8).
start_tailscaled() {
  local daemon pid cmd keep=""
  daemon="$(tailscaled_bin)"
  if [ ! -x "$daemon" ]; then
    log "start: no tailscaled binary" >&2
    return 1
  fi
  if [ ! -e /dev/net/tun ]; then
    log "start: /dev/net/tun missing — kernel TUN required" >&2
    return 1
  fi

  for pid in $(pgrep -x tailscaled 2>/dev/null || true); do
    cmd=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)
    if echo "$cmd" | grep -q -- "$STATE_DIR"; then
      if [ -z "$keep" ]; then
        keep="$pid"
      else
        log "start: extra statedir daemon pid=$pid — stopping"
        kill "$pid" 2>/dev/null || true
      fi
    else
      log "start: stopping stray pid=$pid (wrong statedir)"
      kill "$pid" 2>/dev/null || true
    fi
  done
  sleep 0.4
  for pid in $(pgrep -x tailscaled 2>/dev/null || true); do
    cmd=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)
    echo "$cmd" | grep -q -- "$STATE_DIR" && continue
    kill -9 "$pid" 2>/dev/null || true
  done

  if [ -n "$keep" ] && kill -0 "$keep" 2>/dev/null; then
    return 0
  fi

  touch "$TAILSCALED_LOG" 2>/dev/null || true
  # Keep the log bounded; it lives on the overlay but a long-lived box would
  # otherwise grow it without limit.
  if [ "$(wc -c < "$TAILSCALED_LOG" 2>/dev/null || echo 0)" -gt 52428800 ]; then
    : > "$TAILSCALED_LOG"
  fi

  # The flock lives in a subshell so it is released the moment the fork window
  # closes — a long-lived worker holding it forever would wedge later starts.
  # F7 (#7): spawn_detached closes BOTH lock fds (fd 8 + fd 9) on the daemon so
  # it inherits neither — see the helper. The old code closed only fd 9 (as a
  # sloppy `9<&-`) and never fd 8, so tailscaled held the converge lock for its
  # whole life and starved every tick.
  (
    exec 9>"$START_LOCK"
    flock -n 9 || exit 3
    spawn_detached "$TAILSCALED_LOG" \
      env TS_DEBUG_FIREWALL_MODE="${TS_DEBUG_FIREWALL_MODE:-nftables}" \
      "$daemon" \
        --statedir="$STATE_DIR" \
        --socket="$TS_SOCK" \
        --tun=tailscale0 \
        --port=41641
  )
  if [ "$?" = 3 ]; then
    wait_for_socket || true
    if pgrep -x tailscaled >/dev/null 2>&1; then
      return 0
    fi
    log "start: lock busy ($START_LOCK)" >&2
    return 1
  fi
  wait_for_socket || true
  pid=$(pgrep -n -x tailscaled 2>/dev/null || true)
  log "start: tailscaled pid=${pid:-?} statedir=$STATE_DIR"
}

# --- converge: first login / re-auth -----------------------------------------
# `tailscale up` is allowed here and ONLY here: when the backend needs a login.
# Two cases share this one `up`, distinguished by the statedir:
#   * statedir empty  -> first login (auth-key join, or mint an AuthURL)
#   * statedir populated but backend=NeedsLogin -> the node key expired (~180d)
#     or the node was deleted in the admin console. `tailscale up` on an expired
#     node exits silently, so re-auth needs --force-reauth (tailscale#6786,
#     tailscale#4854). Re-auth reuses the existing machine key: same identity,
#     no fork. The minted AuthURL surfaces in `boxup status` via auth=.
# Everything after a successful login goes through `tailscale set` (up resets
# flags it is not given). NoState right after daemon start is NOT NeedsLogin —
# it stays in the *) arm below and never mints, per the house rule.
# F9 (#9): invoke `tailscale up --force-reauth` with the MENTIONS current
# tailscale (1.102.x) demands. It refuses re-auth otherwise:
#   "changing settings via 'tailscale up' requires mentioning all non-default
#    flags".
# We add --hostname=<current> always, and --advertise-tags=<current> ONLY when
# the device already carries tags (F11 distinction: mentioning tags the node
# already has is the required MENTION, not INTRODUCING new tags on re-auth —
# never source these from config.toml). We NEVER use --reset (it would drop
# prefs we then have to re-set). #9(c): the failure is no longer swallowed with
# `|| true` — we capture combined output and, on non-zero rc, log the actual
# tailscale error at ERROR level, calling out the mentioning-flags case
# explicitly. Non-fatal to the tick (no set -e escape) but always VISIBLE.
# Args: $1 = human reason for the log; remaining args appended to the up argv
# (e.g. --auth-key=...). Returns the tailscale rc.
run_reauth_up() {
  local reason="$1"; shift
  local b hostname tags out rc
  b="$(tailscale_bin)"
  [ -x "$b" ] || return 0
  local -a up
  up=("$b" up --ssh=false --advertise-exit-node --accept-dns
      --snat-subnet-routes=true --timeout=25s --force-reauth)
  id box >/dev/null 2>&1 && up+=(--operator=box)

  hostname="$(prefs_hostname)"
  [ -n "$hostname" ] || hostname="$(read_box_name || true)"
  [ -n "$hostname" ] && up+=(--hostname="$hostname")

  tags="$(current_advertise_tags)"
  if [ -n "$tags" ]; then
    up+=(--advertise-tags="$tags")
    log "login: $reason — mentioning current prefs hostname=${hostname:-?} tags=$tags (--force-reauth)"
  else
    log "login: $reason — mentioning current prefs hostname=${hostname:-?} (no tags on device) (--force-reauth)"
  fi

  out="$("${up[@]}" "$@" 2>&1)"; rc=$?
  if [ "$rc" -ne 0 ]; then
    log "login: tailscale up --force-reauth FAILED rc=$rc: $out" >&2
    case "$out" in
      *"requires mentioning all non-default flags"*)
        log "login: ERROR tailscale refused re-auth — it wants ALL non-default flags mentioned. Our argv had hostname=${hostname:-?} tags=${tags:-<none>}. Tailscale's suggested command is in the error text above; a pref changed underneath us." >&2
        ;;
    esac
  fi
  return "$rc"
}

ensure_login() {
  local st
  # Read full fields (need backend AND nodegone). wait_for_backend settles the
  # backend first; then read_ts_fields populates nodegone from Health + a
  # bounded tailscaled.log tail.
  st="$(wait_for_backend || true)"
  read_ts_fields
  # F8 (#8): Running is a legitimate "logged in" ONLY when the node is not
  # gone. When the control plane has deleted the node, LocalAPI still reports
  # BackendState=Running while PollNetMap 404s — fall through to the re-auth
  # path (same path as NeedsLogin with a populated statedir) instead of
  # returning 0. Gate strictly on Running: NoState/Starting right after daemon
  # start must NOT trigger re-auth off a stale log tail (house rule: NoState ≠
  # NeedsLogin, never mint on NoState).
  if [ "$nodegone" = yes ] && [ "$st" = Running ]; then
    if ! state_is_populated; then
      # No identity to re-auth (empty statedir) — nothing --force-reauth can do.
      return 0
    fi
    # F8 (#8) rate limit: at most one re-auth per D4 backoff window; a re-auth
    # storm against the control plane is worse than the bug.
    if ! reauth_window_ok; then
      return 0
    fi
    date +%s > "$REAUTH_LAST" 2>/dev/null || true
    if [ -s "$AUTHKEY_FILE" ]; then
      if run_reauth_up "node deleted server-side (nodegone), re-auth with auth-key" \
           --auth-key="$(tr -d '[:space:]' < "$AUTHKEY_FILE")"; then
        echo 0 > "$REAUTH_FAIL" 2>/dev/null || true
      else
        echo $(( $(reauth_fail_count) + 1 )) > "$REAUTH_FAIL" 2>/dev/null || true
      fi
    else
      # No key: we can only mint an AuthURL no human may click. Log LOUDLY once
      # per window (the window guard above ensures once-per-window) — do NOT
      # spin.
      log "login: WARNING node gone server-side (nodegone) but NO auth-key — minting AuthURL a human must click; see boxup status. Rate-limited to once per backoff window." >&2
      if run_reauth_up "node deleted server-side (nodegone), minting AuthURL"; then
        echo 0 > "$REAUTH_FAIL" 2>/dev/null || true
      else
        echo $(( $(reauth_fail_count) + 1 )) > "$REAUTH_FAIL" 2>/dev/null || true
      fi
    fi
    return 0
  fi
  case "$st" in Running|Starting) return 0 ;; esac
  case "$st" in NeedsLogin|Stopped|"") ;; *) return 0 ;; esac

  local b
  b="$(tailscale_bin)"
  [ -x "$b" ] || return 0
  # A populated statedir at NeedsLogin means an existing identity whose node
  # key expired or was revoked; --force-reauth re-auths it in place (same key).
  # An empty statedir is a first login and must NOT get --force-reauth.
  if state_is_populated; then
    # Tags are auth-time-only and NEVER INTRODUCED on the --force-reauth branch
    # (F11): an unattended ~180-day key-expiry re-auth must not convert a
    # user-owned node to tag-owned (ACL semantics change, tagged keys stop
    # expiring, and an unauthorized tag is REJECTED after --force-reauth
    # already rotated keys — leaving the box locked out, headscale#3374).
    # F9 (#9): run_reauth_up still MENTIONS the tags the device ALREADY carries
    # (from live prefs, never config.toml) because current tailscale refuses an
    # up that omits an already-set non-default flag. Mentioning is not
    # introducing. Retagging is still a documented MANUAL operator step.
    # P0-C (#9): do NOT swallow the re-auth rc with `|| true`. run_reauth_up
    # already logs the tailscale error text; the CALLER also records the
    # outcome so a persistent NeedsLogin re-auth failure is visible, not silent.
    local rrc
    if [ -s "$AUTHKEY_FILE" ]; then
      run_reauth_up "re-auth existing identity with auth-key" \
        --auth-key="$(tr -d '[:space:]' < "$AUTHKEY_FILE")"; rrc=$?
    else
      run_reauth_up "re-auth existing identity, minting AuthURL — see boxup status"; rrc=$?
    fi
    if [ "$rrc" -ne 0 ]; then
      log "login: re-auth (NeedsLogin, populated statedir) FAILED rc=$rrc — see the tailscale error above; node stays NeedsLogin, will retry next converge" >&2
    fi
  else
    # First login (empty statedir). This is the ONLY place --advertise-tags is
    # added from config: config [tailscale] tags, when non-empty, tags the node
    # at initial registration. Default unset => flag omitted => byte-identical
    # to before. Left intentionally UNCHANGED by #9 (first-login branch only).
    local -a up
    up=("$b" up --ssh=false --advertise-exit-node --accept-dns
        --snat-subnet-routes=true --timeout=25s)
    id box >/dev/null 2>&1 && up+=(--operator=box)
    local tags
    tags="$(config_get tailscale tags || true)"
    [ -n "$tags" ] && up+=(--advertise-tags="$tags")
    if [ -s "$AUTHKEY_FILE" ]; then
      log "login: auth-key join (statedir empty)${tags:+ tags=$tags}"
      "${up[@]}" --auth-key="$(tr -d '[:space:]' < "$AUTHKEY_FILE")" || true
    else
      log "login: minting AuthURL (statedir empty, no key)${tags:+ tags=$tags} — see boxup status"
      "${up[@]}" || true
    fi
  fi
}

# --- converge: name ----------------------------------------------------------
# Pick the lowest free grok-box-N from PEERS only (Self is often still named
# cursor). Only when logged in and peers are visible; a lone node would always
# pick grok-box-1 and collide later.
pick_name() {
  python3 - <<PY
import json, re, subprocess

pat = re.compile(r"^grok-box-([0-9]+)\$")

def run(args, timeout=8):
    try:
        p = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        return p.stdout or ""
    except Exception:
        return ""

tsbin = "$(tailscale_bin)"
raw = run([tsbin, "status", "--json"])
status_txt = run([tsbin, "status"])
self_ip = run([tsbin, "ip", "-4"]).strip()
taken = set()

def take(name):
    if not name:
        return
    name = name.strip().rstrip(".")
    if "." in name and name.endswith("ts.net"):
        name = name.split(".")[0]
    m = pat.match(name)
    if m:
        taken.add(int(m.group(1)))

try:
    d = json.loads(raw) if raw.strip() else {}
except json.JSONDecodeError:
    d = {}

peers = d.get("Peer") or {}
if not peers:
    raise SystemExit(1)   # no peers visible: do not guess

for peer in peers.values():
    take(peer.get("HostName") or "")
    dns = peer.get("DNSName") or ""
    take(dns.split(".")[0] if dns else "")

for line in status_txt.splitlines():
    cols = line.split()
    if len(cols) < 2:
        continue
    if self_ip and cols[0] == self_ip:
        continue
    take(cols[1])

n = 1
while n in taken:
    n += 1
print(f"grok-box-{n}")
PY
}

ensure_name() {
  local name
  name="$(read_box_name || true)"
  case "$name" in grok-box-[0-9]*) return 0 ;; esac
  read_ts_fields
  [ "$backend" = Running ] || return 0
  name="$(pick_name 2>/dev/null || true)"
  case "$name" in
    grok-box-[0-9]*)
      printf '%s\n' "$name" > "$HOSTNAME_FILE"
      log "name: picked $name"
      ;;
  esac
}

# --- converge: exit-node refresh --------------------------------------------
# Full flag set. Prefer operator=box; fall back to root if that user cannot
# talk to the daemon yet (first join, operator not written).
tailscale_set_full() {
  local name="$1" b
  b="$(tailscale_bin)"
  [ -x "$b" ] || return 1
  if id box >/dev/null 2>&1 && sudo -n -u box "$b" set --hostname="$name" \
      --ssh=false --operator=box --advertise-exit-node \
      --snat-subnet-routes=true --stateful-filtering=false 2>/dev/null; then
    return 0
  fi
  "$b" set --hostname="$name" --ssh=false --operator=box \
    --advertise-exit-node --snat-subnet-routes=true \
    --stateful-filtering=false
}

# Refresh-failure backoff (D4). A persistently failing `tailscale set` used to
# retry on EVERY 15s tick forever (last-set is stamped only on success), with
# no escalation and no status visibility. Now consecutive failures stretch the
# effective rate-limit window 20s -> 60s -> 180s -> cap 600s; a success resets
# both the counter and the window. There is NO permanent give-up.
#
# fail.refresh holds the consecutive-failure count (run dir; reset free on
# recycle/boot). The window is a pure function of that count:
refresh_fail_count() {
  local n=0
  [ -f "$RUN_DIR/fail.refresh" ] && \
    n=$(tr -d '[:space:]' < "$RUN_DIR/fail.refresh" 2>/dev/null || echo 0)
  case "$n" in ''|*[!0-9]*) n=0 ;; esac
  echo "$n"
}

refresh_backoff_window() {
  local n="$1"
  if   [ "$n" -le 0 ]; then echo "$SET_MIN_INTERVAL"
  elif [ "$n" -eq 1 ]; then echo 60
  elif [ "$n" -eq 2 ]; then echo 180
  else                      echo 600
  fi
}

# --- re-auth backoff (F8 / #8, D4-shaped) ------------------------------------
# nodegone-triggered re-auth must NOT storm the control plane. It reuses the D4
# backoff WINDOW function above (20->60->180->600s) but with its OWN counter
# and attempt-stamp so it never conflates with refresh_exitnode's failures. A
# re-auth fires at most once per window; when there is no auth key (only an
# AuthURL a human must click) we log loudly ONCE per window instead of spinning.
REAUTH_FAIL="$RUN_DIR/fail.reauth"
REAUTH_LAST="$RUN_DIR/last-reauth"

reauth_fail_count() {
  local n=0
  [ -f "$REAUTH_FAIL" ] && \
    n=$(tr -d '[:space:]' < "$REAUTH_FAIL" 2>/dev/null || echo 0)
  case "$n" in ''|*[!0-9]*) n=0 ;; esac
  echo "$n"
}

# 0 (proceed) iff we are outside the current re-auth backoff window; else 1.
# Stamps nothing — the caller stamps the attempt time on both outcomes.
reauth_window_ok() {
  local fails window now last
  fails=$(reauth_fail_count)
  window=$(refresh_backoff_window "$fails")
  now=$(date +%s)
  last=0
  [ -f "$REAUTH_LAST" ] && last=$(tr -d '[:space:]' < "$REAUTH_LAST" 2>/dev/null || echo 0)
  case "$last" in ''|*[!0-9]*) last=0 ;; esac
  [ $((now - last)) -ge "$window" ]
}

# Push a full `tailscale set` when the coordination server would show "unable
# to relay traffic". Never `up`. Rate-limited: an unneeded set every tick
# cancels PollNetMap and marks the node offline.
refresh_exitnode() {
  local name need=0 reason="" chk warn v4 v6 routes now last
  read_ts_fields
  case "$backend" in Running) ;; *) return 0 ;; esac
  # P0-B (#8 sibling): a node deleted server-side stays backend=Running while
  # PollNetMap 404s (nodegone). A `tailscale set` cannot fix a gone node — the
  # fix is re-auth (ensure_login owns it). Pushing prefs here would be a no-op
  # against a dead identity and can cancel the in-flight map poll. Skip so the
  # re-auth path is the only thing acting on a gone node. Same guard the
  # ensure_login Running-branch now applies.
  if [ "$nodegone" = yes ]; then
    log "refresh: node gone server-side (nodegone) — deferring to re-auth, skipping set" >&2
    return 0
  fi

  name="$(read_box_name || true)"
  case "$name" in
    grok-box-[0-9]*) ;;
    *) name="$(prefs_hostname)" ;;
  esac
  case "$name" in grok-box-[0-9]*) ;; *) return 0 ;; esac

  # Healthy payload is {"Warning":""}. Parse the value — grepping for the key
  # name is always true and spammed `tailscale set` (node went offline).
  chk=$(timeout 5 curl -sS --unix-socket "$TS_SOCK" \
    http://local-tailscaled.sock/localapi/v0/check-ip-forwarding 2>/dev/null || true)
  warn=$(printf '%s' "$chk" | python3 -c '
import json, sys
try:
    w = json.load(sys.stdin).get("Warning") or ""
    if isinstance(w, list):
        w = " ".join(str(x) for x in w)
    print(str(w).strip())
except Exception:
    print("")
' 2>/dev/null || true)
  [ -n "$warn" ] && { need=1; reason="check-ip-forwarding warning"; }

  v4=$(tr -d '[:space:]' < /proc/sys/net/ipv4/ip_forward 2>/dev/null || echo 0)
  v6=$(tr -d '[:space:]' < /proc/sys/net/ipv6/conf/all/forwarding 2>/dev/null || echo 0)
  if [ "$v4" != 1 ] || [ "$v6" != 1 ]; then
    need=1; reason="kernel ipfwd v4=${v4} v6=${v6}"
  fi
  if [ -f "$RUN_DIR/ipfwd.env" ]; then
    # shellcheck disable=SC1091
    . "$RUN_DIR/ipfwd.env"
    [ "${changed:-0}" = 1 ] && { need=1; reason="sysctl just flipped"; }
  fi

  [ "$exitn" = yes ] || { need=1; reason="ExitNodeOption false"; }
  [ "$fwdhealth" = yes ] && { need=1; reason="status Health mentions forward"; }

  routes="$(advertised_routes)"
  echo "$routes" | grep -q '0.0.0.0/0' || { need=1; reason="missing 0.0.0.0/0"; }
  echo "$routes" | grep -q '::/0' || { need=1; reason="missing ::/0"; }

  [ "$need" = 1 ] || return 0

  local fails window force=0
  fails=$(refresh_fail_count)
  window=$(refresh_backoff_window "$fails")

  # BOXUP_FORCE_REFRESH=1 bypasses the backoff window exactly once (an operator
  # escape hatch). It is NOT tied to `cmd == once` — the hourly automation runs
  # `boxup once`, so a cmd-based bypass would reset backoff unattended (F6).
  # sudo strips the var, so require_root whitelists it and D12 documents the
  # working form: sudo env BOXUP_FORCE_REFRESH=1 /workspace/box-setup/boxup once
  if [ "${BOXUP_FORCE_REFRESH:-}" = 1 ]; then
    force=1
    log "refresh: BOXUP_FORCE_REFRESH=1 — bypassing backoff window (${window}s, fails=${fails})"
  fi

  now=$(date +%s)
  # Window guard keyed on the LAST ATTEMPT time (stamped on BOTH success and
  # failure below), not merely the last success — otherwise a fresh RUN_DIR
  # with fail-count > 0 but no stamp would skip the guard entirely and retry a
  # failing `set` every tick (D4 regression). Missing stamp => last=0 => the
  # delta is huge, so a genuine first-ever attempt still proceeds immediately.
  last=0
  [ -f "$RUN_DIR/last-exitnode-set" ] && \
    last=$(cat "$RUN_DIR/last-exitnode-set" 2>/dev/null || echo 0)
  case "$last" in ''|*[!0-9]*) last=0 ;; esac
  if [ "$force" = 0 ] && [ $((now - last)) -lt "$window" ]; then
    log "refresh: need set ($reason) but rate-limited (window=${window}s fails=${fails})"
    return 0
  fi
  log "refresh: tailscale set ($reason) hostname=$name"
  if tailscale_set_full "$name"; then
    echo "$now" > "$RUN_DIR/last-exitnode-set" 2>/dev/null || true
    # Success resets the failure counter and window.
    echo 0 > "$RUN_DIR/fail.refresh" 2>/dev/null || true
  else
    fails=$((fails + 1))
    echo "$fails" > "$RUN_DIR/fail.refresh" 2>/dev/null || true
    # Stamp the ATTEMPT time on failure too, so the stretched window applies
    # from the first failure even on a fresh RUN_DIR with no prior stamp.
    echo "$now" > "$RUN_DIR/last-exitnode-set" 2>/dev/null || true
    window=$(refresh_backoff_window "$fails")
    log "refresh: set failed (consecutive=${fails}, next window=${window}s)" >&2
    return 1
  fi
}

# --- selfheal: freeze / offline recycle -------------------------------------
hb_age() {
  local now prev
  now=$(date +%s)
  prev=0
  [ -f "$RUN_DIR/hb" ] && prev=$(tr -d '[:space:]' < "$RUN_DIR/hb" 2>/dev/null || echo 0)
  case "$prev" in ''|*[!0-9]*) prev=0 ;; esac
  [ "$prev" -le 0 ] && { echo 0; return; }
  echo $((now - prev))
}

recent_time_jump() {
  python3 - "$TAILSCALED_LOG" <<'PY'
import datetime, re, sys, time
try:
    lines = open(sys.argv[1], errors="replace").read().splitlines()[-150:]
except Exception:
    sys.exit(1)
pat = re.compile(r"^(\d{4}/\d{2}/\d{2} \d{2}:\d{2}:\d{2}).*time jump detected")
now = time.time()
for line in reversed(lines):
    m = pat.search(line)
    if not m:
        continue
    ts = datetime.datetime.strptime(m.group(1), "%Y/%m/%d %H:%M:%S")
    ts = ts.replace(tzinfo=datetime.timezone.utc)
    sys.exit(0 if 0 <= now - ts.timestamp() <= 180 else 1)
sys.exit(1)
PY
}

recycled_recently() {
  local now rec
  now=$(date +%s)
  rec=0
  [ -f "$RUN_DIR/last-recycle" ] && rec=$(tr -d '[:space:]' < "$RUN_DIR/last-recycle" 2>/dev/null || echo 0)
  case "$rec" in ''|*[!0-9]*) rec=0 ;; esac
  [ "$rec" -gt 0 ] && [ $((now - rec)) -lt "$RECYCLE_COOLDOWN" ]
}

# Kill that PID only (must be on our statedir), restart, re-push prefs.
recycle_tailscaled() {
  local reason="$1" pid cmd i
  pid=$(pgrep -n -x tailscaled 2>/dev/null || true)
  [ -n "$pid" ] || return 0
  cmd=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)
  echo "$cmd" | grep -q -- "$STATE_DIR" || return 0

  log "selfheal: $reason — recycle tailscaled pid=$pid"
  # Stamp BEFORE the kill: if this tick is slow or dies mid-recycle, the next
  # tick must still honor the cooldown instead of recycling again.
  date +%s > "$RUN_DIR/last-recycle" 2>/dev/null || true
  kill "$pid" 2>/dev/null || true
  i=0
  while [ "$i" -lt 20 ]; do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.2; i=$((i + 1))
  done
  if kill -0 "$pid" 2>/dev/null; then
    kill -9 "$pid" 2>/dev/null || true
    sleep 0.3
  fi
  rm -f "$RUN_DIR/last-online" "$RUN_DIR/offline-ticks"
  start_tailscaled || true
  # Hostinfo set is skipped while backend=NoState; wait out the blip.
  wait_for_backend >/dev/null || true
  refresh_exitnode || true
}

# After freeze/thaw, PollNetMap's long-poll is already dead but Self.Online
# and Health stay green for ~2 min (map timeout). A long-lived worker's stale
# hb is the wake signal — recycle. A brand-new worker (after stop) also sees
# leftover hb; only recycle then if tailscaled logged a time jump or the node
# is already down.
maybe_wake_recycle() {
  local age now started
  age=$(hb_age)
  case "$age" in ''|*[!0-9]*) age=0 ;; esac
  [ "$age" -ge "$FREEZE_SECS" ] || return 0
  recycled_recently && return 0

  now=$(date +%s)
  started=${WORKER_STARTED:-0}
  case "$started" in ''|*[!0-9]*) started=0 ;; esac
  if [ "$started" -gt 0 ] && [ $((now - started)) -lt "$FREEZE_SECS" ]; then
    read_ts_fields
    if [ "$online" = yes ] && [ "$mapfail" != yes ] && ! recent_time_jump; then
      log "selfheal: stale hb ${age}s but worker is new and node is live — skip"
      return 0
    fi
  fi
  recycle_tailscaled "time jump ${age}s (hb) — map poll dies on freeze"
}

# Process alive + Running + (Online=false or map-poll Health) after freeze.
# Not NeedsLogin, not a new AuthURL.
recycle_offline_tailscaled() {
  local now last ticks do_recycle=0
  recycled_recently && return 0
  read_ts_fields
  case "$backend" in
    Running) ;;
    *) rm -f "$RUN_DIR/offline-ticks"; return 0 ;;
  esac

  now=$(date +%s)
  if [ "$online" = yes ] && [ "$mapfail" != yes ]; then
    echo "$now" > "$RUN_DIR/last-online" 2>/dev/null || true
    rm -f "$RUN_DIR/offline-ticks"
    return 0
  fi

  last=0
  [ -f "$RUN_DIR/last-online" ] && last=$(tr -d '[:space:]' < "$RUN_DIR/last-online" 2>/dev/null || echo 0)
  case "$last" in ''|*[!0-9]*) last=0 ;; esac
  ticks=0
  [ -f "$RUN_DIR/offline-ticks" ] && ticks=$(tr -d '[:space:]' < "$RUN_DIR/offline-ticks" 2>/dev/null || echo 0)
  case "$ticks" in ''|*[!0-9]*) ticks=0 ;; esac
  ticks=$((ticks + 1))
  echo "$ticks" > "$RUN_DIR/offline-ticks" 2>/dev/null || true

  if [ "$last" -gt 0 ] && [ $((now - last)) -ge 30 ]; then
    do_recycle=1
  elif [ "$ticks" -ge 3 ]; then
    do_recycle=1
  fi
  [ "$do_recycle" = 1 ] || return 0
  recycle_tailscaled "online=${online} mapfail=${mapfail} after freeze"
}

# --- selfheal: worker --------------------------------------------------------
# The actual tick body. Runs under the converge lock (via run_tick).
do_tick() {
  # Freeze checks first — they need the OLD heartbeat.
  if pgrep -x tailscaled >/dev/null 2>&1; then
    maybe_wake_recycle || true
    recycle_offline_tailscaled || true
  else
    start_tailscaled || true
  fi
  # Write hb immediately after the checks: a slow recycle above must not leave
  # a stale hb for the next tick to mistake for another freeze.
  date +%s > "$RUN_DIR/hb" 2>/dev/null || true

  ensure_forwarding || true
  ensure_nat || true

  if ! pgrep -x sshd >/dev/null 2>&1; then
    # F7/P0-A: do_tick runs under `run_with_converge_lock try`, so this spawn is
    # inside the fd-8 lock subshell too — route through spawn_detached so sshd
    # inherits neither lock fd (see ensure_sshd for the same reason).
    [ -x /usr/sbin/sshd ] && { spawn_detached "" /usr/sbin/sshd || true; }
  fi

  case "$(read_box_name || true)" in
    grok-box-[0-9]*)
      pgrep -x tailscaled >/dev/null 2>&1 && refresh_exitnode || true
      ;;
  esac
  date +%s > "$RUN_DIR/hb" 2>/dev/null || true
}

# run_tick: take the converge lock with flock -n (skip on contention). A tick
# that loses the lock to an in-progress converge MUST still stamp hb before
# returning 0 (B1 — a converge in progress IS liveness; otherwise a long
# `boxup once` starves hb and the next tick spuriously recycles tailscaled).
run_tick() {
  local rc
  run_with_converge_lock try do_tick
  rc=$?
  if [ "$rc" = 200 ]; then
    log "tick: converge already running — skipping (stamping hb for liveness)"
    date +%s > "$RUN_DIR/hb" 2>/dev/null || true
  fi
  return 0
}

# True iff argv is `bash <path>/boxup worker` (or a legacy v4 selfheal worker).
# Never match `bash -c ...`: flattened cmdline greps used to SIGTERM agent
# shells that merely mentioned the name.
is_worker_proc() {
  local pid="$1" arg have_script=0 have_worker=0 have_c=0
  [ -r "/proc/$pid/cmdline" ] || return 1
  while IFS= read -r -d '' arg; do
    case "$arg" in
      -c) have_c=1 ;;
      worker|--worker) have_worker=1 ;;
      *boxup|*tailscale-selfheal.sh) have_script=1 ;;
    esac
  done < "/proc/$pid/cmdline" 2>/dev/null || return 1
  [ "$have_c" = 0 ] && [ "$have_script" = 1 ] && [ "$have_worker" = 1 ]
}

# shellcheck disable=SC2120  # optional $1 (keep-pid) reserved for callers
stop_workers() {
  local keep="${1:-}" pid i leftover
  for pid in $(pgrep -x bash 2>/dev/null || true); do
    [ "$pid" = "$$" ] && continue
    [ -n "$keep" ] && [ "$pid" = "$keep" ] && continue
    is_worker_proc "$pid" || continue
    log "selfheal: stopping worker pid=$pid"
    kill "$pid" 2>/dev/null || true
  done
  i=0
  while [ "$i" -lt 15 ]; do
    leftover=0
    for pid in $(pgrep -x bash 2>/dev/null || true); do
      [ "$pid" = "$$" ] && continue
      [ -n "$keep" ] && [ "$pid" = "$keep" ] && continue
      is_worker_proc "$pid" || continue
      leftover=1
      kill -9 "$pid" 2>/dev/null || true
    done
    [ "$leftover" = 0 ] && break
    sleep 0.2; i=$((i + 1))
  done
}

worker_loop() {
  local trc
  ensure_dirs
  echo $$ > "$WORKER_PID"
  echo "boxup-worker v$BOXUP_VERSION pid=$$ interval=$INTERVAL freeze=${FREEZE_SECS}s" >> "$WORKER_LOG"
  while true; do
    # P1: capture and surface the tick rc instead of a blanket `|| true`.
    # run_tick is designed to return 0 (B1: a skipped tick is liveness), so a
    # NON-zero here means run_tick itself errored unexpectedly — log it rather
    # than discard it silently. Never break the loop (the self-heal must keep
    # ticking past a transient failure — D8 `set -u` not blanket `set -e`).
    run_tick >> "$WORKER_LOG" 2>&1
    trc=$?
    [ "$trc" -ne 0 ] && log "worker: run_tick returned rc=$trc (unexpected; loop continues)" >> "$WORKER_LOG" 2>&1
    if [ "$(wc -c < "$WORKER_LOG" 2>/dev/null || echo 0)" -gt 10485760 ]; then
      : > "$WORKER_LOG"
    fi
    sleep "$INTERVAL"
  done
}

start_daemon() {
  ensure_dirs
  # Always reap leftovers and start one worker from THIS file; a pidfile hit
  # once kept an old version's worker in memory next to a newer install.
  stop_workers
  rm -f "$WORKER_PID"
  # F7/P0-A: route the worker spawn through spawn_detached too. Currently benign
  # (start_daemon runs at top level, after the lock subshell has exited) but it
  # is one refactor away from being bug #7 again if start_daemon is ever called
  # from under the converge lock — one helper, no special cases.
  spawn_detached "" env BOX_SETUP_ROOT="$ROOT" bash "$SELF" worker
  local i=0
  while [ "$i" -lt 15 ]; do
    if [ -f "$WORKER_PID" ] && kill -0 "$(cat "$WORKER_PID" 2>/dev/null)" 2>/dev/null; then
      break
    fi
    sleep 0.2; i=$((i + 1))
  done
  log "selfheal: started pid=$(cat "$WORKER_PID" 2>/dev/null || echo '?')"
}

stop_daemon() {
  local old
  if [ -f "$WORKER_PID" ]; then
    old=$(cat "$WORKER_PID" 2>/dev/null || echo "")
    [ -n "$old" ] && kill "$old" 2>/dev/null || true
    rm -f "$WORKER_PID"
  fi
  stop_workers
  log "selfheal: stopped (tailscaled left running)"
}

# --- status ------------------------------------------------------------------
# The installed git sha, stamped by install.sh into $ROOT/GIT_SHA. "unknown"
# when absent (an old-format box, or a source tree with no .git at install
# time). Never fails.
boxup_git_sha() {
  local s=""
  [ -f "$ROOT/GIT_SHA" ] && s=$(tr -d '[:space:]' < "$ROOT/GIT_SHA" 2>/dev/null || true)
  [ -n "$s" ] || s="unknown"
  printf '%s' "$s"
}

print_status() {
  local sshd=down ts_pid sh_pid="" hb=- v4 v6 name now last
  v4=$(tr -d '[:space:]' < /proc/sys/net/ipv4/ip_forward 2>/dev/null || echo 0)
  v6=$(tr -d '[:space:]' < /proc/sys/net/ipv6/conf/all/forwarding 2>/dev/null || echo 0)
  ts_pid=$(pgrep -n -x tailscaled 2>/dev/null || echo "")
  if [ -f "$WORKER_PID" ]; then
    sh_pid=$(tr -d '[:space:]' < "$WORKER_PID")
    kill -0 "$sh_pid" 2>/dev/null || sh_pid=""
  fi
  if [ -f "$RUN_DIR/hb" ]; then
    now=$(date +%s)
    last=$(tr -d '[:space:]' < "$RUN_DIR/hb" 2>/dev/null || echo 0)
    case "$last" in ''|*[!0-9]*) last=0 ;; esac
    [ "$last" -gt 0 ] && hb="$((now - last))s"
  fi
  pgrep -x sshd >/dev/null 2>&1 && sshd=up
  read_ts_fields
  name="$(read_box_name || true)"

  local vstr
  vstr="$BOXUP_VERSION/$(boxup_git_sha)"
  printf 'backend=%s online=%s exit-node=%s sshd=%s ipfwd=4:%s,6:%s tailscaled=%s selfheal=%s worker=%s hb=%s name=%s v=%s' \
    "${backend:-unknown}" "${online:-no}" "${exitn:-no}" "$sshd" "$v4" "$v6" \
    "${ts_pid:--}" "${sh_pid:--}" "${sh_pid:--}" "$hb" "${name:--}" "$vstr"
  # refresh backoff visibility (D4): surface a persistently failing refresh only
  # at N>=3 consecutive failures, so a healthy box's status line is unchanged.
  local rf
  rf=$(refresh_fail_count)
  [ "$rf" -ge 3 ] && printf ' refresh=failing:%s' "$rf"
  [ -n "${auth:-}" ] && printf ' auth=%s' "$auth"
  printf '\n'
}

# --- check: the single health predicate (D6) ---------------------------------
# `boxup check`: exit 0 iff the box is healthy, else exit 1 printing
# `check=FAIL reason=<first-failed-predicate>`. On success prints
# `check=OK ` + the normal status line. This is THE definition of "healthy";
# fleetctl and D7 rollout verification delegate to it instead of reimplementing
# health parsing laptop-side.
#
# check MUST NEVER exit 2 — exit 2 is the unknown-subcommand dispatch arm and
# is fleetctl's "old boxup" signal (B2). A check bug emitting 2 would silently
# downgrade a new fleetctl to the legacy status parse. Every failure here is
# exit 1; the dispatch arm below runs do_check and translates its rc to 0/1.
do_check() {
  local reason="" v4 v6 hb_secs now last ts_count pid cmd routes
  v4=$(tr -d '[:space:]' < /proc/sys/net/ipv4/ip_forward 2>/dev/null || echo 0)
  v6=$(tr -d '[:space:]' < /proc/sys/net/ipv6/conf/all/forwarding 2>/dev/null || echo 0)
  read_ts_fields

  # Predicates in order; first failure wins.
  if [ -z "$reason" ] && [ "${backend:-}" != Running ]; then
    reason="backend=${backend:-unknown} (want Running)"
  fi
  if [ -z "$reason" ] && [ "${online:-no}" != yes ]; then
    reason="online=${online:-no} (want yes)"
  fi
  if [ -z "$reason" ] && ! pgrep -x sshd >/dev/null 2>&1; then
    reason="sshd=down (want up)"
  fi
  if [ -z "$reason" ] && { [ "$v4" != 1 ] || [ "$v6" != 1 ]; }; then
    reason="ipfwd=4:${v4},6:${v6} (want 4:1,6:1)"
  fi
  if [ -z "$reason" ]; then
    # Exactly one tailscaled bound to the workspace statedir.
    ts_count=0
    for pid in $(pgrep -x tailscaled 2>/dev/null || true); do
      cmd=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)
      echo "$cmd" | grep -q -- "$STATE_DIR" && ts_count=$((ts_count + 1))
    done
    if [ "$ts_count" != 1 ]; then
      reason="tailscaled=${ts_count} on statedir (want exactly 1)"
    fi
  fi
  if [ -z "$reason" ]; then
    # Worker alive with a fresh heartbeat (< FREEZE_SECS).
    if [ ! -f "$WORKER_PID" ] || \
       ! kill -0 "$(tr -d '[:space:]' < "$WORKER_PID" 2>/dev/null)" 2>/dev/null; then
      reason="worker=dead (want alive)"
    else
      hb_secs=-1
      if [ -f "$RUN_DIR/hb" ]; then
        now=$(date +%s)
        last=$(tr -d '[:space:]' < "$RUN_DIR/hb" 2>/dev/null || echo 0)
        case "$last" in ''|*[!0-9]*) last=0 ;; esac
        [ "$last" -gt 0 ] && hb_secs=$((now - last))
      fi
      if [ "$hb_secs" -lt 0 ] || [ "$hb_secs" -ge "$FREEZE_SECS" ]; then
        reason="hb=${hb_secs}s (want < ${FREEZE_SECS}s)"
      fi
    fi
  fi
  if [ -z "$reason" ]; then
    # Exit-node advertised (ExitNodeOption + both default routes present).
    if [ "${exitn:-no}" != yes ]; then
      reason="exit-node=${exitn:-no} (want yes)"
    else
      routes="$(advertised_routes)"
      if ! echo "$routes" | grep -q '0.0.0.0/0' || ! echo "$routes" | grep -q '::/0'; then
        reason="exit-node routes missing 0.0.0.0/0 or ::/0"
      fi
    fi
  fi

  if [ -n "$reason" ]; then
    echo "check=FAIL reason=$reason"
    return 1
  fi
  printf 'check=OK '
  print_status
  return 0
}

# --- converge ----------------------------------------------------------------
# The converge body. Runs under the converge lock (via do_ensure).
# P1: previously every member was bare or `|| true`, so a converge reported
# success even if every step failed — invisibly. We now run each step through
# _ensure_step, which logs a non-zero rc and records a `degraded` marker under
# $RUN_DIR. The function's RETURN SEMANTICS ARE UNCHANGED (callers depend on
# do_ensure_body not failing a tick): it still returns 0 regardless. The marker
# and per-step logs are the visibility; they do not gate convergence. A clean
# converge clears the marker.
DEGRADED_MARKER="$RUN_DIR/degraded"

# _ensure_step <label> <fn>: run <fn>, log its rc if non-zero, set the degraded
# flag (shell var `_degraded`) so the body can stamp the marker. Never aborts.
_ensure_step() {
  local label="$1" fn="$2" rc
  "$fn"; rc=$?
  if [ "$rc" -ne 0 ]; then
    log "converge: step '$label' rc=$rc (converge continues, marking degraded)" >&2
    _degraded=1
  fi
  return 0
}

do_ensure_body() {
  local _degraded=0
  ensure_dirs
  _ensure_step packages       ensure_packages
  _ensure_step tailscale-bin  ensure_tailscale_bin
  _ensure_step sshd           ensure_sshd
  _ensure_step forwarding     ensure_forwarding
  _ensure_step tailscaled     start_tailscaled
  wait_for_socket || true
  _ensure_step login          ensure_login
  _ensure_step name           ensure_name
  _ensure_step nat            ensure_nat
  _ensure_step refresh        refresh_exitnode
  # Visibility only — does NOT change the return code (callers depend on a tick
  # not being failed by a degraded converge). A clean pass clears the marker.
  if [ "$_degraded" = 1 ]; then
    date +%s > "$DEGRADED_MARKER" 2>/dev/null || true
  else
    rm -f "$DEGRADED_MARKER" 2>/dev/null || true
  fi
  return 0
}

# do_ensure: take the converge lock with flock -w 60 (bounded WAIT, never
# skip — `boxup once` is AGENT.md's remedy for nearly every symptom, so a tick
# holding the lock must delay converge, not fake it out). ensure_dirs must run
# BEFORE we open the lock file (CONVERGE_LOCK lives in RUN_DIR); if RUN_DIR is
# absent run_with_converge_lock fails open and converge still runs unlocked.
do_ensure() {
  ensure_dirs
  run_with_converge_lock wait do_ensure_body
}

do_update() {
  local url tmp
  url="$(config_get update repo || echo "$DEFAULT_REPO_URL")"
  have git || { log "update: git missing" >&2; return 1; }
  tmp="$(mktemp -d)" || return 1
  log "update: cloning $url"
  if git clone --depth 1 "$url" "$tmp/repo" >/dev/null 2>&1; then
    BOX_SETUP_ROOT="$ROOT" bash "$tmp/repo/install.sh"
    rm -rf "$tmp"
    log "update: installed $(cat "$ROOT/VERSION" 2>/dev/null || echo '?') — run: boxup once"
  else
    rm -rf "$tmp"
    log "update: clone failed" >&2
    return 1
  fi
}

require_root() {
  if [ "$(id -u)" -ne 0 ]; then
    if have sudo; then
      exec sudo env BOX_SETUP_ROOT="$ROOT" \
        BOX_SETUP_CONFIG="${BOX_SETUP_CONFIG:-}" \
        BOX_SETUP_RUN="${BOX_SETUP_RUN:-}" \
        BOX_SETUP_LOG="${BOX_SETUP_LOG:-}" \
        BOX_SSH_PASSWORD="${BOX_SSH_PASSWORD:-}" \
        BOXUP_FORCE_REFRESH="${BOXUP_FORCE_REFRESH:-}" bash "$SELF" "$@"
    fi
    log "boxup: need root" >&2
    exit 1
  fi
}

usage() { sed -n '4,15p' "$0"; }

cmd="${1:-up}"
case "$cmd" in
  once|--once)
    require_root once
    do_ensure
    start_daemon
    run_tick
    print_status
    ;;
  ensure|--ensure)
    require_root ensure
    do_ensure
    ;;
  up|--up|"")
    require_root up
    do_ensure
    start_daemon
    print_status
    ;;
  tick|--tick)
    require_root tick
    run_tick
    ;;
  status|--status)
    print_status
    ;;
  check|--check)
    # Read-only health gate. Delegate to do_check; force the exit code into
    # {0,1} so a bug can never surface as 2 (B2: 2 = "old boxup" to fleetctl).
    if do_check; then exit 0; else exit 1; fi
    ;;
  stop|--stop)
    require_root stop
    stop_daemon
    ;;
  update|--update)
    require_root update
    do_update
    ;;
  worker|--worker)
    worker_loop
    ;;
  version|--version)
    echo "boxup $BOXUP_VERSION"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "boxup: unknown command: $cmd" >&2
    usage >&2
    exit 2
    ;;
esac


