+case "$rp_b" in
+  *'version = "1.80.0"'*"RENDRC=0"*) pass "config render P1: box file present + fleet.toml ABSENT => box keys render, rc 0" ;;
+  *) bad "P1 render (b) lost box keys with fleet absent: [$rp_b]" ;;
