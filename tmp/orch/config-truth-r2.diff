+# --- config-truth operator surface (D7) --------------------------------------
+# fleetctl config render|diff|push <box>. All three REFUSE for boxes not in
+# enrolled.tsv. render = stdout only; push = D5 for ONE box (independent of the
+# reconcile apply flag — the operator canary + the empirical gate's live tool);
+# diff = push_managed --dry-run + a unified diff of on-box vs rendered, fetching
+# the on-box file in the SAME round trip (remote prints it after a `---FILE---`
+# marker), exit 1 on drift / 0 in sync; ALWAYS annotates enabled=false /
+# enabled=unknown / support=no as "pushed values are IGNORED/unverifiable on
+# this box" so it never reports in-sync for an ignored or unverifiable file.
+cmd_config_enrolled() {
+  local box="$1" b
+  while IFS= read -r b; do [ "$b" = "$box" ] && return 0; done < <(reconcile_target_boxes)
+  return 1
+}
