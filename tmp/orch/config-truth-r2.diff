+        return 2
+      fi
+      want_sha="$(printf '%s\n' "$text" | sha256sum | awk '{print $1}')"
+      local remote
+      remote="$(managed_remote_script "$want_sha" 1)"
+      out="$(printf '%s\n' "$text" | tunnel_ssh "$box" "sudo sh -c '$remote'" 2>/dev/null)"
+      rc=$?
+      if [ "$rc" != 0 ]; then
+        echo "fleetctl config diff: $box unreachable/failed (rc=$rc)" >&2
+        return 2
+      fi
+      # Split at the ---FILE--- marker.
+      local statusline onbox cur support enabled tok
+      statusline="$(printf '%s\n' "$out" | awk '/(^| )cur=/{print; exit}')"
+      onbox="$(printf '%s\n' "$out" | awk 'f{print} /^---FILE---$/{f=1}')"
+      cur=""; support=""; enabled=""
+      for tok in $statusline; do
+        case "$tok" in
+          cur=*)     cur="${tok#cur=}" ;;
+          support=*) support="${tok#support=}" ;;
+          enabled=*) enabled="${tok#enabled=}" ;;
+        esac
+      done
+      # Unified diff: on-box (current) vs rendered (desired).
+      diff -u <(printf '%s\n' "$onbox") <(printf '%s\n' "$text") \
+        --label "on-box:$box/managed.toml" --label "rendered:$box" || true
+      # ALWAYS annotate an ignored/unverifiable file so we never report in-sync for one.
+      if [ "$enabled" = false ]; then
+        echo "NOTE: [managed] enabled=false on $box — pushed values are IGNORED on this box"
+      fi
+      if [ "$enabled" = unknown ]; then
+        echo "NOTE: could not read [managed] enabled on $box (managed-status probe failed) — cannot confirm pushed values are honoured"
+      fi
+      if [ "$support" = no ]; then
+        echo "NOTE: boxup on $box lacks managed support — pushed values are IGNORED (deploy boxup first)"
+      fi
+      # Exit 1 on drift, 0 in sync. An ignored OR unverifiable file is NEVER
+      # reported in sync (enabled must be positively not-false and not-unknown).
+      if [ "$cur" = "$want_sha" ] && [ "$enabled" != false ] && [ "$enabled" != unknown ] && [ "$support" != no ]; then
+        return 0
+      fi
+      return 1
+      ;;
+  esac
+}
