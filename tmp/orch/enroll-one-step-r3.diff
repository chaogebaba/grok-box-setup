+# --- box-side [fleet] block (close the two-part-enroll gap) -------------------
+# enroll_write_box_config <box> <vps> <box_index> [port]: write the box's OWN
+# config.toml [fleet] block over the SAME OpenSSH-on-the-tailnet channel enroll
+# used to READ the tunnel pubkey (box_ssh + sudo — config.toml is root-owned
+# under /workspace). Sets  vps = "<vps>"  and  box_index = <N>  (and  port = P
+# only when P != 22, D3b) so the box's reverse tunnel comes up on the next
+# `boxup once` with NO manual hand-edit (the historical gap: enroll installed
+# the VPS-side key but left the box side unconfigured, so the tunnel stayed
+# dead until someone edited config.toml).
+#
+# IDEMPOTENT + byte-preserving (D3): an awk pass produces the DESIRED file; the
+# remote script then `cmp`s it against the original — identical => NO write at
+# all (the file, its bytes, and its mode are left completely untouched), so a
+# re-enroll with the same values is a true no-op. Differing values are REPLACED
+# in place (only the key lines change; every other byte is preserved) and the
+# block is NEVER duplicated. Three states: (a) an ACTIVE key line => replace its
+# value in place; (b) a key present only COMMENTED => insert the live line right
+# after the comment (comment kept); (c) [fleet] header absent => append
+# header+keys at EOF (never bare keys at EOF — boxup's awk reader would bind
+# them to the last-seen table). The atomic replace keeps mode 600 (config.toml
+# holds the ssh password; it must not widen).
+#
+# When port == 22 (D3b) the port key is OMITTED entirely: an active port line is
+# DROPPED, a commented one is left untouched, and none is added — the box
+# default (boxup reads [fleet].port default 22) stands.
+#
+# D9 remote exit codes: 0 = ok/no-op, 4 = config file ABSENT (distinct — the
+# caller maps ONLY this to "run install.sh on the box first"), any other =
+# write failure. A transport/ssh failure (box_ssh itself fails, no remote exit
+# code) is NOT exit-4 and falls to the D8 generic write-failure contract. The
+# file is NEVER created here.
+#
+# D10 post-write verification: after a successful write (or no-op) the function
+# reads EVERY key it wrote back off the box and asserts the value matches;
+# vps and box_index always, port ONLY when it was written (!= 22). A mismatch
+# is treated exactly as a write failure (return 1).
+#
+# The awk grammar mirrors boxup's config reader: [table] headers, and an ACTIVE
+# key line is `key = value` with optional leading blanks; a `#`-commented line
+# is inert (so the seeded template's `#vps = ...` does not count as set). vps,
+# box_index and port arrive as the remote script's positional args, and
+# box_index/port are validated integers and vps the operator-controlled
+# address, so none can inject shell/awk code. The remote script is delivered on
+# STDIN (sh -s), NOT embedded in a quoted bash string, so awk's own single
+# quotes do not fight the laptop-side quoting.
+enroll_write_box_config() {
+  local box="$1" vps="$2" idx="$3" port="${4:-22}"
+  # want_port="" tells the remote awk to OMIT the port key entirely (drop any
+  # active line, add none); a non-empty value writes/replaces port = <value>.
+  local want_port=""
+  [ "$port" != 22 ] && want_port="$port"
+  # The remote script (POSIX sh): read config.toml, produce the DESIRED file via
+  # awk, cmp against the original (identical => true no-op, mode untouched),
+  # else atomic replace at mode 600. $1=vps $2=box_index, $3=config path.
+  local remote='
+set -e
+want_vps="$1"; want_idx="$2"; cf="$3"; want_port="$4"
+[ -f "$cf" ] || { echo "enroll: box config not found: $cf" >&2; exit 4; }
+tmp="$(mktemp "${cf}.enroll.XXXXXX")" || exit 1
+awk -v want_vps="$want_vps" -v want_idx="$want_idx" -v want_port="$want_port" '"'"'
+  function trim(s){ sub(/^[ \t\r]+/,"",s); sub(/[ \t\r]+$/,"",s); return s }
+  # key of an ACTIVE line (uncommented "key = value"); "" otherwise.
+  function active_key(line,   t,eq){
+    t=trim(line)
+    if (t=="" || substr(t,1,1)=="#") return ""
+    eq=index(t,"="); if (eq==0) return ""
+    return trim(substr(t,1,eq-1))
+  }
+  # key of a COMMENTED line ("#key = value" / "# key = value"); "" otherwise.
+  function comment_key(line,   t,eq){
+    t=trim(line)
+    if (substr(t,1,1)!="#") return ""
+    sub(/^#[ \t]*/,"",t)
+    eq=index(t,"="); if (eq==0) return ""
+    return trim(substr(t,1,eq-1))
+  }
+  function vps_line()  { return "vps = \"" want_vps "\"" }
+  function idx_line()  { return "box_index = " want_idx }
+  function port_line() { return "port = " want_port }
+  # flush the active keys not yet emitted, at the end of the [fleet] block.
+  function flush_fleet() {
+    if (!wrote_vps)  { print vps_line();  wrote_vps=1 }
+    if (!wrote_idx)  { print idx_line();  wrote_idx=1 }
+    if (want_port!="" && !wrote_port) { print port_line(); wrote_port=1 }
+  }
+  BEGIN { in_fleet=0; seen_fleet=0; wrote_vps=0; wrote_idx=0; wrote_port=0
+          scan=1; have_vps=0; have_idx=0; have_port=0 }
+  # PASS 1 (NR==FNR): note which ACTIVE keys already exist in [fleet], so PASS 2
+  # only inserts a live line after a COMMENTED key when NO active line exists
+  # for it (otherwise the active line replace + the comment insert would BOTH
+  # fire and duplicate the key — the byte-identical no-op would break).
+  NR==FNR {
+    t=trim($0)
+    if (t ~ /^\[/) { scan=(t=="[fleet]"); next }
+    if (scan) {
+      ak=active_key($0)
+      if (ak=="vps") have_vps=1
+      if (ak=="box_index") have_idx=1
+      if (ak=="port") have_port=1
+    }
+    next
+  }
+  # PASS 2 (the real rewrite).
+  /^[ \t]*\[/ {
+    t=trim($0)
+    if (in_fleet) { flush_fleet(); in_fleet=0 }
+    if (t=="[fleet]") { in_fleet=1; seen_fleet=1 }
+    print; next
+  }
+  {
+    if (in_fleet) {
+      ak=active_key($0)
+      # (a) replace an active key value in place.
+      if (ak=="vps")       { print vps_line();  wrote_vps=1;  next }
+      if (ak=="box_index") { print idx_line();  wrote_idx=1;  next }
+      if (ak=="port") {
+        # want_port set => replace; want_port "" (port 22) => DROP the line.
+        if (want_port!="") { print port_line(); wrote_port=1 }
+        next
+      }
+      # (b) a COMMENTED key with NO active counterpart: keep the comment, insert
+      # the live line right after it (first sight only).
+      ck=comment_key($0)
+      if (ck=="vps" && !have_vps && !wrote_vps)             { print; print vps_line();  wrote_vps=1;  next }
+      if (ck=="box_index" && !have_idx && !wrote_idx)       { print; print idx_line();  wrote_idx=1;  next }
+      if (ck=="port" && want_port!="" && !have_port && !wrote_port) { print; print port_line(); wrote_port=1; next }
+    }
+    print
+  }
+  END {
+    # (b/end) still inside [fleet] at EOF: flush any remaining active keys.
+    if (in_fleet) { flush_fleet() }
+    # (c) no [fleet] header anywhere: append the whole block at EOF.
+    else if (!seen_fleet) {
+      print "[fleet]"
+      print vps_line()
+      print idx_line()
+      if (want_port!="") print port_line()
+    }
+  }
+'"'"' "$cf" "$cf" > "$tmp"
+if cmp -s "$cf" "$tmp"; then
+  rm -f "$tmp"
+  exit 0
+fi
+chmod 600 "$tmp"
+mv -f "$tmp" "$cf"
+chmod 600 "$cf"
+'
+  printf '%s' "$remote" | box_ssh "$box" "sudo sh -s -- '$vps' '$idx' '$BOX_CONFIG' '$want_port'" >/dev/null 2>&1
+  local wrc=$?
+  # D9: return the remote's exit-4 (config ABSENT) VERBATIM so the caller can
+  # emit the distinct "run install.sh on the box first" message. Any OTHER
+  # non-zero (including a transport/ssh failure, which never yields 4) is a
+  # generic write failure (return 1) — the file is never created here.
+  if [ "$wrc" = 4 ]; then
+    return 4
+  elif [ "$wrc" != 0 ]; then
+    return 1
+  fi
+
+  # D10 post-write verification: read back EVERY key we wrote and assert. vps
+  # and box_index always; port ONLY when it was written (want_port non-empty).
+  # A read-back mismatch is treated exactly as a write failure. The reader is
+  # the same awk grammar boxup uses (config_get parses [fleet].<key> off the
+  # box), so it sees the ACTIVE line we wrote, not a commented template line.
+  local got_vps got_idx got_port
+  got_vps="$(box_ssh "$box" "sudo sh -c \"awk -F= '/^[[:space:]]*\\[/{s=(\\\$0==\\\"[fleet]\\\")}s&&/^[[:space:]]*vps[[:space:]]*=/{sub(/^[^=]*=[[:space:]]*/,\\\"\\\");gsub(/[\\\"[:space:]]/,\\\"\\\");print;exit}' '$BOX_CONFIG'\"" 2>/dev/null | head -1)"
+  [ "$got_vps" = "$vps" ] || { log "enroll: D10 verify FAILED for $box vps (want '$vps' got '$got_vps')"; return 1; }
+  got_idx="$(box_ssh "$box" "sudo sh -c \"awk -F= '/^[[:space:]]*\\[/{s=(\\\$0==\\\"[fleet]\\\")}s&&/^[[:space:]]*box_index[[:space:]]*=/{sub(/^[^=]*=[[:space:]]*/,\\\"\\\");gsub(/[[:space:]]/,\\\"\\\");print;exit}' '$BOX_CONFIG'\"" 2>/dev/null | head -1)"
+  [ "$got_idx" = "$idx" ] || { log "enroll: D10 verify FAILED for $box box_index (want '$idx' got '$got_idx')"; return 1; }
+  if [ -n "$want_port" ]; then
+    got_port="$(box_ssh "$box" "sudo sh -c \"awk -F= '/^[[:space:]]*\\[/{s=(\\\$0==\\\"[fleet]\\\")}s&&/^[[:space:]]*port[[:space:]]*=/{sub(/^[^=]*=[[:space:]]*/,\\\"\\\");gsub(/[[:space:]]/,\\\"\\\");print;exit}' '$BOX_CONFIG'\"" 2>/dev/null | head -1)"
+    [ "$got_port" = "$want_port" ] || { log "enroll: D10 verify FAILED for $box port (want '$want_port' got '$got_port')"; return 1; }
+  fi
+  return 0
+}
+
