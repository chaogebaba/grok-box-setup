#!/bin/bash
# fleetctl — laptop-side fleet CLI for the grok boxes.
#
# One file, run from the operator's laptop (Fedora: tailscale + ssh + sshpass).
# It is the replacement for ad-hoc `for box in ...; do ssh ...; done` loops:
# discover the grok-box-N nodes on the tailnet and drive boxup on each over ssh.
#
#   fleetctl list            discover boxes (name, tailscale IP, online)
#   fleetctl status [box..]  one boxup status line per box (read-only)
#   fleetctl check           quiet health gate; exit 1 if any box unhealthy
#   fleetctl rollout <box..> deploy git HEAD to boxes; --all for the fleet
#   fleetctl ssh <box> [cmd] convenience ssh wrapper
#   fleetctl install-timer   systemd USER timer running `check --notify` /10min
#   fleetctl remove-timer    tear that timer down
#   fleetctl version | help
#
# The boxes are managed by boxup (/workspace/box-setup/boxup); fleetctl never
# duplicates boxup's logic — for `status` it prints boxup's own status line
# verbatim, and `rollout` runs boxup on the box. Only `rollout` mutates a box.
# Never touches a non-grok machine: it acts only on names matching
# ^grok-box-[0-9]+$ (from `tailscale status`, or a FLEET_BOXES override).
#
# Style follows boxup: bash, `set -u` (not -e), a log() helper, no deps beyond
# tailscale / ssh / sshpass / python3 / git.
set -u

FLEETCTL_VERSION=1.0.0

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"
BOXUP_REMOTE="/workspace/box-setup/boxup"
BOX_USER="box"

# Laptop-side config, distinct from the box's config.toml.
# HOME guard (breaks-if-undone): under `set -u` a bare $HOME here aborts the
# whole script at load — before dispatch — when HOME is unset. The VPS
# fleet-reconcile.service sets FLEET_CONFIG but not HOME, so the default arm is
# never taken there; ${HOME:-} keeps this a plain (possibly empty) expansion
# instead of an "unbound variable" fatal. See docs/FLEET-BRAIN.md decision wall.
CONFIG_FILE="${FLEET_CONFIG:-${HOME:-}/.config/fleetctl/config.toml}"
DEFAULT_SSH_PASSWORD="12345678"

# Concurrency cap for the fan-out commands.
MAX_CONCURRENCY="${FLEET_MAX_CONCURRENCY:-2}"

log() { echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] $*" >&2; }
have() { command -v "$1" >/dev/null 2>&1; }

# --- config.toml -------------------------------------------------------------
# A TOML subset read with awk — copied verbatim from boxup so fleetctl has no
# runtime dependency on the box's copy. Handles [table] headers, "basic" and
# 'literal' strings, bare values and # comments. See boxup for the rationale.
read -r -d '' _FLEET_TOML_AWK <<'AWK' || true
function trim(s) { sub(/^[ \t\r]+/, "", s); sub(/[ \t\r]+$/, "", s); return s }
{
  line = trim($0)
  if (line == "" || line ~ /^#/) next
  if (line ~ /^\[.*\]$/) { sec = trim(substr(line, 2, length(line) - 2)); next }
  eq = index(line, "=")
  if (eq == 0) next
  if (sec != want_t || trim(substr(line, 1, eq - 1)) != want_k) next
  v = trim(substr(line, eq + 1))
  if (substr(v, 1, 1) == "\"") {
    out = ""; i = 2; n = length(v)
    while (i <= n) {
      c = substr(v, i, 1)
      if (c == "\\" && i < n) {
        d = substr(v, i + 1, 1)
        if (d == "n") out = out "\n"
        else if (d == "t") out = out "\t"
        else out = out d
        i += 2; continue
      }
      if (c == "\"") break
      out = out c; i++
    }
    print out; found = 1; exit
  }
  if (substr(v, 1, 1) == "'") {
    rest = substr(v, 2)
    q = index(rest, "'")
    if (q > 0) rest = substr(rest, 1, q - 1)
    print rest; found = 1; exit
  }
  h = index(v, "#")
  if (h > 0) v = trim(substr(v, 1, h - 1))
  print v; found = 1; exit
}
END { exit(found ? 0 : 1) }
AWK

# config_get <table> <key> -> prints value, non-zero when unset.
config_get() {
  [ -f "$CONFIG_FILE" ] || return 1
  awk -v want_t="$1" -v want_k="$2" "$_FLEET_TOML_AWK" "$CONFIG_FILE" 2>/dev/null
}

# SSH password. Precedence: FLEET_SSH_PASSWORD env > config.toml [ssh].password
# > default. Never echoed; only ever passed to sshpass -e via the SSHPASS env
# var (not on the command line, so never visible in ps). Not logged, not
# stored in git.
ssh_password() {
  local p=""
  if [ -n "${FLEET_SSH_PASSWORD:-}" ]; then
    p="$FLEET_SSH_PASSWORD"
  else
    p="$(config_get ssh password || true)"
  fi
  [ -n "$p" ] || p="$DEFAULT_SSH_PASSWORD"
  printf '%s' "$p"
}

# --- discovery ---------------------------------------------------------------
# Print "name<TAB>ip<TAB>online" for every grok-box-N peer, sorted by N. Reads
# tailscale status --json once. Self is excluded (a laptop is never a box).
fleet_discover() {
  tailscale status --json 2>/dev/null | python3 -c '
import json, re, sys
pat = re.compile(r"^grok-box-([0-9]+)$")
rows = []
try:
    d = json.load(sys.stdin)
except Exception:
    d = {}
for peer in (d.get("Peer") or {}).values():
    name = str(peer.get("HostName") or "").strip()
    m = pat.match(name)
    if not m:
        continue
    ips = peer.get("TailscaleIPs") or []
    ip = ""
    for cand in ips:
        if ":" not in str(cand):
            ip = str(cand); break
    if not ip and ips:
        ip = str(ips[0])
    online = "yes" if peer.get("Online") else "no"
    rows.append((int(m.group(1)), name, ip or "-", online))
for _, name, ip, online in sorted(rows):
    print(f"{name}\t{ip}\t{online}")
' 2>/dev/null || true
}

# One field of a discovery row for a given box name. field: ip|online.
fleet_field() {
  local want="$1" field="$2"
  fleet_discover | while IFS=$'\t' read -r name ip online; do
    [ "$name" = "$want" ] || continue
    case "$field" in
      ip) printf '%s' "$ip" ;;
      online) printf '%s' "$online" ;;
    esac
    break
  done
}

# Resolve the target box list. FLEET_BOXES (space-separated) bypasses discovery
# entirely — used for testing unreachable handling with fake names. Otherwise
# use the caller's explicit args, else all discovered boxes.
#   resolve_targets [--online-only] [box...]
resolve_targets() {
  local online_only=0
  if [ "${1:-}" = "--online-only" ]; then online_only=1; shift; fi

  if [ -n "${FLEET_BOXES:-}" ]; then
    # Explicit, intentional split of the space-delimited override (no globbing).
    local -a _fb; read -ra _fb <<< "$FLEET_BOXES"
    [ "${#_fb[@]}" -gt 0 ] && printf '%s\n' "${_fb[@]}"
    return 0
  fi
  if [ "$#" -gt 0 ]; then
    printf '%s\n' "$@"
    return 0
  fi
  if [ "$online_only" = 1 ]; then
    fleet_discover | awk -F'\t' '$3 == "yes" { print $1 }'
  else
    fleet_discover | awk -F'\t' '{ print $1 }'
  fi
}

# --- reachability + ssh ------------------------------------------------------
# Reachable if a 1-packet tailscale ping succeeds OR the peer is Online=true.
# Bounded so a dead box never hangs the fan-out. FLEET_BOXES names that are not
# real peers fail here (ping fails, no Online row) → reported unreachable.
box_reachable() {
  local box="$1"
  if [ "$(fleet_field "$box" online)" = "yes" ]; then
    return 0
  fi
  if have tailscale && \
     timeout 5 tailscale ping -c1 --timeout 3s "$box" >/dev/null 2>&1; then
    return 0
  fi
  return 1
}

# Run a command on a box over ssh. Password from ssh_password, never echoed.
# args after box are passed as a single remote command string.
box_ssh() {
  local box="$1"; shift
  local pw
  pw="$(ssh_password)"
  SSHPASS="$pw" sshpass -e ssh \
    -o StrictHostKeyChecking=accept-new \
    -o ConnectTimeout=6 \
    -o BatchMode=no \
    "$BOX_USER@$box" "$@"
}

# --- list --------------------------------------------------------------------
cmd_list() {
  local any=0
  printf '%-14s %-16s %-6s\n' "NAME" "TAILSCALE IP" "ONLINE"
  while IFS=$'\t' read -r name ip online; do
    [ -n "$name" ] || continue
    any=1
    printf '%-14s %-16s %-6s\n' "$name" "$ip" "$online"
  done <<EOF
$(fleet_discover)
EOF
  [ "$any" = 1 ] || echo "(no grok-box-N peers found on the tailnet)"
}

# --- status ------------------------------------------------------------------
# Print boxup's own status line per box, prefixed by the box name. Offline /
# unreachable boxes are reported but never fail the command (exit 0 always).
#
# Drift detection (D10): parse the v=<version>/<sha> token, compare <sha> to the
# laptop's git HEAD, and append `sha=<sha> drift=yes|no`. A box with no sha (old
# boxup, v=<version> with no /sha) renders `sha=unknown drift=unknown` —
# informational, never a failure. status_one echoes the box's sha as its LAST
# stdout word via a side channel file so cmd_status can build the fleet summary.

# Extract the sha from a boxup status line's v= token: v=5.1.0/abc123 -> abc123;
# v=5.1.0 (old) -> unknown.
status_line_sha() {
  local line="$1" tok v
  for tok in $line; do
    case "$tok" in
      v=*) v="${tok#v=}"
           case "$v" in
             */*) printf '%s' "${v#*/}" ;;
             *)   printf 'unknown' ;;
           esac
           return 0 ;;
    esac
  done
  printf 'unknown'
}

status_one() {
  local box="$1" line sha drift head_sha="$2" shafile="${3:-}"
  if ! box_reachable "$box"; then
    printf '%-14s UNREACHABLE\n' "$box"
    [ -n "$shafile" ] && printf '%s\t%s\n' "$box" "unreachable" >> "$shafile"
    return 0
  fi
  line="$(box_ssh "$box" "sudo $BOXUP_REMOTE status" 2>/dev/null)"
  if [ -z "$line" ]; then
    printf '%-14s UNREACHABLE (ssh/boxup failed)\n' "$box"
    [ -n "$shafile" ] && printf '%s\t%s\n' "$box" "unreachable" >> "$shafile"
    return 0
  fi
  sha="$(status_line_sha "$line")"
  if [ "$sha" = "unknown" ] || [ "$head_sha" = "unknown" ]; then
    drift="unknown"
  elif [ "$sha" = "$head_sha" ]; then
    drift="no"
  else
    drift="yes"
  fi
  printf '%-14s %s sha=%s drift=%s\n' "$box" "$line" "$sha" "$drift"
  [ -n "$shafile" ] && printf '%s\t%s\n' "$box" "$sha" >> "$shafile"
}

cmd_status() {
  local -a targets=()
  while IFS= read -r b; do [ -n "$b" ] && targets+=("$b"); done < <(resolve_targets --online-only "$@")
  if [ "${#targets[@]}" -eq 0 ]; then
    echo "(no target boxes)"
    return 0
  fi
  local head_sha shafile
  head_sha="$(git rev-parse --short HEAD 2>/dev/null || echo unknown)"
  shafile="$(mktemp 2>/dev/null || echo '')"
  local b
  for b in "${targets[@]}"; do
    status_one "$b" "$head_sha" "$shafile"
  done
  # Fleet drift summary: mixed shas across reachable boxes, or any box behind
  # laptop HEAD, is worth one summary line. Never a failure (exit 0).
  if [ -n "$shafile" ] && [ -f "$shafile" ]; then
    local uniq_shas
    uniq_shas="$(awk -F'\t' '$2 != "unreachable" && $2 != "unknown" { print $2 }' "$shafile" | sort -u | wc -l)"
    if [ "$uniq_shas" -gt 1 ]; then
      log "status: fleet is MIXED-version ($uniq_shas distinct shas); laptop HEAD=$head_sha"
    elif [ "$head_sha" != "unknown" ] && \
         awk -F'\t' -v h="$head_sha" '$2 != "unreachable" && $2 != "unknown" && $2 != h { c=1 } END { exit(c?0:1) }' "$shafile"; then
      log "status: some boxes drift from laptop HEAD=$head_sha"
    fi
    rm -f "$shafile"
  fi
  return 0
}

# --- check -------------------------------------------------------------------
# Quiet health gate. The single health definition lives in `boxup check` on the
# box (D6); fleetctl delegates to it and trusts its exit code (0 healthy,
# 1 unhealthy). fleetctl keeps only reachability (ssh failure) as its own layer.
#
# Version-skew fallback (B2): an OLD boxup has no `check` subcommand, so its
# dispatch exits 2 on the unknown command. fleetctl MUST treat exit 2 (or
# unknown-command output) as "old boxup" and fall back to the legacy laptop-side
# parse of `boxup status` — never report a healthy old box as failing (the
# README:77-81 timer fires notify-send -u critical every 10 min, and D7's
# canary-first flow guarantees a mixed-version window).

# Legacy laptop-side parse of `boxup status` — the pre-D6 health definition,
# kept ONLY as the skew fallback for boxes running an old boxup.
check_one_legacy() {
  local box="$1" line
  line="$(box_ssh "$box" "sudo $BOXUP_REMOTE status" 2>/dev/null)"
  if [ -z "$line" ]; then
    echo "$box: unreachable (ssh/boxup failed)"
    return 1
  fi

  # Parse the space-separated key=value status line into fields.
  local backend="" online="" exitn="" sshd="" worker="" tok k v
  for tok in $line; do
    k="${tok%%=*}"; v="${tok#*=}"
    case "$k" in
      backend)   backend="$v" ;;
      online)    online="$v" ;;
      exit-node) exitn="$v" ;;
      sshd)      sshd="$v" ;;
      worker)    worker="$v" ;;
    esac
  done

  local -a problems=()
  [ "$backend" = "Running" ] || problems+=("backend=$backend (want Running)")
  [ "$online" = "yes" ]      || problems+=("online=$online (want yes)")
  [ "$exitn" = "yes" ]       || problems+=("exit-node=$exitn (want yes)")
  [ "$sshd" = "up" ]         || problems+=("sshd=$sshd (want up)")
  # worker field is a pid or '-'; exactly one worker means a numeric pid.
  case "$worker" in
    ''|-|*[!0-9]*) problems+=("worker=${worker:--} (want exactly 1)") ;;
  esac

  if [ "${#problems[@]}" -eq 0 ]; then
    return 0
  fi
  local p
  for p in "${problems[@]}"; do
    echo "$box: $p"
  done
  return 1
}

check_one() {
  # echoes nothing when healthy; "<box>: <problem>" lines otherwise.
  # returns 0 healthy, 1 unhealthy/unreachable.
  local box="$1" out rc
  if ! box_reachable "$box"; then
    echo "$box: unreachable"
    return 1
  fi

  # Delegate to `boxup check`. Capture stdout + exit code together.
  out="$(box_ssh "$box" "sudo $BOXUP_REMOTE check" 2>/dev/null)"
  rc=$?

  # ssh connection failure (255): unreachable, not unhealthy.
  if [ "$rc" = 255 ]; then
    echo "$box: unreachable (ssh failed)"
    return 1
  fi

  # B2 skew fallback: an old boxup exits 2 (unknown subcommand) and/or prints
  # an "unknown command" usage line. Fall back to the legacy status parse so a
  # healthy old box is never reported as failing.
  if [ "$rc" = 2 ] || printf '%s' "$out" | grep -qi 'unknown command'; then
    check_one_legacy "$box"
    return $?
  fi

  if [ "$rc" = 0 ]; then
    return 0
  fi

  # rc == 1 (or any other non-2/255): boxup check said unhealthy. Surface its
  # reason line prefixed by the box name.
  if [ -n "$out" ]; then
    printf '%s: %s\n' "$box" "$out"
  else
    printf '%s: check=FAIL (no output, rc=%s)\n' "$box" "$rc"
  fi
  return 1
}

cmd_check() {
  local notify=0
  if [ "${1:-}" = "--notify" ]; then notify=1; shift; fi

  local -a targets=()
  while IFS= read -r b; do [ -n "$b" ] && targets+=("$b"); done < <(resolve_targets "$@")

  local rc=0 b out
  for b in "${targets[@]}"; do
    if ! out="$(check_one "$b")"; then
      rc=1
      printf '%s\n' "$out"
      if [ "$notify" = 1 ] && have notify-send; then
        while IFS= read -r pl; do
          [ -n "$pl" ] && notify-send -u critical "fleetctl: box unhealthy" "$pl"
        done <<EOF
$out
EOF
      fi
    fi
  done
  return "$rc"
}

# --- rollout -----------------------------------------------------------------
# Deploy the current git HEAD to boxes: git archive HEAD -> tarball -> scp ->
# extract on the box -> install.sh -> boxup once -> print the status line.
# Refuses a dirty tree unless --dirty. Sequential with max 2 concurrent.
# Unreachable boxes are skipped and listed. The box /tmp staging dir is cleaned.
box_scp() {
  local src="$1" box="$2" dst="$3" pw
  pw="$(ssh_password)"
  SSHPASS="$pw" sshpass -e scp \
    -o StrictHostKeyChecking=accept-new \
    -o ConnectTimeout=6 \
    -o BatchMode=no \
    "$src" "$BOX_USER@$box:$dst"
}

# Post-install verification via `boxup check` (D6 = the one health predicate).
# rollout_one has already run `boxup once` synchronously, so hb/sshd/ipfwd are
# fresh and fail FAST. But online=yes / backend=Running / exit-node advertised
# can lag a fresh login/recycle by up to ~2 min (map-poll + need-driven set), so
# those three predicates are RETRYABLE: retry every 15s (worker INTERVAL) up to
# 8 tries (~120s). Any other failing predicate fails fast. We distinguish the
# two by the reason `boxup check` prints (S3/F9).
ROLLOUT_VERIFY_TRIES="${FLEET_VERIFY_TRIES:-8}"
ROLLOUT_VERIFY_INTERVAL="${FLEET_VERIFY_INTERVAL:-15}"

# Returns 0 healthy, 1 unhealthy (after retries). Echoes the final reason.
rollout_verify() {
  local box="$1" i=1 out rc reason
  while :; do
    out="$(box_ssh "$box" "sudo $BOXUP_REMOTE check" 2>/dev/null)"
    rc=$?
    # B2 skew: an old boxup has no `check`. Fall back to the laptop parse once.
    if [ "$rc" = 2 ] || printf '%s' "$out" | grep -qi 'unknown command'; then
      if check_one_legacy "$box" >/dev/null; then echo "OK (legacy)"; return 0; fi
      echo "unhealthy (legacy parse)"; return 1
    fi
    [ "$rc" = 0 ] && { echo "OK"; return 0; }
    reason="${out#check=FAIL reason=}"
    # Retryable only if the FIRST-failed predicate is online/backend/exit-node.
    case "$reason" in
      online=*|backend=*|exit-node*)
        if [ "$i" -ge "$ROLLOUT_VERIFY_TRIES" ]; then
          echo "$reason (still pending after ${i} tries)"; return 1
        fi
        log "verify $box: $reason — retry $i/$ROLLOUT_VERIFY_TRIES in ${ROLLOUT_VERIFY_INTERVAL}s"
        sleep "$ROLLOUT_VERIFY_INTERVAL"
        i=$((i + 1))
        ;;
      *)
        echo "$reason"; return 1   # fail fast
        ;;
    esac
  done
}

# rollout_one <box> <tarball> <statusdir>. Writes its outcome to a PER-BOX file
# <statusdir>/<box> as "<result>\t<detail>" (result = ok|failed|skipped). This
# is the result CHANNEL (F8) — a per-box file, so concurrent rollouts never
# interleave; `wait` alone is not a result channel. Returns 0 ok / 1 failed /
# 2 skipped(unreachable).
rollout_one() {
  local box="$1" tarball="$2" statusdir="$3" \
        remote_tar="/tmp/grok-box-setup-fleet.tar" \
        remote_dir="/tmp/grok-box-setup-fleet" line verify sf
  sf="$statusdir/$box"
  if ! box_reachable "$box"; then
    printf '%s\t%s\n' "skipped" "unreachable" > "$sf"
    printf '%-14s SKIPPED (unreachable)\n' "$box"
    return 2
  fi
  if ! box_scp "$tarball" "$box" "$remote_tar" >/dev/null 2>&1; then
    printf '%s\t%s\n' "failed" "scp" > "$sf"
    printf '%-14s FAILED (scp)\n' "$box"
    return 1
  fi
  # Extract, install, converge. BOX_SETUP_GIT_SHA via `sudo env` (D10/B3).
  if ! box_ssh "$box" "
    set -e
    rm -rf '$remote_dir'
    mkdir -p '$remote_dir'
    tar -xf '$remote_tar' -C '$remote_dir'
    sudo env BOX_SETUP_GIT_SHA='${ROLLOUT_GIT_SHA:-unknown}' bash '$remote_dir/install.sh'
    sudo $BOXUP_REMOTE once >/dev/null 2>&1 || sudo $BOXUP_REMOTE once
  " >/dev/null 2>&1; then
    box_ssh "$box" "rm -rf '$remote_dir' '$remote_tar'" >/dev/null 2>&1 || true
    printf '%s\t%s\n' "failed" "install/once" > "$sf"
    printf '%-14s FAILED (install/once)\n' "$box"
    return 1
  fi
  box_ssh "$box" "rm -rf '$remote_dir' '$remote_tar'" >/dev/null 2>&1 || true

  # Post-install verification (retry online/backend/exit-node lag).
  verify="$(rollout_verify "$box")"
  line="$(box_ssh "$box" "sudo $BOXUP_REMOTE status" 2>/dev/null)"
  case "$verify" in
    OK|"OK (legacy)"|"")
      printf '%s\t%s\n' "ok" "${line:-status?}" > "$sf"
      printf '%-14s %s\n' "$box" "${line:-(status unavailable)}"
      return 0 ;;
  esac
  printf '%s\t%s\n' "failed" "verify: $verify" > "$sf"
  printf '%-14s FAILED (verify: %s)\n' "$box" "$verify"
  return 1
}

# Preflight shared by all rollout forms: git present, in a repo, clean tree
# (unless --dirty), package HEAD into a tarball, stamp ROLLOUT_GIT_SHA. Echoes
# the sha and tarball path (TAB-separated) on stdout; returns nonzero on any
# failure. NOTE: the caller runs this in a command substitution, so any
# variable it sets (e.g. ROLLOUT_GIT_SHA) would be LOST in the subshell — that
# is why the sha is RETURNED on stdout for the parent to assign, not exported
# from here (B3: otherwise the remote install got BOX_SETUP_GIT_SHA='unknown').
rollout_package() {
  local allow_dirty="$1" tarball sha
  have git || { log "rollout: git not found"; return 1; }
  if ! git rev-parse --git-dir >/dev/null 2>&1; then
    log "rollout: not inside a git repository"; return 1
  fi
  if [ "$allow_dirty" = 0 ] && [ -n "$(git status --porcelain 2>/dev/null)" ]; then
    log "rollout: working tree is dirty; commit/stash or pass --dirty"; return 1
  fi
  tarball="$(mktemp --suffix=.tar 2>/dev/null || mktemp)" || {
    log "rollout: mktemp failed"; return 1; }
  if ! git archive --format=tar -o "$tarball" HEAD 2>/dev/null; then
    rm -f "$tarball"; log "rollout: git archive HEAD failed"; return 1
  fi
  sha="$(git rev-parse --short HEAD 2>/dev/null || echo unknown)"
  log "rollout: packaged HEAD $sha -> $(basename "$tarball")"
  printf '%s\t%s' "$sha" "$tarball"
}

# Roll a list of boxes with bounded concurrency + an abort brake. The abort
# flag is a file; it is checked BEFORE each new dispatch (F8), so a verified
# failure stops NEW dispatches while in-flight boxes finish and report.
# Args: <tarball> <statusdir> <abortfile> <box...>
rollout_batch() {
  local tarball="$1" statusdir="$2" abortfile="$3"; shift 3
  local b rc1
  for b in "$@"; do
    if [ -f "$abortfile" ]; then
      printf '%s\t%s\n' "skipped" "aborted" > "$statusdir/$b"
      printf '%-14s SKIPPED (rollout aborted)\n' "$b"
      continue
    fi
    while [ "$(jobs -rp | wc -l)" -ge "$MAX_CONCURRENCY" ]; do
      wait -n 2>/dev/null || wait
    done
    # Re-check the abort flag AFTER the capacity wait and immediately before
    # dispatch: an in-flight box can trip the brake while we were blocked in
    # `wait -n`, and dispatching now would violate "no NEW dispatches after a
    # verified failure" (repro: concurrency=1, b1 fails then b2 starts).
    if [ -f "$abortfile" ]; then
      printf '%s\t%s\n' "skipped" "aborted" > "$statusdir/$b"
      printf '%-14s SKIPPED (rollout aborted)\n' "$b"
      continue
    fi
    (
      # A verified failure (rc 1) trips the abort brake for subsequent
      # dispatches; an unreachable skip (rc 2) does not.
      rollout_one "$b" "$tarball" "$statusdir"; rc1=$?
      [ "$rc1" = 1 ] && : > "$abortfile"
    ) &
  done
  wait
}

# Print the deployed/skipped/failed summary from the per-box status files +
# each box's version+sha (D10). Returns 0 iff no box failed.
rollout_summary() {
  local statusdir="$1" rc=0 sf box result detail v
  echo "---- rollout summary ----"
  for sf in "$statusdir"/*; do
    [ -f "$sf" ] || continue
    box="$(basename "$sf")"
    IFS=$'\t' read -r result detail < "$sf"
    case "$result" in
      ok)
        v="$(printf '%s' "$detail" | grep -o 'v=[^ ]*' || echo v=?)"
        printf '  %-14s OK       %s\n' "$box" "$v" ;;
      skipped) printf '  %-14s SKIPPED  (%s)\n' "$box" "$detail" ;;
      failed)  printf '  %-14s FAILED   (%s)\n' "$box" "$detail"; rc=1 ;;
    esac
  done
  return "$rc"
}

cmd_rollout() {
  local allow_dirty=0 all=0 canary="grok-box-5"
  # Flag parse: --dirty, --all, --canary <box>. Remaining args are explicit
  # targets. Order-independent for the flags.
  local -a rest=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dirty)  allow_dirty=1; shift ;;
      --all)    all=1; shift ;;
      --canary) canary="${2:-}"; shift 2 || { log "rollout: --canary needs a box"; return 2; } ;;
      *)        rest+=("$1"); shift ;;
    esac
  done

  # CLI contract (D7): explicit targets OR --all. A bare `rollout` is a usage
  # error naming the two valid forms — full-fleet must be opt-in via --all.
  if [ "$all" = 0 ] && [ "${#rest[@]}" -eq 0 ] && [ -z "${FLEET_BOXES:-}" ]; then
    log "rollout: refusing to guess targets. Use:"
    log "  fleetctl rollout <box...>      deploy to explicit boxes"
    log "  fleetctl rollout --all         deploy to the whole fleet (canary first)"
    return 2
  fi

  local tarball statusdir abortfile rc=0 b crc pkg
  # rollout_package returns "<sha>\t<tarball>" on stdout so the sha assignment
  # survives into THIS shell (a subshell assignment inside $(...) would be lost,
  # and the remote install would run BOX_SETUP_GIT_SHA='unknown' — B3).
  pkg="$(rollout_package "$allow_dirty")" || return 1
  ROLLOUT_GIT_SHA="${pkg%%$'\t'*}"
  tarball="${pkg#*$'\t'}"
  statusdir="$(mktemp -d)"; abortfile="$(mktemp)"; rm -f "$abortfile"

  if [ "$all" = 1 ]; then
    # Canary-first. An UNREACHABLE canary ABORTS (S2): rolling the whole fleet
    # unverified is worse than stopping and letting the operator pick another.
    log "rollout --all: canary=$canary (override with --canary <box>)"
    if ! box_reachable "$canary"; then
      log "rollout: canary $canary is UNREACHABLE — aborting. Pick a reachable"
      log "         canary with: fleetctl rollout --all --canary <other-box>"
      rm -rf "$tarball" "$statusdir" "$abortfile"
      return 1
    fi
    rollout_one "$canary" "$tarball" "$statusdir"; crc=$?
    if [ "$crc" != 0 ]; then
      log "rollout: canary $canary FAILED verification — aborting, ZERO other boxes touched"
      log "         last-good redeploy after fixing: fleetctl rollout $canary"
      rollout_summary "$statusdir"
      rm -rf "$tarball" "$statusdir" "$abortfile"
      return 1
    fi
    log "rollout: canary $canary verified — rolling the rest"
    # The rest = all discovered boxes minus the canary.
    local -a therest=()
    while IFS= read -r b; do
      [ -n "$b" ] && [ "$b" != "$canary" ] && therest+=("$b")
    done < <(resolve_targets)
    rollout_batch "$tarball" "$statusdir" "$abortfile" "${therest[@]}"
  else
    # Explicit targets (or FLEET_BOXES). No canary gate; still abort-on-failure.
    local -a targets=()
    while IFS= read -r b; do [ -n "$b" ] && targets+=("$b"); done < <(resolve_targets "${rest[@]}")
    rollout_batch "$tarball" "$statusdir" "$abortfile" "${targets[@]}"
  fi

  rollout_summary "$statusdir"; rc=$?
  if [ -f "$abortfile" ]; then
    log "rollout: ABORTED on a verified failure — no new dispatches after it"
    log "         redeploy the last-good sha after fixing: fleetctl rollout --all"
    rc=1
  fi
  rm -rf "$tarball" "$statusdir" "$abortfile"
  return "$rc"
}

# --- ssh ---------------------------------------------------------------------
cmd_ssh() {
  local box="${1:-}"
  if [ -z "$box" ]; then
    log "usage: fleetctl ssh <box> [cmd...]"
    return 2
  fi
  shift
  if [ "$#" -gt 0 ]; then
    box_ssh "$box" "$*"
  else
    # Interactive session.
    local pw; pw="$(ssh_password)"
    SSHPASS="$pw" sshpass -e ssh \
      -o StrictHostKeyChecking=accept-new \
      -o ConnectTimeout=6 \
      -o BatchMode=no \
      "$BOX_USER@$box"
  fi
}

# --- systemd user timer ------------------------------------------------------
# HOME guard (breaks-if-undone): top-level assignment, evaluated at load under
# `set -u`. A bare $HOME aborts the whole script (incl. the reconcile path,
# which runs under systemd with no HOME) before any command dispatch. The
# install-timer/remove-timer commands that USE this are only ever run
# interactively with a real HOME; ${HOME:-} just keeps load-time safe.
UNIT_DIR="${HOME:-}/.config/systemd/user"
UNIT_SERVICE="$UNIT_DIR/fleetctl-check.service"
UNIT_TIMER="$UNIT_DIR/fleetctl-check.timer"

cmd_install_timer() {
  have systemctl || { log "install-timer: systemctl not found"; return 1; }
  mkdir -p "$UNIT_DIR"
  cat > "$UNIT_SERVICE" <<EOF
[Unit]
Description=fleetctl health check (grok box fleet)

[Service]
Type=oneshot
ExecStart=$SELF check --notify
EOF
  cat > "$UNIT_TIMER" <<EOF
[Unit]
Description=Run fleetctl check every 10 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=10min
AccuracySec=1min
Persistent=true

[Install]
WantedBy=timers.target
EOF
  systemctl --user daemon-reload
  systemctl --user enable --now fleetctl-check.timer
  log "install-timer: enabled fleetctl-check.timer (every 10min, check --notify)"
  log "install-timer: units at $UNIT_TIMER"
}

cmd_remove_timer() {
  have systemctl || { log "remove-timer: systemctl not found"; return 1; }
  systemctl --user disable --now fleetctl-check.timer >/dev/null 2>&1 || true
  rm -f "$UNIT_TIMER" "$UNIT_SERVICE"
  systemctl --user daemon-reload
  log "remove-timer: removed fleetctl-check timer + service"
}

# =============================================================================
# BRAIN subcommands (docs/FLEET-BRAIN.md) — the VPS-side always-on reconciler.
#
# These run from the VPS (/opt/grok-fleet/fleetctl under a systemd timer) and
# ALSO from the laptop for manual enroll/mint. They are a DISTINCT concern from
# the laptop-side list/status/check/rollout above: they use the Tailscale API
# (write-scoped PAT from a 600 file, NEVER argv/log) + per-box reverse-SSH
# tunnels + OpenSSH-over-the-tailnet enrollment. Deps: curl + jq + ssh only
# (VPS budget: bash+curl+jq+ssh, no python service).
#
# The brain reaches an enrolled box ONLY as `box@127.0.0.1 -p 2000N` over that
# box's reverse tunnel, using the VPS's own ed25519 key (Resolved decision 7);
# enrollment/first-contact reach the box over OpenSSH on the tailnet
# (`ssh box@grok-box-N`) because Tailscale SSH is off fleet-wide (--ssh=false).
# =============================================================================

TS_API="${FLEET_TS_API:-https://api.tailscale.com/api/v2}"
TS_TAILNET="${FLEET_TS_TAILNET:--}"          # "-" = the token's default tailnet
FLEET_ETC="${FLEET_ETC:-/etc/grok-fleet}"
FLEET_STATE="${FLEET_STATE:-/var/lib/grok-fleet}"
# The VPS-side user whose ~/.ssh/authorized_keys carries the per-box tunnel
# lines. sshd privsep reads this file AS this user, so the dir + file MUST end
# up owned by it (BUG-E): a root:root authorized_keys yields StrictModes/privsep
# "Could not open user 'fleet' authorized keys ... Permission denied" and every
# tunnel fails publickey. Honors FLEET_USER (install-vps.sh's name) too.
FLEET_VPS_USER="${FLEET_VPS_USER:-${FLEET_USER:-fleet}}"
FLEET_TELEGRAM_ENV="${FLEET_TELEGRAM_ENV:-$FLEET_ETC/telegram.env}"
# The box-side tunnel key + boxup live under /workspace on the box.
BOX_ROOT="/workspace/box-setup"
BOX_TUNNEL_PUB="$BOX_ROOT/secrets/tunnel_ed25519.pub"
BOX_AUTHKEY="$BOX_ROOT/secrets/ts-authkey"
BOX_AUTHKEY_TMP="$BOX_ROOT/secrets/.ts-authkey.tmp"
BOX_AUTHKEY_EXPIRES="$BOX_ROOT/secrets/ts-authkey.expires"
# VPS's own key that authenticates the brain INTO each box (over the tunnel);
# its PUBKEY is what enroll installs into the box's authorized_keys.
FLEET_BOX_KEY="${FLEET_BOX_KEY:-$FLEET_ETC/box_access_ed25519}"
# Key expiry cap: 90 days (Tailscale max). Rotation trigger: < 7 days.
FLEET_KEY_EXPIRY_SECS="${FLEET_KEY_EXPIRY_SECS:-7776000}"     # 90d
FLEET_ROTATE_BEFORE_SECS="${FLEET_ROTATE_BEFORE_SECS:-604800}" # 7d
# Per-box minted-key metadata (id + expires) so a rotation knows the OLD key id
# to revoke. Written at mint time (row a/c), read on rotate. NOT a secret (the
# key MATERIAL never lands here — only its id/expiry), so mode 600 is belt-and-
# braces, not strictly required.
FLEET_KEYS_DIR="${FLEET_KEYS_DIR:-$FLEET_STATE/keys}"

# key_meta_file <N|grok-box-N> -> /var/lib/grok-fleet/keys/<N>.json
key_meta_file() {
  local n; n="$(box_index "$1")" || return 1
  printf '%s/%s.json' "$FLEET_KEYS_DIR" "$n"
}

# key_meta_id <box> -> the recorded minted key id, or empty if none/unparseable.
key_meta_id() {
  local f; f="$(key_meta_file "$1")" || return 1
  [ -f "$f" ] || return 1
  jq -r '.id // empty' "$f" 2>/dev/null
}

# port_for <N|grok-box-N> -> 20000+N. The deterministic per-box loopback port.
port_for() {
  local n="$1"
  n="${n#grok-box-}"
  case "$n" in ''|*[!0-9]*) return 1 ;; esac
  printf '%s' "$((20000 + n))"
}

# box_index <name> -> N (integer) from grok-box-N.
box_index() {
  local n="${1#grok-box-}"
  case "$n" in ''|*[!0-9]*) return 1 ;; esac
  printf '%s' "$n"
}

# --- notify() (Q4) -----------------------------------------------------------
# notify <level> <msg...>: ALWAYS to stderr/journal; ALSO to Telegram iff
# $FLEET_TELEGRAM_ENV (600, TELEGRAM_BOT_TOKEN=/TELEGRAM_CHAT_ID=) exists. No
# bot => journal-only, no error. The token is never echoed.
notify() {
  local level="$1"; shift
  local msg="$*"
  log "notify[$level]: $msg"
  [ -f "$FLEET_TELEGRAM_ENV" ] || return 0
  local tok="" chat=""
  # Source in a subshell so the token never lands in this shell's env/ps.
  # shellcheck disable=SC1090
  tok="$( . "$FLEET_TELEGRAM_ENV" 2>/dev/null; printf '%s' "${TELEGRAM_BOT_TOKEN:-}" )"
  # shellcheck disable=SC1090
  chat="$( . "$FLEET_TELEGRAM_ENV" 2>/dev/null; printf '%s' "${TELEGRAM_CHAT_ID:-}" )"
  [ -n "$tok" ] && [ -n "$chat" ] || return 0
  have curl || return 0
  curl -fsS --max-time 10 \
    -d "chat_id=$chat" \
    --data-urlencode "text=[grok-fleet/$level] $msg" \
    "https://api.telegram.org/bot${tok}/sendMessage" >/dev/null 2>&1 || \
    log "notify: Telegram POST failed (journal alert still delivered)"
  return 0
}

# --- API token (read from a 600 file, NEVER argv/log) ------------------------
# Precedence: FLEET_API_TOKEN_FILE env > config [fleet-brain].api_token_file >
# $FLEET_ETC/api-token. The token VALUE is only ever passed to curl via a
# header from an env var in a subshell, never on the command line.
api_token_file() {
  local f="${FLEET_API_TOKEN_FILE:-}"
  [ -n "$f" ] || f="$(config_get fleet-brain api_token_file || true)"
  [ -n "$f" ] || f="$FLEET_ETC/api-token"
  printf '%s' "$f"
}

# api_token -> the token string on stdout, or non-zero if the file is missing.
api_token() {
  local f; f="$(api_token_file)"
  [ -f "$f" ] || { log "api: token file not found: $f"; return 1; }
  tr -d '[:space:]' < "$f"
}

# ts_api <method> <path> [json-body]: perform the request. The response BODY is
# written to $TS_API_LAST_BODY and the HTTP status to $TS_API_CODE. It ALSO
# echoes the body on stdout for convenience — BUT because a `$(...)` capture
# runs in a subshell where the TS_API_CODE global assignment would be LOST, the
# reliable pattern for callers that need the code is:
#     ts_api GET /path            # no $() capture
#     [ "$TS_API_CODE" -ge 200 ] && body="$(ts_api_body)"
# ts_api_body reads the file, so it survives the subshell problem. The token is
# passed via a curl --config file (mode 600, removed immediately), NEVER on argv
# and NEVER in an env var visible to child processes (P1-7: no ps/procfs leak).
TS_API_CODE=0
TS_API_LAST_BODY=""
# B-1 run-wide READ-ONLY latch: once any API interaction in a reconcile run
# fails (non-2xx, malformed 200, or an action-time API failure), NO further
# mutation (mint/delete/rename) may run for the REST of that run. Fail-closed is
# a whole-run property, not per-call. Default 0 outside a run.
RECONCILE_READONLY=0
ts_api() {
  local method="$1" path="$2" body="${3:-}" tok code
  have curl || { log "api: curl not found"; TS_API_CODE=0; return 1; }
  tok="$(api_token)" || { TS_API_CODE=0; return 1; }
  [ -n "$TS_API_LAST_BODY" ] || TS_API_LAST_BODY="$(mktemp)"
  # P1-7: the write-scoped PAT is NEVER put on curl's argv (it would be visible
  # to any same-host `ps`/procfs reader). Instead the Authorization header is
  # written to a mode-600 curl --config file, which curl reads and never
  # exposes on the command line. The config file is removed immediately after.
  local cfg; cfg="$(mktemp 2>/dev/null)" || { log "api: mktemp for curl config failed"; TS_API_CODE=0; return 1; }
  chmod 600 "$cfg" 2>/dev/null || true
  # curl --config syntax: `header = "..."`. The token value lives ONLY here,
  # in a 600 file, never in argv/env-visible-to-children.
  {
    printf 'header = "Authorization: Bearer %s"\n' "$tok"
    # BUG-D (breaks-if-undone): without an explicit `Accept: application/json`,
    # the Tailscale API serves the ACL endpoint (GET /tailnet/-/acl) as HuJSON
    # (leading // comments, trailing commas) — which `jq -e` rejects rc=5, so
    # acl_has_fleet_brain_tagowner() fails and `enroll` refuses even when
    # tagOwners is correct (proven live on the VPS). Send Accept on EVERY call
    # so every endpoint returns strict JSON.
    printf 'header = "Accept: application/json"\n'
    if [ -n "$body" ]; then
      printf 'header = "Content-Type: application/json"\n'
    fi
  } > "$cfg"
  local -a args=(-fsS -X "$method" --max-time 30
    -o "$TS_API_LAST_BODY" -w '%{http_code}'
    --config "$cfg")
  if [ -n "$body" ]; then
    args+=(-d "$body")
  fi
  # -f makes curl exit non-zero on HTTP >=400 but -w still prints the code; we
  # read the code from -w regardless of curl's own rc.
  code="$(curl "${args[@]}" "$TS_API$path" 2>/dev/null || true)"
  rm -f "$cfg" 2>/dev/null || true
  case "$code" in ''|*[!0-9]*) code=0 ;; esac
  TS_API_CODE="$code"
  cat "$TS_API_LAST_BODY" 2>/dev/null
  [ "$code" -ge 200 ] && [ "$code" -lt 300 ]
}

# ts_api_body: the body of the LAST ts_api call (survives a subshell capture of
# ts_api's stdout, which loses the TS_API_CODE global).
ts_api_body() { [ -n "$TS_API_LAST_BODY" ] && cat "$TS_API_LAST_BODY" 2>/dev/null; }

# ts_ok: 0 iff the last TS_API_CODE was 2xx.
ts_ok() { [ "$TS_API_CODE" -ge 200 ] 2>/dev/null && [ "$TS_API_CODE" -lt 300 ] 2>/dev/null; }

# --- enroll ------------------------------------------------------------------
# fleetctl enroll <box>: brain-initiated, tailnet-gated, one-time.
#   1. PRECHECK tag:fleet-brain in tagOwners via GET /acl; refuse if absent.
#   2. read the box's tunnel PUBKEY over OpenSSH on the tailnet
#      (`ssh box@grok-box-N sudo cat .../tunnel_ed25519.pub`).
#   3. install a locked-down authorized_keys line for fleet@vps on the VPS.
#   4. install the VPS's box-access PUBKEY into the box user's authorized_keys.
#
# The authorized_keys line shape (the security control, §2):
#   restrict,port-forwarding,permitlisten="127.0.0.1:2000N" ssh-ed25519 AAAA... comment
authorized_keys_line() {
  local port="$1" pubkey="$2"
  printf 'restrict,port-forwarding,permitlisten="127.0.0.1:%s" %s' "$port" "$pubkey"
}

# acl_has_fleet_brain_tagowner: GET /acl, return 0 iff tagOwners has an entry
# for "tag:fleet-brain". The ACL is stored as HuJSON (// comments, trailing
# commas) which jq CANNOT parse — so ts_api MUST send `Accept: application/json`
# (BUG-D) to make the API return strict JSON on GET. Without that header the
# body is HuJSON, jq -e exits rc=5, and enroll refuses even when the tagOwner
# entry is present.
acl_has_fleet_brain_tagowner() {
  ts_api GET "/tailnet/$TS_TAILNET/acl" >/dev/null
  ts_ok || return 2                                   # API failure (fail-closed)
  ts_api_body | jq -e '.tagOwners | has("tag:fleet-brain")' >/dev/null 2>&1
}

cmd_enroll() {
  local box="${1:-}"
  [ -n "$box" ] || { log "usage: fleetctl enroll <grok-box-N>"; return 2; }
  case "$box" in grok-box-[0-9]*) : ;; *) log "enroll: refusing non-grok box '$box'"; return 2 ;; esac
  local n port; n="$(box_index "$box")" || { log "enroll: bad box name '$box'"; return 2; }
  port="$(port_for "$box")"

  # (1) ACL precheck (Q3). Refuse on absent; refuse on API failure (fail-closed).
  local acl_rc
  acl_has_fleet_brain_tagowner; acl_rc=$?
  if [ "$acl_rc" = 2 ]; then
    log "enroll: ACL read FAILED (HTTP $TS_API_CODE) — refusing (cannot confirm tag:fleet-brain tagOwners)"
    return 1
  fi
  if [ "$acl_rc" != 0 ]; then
    log "enroll: REFUSING — 'tag:fleet-brain' has no tagOwners entry in the ACL."
    log "enroll: add  \"tag:fleet-brain\": [\"autogroup:admin\"]  to tagOwners first (Resolved decision 3),"
    log "enroll: else a tagged rejoin fails opaquely."
    return 1
  fi

  # (2) read the box's tunnel pubkey over OpenSSH on the tailnet. The box
  # generates its keypair on first `boxup once`; if absent, tell the operator.
  log "enroll: reading $box tunnel pubkey over OpenSSH on the tailnet"
  local pubkey
  pubkey="$(enroll_read_box_pubkey "$box")" || {
    log "enroll: could not read $BOX_TUNNEL_PUB on $box (is it on the tailnet? has boxup run once?)"
    return 1
  }
  case "$pubkey" in ssh-ed25519\ *) : ;; *) log "enroll: unexpected pubkey shape from $box: [${pubkey%% *} ...]"; return 1 ;; esac

  # (3) install the locked-down authorized_keys line for fleet@vps on the VPS.
  local line; line="$(authorized_keys_line "$port" "$pubkey")"
  enroll_install_vps_authorized_key "$line" || { log "enroll: failed to install VPS authorized_keys line"; return 1; }
  log "enroll: installed VPS fleet authorized_keys line for $box (permitlisten 127.0.0.1:$port)"

  # P2-3: keep a COPY of this box's tunnel authorized-key mapping under
  # /etc/grok-fleet (the wall §2 requires it). One file per box records the
  # exact authorized_keys line the brain trusts, so the mapping is auditable
  # independent of ~fleet/.ssh (which enroll also writes).
  enroll_record_etc_mapping "$box" "$port" "$line" || log "enroll: WARNING could not write /etc mapping copy for $box"

  # (4) install the VPS's box-access PUBKEY into the box user's authorized_keys,
  # so the brain can `ssh box@127.0.0.1 -p 2000N` over the tunnel with no pw.
  local vpspub
  vpspub="$(enroll_vps_box_access_pubkey)" || { log "enroll: no VPS box-access key at $FLEET_BOX_KEY(.pub) — generate it on the VPS first"; return 1; }
  enroll_install_box_authorized_key "$box" "$vpspub" || { log "enroll: failed to install VPS key into $box authorized_keys"; return 1; }
  log "enroll: installed VPS box-access key into $box:~box/.ssh/authorized_keys"

  # Record the enrollment (idempotent, informational).
  mkdir -p "$FLEET_STATE" 2>/dev/null || true
  printf '%s\t%s\n' "$box" "$port" >> "$FLEET_STATE/enrolled.tsv" 2>/dev/null || true
  notify info "enrolled $box (reverse port 127.0.0.1:$port)"
  log "enroll: $box DONE"
}

# The three side-effecting enroll steps are separate functions so tests can
# stub the ssh/curl transport and assert the authorized_keys line SHAPE without
# a real box or VPS.
enroll_read_box_pubkey() {
  local box="$1"
  box_ssh "$box" "sudo cat '$BOX_TUNNEL_PUB'" 2>/dev/null | head -1
}

enroll_vps_box_access_pubkey() {
  [ -f "$FLEET_BOX_KEY.pub" ] || return 1
  head -1 "$FLEET_BOX_KEY.pub"
}

# Append a line to fleet@vps authorized_keys, idempotently (never duplicate the
# same pubkey; replace an existing line for that key so a re-enroll updates the
# permitlisten). Runs LOCALLY on the VPS (the brain IS fleet@vps's host root),
# writing ~fleet/.ssh/authorized_keys.
FLEET_VPS_AUTHKEYS="${FLEET_VPS_AUTHKEYS:-/home/fleet/.ssh/authorized_keys}"

# ensure_vps_authkeys_perms: BUG-E — make ~fleet/.ssh and its authorized_keys
# safe for sshd privsep to read AS the fleet user. Idempotent: dir 700, file
# 600, and BOTH owned by $FLEET_VPS_USER:$FLEET_VPS_USER. Without the chown the
# enroll writes them root:root (the brain runs as root), sshd StrictModes/privsep
# then refuses to open them and every tunnel gets "Permission denied (publickey)".
# Must be called after EVERY write of the file (enroll / re-enroll / any rewrite).
ensure_vps_authkeys_perms() {
  local akdir; akdir="$(dirname "$FLEET_VPS_AUTHKEYS")"
  chmod 700 "$akdir" 2>/dev/null || true
  [ -e "$FLEET_VPS_AUTHKEYS" ] && chmod 600 "$FLEET_VPS_AUTHKEYS" 2>/dev/null || true
  # Owner LAST so the mode above isn't clobbered; -R so the dir + file both flip.
  chown -R "$FLEET_VPS_USER":"$FLEET_VPS_USER" "$akdir" 2>/dev/null || true
}

enroll_install_vps_authorized_key() {
  local line="$1" key akdir
  key="$(printf '%s' "$line" | awk '{print $3}')"   # the base64 key material
  akdir="$(dirname "$FLEET_VPS_AUTHKEYS")"
  mkdir -p "$akdir" 2>/dev/null || return 1
  touch "$FLEET_VPS_AUTHKEYS" 2>/dev/null || return 1
  local tmp; tmp="$(mktemp)" || return 1
  # Drop any prior line carrying the same key, then append the new one.
  grep -vF "$key" "$FLEET_VPS_AUTHKEYS" > "$tmp" 2>/dev/null || true
  printf '%s\n' "$line" >> "$tmp"
  mv -f "$tmp" "$FLEET_VPS_AUTHKEYS"
  # BUG-E: sshd reads this AS $FLEET_VPS_USER — dir 700, file 600, both fleet-owned.
  ensure_vps_authkeys_perms
}

# enroll_record_etc_mapping <box> <port> <authorized_keys-line>: P2-3 — write a
# COPY of the box's tunnel authorized-key mapping under $FLEET_ETC (600). One
# file per box: $FLEET_ETC/authorized-keys.d/<box>.line holds the exact line;
# an index tsv (box<TAB>port<TAB>keymaterial) makes the mapping auditable. This
# is a COPY for audit/rebuild; ~fleet/.ssh/authorized_keys remains authoritative.
FLEET_ETC_AK_DIR="${FLEET_ETC_AK_DIR:-$FLEET_ETC/authorized-keys.d}"
enroll_record_etc_mapping() {
  local box="$1" port="$2" line="$3" key
  key="$(printf '%s' "$line" | awk '{print $3}')"
  mkdir -p "$FLEET_ETC_AK_DIR" 2>/dev/null || return 1
  chmod 700 "$FLEET_ETC" 2>/dev/null || true
  chmod 700 "$FLEET_ETC_AK_DIR" 2>/dev/null || true
  local f="$FLEET_ETC_AK_DIR/$box.line" tmp
  tmp="$(mktemp "$FLEET_ETC_AK_DIR/.ak.XXXXXX" 2>/dev/null)" || return 1
  printf '%s\n' "$line" > "$tmp" || { rm -f "$tmp"; return 1; }
  chmod 600 "$tmp" 2>/dev/null || true
  mv -f "$tmp" "$f" 2>/dev/null || { rm -f "$tmp"; return 1; }
  # Maintain an index mapping (idempotent: drop any prior row for this box).
  local idx="$FLEET_ETC/authorized-keys.map" itmp
  itmp="$(mktemp "$FLEET_ETC/.akmap.XXXXXX" 2>/dev/null)" || return 0
  if [ -f "$idx" ]; then grep -vE "^$box	" "$idx" > "$itmp" 2>/dev/null || true; fi
  printf '%s\t%s\t%s\n' "$box" "$port" "$key" >> "$itmp"
  chmod 600 "$itmp" 2>/dev/null || true
  mv -f "$itmp" "$idx" 2>/dev/null || rm -f "$itmp"
  return 0
}

# Install the VPS box-access pubkey into the box's authorized_keys over OpenSSH
# on the tailnet (idempotent append). The box user is 'box'.
enroll_install_box_authorized_key() {
  local box="$1" pubkey="$2"
  box_ssh "$box" "
    set -e
    mkdir -p ~/.ssh && chmod 700 ~/.ssh
    touch ~/.ssh/authorized_keys && chmod 600 ~/.ssh/authorized_keys
    key='$pubkey'
    kmat=\$(printf '%s' \"\$key\" | awk '{print \$2}')
    tmp=\$(mktemp)
    grep -vF \"\$kmat\" ~/.ssh/authorized_keys > \"\$tmp\" 2>/dev/null || true
    printf '%s\n' \"\$key\" >> \"\$tmp\"
    mv -f \"\$tmp\" ~/.ssh/authorized_keys
    chmod 600 ~/.ssh/authorized_keys
  " >/dev/null 2>&1
}

# --- mint-key ----------------------------------------------------------------
# fleetctl mint-key <box>: mint a per-box tag-scoped key and seed it ATOMICALLY
# over the tunnel (S1). Verify via `boxup status` over the tunnel BEFORE
# recording success; a failure leaves the OLD key intact.
mint_payload() {
  # The EXACT capabilities shape the frozen wall (H11) mandates.
  # P1-6: expirySeconds is HARD-CLAMPED to the 90-day Tailscale maximum. Neither
  # the FLEET_KEY_EXPIRY_SECS env nor the function argument can push it past the
  # cap (must-cover invariant 4: expiry ≤ 90d, not merely "default is 90d").
  local secs; secs="$(clamp_expiry_secs "${1:-$FLEET_KEY_EXPIRY_SECS}")"
  jq -cn --argjson secs "$secs" '{
    capabilities: { devices: { create: {
      reusable: true, ephemeral: false, preauthorized: true,
      tags: ["tag:grok-box"]
    } } },
    expirySeconds: $secs
  }'
}

# clamp_expiry_secs <secs> -> a valid Tailscale key expiry in [1, 7776000].
# P1-6 hard cap: anything > 90d (7776000s) is clamped DOWN to 90d; a
# non-numeric/empty/<=0 value falls back to the 90d default. The cap is a
# security invariant, not advice — an operator override cannot exceed it.
FLEET_KEY_EXPIRY_MAX=7776000     # 90 days, the Tailscale hard maximum
clamp_expiry_secs() {
  local s="$1" max="${FLEET_KEY_EXPIRY_MAX:-7776000}"
  case "$s" in ''|*[!0-9]*) s="$max" ;; esac
  [ "$s" -ge 1 ] 2>/dev/null || s="$max"
  [ "$s" -le "$max" ] 2>/dev/null || s="$max"
  printf '%s' "$s"
}

# mint_create -> writes the raw key-create JSON response to stdout; sets
# TS_API_CODE. Caller checks the code (S3).
mint_create() {
  local secs="${1:-$FLEET_KEY_EXPIRY_SECS}"
  ts_api POST "/tailnet/$TS_TAILNET/keys" "$(mint_payload "$secs")"
}

# seed_key_over_tunnel <box> <key> <expires-iso>: the S1 atomic verified seed.
# Runs entirely on the box over its tunnel:
#   write .ts-authkey.tmp (600) -> sha256 verify -> mv into place ->
#   write .expires from the API `expires`. The key is passed on stdin, NEVER
#   argv, so it never appears in the box's ps/logs.
#
# P1-2 verify: after the atomic write, confirm via `sudo boxup status` over the
# tunnel that the NEW authkey state actually shows — the status line must carry
# an authkey token that is NOT `EXPIRED`/`none`/`missing`. A stale line still
# reporting the OLD expired key means the seed did not converge; we FAIL the
# seed so the mint is not recorded and the guard is not advanced (retry next
# run, escalate after >3 runs — cmd_mint_key).
seed_key_over_tunnel() {
  local box="$1" key="$2" expires="$3" want_sha
  want_sha="$(printf '%s\n' "$key" | sha256sum | awk '{print $1}')"
  # Stream the key over stdin to a remote heredoc consumer.
  printf '%s\n' "$key" | tunnel_ssh "$box" "
    set -e
    umask 077
    cat > '$BOX_AUTHKEY_TMP'
    got=\$(sha256sum '$BOX_AUTHKEY_TMP' | awk '{print \$1}')
    if [ \"\$got\" != '$want_sha' ]; then echo \"SEED_SHA_MISMATCH:\$got\" >&2; rm -f '$BOX_AUTHKEY_TMP'; exit 3; fi
    mv -f '$BOX_AUTHKEY_TMP' '$BOX_AUTHKEY'
    chmod 600 '$BOX_AUTHKEY'
    printf '%s\n' '$expires' > '$BOX_AUTHKEY_EXPIRES'
    chmod 600 '$BOX_AUTHKEY_EXPIRES'
  " >/dev/null 2>&1 || return 1
  # Verify via `boxup status` over the tunnel BEFORE recording success.
  local st
  st="$(tunnel_ssh "$box" "sudo $BOX_ROOT/boxup status" 2>/dev/null)" || return 1
  [ -n "$st" ] || return 1
  # P1-2: confirm the box CONVERGED onto the NEW key. boxup emits an `authkey=`
  # token ONLY for the warn/expired/unknown states (a healthy fresh key is
  # SILENT — no token). So convergence = the status line does NOT still report
  # the OLD key as `authkey=EXPIRED:*` and does NOT report `authkey=unknown-expiry`
  # (which would mean our `.expires` write did not land). Additionally confirm
  # the box now reads back the exact `.expires` date we wrote (the seed of the
  # sidecar landed), which pins the verify to THIS mint, not a stale line.
  seed_status_converged "$st" || return 1
  local seen_exp
  seen_exp="$(tunnel_ssh "$box" "cat '$BOX_AUTHKEY_EXPIRES' 2>/dev/null" 2>/dev/null | tr -d '[:space:]')"
  [ "$seen_exp" = "$expires" ]
}

# seed_status_converged <status-line>: 0 iff the box has converged onto a fresh
# key. boxup only prints an `authkey=` token for the FAILURE/near-expiry states
# (EXPIRED / expiring / unknown-expiry); a healthy fresh key is SILENT. So:
#   * `authkey=EXPIRED:*`        -> NOT converged (old key still active)  -> 1
#   * `authkey=unknown-expiry`   -> NOT converged (.expires didn't land)  -> 1
#   * no authkey token / expiring-> converged (fresh key seeded)          -> 0
seed_status_converged() {
  local line="$1" tok v
  for tok in $line; do
    case "$tok" in
      authkey=*)
        v="${tok#authkey=}"
        case "$v" in
          [Ee][Xx][Pp][Ii][Rr][Ee][Dd]:*|[Ee][Xx][Pp][Ii][Rr][Ee][Dd]) return 1 ;;
          unknown-expiry) return 1 ;;
          *) : ;;   # expiring:<date> is acceptable (a valid, just-near-expiry key)
        esac
        ;;
    esac
  done
  return 0
}

cmd_mint_key() {
  local box="${1:-}"
  [ -n "$box" ] || { log "usage: fleetctl mint-key <grok-box-N>"; return 2; }
  case "$box" in grok-box-[0-9]*) : ;; *) log "mint-key: refusing non-grok box '$box'"; return 2 ;; esac

  local resp key expires
  # Call bare (no $() capture) so TS_API_CODE survives; read the body from file.
  mint_create >/dev/null
  if ! ts_ok; then
    # B-1: a key-create non-2xx is an API failure — latch the run-wide READ-ONLY
    # so no later row mutates this run.
    log "mint-key: key-create FAILED (HTTP $TS_API_CODE) — old key on $box left intact"
    RECONCILE_READONLY=1
    return 1
  fi
  resp="$(ts_api_body)"
  key="$(printf '%s' "$resp" | jq -r '.key // empty')"
  expires="$(printf '%s' "$resp" | jq -r '.expires // empty')"
  local keyid; keyid="$(printf '%s' "$resp" | jq -r '.id // empty')"
  if [ -z "$key" ]; then
    log "mint-key: response had no .key — old key on $box left intact"
    return 1
  fi
  # P1-3: a blank/missing API `id` means we cannot record the key we just minted,
  # which breaks the invariant that a later rotation can revoke it. Treat a
  # missing id as a mint FAILURE and REVOKE the just-minted key so we do not
  # leave an unrevokable key on the tailnet. We have the key material but not its
  # id — the safest recovery is to abandon this key (it will lapse at expiry) and
  # NOT seed it, retrying next run.
  if [ -z "$keyid" ]; then
    log "mint-key: key-create response had no .id — cannot persist key identity; abandoning this key (old key on $box left intact)"
    # Best-effort revoke is impossible without an id; the key will lapse at its
    # own expiry. We do NOT seed it, so the box keeps its old key.
    return 1
  fi
  # Normalize expires to a day-granular ISO date for the H11 .expires sidecar.
  local expdate; expdate="$(printf '%s' "$expires" | cut -c1-10)"
  case "$expdate" in ????-??-??) : ;; *) expdate="$(date -u -d "+90 days" +%Y-%m-%d 2>/dev/null || echo "$expdate")" ;; esac

  if ! seed_key_over_tunnel "$box" "$key" "$expdate"; then
    log "mint-key: atomic seed/verify FAILED on $box — old key left intact (retry next run)"
    return 1
  fi
  # P1-3 PERSISTENCE INVARIANT: the minted {id,expires} MUST be durably recorded
  # before we call the mint a success. If persistence fails, the mint FAILS and
  # we REVOKE the just-minted key (we cannot rely on a later rotation finding its
  # id, so an unrecorded key must not be left live). The box keeps its OLD key
  # (the seed already happened, but a re-seed next run restores coherence, and
  # the OLD key is still valid — we did not advance the mint-window guard).
  mkdir -p "$FLEET_STATE" 2>/dev/null || true
  if ! record_key_meta "$box" "$keyid" "$expires"; then
    log "mint-key: FAILED to persist key meta for $box — REVOKING the just-minted key id=$keyid (invariant: unrecorded key must not stay live)"
    ts_api DELETE "/tailnet/$TS_TAILNET/keys/$keyid" >/dev/null
    if ts_ok || [ "$TS_API_CODE" = 404 ]; then
      log "mint-key: revoked unrecorded key id=$keyid (HTTP $TS_API_CODE)"
    else
      log "mint-key: could not revoke unrecorded key id=$keyid (HTTP $TS_API_CODE) — it will lapse at expiry"
      RECONCILE_READONLY=1
    fi
    return 1
  fi
  # Record the mint window + expiry AFTER verified seed + persisted meta (never
  # before). This IS the mint-window marker read by mint_window_valid (P1-1).
  printf '%s\t%s\n' "$box" "$expdate" > "$FLEET_STATE/$box.expires" 2>/dev/null || true
  log "mint-key: $box seeded a fresh per-box key (expires $expdate); verified via boxup status; key id recorded"
  return 0
}

# mint_window_valid <box> (P1-1): 0 iff a VALID per-box key was already seeded
# this window — i.e. we have a recorded .expires whose date is still beyond the
# rotation threshold (>7d out). Row a mints ONLY when this is false, so a box
# that already has a fresh key is not re-minted every 5-min tick. Rotation
# (row c) fires precisely when this becomes false (<7d), so the two do not fight.
mint_window_valid() {
  local box="$1"
  local expf="$FLEET_STATE/$box.expires" d days
  [ -f "$expf" ] || return 1
  # Also require the recorded key id to exist — a .expires without a persisted
  # id is not a fully valid window (P1-3 invariant).
  [ -n "$(key_meta_id "$box" 2>/dev/null || true)" ] || return 1
  d="$(awk -F'\t' '{print $2}' "$expf" 2>/dev/null | tr -d '[:space:]')"
  [ -n "$d" ] || return 1
  days="$(days_until "$d")"
  case "$days" in ''|unknown|*[!0-9-]*) return 1 ;; esac
  [ "$days" -ge 7 ] 2>/dev/null
}

# record_key_meta <box> <id> <expires-iso>: atomically write the per-box minted-
# key metadata to $FLEET_KEYS_DIR/<N>.json. P1-3: persistence is an INVARIANT —
# this returns NON-ZERO on any failure (blank id, mkdir/mktemp/encode/install
# failure, or a post-write read-back that does not match), and the caller treats
# that as a mint failure + revokes the just-minted key. Stores id + expires ONLY;
# never the key material.
record_key_meta() {
  local box="$1" id="$2" expires="$3" f tmp
  # A blank id cannot satisfy the invariant (a later rotation could not revoke).
  [ -n "$id" ] || { log "mint-key: refusing to record blank key id for $box"; return 1; }
  f="$(key_meta_file "$box")" || { log "mint-key: cannot resolve key meta path for $box"; return 1; }
  mkdir -p "$FLEET_KEYS_DIR" 2>/dev/null || { log "mint-key: cannot mkdir $FLEET_KEYS_DIR — key id NOT recorded"; return 1; }
  tmp="$(mktemp "$FLEET_KEYS_DIR/.keymeta.XXXXXX" 2>/dev/null)" || { log "mint-key: mktemp failed — key id NOT recorded"; return 1; }
  if ! jq -cn --arg id "$id" --arg exp "$expires" '{id:$id, expires:$exp}' > "$tmp" 2>/dev/null; then
    rm -f "$tmp"; log "mint-key: could not encode key meta for $box"; return 1
  fi
  chmod 600 "$tmp" 2>/dev/null || true
  if ! mv -f "$tmp" "$f" 2>/dev/null; then
    rm -f "$tmp"; log "mint-key: could not install key meta $f"; return 1
  fi
  # Read-back invariant: the id we just wrote must be recoverable.
  if [ "$(jq -r '.id // empty' "$f" 2>/dev/null)" != "$id" ]; then
    log "mint-key: key meta read-back mismatch for $box ($f)"; return 1
  fi
  return 0
}

# --- device list + tunnel liveness (reconcile inputs) ------------------------
# devices_json -> the raw devices array JSON on stdout; sets TS_API_CODE. On
# non-2xx, TS_API_CODE tells the caller to go READ-ONLY (S3).
devices_json() {
  ts_api GET "/tailnet/$TS_TAILNET/devices?fields=all"
}

# tunnel_up <box>: 0 iff 127.0.0.1:2000N is LISTENING on the VPS (ss -tln). The
# authoritative "tunnel up" signal given ClientAliveInterval 0.
tunnel_up() {
  local port; port="$(port_for "$1")" || return 1
  have ss || return 1
  ss -tln 2>/dev/null | awk '{print $4}' | grep -qE "127\.0\.0\.1:$port\$"
}

# tunnel_ssh <box> <cmd...>: reach the box over its reverse tunnel as
# box@127.0.0.1 -p 2000N using the VPS's own key (NO password fallback — R7).
tunnel_ssh() {
  local box="$1"; shift
  local port; port="$(port_for "$box")" || return 1
  ssh -o StrictHostKeyChecking=accept-new \
      -o BatchMode=yes \
      -o ConnectTimeout=8 \
      -i "$FLEET_BOX_KEY" \
      -p "$port" "box@127.0.0.1" "$@"
}

# --- reconcile — the decision table (§3) -------------------------------------
# reconcile [--apply]. DRY-RUN by default (log intended actions, mutate
# nothing). Per-run flock. On ANY API non-2xx the run is READ-ONLY (S3).
#
# Decision table (rows a–e + API-failure read-only row):
#   a  tailnet gone/offline BUT tunnel alive        -> mint+seed+boxup once
#   b  duplicate hostname                           -> delete older-offline, rename live
#   c  auth-key expiry < 7d                          -> rotate (mint) + revoke old
#   d  version drift                                 -> D7 canary rollout over tunnels
#   e  BOTH paths dead                               -> tiered alert (asleep/incident)
#   -  API non-2xx                                   -> READ-ONLY this run
#
# reconcile_decide <box> <online> <lastseen_fresh> <dupcount> <both_online_dup>
#                  <tunnel> <checkfail> <expiry_days> <drift>
# -> prints the decided action token(s), one per line. PURE (no I/O), so the
# whole table is unit-testable over fixture device lists. Tokens:
#   mint | delete-then-rename | rotate | rollout | alert-asleep |
#   alert-incident | noop
reconcile_decide() {
  local online="$1" lastseen_fresh="$2" dupcount="$3" both_online_dup="$4" \
        tunnel="$5" checkfail="$6" expiry_days="$7" drift="$8" checkfail_runs="${9:-0}"
  local acted=0
  # Row b: duplicate hostname. Never delete when both online.
  if [ "$dupcount" -ge 2 ]; then
    if [ "$both_online_dup" = yes ]; then
      echo "alert-incident:duplicate-both-online"
    else
      echo "delete-then-rename"
    fi
    acted=1
  fi
  # Row a: tailnet says gone/offline (absent or stale lastSeen) but tunnel alive.
  if { [ "$online" = no ] || [ "$lastseen_fresh" = no ]; } && [ "$tunnel" = up ]; then
    echo "mint"
    acted=1
  fi
  # Row c: auth-key expiry < 7 days -> rotate (only meaningful with a tunnel to seed over).
  if [ "$expiry_days" != unknown ] && [ "$expiry_days" -lt 7 ] 2>/dev/null && [ "$tunnel" = up ]; then
    echo "rotate"
    acted=1
  fi
  # Row d: version drift, tunnel alive, box converged enough to check.
  if [ "$drift" = yes ] && [ "$tunnel" = up ]; then
    echo "rollout"
    acted=1
  fi
  # Row e: tunnel is DOWN and we HAVE an API reading (online known). Two
  # sub-cases (Q1 ruling):
  #   * API says the device is OFFLINE / stale too  -> BOTH paths dead -> asleep
  #     (informational after T=2h; a sand box legitimately sleeps).
  #   * API says the device is ONLINE / lastSeen fresh yet the tunnel is dead
  #     -> INCOHERENT split (something is lying) -> immediate actionable incident.
  # When online is UNKNOWN (no API data this run, e.g. an API-failure read-only
  # run), row e does NOT classify — we cannot tell asleep from incoherent
  # without the device list (never alert on no-data).
  if [ "$tunnel" = down ] && [ "$online" != unknown ]; then
    if [ "$online" = no ] || [ "$lastseen_fresh" = no ]; then
      echo "alert-asleep"
    else
      echo "alert-incident:incoherent-both-dead"
    fi
    acted=1
  fi
  # N-1 / row e: reachable (tunnel up) but boxup check fails > 3 runs.
  if [ "$tunnel" = up ] && [ "$checkfail" = yes ] && [ "$checkfail_runs" -gt 3 ] 2>/dev/null; then
    echo "alert-incident:reachable-cannot-converge"
    acted=1
  fi
  [ "$acted" = 1 ] || echo "noop"
}

cmd_reconcile() {
  local apply=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --apply) apply=1; shift ;;
      --dry-run) apply=0; shift ;;
      *) log "reconcile: unknown arg '$1'"; return 2 ;;
    esac
  done

  mkdir -p "$FLEET_STATE" 2>/dev/null || true
  local lock="$FLEET_STATE/reconcile.lock"
  # Per-run flock — never two reconciles at once (idempotency + safety row).
  # breaks-if-undone: do NOT write `exec 9>"$lock" 2>/dev/null` — an `exec` with
  # redirections and NO command makes 2>/dev/null PERMANENT for the whole
  # process, so every subsequent log() (all of which write to stderr) is
  # silently swallowed and interactive `reconcile` exits 0 with no output. Open
  # the fd WITHOUT a persistent stderr redirect; scope any error suppression to
  # the exec itself via a brace group so it cannot leak past this line.
  if ! { exec 9>"$lock"; } 2>/dev/null; then
    log "reconcile: cannot open lock $lock"; return 1
  fi
  if ! flock -n 9; then
    log "reconcile: another reconcile holds the lock — skipping this run"
    return 0
  fi

  local mode="DRY-RUN"; [ "$apply" = 1 ] && mode="APPLY"
  log "reconcile: start ($mode)"

  # Fetch the device list. Any non-2xx => READ-ONLY run (S3). Call bare so
  # TS_API_CODE survives (a $() capture would run devices_json in a subshell).
  # A run-wide READ-ONLY latch (B-1): once set, NO row may mint/delete/rename for
  # the REST of the run. It latches on (i) the initial GET non-2xx, (ii) a
  # malformed/partial HTTP-200 device body, or (iii) any later action-time API
  # failure (set by reconcile_execute). Fail-closed is run-wide, not per-call.
  RECONCILE_READONLY=0
  local devs
  devices_json >/dev/null
  if ! ts_ok; then
    reconcile_record_api_failure
    log "reconcile: device list HTTP $TS_API_CODE — READ-ONLY run (no mint/delete/rename)"
    RECONCILE_READONLY=1
    devs=""      # never act on a partial/absent list (never a spurious delete/mint)
  else
    devs="$(ts_api_body)"
    # B-1: a 2xx with a malformed/partial body is NOT trustworthy device data.
    # Validate it parses as JSON with a `.devices` array before trusting it; a
    # truncated/garbage 200 is treated as no-data + READ-ONLY (never "device
    # absent" => never a spurious delete/mint).
    if ! devices_json_valid "$devs"; then
      reconcile_record_api_failure
      log "reconcile: device list HTTP 200 but body malformed/partial — READ-ONLY run (no mint/delete/rename)"
      RECONCILE_READONLY=1
      devs=""
    else
      reconcile_reset_api_failure
    fi
  fi

  # Enumerate enrolled boxes (from enroll state, or FLEET_BOXES override for tests).
  local -a boxes=()
  local b
  while IFS= read -r b; do [ -n "$b" ] && boxes+=("$b"); done < <(reconcile_target_boxes)
  if [ "${#boxes[@]}" -eq 0 ]; then
    log "reconcile: no enrolled boxes"
    return 0
  fi

  local rc=0
  for b in "${boxes[@]}"; do
    reconcile_one "$b" "$devs" "$apply" "$RECONCILE_READONLY" || rc=1
  done
  log "reconcile: done ($mode)"
  return "$rc"
}

# devices_json_valid <body>: 0 iff the body parses as JSON AND has a `.devices`
# array (B-1). A truncated/garbage HTTP-200 fails here and forces a READ-ONLY
# run. An empty body is invalid (not "zero devices").
devices_json_valid() {
  local body="$1"
  [ -n "$body" ] || return 1
  printf '%s' "$body" | jq -e 'has("devices") and (.devices | type == "array")' >/dev/null 2>&1
}

# Enrolled boxes: FLEET_BOXES override (tests) else the enrolled.tsv names.
reconcile_target_boxes() {
  if [ -n "${FLEET_BOXES:-}" ]; then
    local -a _fb; read -ra _fb <<< "$FLEET_BOXES"
    [ "${#_fb[@]}" -gt 0 ] && printf '%s\n' "${_fb[@]}"
    return 0
  fi
  [ -f "$FLEET_STATE/enrolled.tsv" ] || return 0
  awk -F'\t' '{print $1}' "$FLEET_STATE/enrolled.tsv" | sort -u
}

reconcile_record_api_failure() {
  local n=0
  [ -f "$FLEET_STATE/api.fails" ] && n=$(tr -d '[:space:]' < "$FLEET_STATE/api.fails" 2>/dev/null || echo 0)
  case "$n" in ''|*[!0-9]*) n=0 ;; esac
  n=$((n + 1)); echo "$n" > "$FLEET_STATE/api.fails" 2>/dev/null || true
  # P1-5: bounded retry backoff 5 -> 10 -> 20 min. The timer fires every 5 min;
  # this writes a `api.next_retry` epoch that the NEXT run consults (see
  # reconcile_backoff_active) so we skip API calls until the backoff elapses.
  # Backoff step by consecutive-failure count: 1->5min, 2->10min, >=3->20min,
  # capped at 20. Written as an absolute epoch so a run can cheaply compare.
  local mins now next
  case "$n" in
    1) mins=5 ;;
    2) mins=10 ;;
    *) mins=20 ;;
  esac
  echo "$mins" > "$FLEET_STATE/api.backoff_min" 2>/dev/null || true
  now="$(date -u +%s 2>/dev/null || echo 0)"
  next=$(( now + mins * 60 ))
  echo "$next" > "$FLEET_STATE/api.next_retry" 2>/dev/null || true
  # notify() after 3 consecutive failures.
  [ "$n" -ge 3 ] && notify warn "Tailscale API failing: $n consecutive non-2xx (backoff ${mins}m)"
}

# reconcile_backoff_active: 0 iff a backoff window is currently in effect (the
# recorded api.next_retry epoch is still in the future). Used to skip API calls
# during a 5/10/20-min backoff window (P1-5) so we do not hammer a failing API
# every 5-min tick. A missing/zero marker => not active.
reconcile_backoff_active() {
  local f="$FLEET_STATE/api.next_retry" next now
  [ -f "$f" ] || return 1
  next="$(tr -d '[:space:]' < "$f" 2>/dev/null || echo 0)"
  case "$next" in ''|*[!0-9]*) return 1 ;; esac
  now="$(date -u +%s 2>/dev/null || echo 0)"
  [ "$now" -lt "$next" ] 2>/dev/null
}
reconcile_reset_api_failure() {
  echo 0 > "$FLEET_STATE/api.fails" 2>/dev/null || true
  # P1-5: clear the backoff window on a clean API run.
  rm -f "$FLEET_STATE/api.next_retry" "$FLEET_STATE/api.backoff_min" 2>/dev/null || true
}

# reconcile_one <box> <devices-json> <apply> <readonly>: gather this box's
# inputs, decide via the PURE table, then either LOG (dry-run/read-only) or
# execute (apply) each action idempotently.
reconcile_one() {
  local box="$1" devs="$2" apply="$3" readonly="$4"
  local rc_one=0
  local n; n="$(box_index "$box")" || return 1

  # Inputs from the device list (jq). On a read-only run devs="" => treat as
  # no-data (never "absent" => never a spurious delete/mint).
  local online=unknown lastseen_fresh=unknown dupcount=0 both_online_dup=no
  if [ -n "$devs" ]; then
    online="$(dev_field "$devs" "$box" online)"
    lastseen_fresh="$(dev_field "$devs" "$box" fresh)"
    dupcount="$(dev_field "$devs" "$box" dupcount)"
    both_online_dup="$(dev_field "$devs" "$box" both_online)"
  fi

  # Tunnel + check inputs (local to the VPS; safe even on an API-failure run).
  local tunnel=down; tunnel_up "$box" && tunnel=up
  local checkfail=no checkfail_runs=0
  if [ "$tunnel" = up ]; then
    if ! tunnel_ssh "$box" "sudo $BOX_ROOT/boxup check" >/dev/null 2>&1; then
      checkfail=yes
      checkfail_runs="$(reconcile_bump_checkfail "$box")"
    else
      reconcile_reset_checkfail "$box"
    fi
  fi

  # Expiry (days) from the brain-recorded per-box .expires (VPS-side clock, P2-5).
  local expiry_days=unknown expf="$FLEET_STATE/$box.expires"
  if [ -f "$expf" ]; then
    local d; d="$(awk -F'\t' '{print $2}' "$expf" 2>/dev/null | tr -d '[:space:]')"
    [ -n "$d" ] && expiry_days="$(days_until "$d")"
  fi

  # Drift: compare boxup status v=.../<sha> over the tunnel to the target sha.
  local drift=unknown
  if [ "$tunnel" = up ] && [ -n "${FLEET_TARGET_SHA:-}" ]; then
    local sha; sha="$(tunnel_status_sha "$box")"
    if [ "$sha" != unknown ]; then
      [ "$sha" = "$FLEET_TARGET_SHA" ] && drift=no || drift=yes
    fi
  fi

  # On a read-only run, suppress ALL mutations regardless of the decision.
  local actions
  actions="$(reconcile_decide "$online" "$lastseen_fresh" "$dupcount" \
      "$both_online_dup" "$tunnel" "$checkfail" "$expiry_days" "$drift" "$checkfail_runs")"

  local a
  while IFS= read -r a; do
    [ -n "$a" ] || continue
    case "$a" in
      noop) continue ;;
      alert-asleep)
        # P1-4: BOTH-paths-dead "asleep" is informational and TIMED — a sand box
        # legitimately sleeps. Fire ONE alert only after T=2h of continuous
        # both-dead, then a DAILY digest; suppress otherwise. State is per-box +
        # durable across runs.
        reconcile_alert_asleep "$box"
        continue ;;
      alert-incident:incoherent-both-dead)
        # P1-4: the INCOHERENT split (API online yet both paths dead) is
        # actionable but only after 2 CONSECUTIVE reconcile runs (one blip is
        # not paged). A coherent/other observation resets the counter.
        reconcile_alert_incoherent "$box"
        continue ;;
      alert-*)
        # Other incidents (duplicate-both-online, reachable-cannot-converge) are
        # immediate.
        reconcile_reset_asleep "$box"
        reconcile_reset_incoherent "$box"
        notify warn "$box: ${a#alert-}"
        continue ;;
    esac
    # A non-alert, non-both-dead observation clears the row-e timers.
    reconcile_reset_asleep "$box"
    reconcile_reset_incoherent "$box"
    # P1-1: row-a mint is idempotent per WINDOW — skip if a valid key was already
    # seeded this window (a fresh key still >7d out). Prevents re-minting every
    # 5-min tick. Rotation (row c) handles the <7d case, so they never fight.
    if [ "$a" = mint ] && mint_window_valid "$box"; then
      log "reconcile: $box mint SKIPPED — a valid key was already seeded this window (mint-window guard)"
      continue
    fi
    # B-1: honor BOTH the per-call readonly arg AND the run-wide latch — an
    # earlier box's action-time API failure latches RECONCILE_READONLY and must
    # suppress every later mutation this run.
    if [ "$readonly" = 1 ] || [ "${RECONCILE_READONLY:-0}" = 1 ] || [ "$apply" != 1 ]; then
      log "reconcile: $box WOULD $a (${readonly:+read-only }dry-run/no-apply)"
      continue
    fi
    if ! reconcile_execute "$box" "$a"; then
      # An action failed. reconcile_execute/its callees latch RECONCILE_READONLY
      # when the failure was an API non-2xx (fail-closed, run-wide).
      log "reconcile: $box action '$a' FAILED"
      rc_one=1
      # P1-2 escalation: a mint that returns 2xx from the API but whose
      # seed/status never converges, while the box's OLD key still passes
      # `boxup check`, must not silently no-op forever. Count consecutive
      # seed-failures; after >3 raise the SAME actionable incident as row e.
      if [ "$a" = mint ] && [ "$checkfail" = no ] && [ "$tunnel" = up ]; then
        local sf; sf="$(reconcile_bump_seedfail "$box")"
        if [ "$sf" -gt 3 ] 2>/dev/null; then
          notify warn "$box: reachable-cannot-converge (mint seeded but boxup status never converged for $sf runs)"
        fi
      fi
    else
      # A successful (or skipped-not-needed) mint clears the seed-fail counter.
      [ "$a" = mint ] && reconcile_reset_seedfail "$box"
    fi
  done <<EOF
$actions
EOF
  return "${rc_one:-0}"
}

# reconcile_execute <box> <action>: perform ONE idempotent mutation (apply mode).
reconcile_execute() {
  local box="$1" action="$2"
  case "$action" in
    mint)
      cmd_mint_key "$box" && tunnel_ssh "$box" "sudo $BOX_ROOT/boxup once" >/dev/null 2>&1
      ;;
    rotate)
      reconcile_rotate "$box"
      ;;
    delete-then-rename)
      reconcile_dedup "$box"
      ;;
    rollout)
      reconcile_rollout "$box"
      ;;
    *) log "reconcile: $box unknown action '$action'" ; return 1 ;;
  esac
}

# reconcile_rotate <box> (row c): mint+seed a FRESH per-box key, THEN — only
# after the new key is verified seeded — revoke the OLD key via the API. The
# OLD id is read BEFORE the mint (cmd_mint_key overwrites the per-box key-meta
# with the NEW id). A missing/blank old id => log + SKIP the revoke, never fail
# the rotation (the new key is already in place; a stale old key just lingers
# until its own expiry). The DELETE NEVER runs before cmd_mint_key returns 0
# (i.e. before the new key is verified seeded).
reconcile_rotate() {
  local box="$1" old_id
  # Capture the OLD key id BEFORE minting (mint overwrites the meta file).
  old_id="$(key_meta_id "$box" 2>/dev/null || true)"
  # Mint + atomically seed + verify the new key. On failure the OLD key is left
  # intact (cmd_mint_key guarantees this) and we do NOT revoke anything.
  if ! cmd_mint_key "$box"; then
    log "reconcile: rotate $box — mint/seed FAILED, old key intact, NOT revoking"
    return 1
  fi
  # New key verified seeded. Now revoke the OLD key (task b).
  if [ -z "$old_id" ]; then
    log "reconcile: rotate $box — no recorded old key id; skipping revoke (new key seeded OK)"
    return 0
  fi
  ts_api DELETE "/tailnet/$TS_TAILNET/keys/$old_id" >/dev/null
  if ts_ok || [ "$TS_API_CODE" = 404 ]; then
    # 404 = the old key is already gone (already revoked/expired) — idempotent OK.
    log "reconcile: rotate $box — revoked old key id=$old_id (HTTP $TS_API_CODE)"
  else
    # Revoke failed: the NEW key is still seeded + working, so the rotation as a
    # whole SUCCEEDED. Surface the stale-key leftover but do NOT fail (never
    # fail the rotation on a revoke miss — the old key expires on its own).
    log "reconcile: rotate $box — old key id=$old_id revoke FAILED (HTTP $TS_API_CODE); new key OK, old key will lapse at its own expiry"
  fi
  return 0
}

# reconcile_rollout <box> (row d): deploy the target tree to the fleet over the
# reverse tunnels REUSING the D7 canary-first + abort-on-first-failure control
# flow. The canary box (config [fleet-brain].canary_box, default 8) goes first
# and is verified via `boxup check` over its tunnel; on any verified failure the
# rollout ABORTS (no further boxes touched); the rest roll SERIALLY, each
# verified by `boxup check`, aborting on the first failure. Drift on ONE box
# triggers a FLEET rollout (D7 is a fleet operation, canary-first) — the same
# semantics as the laptop-side `rollout --all`, but the transport is the tunnel
# (ssh -p 2000N box@127.0.0.1 with the VPS key) instead of tailnet+password.
reconcile_rollout() {
  local trigger="$1"
  local canary; canary="$(reconcile_canary_box)"
  log "reconcile: rollout triggered by $trigger drift — canary-first over tunnels (canary=$canary)"

  # B-2: STAGE the target artifact BEFORE touching any box. A rollout with no
  # artifact to push is a no-op masquerading as success — the whole point of
  # row d is version drift, so a rollout MUST deploy a tree. If we cannot stage
  # one, ABORT the rollout (never run a push-less converge and report success).
  if ! reconcile_stage_rollout_tree; then
    log "reconcile: rollout ABORT — could not stage a target tree to push (no artifact => not a rollout)"
    notify warn "rollout aborted: no deployable artifact staged (set [fleet-brain].rollout_src or FLEET_ROLLOUT_SRC)"
    return 1
  fi

  # Ordered target list: canary FIRST, then the rest of the enrolled boxes
  # (serially). Only boxes whose tunnel is UP are reachable to deploy over.
  local -a rest=() b
  while IFS= read -r b; do
    [ -n "$b" ] || continue
    [ "$b" = "$canary" ] && continue
    rest+=("$b")
  done < <(reconcile_target_boxes)

  # Canary gate: an UNREACHABLE canary ABORTS (mirrors D7 cmd_rollout: rolling
  # the fleet unverified is worse than stopping).
  if ! tunnel_up "$canary"; then
    log "reconcile: rollout ABORT — canary $canary tunnel is DOWN (cannot verify); ZERO boxes deployed"
    notify warn "rollout aborted: canary $canary unreachable over tunnel"
    reconcile_cleanup_rollout_tree
    return 1
  fi
  if ! tunnel_deploy_one "$canary"; then
    log "reconcile: rollout ABORT — canary $canary FAILED verification; ZERO other boxes touched"
    notify warn "rollout aborted: canary $canary failed verification"
    reconcile_cleanup_rollout_tree
    return 1
  fi
  log "reconcile: rollout — canary $canary verified; rolling the rest serially"

  local b2 rc=0
  for b2 in "${rest[@]}"; do
    if ! tunnel_up "$b2"; then
      log "reconcile: rollout — $b2 tunnel down; skipping (not a verified failure, continuing)"
      continue
    fi
    if ! tunnel_deploy_one "$b2"; then
      log "reconcile: rollout ABORT — $b2 FAILED verification; no further boxes deployed"
      notify warn "rollout aborted at $b2 (verified failure)"
      rc=1
      break
    fi
  done
  reconcile_cleanup_rollout_tree
  [ "$rc" = 0 ] && log "reconcile: rollout complete"
  return "$rc"
}

# reconcile_stage_rollout_tree (B-2): package the target tree into a tarball and
# export its path as FLEET_ROLLOUT_TREE so tunnel_deploy_one pushes a REAL
# artifact. Source precedence:
#   1. FLEET_ROLLOUT_TREE already points at an existing tarball (pre-staged /
#      test injection) — use it as-is (we did not create it, so don't delete it).
#   2. a git checkout at [fleet-brain].rollout_src / FLEET_ROLLOUT_SRC — package
#      HEAD (or FLEET_TARGET_SHA) via `git archive`, mirroring D7's packaging.
# Returns non-zero if it cannot produce a tarball. Sets FLEET_ROLLOUT_TREE and
# FLEET_ROLLOUT_TREE_STAGED=1 (so cleanup removes only what WE created).
FLEET_ROLLOUT_TREE_STAGED=0
reconcile_stage_rollout_tree() {
  FLEET_ROLLOUT_TREE_STAGED=0
  # (1) already a real tarball path? use it verbatim.
  if [ -n "${FLEET_ROLLOUT_TREE:-}" ] && [ -f "$FLEET_ROLLOUT_TREE" ]; then
    log "reconcile: rollout using pre-staged tree $FLEET_ROLLOUT_TREE"
    return 0
  fi
  # (2) package from a git source on the VPS.
  local src; src="${FLEET_ROLLOUT_SRC:-$(config_get fleet-brain rollout_src 2>/dev/null || true)}"
  [ -n "$src" ] || { log "reconcile: rollout no source tree configured (FLEET_ROLLOUT_SRC / [fleet-brain].rollout_src)"; return 1; }
  [ -d "$src" ] || { log "reconcile: rollout source '$src' is not a directory"; return 1; }
  have git || { log "reconcile: rollout needs git to package '$src'"; return 1; }
  ( cd "$src" && git rev-parse --git-dir >/dev/null 2>&1 ) || { log "reconcile: rollout source '$src' is not a git repo"; return 1; }
  local tar ref="${FLEET_TARGET_SHA:-HEAD}"
  tar="$(mktemp --suffix=.tar 2>/dev/null || mktemp)" || { log "reconcile: rollout mktemp failed"; return 1; }
  if ! ( cd "$src" && git archive --format=tar -o "$tar" "$ref" ) 2>/dev/null; then
    rm -f "$tar"; log "reconcile: rollout git archive $ref from '$src' failed"; return 1
  fi
  # A zero-byte tarball is not a deployable artifact.
  [ -s "$tar" ] || { rm -f "$tar"; log "reconcile: rollout packaged an empty tree from '$src'"; return 1; }
  FLEET_ROLLOUT_TREE="$tar"
  FLEET_ROLLOUT_TREE_STAGED=1
  log "reconcile: rollout staged $ref from '$src' -> $(basename "$tar")"
  return 0
}

# reconcile_cleanup_rollout_tree: remove the tarball only if WE staged it.
reconcile_cleanup_rollout_tree() {
  if [ "${FLEET_ROLLOUT_TREE_STAGED:-0}" = 1 ] && [ -n "${FLEET_ROLLOUT_TREE:-}" ]; then
    rm -f "$FLEET_ROLLOUT_TREE" 2>/dev/null || true
    FLEET_ROLLOUT_TREE_STAGED=0
  fi
}

# reconcile_canary_box -> the canary box name. [fleet-brain].canary_box (a bare
# N or grok-box-N) else default 8.
reconcile_canary_box() {
  local c; c="$(config_get fleet-brain canary_box 2>/dev/null || true)"
  [ -n "$c" ] || c="8"
  case "$c" in grok-box-*) printf '%s' "$c" ;; *) printf 'grok-box-%s' "${c#grok-box-}" ;; esac
}

# tunnel_deploy_one <box>: push the target tree over the box's reverse tunnel,
# run install.sh + boxup once, then VERIFY via `boxup check` over the tunnel.
# Returns 0 iff the post-deploy `boxup check` passes (the D6 postcondition),
# 1 on any transport/install/verify failure. The tree is staged from
# $FLEET_ROLLOUT_TREE (a tarball path) when set — the reconcile caller stages
# HEAD once; tests stub tunnel_ssh/tunnel_scp and assert the tunnel argv + the
# canary-first/abort ordering without a real box.
FLEET_ROLLOUT_TREE="${FLEET_ROLLOUT_TREE:-}"
tunnel_deploy_one() {
  local box="$1" remote_tar="/tmp/grok-box-setup-brain.tar" \
        remote_dir="/tmp/grok-box-setup-brain"
  # B-2: a rollout MUST push a real artifact. If no staged tree exists, this is
  # not a deploy — FAIL rather than silently running a push-less converge and
  # reporting success (that was the B-2 lie). reconcile_rollout stages the tree
  # before calling us; a direct caller must set FLEET_ROLLOUT_TREE.
  if [ -z "${FLEET_ROLLOUT_TREE:-}" ] || [ ! -f "$FLEET_ROLLOUT_TREE" ]; then
    log "reconcile: rollout $box — NO artifact staged (FLEET_ROLLOUT_TREE unset/missing); refusing a push-less rollout"
    return 1
  fi
  # Push the tree over the tunnel. A scp failure is a hard failure.
  if ! tunnel_scp "$box" "$FLEET_ROLLOUT_TREE" "$remote_tar"; then
    log "reconcile: rollout $box — scp over tunnel FAILED"
    return 1
  fi
  # Extract + install + converge over the tunnel, then verify with boxup check.
  # The remote_tar MUST be present (we just pushed it); a missing tar here means
  # the push did not land — fail rather than converge without installing.
  if ! tunnel_ssh "$box" "
    set -e
    [ -f '$remote_tar' ] || { echo 'ROLLOUT_NO_ARTIFACT' >&2; exit 4; }
    rm -rf '$remote_dir'; mkdir -p '$remote_dir'
    tar -xf '$remote_tar' -C '$remote_dir'
    sudo env BOX_SETUP_GIT_SHA='${FLEET_TARGET_SHA:-unknown}' bash '$remote_dir/install.sh'
    rm -rf '$remote_dir' '$remote_tar'
    sudo $BOX_ROOT/boxup once >/dev/null 2>&1 || sudo $BOX_ROOT/boxup once
  " >/dev/null 2>&1; then
    log "reconcile: rollout $box — install/once over tunnel FAILED (or artifact missing)"
    return 1
  fi
  # Postcondition: boxup check over the tunnel (D6, same as D7's verify).
  if ! tunnel_ssh "$box" "sudo $BOX_ROOT/boxup check" >/dev/null 2>&1; then
    log "reconcile: rollout $box — post-deploy boxup check FAILED (verify)"
    return 1
  fi
  log "reconcile: rollout $box — deployed + verified over tunnel"
  return 0
}

# tunnel_scp <box> <local-src> <remote-dst>: scp over the box's reverse tunnel
# as box@127.0.0.1 -p 2000N using the VPS's own key (mirrors tunnel_ssh; NO
# password fallback — R7).
tunnel_scp() {
  local box="$1" src="$2" dst="$3"
  local port; port="$(port_for "$box")" || return 1
  scp -o StrictHostKeyChecking=accept-new \
      -o BatchMode=yes \
      -o ConnectTimeout=8 \
      -P "$port" \
      -i "$FLEET_BOX_KEY" \
      "$src" "box@127.0.0.1:$dst"
}

# reconcile_dedup <box>: DELETE the older-offline duplicate, THEN POST the live
# node's name back to grok-box-N (clears the -1 suffix, F2). Never deletes when
# both are online (decided upstream). Uses the recorded device ids.
reconcile_dedup() {
  local box="$1" devs stale live
  devices_json >/dev/null
  ts_ok || { log "reconcile: dedup $box API read failed — skip"; RECONCILE_READONLY=1; return 1; }
  devs="$(ts_api_body)"
  # B-1: a malformed 200 here is not trustworthy device data — latch read-only.
  if ! devices_json_valid "$devs"; then
    log "reconcile: dedup $box API body malformed — READ-ONLY latch, skip"; RECONCILE_READONLY=1; return 1
  fi
  stale="$(dev_field "$devs" "$box" stale_id)"
  live="$(dev_field "$devs" "$box" live_id)"
  [ -n "$stale" ] || { log "reconcile: dedup $box no stale id"; return 1; }
  ts_api DELETE "/device/$stale" >/dev/null
  ts_ok || { log "reconcile: dedup $box DELETE $stale HTTP $TS_API_CODE"; RECONCILE_READONLY=1; return 1; }
  log "reconcile: dedup $box deleted stale device $stale"
  if [ -n "$live" ]; then
    ts_api POST "/device/$live/name" "$(jq -cn --arg n "$box" '{name:$n}')" >/dev/null
    if ts_ok; then
      log "reconcile: dedup $box renamed live $live -> $box"
    else
      # A rename failure is a real API failure: latch read-only so no later row
      # mutates this run, and report the failure (do NOT swallow it as success).
      log "reconcile: dedup $box rename HTTP $TS_API_CODE"
      RECONCILE_READONLY=1
      return 1
    fi
  fi
  return 0
}

reconcile_bump_checkfail() {
  local box="$1" f n=0
  f="$FLEET_STATE/$box.checkfail"
  [ -f "$f" ] && n=$(tr -d '[:space:]' < "$f" 2>/dev/null || echo 0)
  case "$n" in ''|*[!0-9]*) n=0 ;; esac
  n=$((n + 1)); echo "$n" > "$f" 2>/dev/null || true
  printf '%s' "$n"
}
reconcile_reset_checkfail() { echo 0 > "$FLEET_STATE/$1.checkfail" 2>/dev/null || true; }

# --- P1-2 seed-failure counter (mint 2xx but seed never converges) -----------
reconcile_bump_seedfail() {
  local box="$1"
  local f="$FLEET_STATE/$box.seedfail" n=0
  [ -f "$f" ] && n=$(tr -d '[:space:]' < "$f" 2>/dev/null || echo 0)
  case "$n" in ''|*[!0-9]*) n=0 ;; esac
  n=$((n + 1)); echo "$n" > "$f" 2>/dev/null || true
  printf '%s' "$n"
}
reconcile_reset_seedfail() { echo 0 > "$FLEET_STATE/$1.seedfail" 2>/dev/null || true; }

# --- P1-4 row-e timing/digest state ------------------------------------------
# alert-asleep: BOTH paths dead is informational and legitimately common (a sand
# box sleeps). Fire the FIRST alert only after T=2h of CONTINUOUS both-dead,
# then at most one DAILY digest thereafter. State: $box.asleep holds two
# whitespace-separated epochs "<since> <last_alert>" (last_alert 0 = never).
FLEET_ASLEEP_T_SECS="${FLEET_ASLEEP_T_SECS:-7200}"     # 2h before first alert
FLEET_ASLEEP_DIGEST_SECS="${FLEET_ASLEEP_DIGEST_SECS:-86400}"  # daily digest
reconcile_alert_asleep() {
  local box="$1"
  local f="$FLEET_STATE/$box.asleep" now since last
  now="$(date -u +%s 2>/dev/null || echo 0)"
  if [ -f "$f" ]; then
    read -r since last < "$f" 2>/dev/null || { since=""; last=""; }
  fi
  case "$since" in ''|*[!0-9]*) since="$now" ;; esac   # first both-dead observation
  case "$last"  in ''|*[!0-9]*) last=0 ;; esac
  local elapsed=$(( now - since ))
  if [ "$last" = 0 ]; then
    # No alert yet: fire once we have been asleep >= T.
    if [ "$elapsed" -ge "$FLEET_ASLEEP_T_SECS" ]; then
      notify info "$box: asleep — both paths dead for >= $((FLEET_ASLEEP_T_SECS/3600))h"
      last="$now"
    fi
  else
    # Already alerted once: daily digest only.
    if [ $(( now - last )) -ge "$FLEET_ASLEEP_DIGEST_SECS" ]; then
      notify info "$box: still asleep (daily digest) — both paths dead since $since"
      last="$now"
    fi
  fi
  printf '%s %s\n' "$since" "$last" > "$f" 2>/dev/null || true
}
reconcile_reset_asleep() { rm -f "$FLEET_STATE/$1.asleep" 2>/dev/null || true; }

# alert-incident:incoherent-both-dead: API says the device is ONLINE yet BOTH
# paths are dead — something is lying. Actionable, but only after 2 CONSECUTIVE
# reconcile runs (one blip is not paged). $box.incoherent holds the consecutive
# run count.
reconcile_alert_incoherent() {
  local box="$1"
  local f="$FLEET_STATE/$box.incoherent" n=0
  [ -f "$f" ] && n=$(tr -d '[:space:]' < "$f" 2>/dev/null || echo 0)
  case "$n" in ''|*[!0-9]*) n=0 ;; esac
  n=$((n + 1)); echo "$n" > "$f" 2>/dev/null || true
  if [ "$n" -ge 2 ] 2>/dev/null; then
    notify warn "$box: incoherent-both-dead (API online yet both paths dead for $n consecutive runs)"
  fi
}
reconcile_reset_incoherent() { rm -f "$FLEET_STATE/$1.incoherent" 2>/dev/null || true; }

# days_until <YYYY-MM-DD> -> integer days from now (may be negative); "unknown"
# if unparseable. VPS-side clock (P2-5).
days_until() {
  local d="$1" epoch now
  epoch="$(date -u -d "$d" +%s 2>/dev/null)" || { echo unknown; return; }
  now="$(date -u +%s)"
  echo $(( (epoch - now) / 86400 ))
}

# tunnel_status_sha <box> -> the sha from `boxup status` v=<ver>/<sha> over the
# tunnel, or "unknown".
tunnel_status_sha() {
  local line; line="$(tunnel_ssh "$1" "sudo $BOX_ROOT/boxup status" 2>/dev/null)"
  status_line_sha "$line"
}

# dev_field <devices-json> <box> <field>: extract one derived field for a box
# from the Tailscale devices response. field one of:
#   online     -> yes|no  (any device for this hostname currently online)
#   fresh      -> yes|no  (any device lastSeen within FLEET_STALE_SECS)
#   dupcount   -> integer count of devices with hostname==box
#   both_online-> yes|no  (>=2 devices AND >=2 of them online)
#   stale_id   -> nodeId of the OLDER OFFLINE duplicate (row b delete target)
#   live_id    -> nodeId of the currently-online duplicate (rename target)
# Hostname match is against the base name grok-box-N OR the -1 suffixed corpse.
FLEET_STALE_SECS="${FLEET_STALE_SECS:-600}"
dev_field() {
  local devs="$1" box="$2" field="$3"
  printf '%s' "$devs" | jq -r \
    --arg box "$box" --arg field "$field" --argjson stale "$FLEET_STALE_SECS" '
    def base(h): (h | sub("-1$"; ""));
    (now) as $now
    | [ .devices[]? | select((base(.hostname // .name // "")) == $box) ] as $ds
    | ($ds | map(select(.online == true)) ) as $on
    | ($ds
        | map(select(.online != true))
        | sort_by(.lastSeen // .created // "")
      ) as $off
    | if   $field == "online"    then (if ($on|length)>0 then "yes" else "no" end)
      elif $field == "dupcount"  then ($ds|length|tostring)
      elif $field == "both_online" then (if ($on|length)>=2 then "yes" else "no" end)
      elif $field == "fresh"     then
        (if ($ds | map((.lastSeen // "1970-01-01T00:00:00Z") | fromdateiso8601? // 0)
               | map(select($now - . <= $stale)) | length) > 0 then "yes" else "no" end)
      elif $field == "stale_id"  then ($off | (.[0].nodeId // .[0].id // ""))
      elif $field == "live_id"   then ($on  | (.[0].nodeId // .[0].id // ""))
      else "" end
  ' 2>/dev/null
}

# --- status (brain fleet table) ----------------------------------------------
# fleetctl status is ALREADY defined above (laptop-side, boxup status per box).
# The brain adds `fleet-status`: API online/lastSeen + tunnel up + boxup check
# + authkey expiry + version, one row per enrolled box.
cmd_fleet_status() {
  local devs=""; devices_json >/dev/null
  local api_ok=1
  if ts_ok; then devs="$(ts_api_body)"; else api_ok=0; devs=""; fi
  printf '%-14s %-7s %-7s %-7s %-12s %-10s\n' NAME API TUNNEL CHECK AUTHKEY VERSION
  local -a boxes=(); local b
  while IFS= read -r b; do [ -n "$b" ] && boxes+=("$b"); done < <(reconcile_target_boxes)
  for b in "${boxes[@]}"; do
    local api=down tun=down chk="-" akx="-" ver="-"
    if [ "$api_ok" = 1 ] && [ -n "$devs" ]; then
      [ "$(dev_field "$devs" "$b" online)" = yes ] && api=online || api=offline
    else
      api="?"
    fi
    tunnel_up "$b" && tun=up
    if [ "$tun" = up ]; then
      tunnel_ssh "$b" "sudo $BOX_ROOT/boxup check" >/dev/null 2>&1 && chk=OK || chk=FAIL
      local line; line="$(tunnel_ssh "$b" "sudo $BOX_ROOT/boxup status" 2>/dev/null)"
      ver="$(status_line_sha "$line")"
    fi
    local expf="$FLEET_STATE/$b.expires"
    if [ -f "$expf" ]; then
      local d; d="$(awk -F'\t' '{print $2}' "$expf" 2>/dev/null | tr -d '[:space:]')"
      [ -n "$d" ] && akx="$d"
    fi
    printf '%-14s %-7s %-7s %-7s %-12s %-10s\n' "$b" "$api" "$tun" "$chk" "$akx" "$ver"
  done
}

# --- help --------------------------------------------------------------------
usage() {
  cat <<'EOF'
fleetctl — laptop-side fleet CLI for the grok boxes

Usage:
  fleetctl list                  discover grok-box-N peers (name, ts IP, online)
  fleetctl status [box...]       one boxup status line per box (default: online)
  fleetctl check [--notify]      health gate; exit 1 if any box unhealthy
  fleetctl rollout <box...>      deploy current git HEAD to explicit boxes
  fleetctl rollout --all [--canary <box>]
                                 deploy to the whole fleet (canary first,
                                 verify, abort on first verified failure)
  fleetctl rollout [--dirty] ... allow a dirty working tree
  fleetctl ssh <box> [cmd...]    ssh into a box (or run a command)
  fleetctl install-timer         systemd USER timer: check --notify every 10min
  fleetctl remove-timer          remove that timer

Brain subcommands (docs/FLEET-BRAIN.md — run on the VPS + laptop):
  fleetctl enroll <grok-box-N>   trust a box's reverse tunnel (OpenSSH/tailnet;
                                 ACL-prechecks tag:fleet-brain tagOwners)
  fleetctl reconcile [--apply]   the 5-min decision table (DRY-RUN by default)
  fleetctl mint-key <grok-box-N> mint a per-box tag-scoped key + atomic seed
  fleetctl fleet-status          brain table: API / tunnel / check / authkey / ver
  fleetctl version | help

Environment:
  FLEET_SSH_PASSWORD   ssh password (else config.toml [ssh].password, else 12345678)
  FLEET_BOXES          space-separated box list, bypasses tailscale discovery
  FLEET_CONFIG         config path (default ~/.config/fleetctl/config.toml)
  FLEET_MAX_CONCURRENCY  max concurrent rollouts (default 2)
  FLEET_ETC            brain secrets dir (default /etc/grok-fleet)
  FLEET_STATE          brain state dir (default /var/lib/grok-fleet)
  FLEET_API_TOKEN_FILE Tailscale API token file (600; else [fleet-brain].api_token_file)
EOF
}

# --- dispatch ----------------------------------------------------------------
cmd="${1:-help}"
[ "$#" -gt 0 ] && shift
case "$cmd" in
  list)                  cmd_list "$@" ;;
  status)                cmd_status "$@" ;;
  check)                 cmd_check "$@" ;;
  rollout)               cmd_rollout "$@" ;;
  ssh)                   cmd_ssh "$@" ;;
  install-timer)         cmd_install_timer "$@" ;;
  remove-timer)          cmd_remove_timer "$@" ;;
  enroll)                cmd_enroll "$@" ;;
  reconcile)             cmd_reconcile "$@" ;;
  mint-key)              cmd_mint_key "$@" ;;
  fleet-status)          cmd_fleet_status "$@" ;;
  version|--version)     echo "fleetctl $FLEETCTL_VERSION" ;;
  -h|--help|help)        usage ;;
  *)
    echo "fleetctl: unknown command: $cmd" >&2
    usage >&2
    exit 2
    ;;
esac
