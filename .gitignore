# Runtime identity — never publish another box's node
state/tailscale/**
!state/tailscale/.gitkeep
secrets/**
!secrets/.gitkeep
hostname
*.pre-v4
*.v4tmp

# H10: auth keys must never land in the tree even if dropped OUTSIDE secrets/.
# A live tailnet key was once left at the repo root as auth_key.txt (untracked
# but not ignored). Belt-and-braces filename patterns — no hook, no scanner.
auth_key.txt
*authkey*
*auth_key*
tskey-*
*.authkey

# Logs and pid files
*.log
*.pid
/run/

# Local overlays
/usr-copy/
box-bootstrap.sh.bak

# OS / editor
.DS_Store
Thumbs.db
*~
*.swp
.idea/
.vscode/
.env
.env.*

# CAO worker artifacts (session-local, never ship)
/probes/
/assets/
/tmp/

# fleet2 (bun+TS brain) build output — the compiled binary never ships in the
# tree; `git archive` must not carry it to boxes (blueprint S11).
fleet/dist/
fleet/node_modules/
