# Runtime identity — never publish another box's node
state/tailscale/**
!state/tailscale/.gitkeep
secrets/**
!secrets/.gitkeep
hostname
*.pre-v4
*.v4tmp

# H10: auth keys must never land in the tree even if dropped OUTSIDE secrets/.
# A live tailnet key was once left at the repo root as auth_key.txt (untracked
# but not ignored). Belt-and-braces filename patterns — no hook, no scanner.
# Underscore AND hyphen spellings both count: `auth-key.txt` / `tskey.txt` used
# to fall through the underscore-only patterns.
auth_key.txt
*authkey*
*auth_key*
*auth-key*
tskey*
tskey-*
*.authkey

# Logs and pid files
*.log
*.pid
/run/

# Local overlays
/usr-copy/
box-bootstrap.sh.bak

# OS / editor
.DS_Store
Thumbs.db
*~
*.swp
.idea/
.vscode/
.env
.env.*

# CAO worker artifacts (session-local, never ship)
/probes/
/assets/
/tmp/

# grokfleet (bun+TS brain) build output — the compiled binary never ships in the
# tree; `git archive` must not carry it to boxes (blueprint S11).
fleet/dist/
fleet/node_modules/

# The state-store suite's real-file scratch (test/store/helpers.ts). Repo-local
# so the suite runs on any checkout; never committed.
fleet/.test-scratch/

# Local CAO orchestration hooks — session/seat wiring for the agent harness that
# drives this repo, NOT project code. They are live on the operator's machine and
# must keep working, so they stay on disk and out of the tree (untracked in
# grokfleet phase 3 r2, blocker 4).
.claude/
