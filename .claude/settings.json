{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/supervisor-only.sh\" $CLAUDE_PROJECT_DIR/.claude/hooks/f162-register-inbox.sh",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/supervisor-only.sh\" $CLAUDE_PROJECT_DIR/.claude/hooks/f213-callback-rewake.sh --prime --notify",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/supervisor-only.sh\" /home/chao/VScode_projects/cli-subagents/scripts/fleet-tui-ensure.sh || true",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/supervisor-only.sh\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/ws-arming-check.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/supervisor-only.sh\" $CLAUDE_PROJECT_DIR/.claude/hooks/f213-callback-rewake.sh --arm --source=stop",
            "asyncRewake": true,
            "timeout": 10,
            "rewakeSummary": "CAO callback waiting",
            "rewakeMessage": "A CAO worker callback is pending and was not delivered by any other channel. The authoritative digest will be injected by the inbox-drain hook on your first tool call this turn \u2014 make one. Summary of what is waiting:"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/supervisor-only.sh\" $CLAUDE_PROJECT_DIR/.claude/hooks/f162-register-inbox.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/supervisor-inbox-drain.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/supervisor-only.sh\" $CLAUDE_PROJECT_DIR/.claude/hooks/f213-callback-rewake.sh --arm --source=posttooluse",
            "asyncRewake": true,
            "timeout": 10,
            "rewakeSummary": "CAO callback waiting",
            "rewakeMessage": "A CAO worker callback is pending and was not delivered by any other channel. The authoritative digest will be injected by the inbox-drain hook on your first tool call this turn \u2014 make one. Summary of what is waiting:"
          }
        ]
      },
      {
        "matcher": "mcp__cao-mcp-server__assign|mcp__cao-mcp-server__handoff",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/supervisor-only.sh\" /home/chao/VScode_projects/cli-subagents/scripts/fleet-tui-ensure.sh || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}